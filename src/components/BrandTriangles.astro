---
/* The DE-CONSPIRATOR geometric tangram — clusters of right-triangles in navy,
   slate and periwinkle that decorate cover corners across the deliverable family.
   Decorative only; positioned by the parent via a passed class. */
interface Props {
  tone?: 'light' | 'dark';   // 'light' = on porcelain, 'dark' = on navy
  class?: string;
}
const { tone = 'light', class: klass = '' } = Astro.props;

const S = 80; // cell size in the 320×320 viewBox
// palette index 0..3 = [deepest, mid, periwinkle, faint]
const PALETTES = {
  light: ['#162259', '#3A4378', '#8689A8', '#DEDEEB'],
  dark: ['#22306E', '#3A4378', '#5A639F', 'rgba(220,226,240,0.13)'],
};
const pal = PALETTES[tone];

// [col, row, direction, paletteIndex]
const TRIS: [number, number, 'tl' | 'tr' | 'bl' | 'br', number][] = [
  [3, 0, 'tl', 3], [3, 0, 'br', 0],
  [2, 0, 'br', 2],
  [3, 1, 'tl', 1], [3, 1, 'br', 3],
  [2, 1, 'tr', 0], [2, 1, 'bl', 2],
  [1, 1, 'br', 3],
  [3, 2, 'bl', 0],
  [2, 2, 'tl', 2], [2, 2, 'br', 1],
  [1, 2, 'tr', 3],
  [0, 2, 'br', 2],
  [2, 3, 'tl', 0],
  [1, 3, 'tr', 1],
  [0, 3, 'br', 3],
];

function points(col: number, row: number, dir: string): string {
  const x = col * S, y = row * S;
  const p: Record<string, number[][]> = {
    tl: [[x, y], [x + S, y], [x, y + S]],
    tr: [[x, y], [x + S, y], [x + S, y + S]],
    bl: [[x, y], [x, y + S], [x + S, y + S]],
    br: [[x + S, y], [x, y + S], [x + S, y + S]],
  };
  return p[dir].map(([px, py]) => `${px},${py}`).join(' ');
}
---
<svg class:list={['brand-triangles', klass]} viewBox="0 0 320 320" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMid meet">
  {TRIS.map(([c, r, d, i]) => <polygon points={points(c, r, d)} fill={pal[i]} />)}
</svg>

<style>
  /* fills its (sized) wrapper; the consumer positions a wrapper div. */
  .brand-triangles { display: block; width: 100%; height: 100%; pointer-events: none; }
</style>
