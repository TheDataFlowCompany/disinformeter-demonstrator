---
// Alternative hero: the instrument as one abstract reading.
//
// The old gauge was a single needle on a single arc, which is exactly the folk
// continuum the instrument exists to replace. This keeps what was good about it,
// a measuring tool caught in the act, and drops what was wrong: the reading is a
// point in a two-axis field, so receptivity and resilience are read together
// without being collapsed into one number. The probe sweeps in, overshoots,
// settles, then drifts very slightly, the way a live instrument never sits
// perfectly still. Pure CSS, no script. Illustrative, not a data reading.
const TICKS = 6; // six intervals = the seven points of the response scale
---

<figure class="instr">
  <div class="field">
    <span class="ax ay mono" aria-hidden="true">FIMI Resilience</span>
    <span class="end y7 mono" aria-hidden="true">7</span>
    <span class="end y1 mono" aria-hidden="true">1</span>

    <div class="plot">
      <span class="grid" aria-hidden="true" style={`--n: ${TICKS}`}></span>
      <span class="probe" aria-hidden="true"><span class="drift"><span class="glow"></span><span class="dot"></span></span></span>
    </div>

    <span class="ax axx mono" aria-hidden="true">FIMI Receptivity</span>
    <span class="end x1 mono" aria-hidden="true">1</span>
    <span class="end x7 mono" aria-hidden="true">7</span>
  </div>
  <figcaption class="cap mono">One reading, two axes · illustrative</figcaption>
</figure>

<style>
  .instr { margin: 0; width: 100%; max-width: 460px; display: grid; gap: var(--sp-3); }

  .field {
    position: relative;
    padding: var(--sp-5) var(--sp-5) var(--sp-6) var(--sp-6);
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  /* the measurement field: six intervals each way, the seven points of the
     1-7 scale, and it clips the crosshair so the reading stays inside its frame */
  .plot {
    position: relative; aspect-ratio: 1.25; overflow: clip;
    border: 1px solid var(--hairline-strong); border-radius: 2px;
    background: var(--surface-2);
  }
  .grid {
    position: absolute; inset: 0;
    background-image:
      repeating-linear-gradient(to right, var(--hairline) 0 1px, transparent 1px calc(100% / var(--n))),
      repeating-linear-gradient(to bottom, var(--hairline) 0 1px, transparent 1px calc(100% / var(--n)));
    background-size: calc(100% - 1px) calc(100% - 1px);
    background-repeat: no-repeat;
  }

  /* the probe is a point; its crosshair is drawn through it, so the whole
     reading moves by animating one pair of offsets */
  .probe {
    position: absolute; width: 0; height: 0;
    left: 62%; bottom: 54%;
    animation: probe-in 2100ms cubic-bezier(0.3, 0.7, 0.35, 1) both;
  }
  .drift { position: absolute; }
  .drift::before, .drift::after { content: ""; position: absolute; }
  .drift::before { left: -50vw; top: -0.5px; width: 100vw; height: 1px;
    background: color-mix(in srgb, var(--axis-detection) 45%, transparent); }
  .drift::after { top: -50vh; left: -0.5px; width: 1px; height: 100vh;
    background: color-mix(in srgb, var(--axis-receptivity) 40%, transparent); }

  /* a faint signal around the reading, so the field has somewhere to look */
  .glow { position: absolute; left: -60px; top: -60px; width: 120px; height: 120px; border-radius: 999px;
    background: radial-gradient(circle,
      color-mix(in srgb, var(--azure) 12%, transparent) 0%, transparent 70%); }

  .dot { position: absolute; left: -6.5px; top: -6.5px; width: 13px; height: 13px; border-radius: 999px;
    background: var(--navy);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--azure) 20%, transparent),
      0 2px 6px rgba(22, 34, 89, 0.28); }
  /* the moment the reading lands */
  .dot::after { content: ""; position: absolute; inset: -4px; border-radius: 999px;
    border: 1.5px solid var(--azure);
    animation: land 950ms ease-out both; animation-delay: 1900ms; }

  @keyframes probe-in {
    0%   { left: 8%;  bottom: 9%;  opacity: 0; }
    14%  { opacity: 1; }
    68%  { left: 69%; bottom: 62%; }
    84%  { left: 59%; bottom: 50%; }
    100% { left: 62%; bottom: 54%; opacity: 1; }
  }
  @keyframes drift {
    to { translate: -14px 10px; }
  }
  @keyframes land {
    from { transform: scale(1); opacity: 0.8; }
    to   { transform: scale(2.8); opacity: 0; }
  }
  /* a live instrument never sits perfectly still */
  @media (prefers-reduced-motion: no-preference) {
    .drift { animation: drift 9s 2300ms ease-in-out infinite alternate; }
  }

  /* axis furniture, in each axis's own colour */
  .ax, .end { position: absolute; font-size: 0.58rem; letter-spacing: 0.16em; text-transform: uppercase; }
  .end { font-size: 0.56rem; letter-spacing: 0.06em; color: var(--text-faint); }
  .axx { left: 50%; bottom: calc(var(--sp-6) - 1.5rem); transform: translateX(-50%);
    color: var(--axis-receptivity); }
  .ay { left: calc(var(--sp-6) - 1.5rem); top: 50%; transform-origin: center; rotate: -90deg;
    translate: -50% -50%; color: var(--axis-detection); }
  .x1 { left: var(--sp-6); bottom: calc(var(--sp-6) - 1.45rem); }
  .x7 { right: var(--sp-5); bottom: calc(var(--sp-6) - 1.45rem); }
  .y1 { left: calc(var(--sp-6) - 1.1rem); bottom: var(--sp-6); }
  .y7 { left: calc(var(--sp-6) - 1.1rem); top: var(--sp-5); }

  .cap { font-size: 0.62rem; letter-spacing: 0.13em; text-transform: uppercase;
    color: var(--text-faint); text-align: center; }

  @media (max-width: 900px) { .instr { max-width: 460px; margin-inline: auto; } }
</style>
