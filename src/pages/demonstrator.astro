  .sv-title { font-size: var(--step-4); font-weight: 800; margin-top: var(--sp-3); outline: none; }
  .sv-lede { margin-top: var(--sp-4); font-size: var(--step-1); color: var(--text-muted); }
  .sv-lede :global(strong) { color: var(--text); }

  /* ---- welcome ---- */
  .sv-steps { list-style: none; padding: 0; margin: var(--sp-6) 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); }
  .sv-stepcard { display: flex; flex-direction: column; gap: 2px; padding: var(--sp-4) var(--sp-5);
    background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--radius-lg); }
  .sv-stepcard-no { width: 1.7rem; height: 1.7rem; display: grid; place-items: center; border-radius: 999px;
    background: var(--navy); color: #fff; font-weight: 700; font-size: 0.8rem; margin-bottom: var(--sp-2); }
  .sv-stepcard strong { font-family: var(--font-display); color: var(--navy); }
  .sv-stepcard span:last-child { color: var(--text-muted); font-size: 0.9rem; }
  .sv-sim { margin-top: var(--sp-6); padding: var(--sp-4) var(--sp-5); background: var(--azure-soft);
    border-radius: var(--radius); color: var(--azure-700); font-size: 0.9rem; max-width: var(--maxw-prose); }
  .sv-welcome-cta { display: flex; align-items: center; gap: var(--sp-5); margin-top: var(--sp-6); flex-wrap: wrap; }
  .btn.lg { font-size: var(--step-0); padding: 0.85em 1.6em; }
  .sv-minutes { font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-faint); }

  /* ---- questionnaire ---- */
  .q-instr { font-size: var(--step-1); font-weight: 600; color: var(--navy); max-width: var(--maxw-prose);
    padding-bottom: var(--sp-4); border-bottom: 2px solid var(--azure-soft); }
  .q-list { display: grid; gap: var(--sp-4); margin-top: var(--sp-5); }
  .q { padding: var(--sp-5); background: var(--surface); border: 1px solid var(--hairline);
    border-radius: var(--radius-lg); transition: border-color 0.15s var(--ease), box-shadow 0.15s var(--ease); }
  .q.unanswered { border-color: var(--crimson); box-shadow: 0 0 0 3px var(--crimson-soft); }
  .q-text { font-size: 1.06rem; line-height: 1.45; color: var(--text); }

  /* 1–7 radio scale */
  .q-scale { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--sp-3) var(--sp-4); margin-top: var(--sp-4); }
  .q-anchor { font-size: 0.72rem; color: var(--text-faint); max-width: 9rem; line-height: 1.25; }
  .q-anchor.lo { text-align: right; }
  .q-radios { display: flex; justify-content: space-between; gap: 0.4rem; }
  .q-opt { flex: 1; display: grid; justify-items: center; gap: 0.3em; cursor: pointer; }
  .q-opt input { position: absolute; opacity: 0; width: 0; height: 0; }
  .q-opt-n { width: 2.4rem; max-width: 100%; aspect-ratio: 1; display: grid; place-items: center; border-radius: 999px;
    border: 1.5px solid var(--hairline-strong); background: var(--surface); color: var(--text-muted);
    font-family: var(--font-mono); font-weight: 500; font-size: 0.92rem;
    transition: border-color 0.12s var(--ease), background 0.12s var(--ease), color 0.12s var(--ease), transform 0.1s var(--ease); }
  .q-opt:hover .q-opt-n { border-color: var(--navy-300); }
  .q-opt input:checked + .q-opt-n { background: var(--navy); border-color: var(--navy); color: #fff; transform: scale(1.06); }
  .q-opt input:focus-visible + .q-opt-n { outline: 2px solid var(--azure-600); outline-offset: 2px; }

  .q-warn { margin-top: var(--sp-4); color: var(--crimson-700); font-weight: 600; font-size: 0.92rem; }

  /* ---- nav ---- */
  .sv-nav { display: flex; align-items: center; gap: var(--sp-4); margin-top: var(--sp-6); flex-wrap: wrap; }
  .sv-nav.end { justify-content: flex-end; }
  .sv-fill { margin-left: auto; background: none; border: 0; cursor: pointer; color: var(--text-faint);
    font-size: 0.72rem; letter-spacing: 0.04em; display: inline-flex; align-items: center; gap: 0.5em; text-decoration: underline;
    text-underline-offset: 2px; text-decoration-color: var(--hairline-strong); }
