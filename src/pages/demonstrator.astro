  .sv-fill-tag { font-size: 0.56rem; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.15em 0.5em;
    border-radius: 999px; background: var(--surface-2); border: 1px solid var(--hairline-strong); text-decoration: none; }

  /* ---- scoring transition ---- */
  .sv-scoring { display: grid; place-items: center; gap: var(--sp-4); padding: var(--sp-9) 0; color: var(--text-faint); }
  .sv-scoring-spin { width: 2.6rem; height: 2.6rem; border-radius: 999px; border: 3px solid var(--hairline);
    border-top-color: var(--azure); animation: sv-spin 0.8s linear infinite; }
  @keyframes sv-spin { to { transform: rotate(360deg); } }

  /* ---- feedback (shared look with /feedback) ---- */
  .sv-feedback { margin-top: var(--sp-6); display: grid; gap: var(--sp-6); }
  .fb-shared { padding: var(--sp-5); background: var(--surface-2); border-radius: var(--radius); }
  .shared-tag { font-size: 0.6rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--azure-700); margin-bottom: var(--sp-3); }
  .fb-group { --g: var(--azure-600); --g-soft: var(--azure-soft); --g-tint: color-mix(in srgb, var(--azure) 6%, var(--surface)); }
  .fb-group[data-tone="less"] { --g: var(--slate); --g-soft: var(--peri-100); --g-tint: color-mix(in srgb, var(--slate) 6%, var(--surface)); }
  .grp-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--sp-3);
    margin-bottom: var(--sp-3); padding-bottom: var(--sp-2); border-bottom: 2px solid var(--g-soft); }
  .grp-head h3 { font-size: var(--step-1); color: var(--navy); font-weight: 700; }
  .grp-mech { font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-faint); flex: none; }
  .cards { display: grid; gap: var(--sp-4); }

  /* ---- choice-task frame ---- */
  .ct-frame-wrap { margin-top: var(--sp-6); border: 1px solid var(--hairline-strong); border-radius: var(--radius-lg);
    overflow: hidden; box-shadow: var(--shadow); background: var(--surface); }
  .ct-frame-bar { padding: 0.55em var(--sp-4); background: var(--navy); color: #C7CBDE; font-size: 0.7rem; letter-spacing: 0.08em; }
  .ct-frame-bar .mono { text-transform: uppercase; }
  .ct-frame { width: 100%; height: 540px; border: 0; display: block; background: var(--ground); }
  .sv-task-note { margin-top: var(--sp-4); color: var(--text-faint); font-size: 0.88rem; }

  /* ---- done ---- */
  .step-done { text-align: center; padding-top: var(--sp-6); }
  .sv-done-mark { width: 3.4rem; height: 3.4rem; margin: 0 auto var(--sp-4); display: grid; place-items: center;
    border-radius: 999px; background: var(--azure-soft); color: var(--azure-700); font-size: 1.6rem; font-weight: 800; }
  .step-done .sv-lede { justify-content: center; margin-inline: auto; }
  .step-done .sv-lede { text-align: center; }
  .step-done .sv-sim { margin-inline: auto; }
  .sv-done-links { display: flex; flex-direction: column; gap: var(--sp-3); align-items: center; margin-top: var(--sp-6); }
  .sv-done-link { display: inline-flex; align-items: center; gap: 0.5em; font-family: var(--font-display); font-weight: 600; }
  .step-done .sv-nav.end { justify-content: center; }

  @media (max-width: 640px) {
    .sv-steps { grid-template-columns: 1fr; }
    .q-scale { grid-template-columns: 1fr; gap: var(--sp-3); }
    .q-anchor { max-width: none; }
    .q-anchor.lo { text-align: left; }
    .q-anchor.lo::before { content: "↓ "; }
    .q-anchor.hi { text-align: right; }
    .q-radios { order: 1; }
    .q-opt-n { width: 100%; aspect-ratio: auto; padding: 0.6em 0; }
  }
</style>

