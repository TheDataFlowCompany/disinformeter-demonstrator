---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { fb } from '../lib/data';

// domain key -> hue (the only place each domain's identity colour appears: a small dot)
const hueByKey: Record<string, string> = {
  threat: '--d-threat', aband: '--d-aband', fear: '--d-fear', super: '--d-admire',
};
const domains = fb.domains.map((d) => ({ ...d, hue: hueByKey[d.key] ?? '--ink' }));
---
<Base title="Personalized feedback" description="Try the DisInforMeter personalized-feedback intervention: enter domain scores and see the calm, relative feedback a respondent would receive.">
  <PageHeader title="Personalized feedback simulator">
    <p>After completing the DisInforMeter, respondents receive feedback tuned to their
       <strong>relatively strongest and weakest</strong> domains, written to inform without alarming.
       Set the four domain scores below, or randomise, and see exactly what the intervention returns,
       reproduced from the deployed Study&nbsp;5 logic.</p>
  </PageHeader>

  <section class="wrap fb">
    <div class="fb-grid">
      <!-- controls -->
      <form class="fb-controls panel" id="fb-controls" aria-label="Domain scores">
        <div class="fb-controls-head">
          <h2>Domain scores</h2>
          <button type="button" class="btn btn-ghost sm" id="randomize">Randomise</button>
        </div>
        <p class="fb-hint mono">1 = low endorsement · 7 = high endorsement</p>
        {domains.map((d) => (
          <div class="slider-row" style={`--c: var(${d.hue})`}>
            <label for={`s-${d.key}`}><span class="dot" aria-hidden="true"></span>{d.disinformeter_domain}</label>
            <input type="range" id={`s-${d.key}`} name={d.key} min="1" max="7" step="0.1" value="4"
                   aria-describedby={`o-${d.key}`} />
            <output id={`o-${d.key}`} class="mono" for={`s-${d.key}`}>4.0</output>
          </div>
        ))}
        <div class="lang-toggle" role="group" aria-label="Feedback language">
          <button type="button" data-lang="en" class="lang-btn active" aria-pressed="true">English<span class="prov">official</span></button>
          <button type="button" data-lang="lt" class="lang-btn" aria-pressed="false">Lietuvių<span class="prov">deployed</span></button>
        </div>
      </form>

      <!-- output -->
      <div class="fb-output">
        <article class="fb-shared panel" id="fb-intro">
          <p class="shared-tag mono">Shown to everyone</p>
          <div class="fb-msg" id="fb-intro-body"></div>
        </article>

        <section class="fb-group" data-tone="more" aria-labelledby="grp-more">
          <header class="grp-head">
            <h2 id="grp-more">Where messages may resonate more</h2>
            <span class="grp-mech mono">top 2 of 4 by score</span>
          </header>
          <div class="cards" id="cards-more"></div>
        </section>

        <section class="fb-group" data-tone="less" aria-labelledby="grp-less">
          <header class="grp-head">
            <h2 id="grp-less">Where messages may resonate less</h2>
            <span class="grp-mech mono">bottom 2 of 4 by score</span>
          </header>
          <div class="cards" id="cards-less"></div>
        </section>

        <article class="fb-shared panel" id="fb-closing">
          <p class="shared-tag mono">Shown to everyone</p>
          <div class="fb-msg" id="fb-closing-body"></div>
        </article>
      </div>
    </div>

    <details class="algo panel">
      <summary>How the selection works</summary>
      <p>{fb.algorithm.summary}</p>
      <ol>{fb.algorithm.steps.map((s) => <li>{s}</li>)}</ol>
      <p class="algo-note">{fb.algorithm.note}</p>
    </details>

    <p class="prov-note">
      English shows the project's official wording for this intervention; the study was fielded in
      Lithuanian (Study&nbsp;5). Switch to <strong>Lietuvių</strong> for the verbatim deployed text.
    </p>
  </section>
</Base>

<script define:vars={{ domains, intro: fb.intro, closing: fb.closing }}>
  const EPS = 1e-9;
  let lang = 'en';
  const state = {};
  domains.forEach((d) => (state[d.key] = 4));

  const introBody = document.getElementById('fb-intro-body');
  const closingBody = document.getElementById('fb-closing-body');
  const cardsMore = document.getElementById('cards-more');
  const cardsLess = document.getElementById('cards-less');

  function shuffle(arr) { // ties shuffled, mirroring the deployed ranking JS (Math.random ok client-side)
    for (let i = arr.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [arr[i], arr[j]] = [arr[j], arr[i]]; }
    return arr;
  }

  // Mirror the deployed ranking: sort ascending, group ties, bottom-2 = low, top-2 = high.
  function rank() {
    const keys = domains.map((d) => d.key);
    const sorted = [...keys].sort((a, b) => state[a] - state[b]);
    const groups = []; let cur = [sorted[0]];
    for (let i = 1; i < sorted.length; i++) {
      if (Math.abs(state[sorted[i]] - state[sorted[i - 1]]) <= EPS) cur.push(sorted[i]);
      else { groups.push(shuffle(cur)); cur = [sorted[i]]; }
    }
    groups.push(shuffle(cur));
    const order = groups.flat();
    const level = {};
    order.forEach((k, i) => (level[k] = i < 2 ? 'low' : 'high'));
    return level;
  }

  function escapeHtml(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

  // Render a plain-text block (blank-line paragraphs; "•"/"-" lines become a list) to safe HTML.
  function formatBlock(text) {
    return text.split(/\n\s*\n/).map((s) => s.trim()).filter(Boolean).map((seg) => {
      const lines = seg.split('\n').map((l) => l.trim()).filter(Boolean);
      let html = '', para = [], list = [];
      const flushP = () => { if (para.length) { html += `<p>${para.map(escapeHtml).join('<br>')}</p>`; para = []; } };
      const flushUl = () => { if (list.length) { html += `<ul>${list.map((l) => `<li>${escapeHtml(l)}</li>`).join('')}</ul>`; list = []; } };
      for (const l of lines) {
        const m = l.match(/^[•\-]\s?(.*)$/);
        if (m) { flushP(); list.push(m[1]); } else { flushUl(); para.push(l); }
      }
      flushP(); flushUl();
      return html;
    }).join('');
  }

  function cardHtml(d, level) {
    const s = state[d.key];
    const pct = Math.round((s / 7) * 100);
    return `<article class="fb-card" style="--c: var(${d.hue})">
      <div class="fb-card-head">
        <span class="fb-dot" aria-hidden="true"></span>
        <span class="fb-domain">${escapeHtml(d.disinformeter_domain)}</span>
        <span class="fb-score mono">${s.toFixed(1)}<span class="fb-score-max">/7</span></span>
      </div>
      <div class="fb-meter" aria-hidden="true"><i style="width:${pct}%"></i></div>
      <div class="fb-msg">${formatBlock(d.messages[level][lang].replace(/^\s*[-•–]\s*/, ''))}</div>
    </article>`;
  }

  function render() {
    const level = rank();
    const byScoreDesc = (a, b) => state[b.key] - state[a.key];
    const more = domains.filter((d) => level[d.key] === 'high').sort(byScoreDesc);
    const less = domains.filter((d) => level[d.key] === 'low').sort(byScoreDesc);

    introBody.innerHTML = formatBlock(intro[lang]);
    cardsMore.innerHTML = more.map((d) => cardHtml(d, 'high')).join('');
    cardsLess.innerHTML = less.map((d) => cardHtml(d, 'low')).join('');
    closingBody.innerHTML = formatBlock(closing[lang]);
  }

  // wire sliders
  domains.forEach((d) => {
    const input = document.getElementById(`s-${d.key}`);
    const out = document.getElementById(`o-${d.key}`);
    input.addEventListener('input', () => {
      state[d.key] = parseFloat(input.value);
      out.textContent = state[d.key].toFixed(1);
      render();
    });
  });
  document.getElementById('randomize').addEventListener('click', () => {
    domains.forEach((d) => {
      const v = Math.round((1 + Math.random() * 6) * 10) / 10;
      state[d.key] = v;
      document.getElementById(`s-${d.key}`).value = String(v);
      document.getElementById(`o-${d.key}`).textContent = v.toFixed(1);
    });
    render();
  });
  document.querySelectorAll('.lang-btn').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('.lang-btn').forEach((x) => { x.classList.remove('active'); x.setAttribute('aria-pressed', 'false'); });
    b.classList.add('active'); b.setAttribute('aria-pressed', 'true');
    lang = b.dataset.lang; render();
  }));

  render();
</script>

<style>
  .fb { padding-block: var(--sp-6) var(--sp-8); }
  .fb-grid { display: grid; grid-template-columns: 320px 1fr; gap: var(--sp-6); align-items: start; }

  /* ---- controls ---- */
  .fb-controls { padding: var(--sp-5); position: sticky; top: 68px; }
  .fb-controls-head { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-3); }
  .fb-controls-head h2 { font-size: var(--step-1); }
  .btn.sm { padding: 0.45em 0.8em; font-size: 0.74rem; }
  .fb-hint { font-size: 0.7rem; color: var(--text-faint); margin: var(--sp-2) 0 var(--sp-5); letter-spacing: 0.04em; }
  .slider-row { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 0.35em var(--sp-3); margin-bottom: var(--sp-5); }
  .slider-row label { display: inline-flex; align-items: center; gap: 0.5em; font-size: 0.9rem; font-weight: 600; }
  .slider-row label .dot { width: 9px; height: 9px; border-radius: 999px; background: var(--c); flex: none; }
  .slider-row output { font-family: var(--font-mono); font-weight: 600; color: var(--text-muted); font-size: 1rem; }
  .slider-row input[type=range] { grid-column: 1 / -1; width: 100%; accent-color: var(--c); cursor: pointer; }

  .lang-toggle { display: flex; gap: var(--sp-2); margin-top: var(--sp-2); border-top: 1px solid var(--hairline); padding-top: var(--sp-4); }
  .lang-btn { flex: 1; display: flex; flex-direction: column; gap: 1px; align-items: flex-start; cursor: pointer;
    font-family: var(--font-display); font-weight: 600; font-size: 0.85rem; padding: 0.5em 0.7em;
    background: var(--surface-2); border: 1px solid var(--hairline-strong); border-radius: var(--radius); color: var(--text-muted);
    transition: background 0.15s var(--ease), color 0.15s var(--ease), border-color 0.15s var(--ease); }
  .lang-btn:hover { border-color: var(--navy-300); }
  .lang-btn.active { background: var(--navy); color: #fff; border-color: var(--navy); }
  .lang-btn .prov { font-family: var(--font-mono); font-size: 0.56rem; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.7; font-weight: 400; }

  /* ---- output column ---- */
  .fb-output { display: grid; gap: var(--sp-6); }

  /* shared (everyone) blocks: calm, set apart from the personalized cards */
  .fb-shared { padding: var(--sp-5); background: var(--surface-2); border-radius: var(--radius); }
  .shared-tag { font-size: 0.6rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--azure-700);
    margin-bottom: var(--sp-3); }

  /* ---- the two resonance groups ---- */
  .fb-group { --g: var(--azure-600); --g-soft: var(--azure-soft); --g-tint: color-mix(in srgb, var(--azure) 6%, var(--surface)); }
  .fb-group[data-tone="less"] { --g: var(--slate); --g-soft: var(--peri-100); --g-tint: color-mix(in srgb, var(--slate) 6%, var(--surface)); }

  .grp-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--sp-3);
    margin-bottom: var(--sp-3); padding-bottom: var(--sp-2); border-bottom: 2px solid var(--g-soft); }
  .grp-head h2 { font-size: var(--step-1); color: var(--navy); font-weight: 700; }
  .grp-mech { font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-faint); flex: none; }

  .cards { display: grid; gap: var(--sp-4); }

  /* ---- algorithm + provenance ---- */
  .algo { margin-top: var(--sp-7); padding: var(--sp-5); }
  .algo summary { cursor: pointer; font-family: var(--font-display); font-weight: 600; }
  .algo ol { margin: var(--sp-3) 0 0 1.2em; display: grid; gap: 0.3em; color: var(--text-muted); font-size: 0.92rem; }
  .algo p { color: var(--text-muted); margin-top: var(--sp-3); }
  .algo-note { font-size: 0.88rem; font-style: italic; }

  .prov-note { margin-top: var(--sp-5); font-size: 0.88rem; color: var(--text-faint); max-width: var(--maxw-prose); }

  @media (max-width: 820px) {
    .fb-grid { grid-template-columns: 1fr; gap: var(--sp-5); }
    .fb-controls { position: static; }
  }
</style>

<!-- Cards and message bodies are injected at runtime (innerHTML), so they carry no
     Astro scope attribute and scoped rules skip them. These rules target that
     injected content; they stay contained by the page-level `.fb` class. -->
<style is:global>
  .fb .fb-msg { color: var(--text-muted); }
  .fb .fb-msg p + p { margin-top: var(--sp-3); }
  .fb .fb-msg ul { list-style: none; margin: var(--sp-3) 0 0; padding: 0; display: grid; gap: 0.45em; }
  .fb .fb-msg li { position: relative; padding-left: 1.3em; }
  .fb .fb-msg li::before { content: ""; position: absolute; left: 0.1em; top: 0.62em; width: 0.45em; height: 0.45em;
    border-radius: 999px; background: var(--azure-600); }

  .fb .fb-card { padding: var(--sp-4) var(--sp-5); background: var(--g-tint);
    border: 1px solid var(--hairline); border-radius: var(--radius-lg); }
  .fb .fb-card-head { display: flex; align-items: center; gap: 0.6em; }
  .fb .fb-dot { width: 10px; height: 10px; border-radius: 999px; background: var(--c); flex: none; }
  .fb .fb-domain { font-family: var(--font-display); font-weight: 700; color: var(--navy); }
  .fb .fb-score { margin-left: auto; color: var(--text-muted); font-weight: 600; }
  .fb .fb-score-max { color: var(--text-faint); font-weight: 400; }
  .fb .fb-meter { height: 5px; border-radius: 999px; background: var(--hairline); overflow: hidden; margin: var(--sp-3) 0 var(--sp-4); }
  .fb .fb-meter i { display: block; height: 100%; border-radius: 999px; background: var(--g); transition: width 0.18s var(--ease); }
  .fb .fb-card .fb-msg { font-size: 0.95rem; }
</style>
