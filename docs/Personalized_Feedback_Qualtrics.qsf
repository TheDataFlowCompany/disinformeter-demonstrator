lement":"SQ","PrimaryAttribute":"QID129","SecondaryAttribute":"- \u012fprastai pasitikite institucijomis ir pagrindin\u0117mis \u017einiasklaidos priemon\u0117mis, net ir tada, ka","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><\/p>\n\n<p><\/p>\n\n<p><b>- \u012fprastai pasitikite institucijomis ir pagrindin\u0117mis \u017einiasklaidos priemon\u0117mis, net ir tada, kai nesutinkate su j\u0173 sprendimais. <\/b><br>\n&nbsp;<\/p>\n<i>\u0160i tendencija siejama su didesniu atsparumu pasakojimams, kurie valstybes, s\u0105jungininkus ar \u017einiasklaid\u0105 vaizduoja kaip i\u0161 esm\u0117s prie\u0161i\u0161kus ar klaidinan\u010dius \u2013 tai informacin\u0117s manipuliacijos b\u016bdas, kur\u012f da\u017enai naudoja prie\u0161i\u0161kos u\u017esienio \u0161alys. <\/i>","DefaultChoices":false,"DataExportTag":"aband low","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"- \u012fprastai pasitikite institucijomis ir pagrindin\u0117mis \u017einiasklaidos priemon\u0117mis, net ir tada, kai...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID129","DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">group_aband<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> bottom <\/span>","LeftOperand":"group_aband","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"bottom","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_1BS1hBCYWqTVFgG","Element":"SQ","PrimaryAttribute":"QID13","SecondaryAttribute":" ","TertiaryAttribute":null,"Payload":{"QuestionText":"&nbsp;","DefaultChoices":false,"DataExportTag":"censLT","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Confi