","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":12,"NextAnswerId":8,"Answers":{"1":{"Display":"1 - visi\u0161kai nesutinku"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 - visi\u0161kai sutinku"}},"AnswerOrder":[1,2,3,4,5,6,7],"ChoiceDataExportTags":false,"QuestionID":"QID17","QuestionText_Unsafe":"&nbsp;"}},{"SurveyID":"SV_1BS1hBCYWqTVFgG","Element":"SQ","PrimaryAttribute":"QID170","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"RANK JS timing","QuestionID":"QID170","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":140,"NextAnswerId":1,"QuestionJS":false}},{"SurveyID":"SV_1BS1hBCYWqTVFgG","Element":"SQ","PrimaryAttribute":"QID171","SecondaryAttribute":" ","TertiaryAttribute":null,"Payload":{"QuestionText":"&nbsp;","DefaultChoices":false,"DataExportTag":"DONT DELETE RANK JS","QuestionID":"QID171","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":" ","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionJS":false}},{"SurveyID":"SV_1BS1hBCYWqTVFgG","Element":"SQ","PrimaryAttribute":"QID172","SecondaryAttribute":" ","TertiaryAttribute":null,"Payload":{"QuestionText":"&nbsp;","DefaultChoices":false,"DataExportTag":"DONT DELETE RANK JS","QuestionID":"QID172","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":" ","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function () {\n  this.hideNextButton();\n  var self = this;\n  var done = false;\n  var debugLog = [];\n\n  function log(msg) {\n    debugLog.push(msg);\n    Qualtrics.SurveyEngine.setEmbeddedData(\"ranking_debug\",\n      debugLog.join(\" | \"));\n  }\n\n  function parseNum(raw) {\n    if (raw === null || raw === undefined) return NaN;\n    raw = String(raw).trim().replace(\",\", \".\");\n    var v = parseFloat(raw);\n    return Number.isFinite(v) ? v : NaN;\n  }\n\n  function nearlyEqual(a, b, eps) {\n    return Math.abs(a - b) <= eps;\n  }\n\n  function shuffle(arr) {\n    for (var i = arr.length - 1; i > 0; i--) {\n      var j = Math.floor(Math.random() * (i + 1));\n      var tmp = arr[i]; arr[i] = arr[j]; arr[j] = tmp;\n    }\n    return arr;\n  }\n\n  try {\n    var eps = 1e-9;\n\n    var rawThreat = \"${e:\/\/Field\/meanscore_threat}\";\n    var rawAband  = \"${e:\/\/Field\/meanscore_aband}\";\n    var rawFear   = \"${e:\/\/Field\/meanscore_fear}\";\n    var rawSuper  = \"${e:\/\/Field\/meanscore_super}\";\n    log(\"RAW: t=\" + rawThreat + \" a=\" + rawAband +\n        \" f=\" + rawFear + \" s=\" + rawSuper);\n\n    var scores = {\n      threat: parseNum(rawThreat),\n      aband:  parseNum(rawAband),\n      fear:   parseNum(rawFear),\n      super:  parseNum(rawSuper)\n    };\n\n    log(\"PARSED: t=\" + scores.threat + \" a=\" + scores.aband +\n        \" f=\" + scores.fear + \" s=\" + scores.super);\n\n    var keys = Object.keys(scores);\n\n    var allValid = keys.every(function (k) {\n      return Number.isFinite(scores[k]);\n    });\n    Qualtrics.SurveyEngine.setEmbeddedData(\"ranking_valid\",\n      allValid ? \"1\" : \"0\");\n\n    if (!allValid) {\n      log(\"ABORT: invalid scores\");\n      self.showNextButton();\n      return;\n    }\n\n    var sorted = keys.slice().sort(function (a, b) {\n      return scores[a] - scores[b];\n    });\n    log(\"SORTED: \" + sorted.join(\",\"));\n\n    var compRanks = {};\n    for (var i = 0; i < sorted.length; i++) {\n      var rank = i + 1;\n      for (var j = 0; j < i; j++) {\n        if (nearlyEqual(scores[sorted[j]], scores[sorted[i]], eps)) {\n          rank = compRanks[sorted[j]];\n          break;\n        }\n      }\n      compRanks[sorted[i]] = rank;\n    }\n\n    var groups = [];\n    var currentGroup = [sorted[0]];\n    for (var i = 1; i < sorted.length; i++) {\n      if (nearlyEqual(scores[sorted[i]], scores[sorted[i - 1]], eps)) {\n        currentGroup.push(sorted[i]);\n      } else {\n        groups.push(shuffle(currentGroup));\n        currentGroup = [sorted[i]];\n      }\n    }\n    groups.push(shuffle(currentGroup));\n\n    var finalOrder = [];\n    for (var g = 0; g < groups.length; g++) {\n      for (var k = 0; k < groups[g].length; k++) {\n        finalOrder.push(groups[g][k]);\n      }\n    }\n\n    var forcedRanks = {};\n    var groupLabels = {};\n    for (var i = 0; i < finalOrder.length; i++) {\n      forcedRanks[finalOrder[i]] = i + 1;\n      groupLabels[finalOrder[i]] = (i < 2) ? \"bottom\" : \"top\";\n    }\n\n    \/\/ \u2500\u2500 NEW: Map subscale keys to show_ field names \u2500\u2500\n    var showMap = {\n      threat: \"show_threat_high\",\n      aband:  \"show_aband_high\",\n      fear:   \"show_fear_high\",\n      super:  \"show_superior_high\"\n    };\n\n    keys.forEach(function (s) {\n      Qualtrics.SurveyEngine.setEmbeddedData(\"rank_\" + s,\n        String(compRanks[s]));\n      Qualtrics.SurveyEngine.setEmbeddedData(\"forced_rank_\" + s,\n        String(forcedRanks[s]));\n      Qualtrics.SurveyEngine.setEmbeddedData(\"group_\" + s,\n        groupLabels[s]);\n      \/\/ \u2500\u2500 NEW: Set show_ flags (1 for top, 0 for bottom) \u2500\u2500\n      Qualtrics.SurveyEngine.setEmbeddedData(showMap[s],\n        groupLabels[s] === \"top\" ? \"1\" : \"0\");\n    });\n\n    log(\"DONE: comp=\" + JSON.stringify(compRanks) +\n        \" forced=\" + JSON.stringify(forcedRanks) +\n        \" groups=\" + JSON.stringify(groupLabels));\n\n    done = true;\n    setTimeout(function () { self.clickNextButton(); }, 0);\n\n  } catch (e) {\n    log(\"ERROR: \" + e.message);\n    Qualtrics.SurveyEngine.setEmbeddedData(\"ranking_valid\", \"0\");\n    self.showNextButton();\n  }\n\n  setTimeout(function () {\n    if (!done) {\n      log(\"TIMEOUT: safety net triggered\");\n      self.showNextButton();\n    }\n  }, 3000);\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_1BS1hBCYWqTVFgG","Element":"SQ","PrimaryAttribute":"QID173","SecondaryAttribute":"\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<div id=\"task\">&nbsp;<\/div>","DefaultChoices":false,"DataExportTag":"choice_dv_task","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00a0","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID173","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n  var qualtricsSurveyEngine = Qualtrics.SurveyEngine,\n      qualtricsQuestionData = this;\n\n  \/\/ Configure your study here:\n  var userSettings = {\n    \/\/ --- TIMING \/ MESSAGES ---\n    MOUSE_RECORDING_INTERVAL: 150,       \/\/ ms\n    STIMULUS_TIMEOUT: 30000,             \/\/ ms per pair\n    SHOW_TIMER: false, \/\/ show the circular countdown widget during timed trials (timeout still enforced when false)\n  INTER_TRIAL_TIMEOUT: 1000,           \/\/ ms between trials\n    INTER_TRIAL_LOADER: true,\n    INTER_TRIAL_LOADER_MSG_TIMEOUT: \"Per l\u0117tai. Palaukite, kol bus \u012fkelti kiti du naujien\u0173 prane\u0161imai.\",\n    INTER_TRIAL_LOADER_MSG_CLICK: \"J\u016bs\u0173 atsakymas \u012fra\u0161omas. Pra\u0161ome palaukti, kol pasirodys kitos dvi naujienos.\",\n    SHOW_SKIP_STIMULUS: true,\n    SKIP_STIMULUS_LABEL: \"Negaliu apsispr\u0119sti \u2013 praleisti \u0161i\u0105 por\u0105.\",\n    SHOW_LABEL_OVERLAY: false,           \/\/ set true for debugging (shows FIMI\/NON on tiles)\n\tCONCEAL_UNTIL_HOVER: true, \/\/ hides clipping until hover\/focus for cognitive measurement\n    END_OF_TASK_TITLE: \"\",\n    END_OF_TASK_MSG: \"J\u016bs\u0173 atsakymas \u012fra\u0161ytas. Spustel\u0117kite \u201e\u2192\u201c, kad t\u0119stum\u0117te.\",\n    QUALTRICS_EMBEDDED_FIELD: \"taskData\",\n\tPRELOAD_STIMULI: true,\n\n    \/\/ --- HOSTING ---\n    STIMULI_URL: \"https:\/\/thedataflowcompany.com\/files\/deconspirator\/stimuli\/lt\/\",\n\n    \/\/ --- WHAT COUNTS AS CORRECT? ---\n    \/\/ \\\"non\\\" = authentic is correct (default). Set to \\\"fimi\\\" if you ever want the opposite.\n    SELECT_TARGET: \"fimi\",\n\t  \n\t\/\/ --- CONFIDENCE RATING ---\n    CONFIDENCE_ENABLED: true,\n    CONFIDENCE_QUESTION: \"Kiek esate u\u017etikrintas (-a) \u0161iuo vertinimu?\",\n    CONFIDENCE_LABELS: [\n      \"1 - visai neu\u017etikrintas (-a)\",\n      \"2\",\n      \"3\",\n      \"4\",\n      \"5\",\n      \"6\",\n      \"7 - labai u\u017etikrintas (-a)\",\n    ],\n    CONFIDENCE_EMBEDDED_FIELD_PREFIX: \"confidence_fimi_\",\n\t  \n\t\/\/ --- MOBILE MODE ---\n    FORCE_TOUCH_MODE: null,\n    TOUCH_SELECT_LABEL: \"Pateikti mano pasirinkim\u0105\",\n\t\n    \/\/ --- TUTORIAL ---\n    TUTORIAL_ENABLED: true,\n    TUTORIAL_FIMI: \"FIMI-Tutorial.jpg\",\n    TUTORIAL_NON: \"NonFIMI-Tutorial.jpg\",\n\tTUTORIAL_HEADING: \"Bandomasis etapas\",\n    TUTORIAL_INSTRUCTION: \"Pra\u0161ome laikytis nurodym\u0173 ir susipa\u017einti su u\u017eduotimi\",  \/\/ automati\u0161kai sugeneruojama i\u0161 SELECT_TARGET, kai null\n    TUTORIAL_CORRECT_MSG: \"Teisingai! J\u016bs atpa\u017einote manipuliuot\u0105 naujien\u0105.\",\n    TUTORIAL_INCORRECT_MSG: \"Ne visai \u2014 \u0161i naujiena buvo tikra. Bandykite dar kart\u0105 arba prad\u0117kite u\u017eduot\u012f.\",\n    TUTORIAL_TIMEOUT_MSG: \"Laikas baig\u0117si! Tikrojoje u\u017eduotyje stenkit\u0117s atsakyti prie\u0161 pasibaigiant laikui.\",\n    TUTORIAL_SKIP_MSG: \"Praleidote \u0161\u012f klausim\u0105. Tikrojoje u\u017eduotyje stenkit\u0117s pasirinkti, kai tik \u012fmanoma.\",\n    TUTORIAL_REDO_LABEL: \"Bandykite dar kart\u0105\",\n    TUTORIAL_START_LABEL: \"Prad\u0117ti u\u017eduot\u012f\",\n\n    \/\/ --- YOUR PAIRED STIMULI ---\n    \/\/ Each pair keeps the same numeric id for FIMI and NonFIMI.\n    STIMULI_PAIRS: [\n      { id: \"01\", fimi: \"FIMI-01.jpg\",   non: \"NonFIMI-01.jpg\" },\n      { id: \"02\", fimi: \"FIMI-02.jpg\",   non: \"NonFIMI-02.jpg\" },\n      { id: \"03\", fimi: \"FIMI-03.jpg\",   non: \"NonFIMI-03.jpg\" },\n      { id: \"04\", fimi: \"FIMI-04.jpg\",   non: \"NonFIMI-04.jpg\" },\n\t  { id: \"05\", fimi: \"FIMI-05.jpg\",   non: \"NonFIMI-05.jpg\" },\n\t  { id: \"06\", fimi: \"FIMI-06.jpg\",   non: \"NonFIMI-06.jpg\" },\n\t  { id: \"07\", fimi: \"FIMI-07.jpg\",   non: \"NonFIMI-07.jpg\" },\n\t  { id: \"08\", fimi: \"FIMI-08.jpg\",   non: \"NonFIMI-08.jpg\" },\n    ]\n  };\n\n  \/\/ Start task\n  window.startTask(qualtricsSurveyEngine, qualtricsQuestionData, userSettings);\n});\n\nQualtrics.SurveyEngine.addOnReady(function () { });\nQualtrics.SurveyEngine.addOnUnload(function () { });"}},{"SurveyID":"SV_1BS1hBCYWqTVFgG","Element":"SQ","PrimaryAttribute":"QID174","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"meta_info","QuestionType":"Meta","Selector":"Browser","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription"