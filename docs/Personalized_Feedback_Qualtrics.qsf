":{"SC_es4fC9CgzhkmGEe":4,"SC_3QoVFAlAIoNcxP8":4},"index":31},{"AnswerID":5,"ChoiceID":"5","Grades":{"SC_es4fC9CgzhkmGEe":5,"SC_3QoVFAlAIoNcxP8":5},"index":32},{"AnswerID":6,"ChoiceID":"5","Grades":{"SC_es4fC9CgzhkmGEe":6,"SC_3QoVFAlAIoNcxP8":6},"index":33},{"AnswerID":7,"ChoiceID":"5","Grades":{"SC_es4fC9CgzhkmGEe":7,"SC_3QoVFAlAIoNcxP8":7},"index":34}],"Language":[],"NextChoiceId":6,"NextAnswerId":8,"Answers":{"1":{"Display":"1 - visi\u0161kai nesutinku"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 - visi\u0161kai sutinku"}},"AnswerOrder":[1,2,3,4,5,6,7],"ChoiceDataExportTags":{"1":"gen1","2":"gen2","3":"gen3","4":"gen5","5":"gen7"},"QuestionID":"QID15","QuestionText_Unsafe":"&nbsp;"}},{"SurveyID":"SV_1BS1hBCYWqTVFgG","Element":"SQ","PrimaryAttribute":"QID150","SecondaryAttribute":"Remiantis J\u016bs\u0173 atsakymais, nurod\u0117te, kad kasdien\u0117je rutinoje \u012fvairiu da\u017enumu atliekate \u012fprast","TertiaryAttribute":null,"Payload":{"QuestionText":"Remiantis J\u016bs\u0173 atsakymais, nurod\u0117te, kad kasdien\u0117je rutinoje \u012fvairiu da\u017enumu atliekate \u012fprastas, kasdienes veiklas. \u0160iame klausimyne n\u0117ra teising\u0173 ar neteising\u0173 atsakym\u0173. Pateikta informacija bus naudojama tik apibendrintai moksliniais tikslais.","DefaultChoices":false,"DataExportTag":"Q150","QuestionID":"QID150","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Remiantis J\u016bs\u0173 atsakymais, nurod\u0117te, kad kasdien\u0117je rutinoje \u012fvairiu da\u017enumu atliekate \u012fprastas,...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_1BS1hBCYWqTVFgG","Element":"SQ","PrimaryAttribute":"QID151","SecondaryAttribute":"Dabar prisiminkite ankstesn\u0119 u\u017eduot\u012f, kurios metu vertinote \u201eDisInforMeter\u201c \u012frankio pateiktu","TertiaryAttribute":null,"Payload":{"QuestionText":"Dabar prisiminkite ankstesn\u0119 u\u017eduot\u012f, kurios metu vertinote \u201eDisInforMeter\u201c \u012frankio pateiktus teiginius.","DefaultChoices":false,"DataExportTag":"Q151","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Dabar prisiminkite ankstesn\u0119 u\u017eduot\u012f, kurios metu vertinote \u201eDisInforMeter\u201c \u012frankio pateiktus tei...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID151"}},{"SurveyID":"SV_1BS1hBCYWqTVFgG","Element":"SQ","PrimaryAttribute":"QID152","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q152","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"QuestionID":"QID152"}},{"SurveyID":"SV_1BS1hBCYWqTVFgG","Element":"SQ","PrimaryAttribute":"QID153","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q153","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"QuestionID":"QID153"}},{"SurveyID":"SV_1BS1hBCYWqTVFgG","Element":"SQ","PrimaryAttribute":"QID154","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q154","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"QuestionID":"QID154"}},{"SurveyID":"SV_1BS1hBCYWqTVFgG","Element":"SQ","PrimaryAttribute":"QID155","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q155","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1,"QuestionID":"QID155"}},{"SurveyID":"SV_1BS1hBCYWqTVFgG","Element":"SQ","PrimaryAttribute":"QID156","SecondaryAttribute":"D\u0117kojame, kad u\u017epild\u0117te DisInforMeter klausimyn\u0105. Informacijos manipuliacija, kuri\u0105 vykdo prie","TertiaryAttribute":null,"Payload":{"QuestionText":"D\u0117kojame, kad u\u017epild\u0117te DisInforMeter klausimyn\u0105.<br><br><b>Informacijos manipuliacija, kuri\u0105 vykdo prie\u0161i\u0161kos u\u017esienio \u0161alys, da\u017enai remiasi pasikartojan\u010diais modeliais, o toliau pateikta informacija apibendrina da\u017eniausius b\u016bdus, kaip emoci\u0161kai paveik\u016bs ar strategi\u0161kai suformuluoti prane\u0161imai gali veikti \u017emones.<\/b><br><br><b>DISMISS (\u0161altinio diskreditavimas)<\/b><br><br>Kai kurios \u017einut\u0117s siekia pakirsti pasitik\u0117jim\u0105 diskredituodamos institucijas, ekspertus ar \u017einiasklaidos \u0161altinius, u\u017euot nagrin\u0117jusios pa\u010dios informacijos turin\u012f.\r\n\u0160i taktika veikia nukreipiant d\u0117mes\u012f nuo \u012frodym\u0173 \u012f paties \u0161altinio patikimumo kvestionavim\u0105. Atpa\u017einimas, kada kritika nukreipta \u012f \u0161altin\u012f, o ne \u012f pa\u010di\u0105 informacij\u0105, gali pad\u0117ti i\u0161laikyti labiau subalansuot\u0105 vertinim\u0105.<br><br><b>DISTORT (fakt\u0173 i\u0161kraipymas)<\/b><br><br>Kai kurios \u017einut\u0117s pateikia selektyviai suformuot\u0105 arba perd\u0117t\u0105 informacij\u0105 siekiant paveikti jos interpretacij\u0105.\r\nTai gali apimti kra\u0161tutini\u0173 atvej\u0173 i\u0161ry\u0161kinim\u0105, konteksto nutyl\u0117jim\u0105 arba sp\u0117jim\u0173 pateikim\u0105 kaip fakt\u0173. Supratimas, kaip informacija gali b\u016bti pateikiama, padeda atskirti tiksl\u0173 prane\u0161im\u0105 nuo i\u0161kraipyt\u0173 naratyv\u0173.<br><br><b>DISTRACT (d\u0117mesio nukreipimas)<\/b><br><br>Kai kurios \u017einut\u0117s \u012ftraukia emoci\u0161kai patrauklias, ta\u010diau su pagrindine tema nesusijusias temas, siekiant nukreipti d\u0117mes\u012f.\r\nD\u0117l to tampa sunkiau susitelkti \u012f svarbius faktus ar \u012fvertinti pirmin\u0119 \u017einut\u0119. Pasteb\u0117jimas, kada d\u0117mesys yra nukreipiamas, gali pad\u0117ti priimti labiau apgalvotus sprendimus.<br><br><b>DISMAY (baim\u0117s suk\u0117limas)<\/b><br><br>\u017dinut\u0117s, kurios pabr\u0117\u017eia kriz\u0119, gr\u0117sm\u0119 ar skubum\u0105, da\u017enai yra skirtos sukelti stiprias emocines reakcijas.\r\nBaim\u0119 akcentuojantis pateikimas gali suma\u017einti kritin\u012f vertinim\u0105 ir padidinti pasikliovim\u0105 intuityviais sprendimais. Emocinio intensyvumo atpa\u017einimas kaip galimo manipuliavimo signalo gali pad\u0117ti sukurti erdv\u0119 labiau apm\u0105stytam m\u0105stymui.<br><br><b>DIVIDE (visuomen\u0117s skaldymas)<\/b><br><br>Kai kurie naratyvai siekia suprie\u0161inti grupes, pabr\u0117\u017edami skirtumus, konfliktus ar tariamas gr\u0117smes tarp bendruomeni\u0173.\r\nTai gali didinti prie\u0161i\u0161kum\u0105 ir ma\u017einti pasitik\u0117jim\u0105, tod\u0117l \u017emon\u0117s tampa imlesni supaprastintiems ar \u0161ali\u0161kiems paai\u0161kinimams. \u0160ios taktikos suvokimas gali pad\u0117ti i\u0161laikyti platesn\u0119 perspektyv\u0105.<br><br>Keletas paprast\u0173 \u012fpro\u010di\u0173, padedan\u010di\u0173 stiprinti atsparum\u0105:<br>- jei antra\u0161t\u0117 sukelia stipri\u0105 emocij\u0105, trumpam stabtel\u0117kite.<br>- patikrinkite, ar tuos pa\u010dius faktus prane\u0161a ir kitas nepriklausomas \u0161altinis.<br>- nukopijuokite vien\u0105 pagrindin\u0119 fraz\u0119 i\u0161 antra\u0161t\u0117s \u012f paie\u0161k\u0105 ir pa\u017ei\u016br\u0117kite, ar apie tai ra\u0161o ir kiti \u0161altiniai.<br><br>Informacin\u0117 manipuliacija remiasi ne ne\u017einojimu, o emocijomis, kurias patiria daugelis \u017emoni\u0173. Supratimas, kaip skirtingos \u017einut\u0117s veikia vertinim\u0105, yra vienas veiksmingiausi\u0173 b\u016bd\u0173 suma\u017einti j\u0173 poveik\u012f.","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"D\u0117kojame, kad u\u017epild\u0117te DisInforMeter klausimyn\u0105. Informacijos manipuliacija, kuri\u0105 vykdo prie\u0161i\u0161...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"D\u0117kojame, kad u\u017epild\u0117te klausimyn\u0105. Dabar pateiksime jums trump\u0105 gr\u012f\u017etam\u0105j\u012f ry\u0161\u012f.\r\n\r\n\u017demiau matysite, kokio tipo manipuliacin\u0117s \u017einut\u0117s i\u0161 prie\u0161i\u0161k\u0173 u\u017esienio \u0161ali\u0173 jums gali pasirodyti \u012ftikinamesn\u0117s. \u0160ie rezultatai n\u0117ra skirti j\u016bs\u0173 vertinti ar \u201epriklijuoti etiket\u0119\u201c \u2013 kiekvienas gali stiprinti savo atsparum\u0105 klaidinan\u010diai informacijai.<br><br>J\u016bs\u0173 atsakymai rodo, kad:","DataExportTag":"Q156","QuestionID":"QID156"}},{"SurveyID":"SV_1BS1hBCYWqTVFgG","Element":"SQ","PrimaryAttribute":"QID157","SecondaryAttribute":"- \u017dinut\u0117s, kurios kalba apie gr\u0117smes m\u016bs\u0173 kult\u016brai, tapatybei ar \u0161alies i\u0161likimui, paprastai","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><\/p>\n\n<p><\/p>\n\n<p><b>- \u017dinut\u0117s, kurios kalba apie gr\u0117smes m\u016bs\u0173 kult\u016brai, tapatybei ar \u0161alies i\u0161likimui, paprastai jums nesukelia stipri\u0173 emocij\u0173. <\/b><br>\n&nbsp;<\/p>\n<i>Tokios emocin\u0117s reakcijos paprastai siejamos su geb\u0117jimu atskirti tikras visuomen\u0117s problemas nuo pasakojim\u0173, kurie dirbtinai i\u0161pu\u010dia gr\u0117smes, siekiant sukelti baim\u0119 ar pykt\u012f. Toks reagavimo pob\u016bdis da\u017eniausiai siejamas su didesniu atsparumu klaidinan\u010diai informacijai, kuria prie\u0161i\u0161kos u\u017esienio \u0161alys perd\u0117tai i\u0161ry\u0161kina gr\u0117smes. <\/i>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"- \u017dinut\u0117s, kurios kalba apie gr\u0117smes m\u016bs\u0173 kult\u016brai, tapatybei ar \u0161alies i\u0161likimui, paprastai jums...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(fu