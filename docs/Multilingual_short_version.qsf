ices":{"1":{"Display":"\u6211\u4e4b\u6240\u4ee5\u80fd\u83b7\u5f97\u65b0\u95fb\uff0c\u4e3b\u8981\u662f\u56e0\u4e3a\u6211\u5728\u5bfb\u627e\u5b83"},"2":{"Display":"\u6211\u4e3b\u8981\u901a\u8fc7\u5076\u7136\u63a5\u89e6\u65b0\u95fb\u6765\u83b7\u53d6\u65b0\u95fb"},"3":{"Display":"\u4e24\u4e2a\u90fd"},"4":{"Display":"\u4e0d\u77e5\u9053\/\u6ca1\u6709\u7b54\u6848"}}},"NL":{"QuestionText":"[Q6] Welke uitspraak beschrijft <strong>het beste<\/strong> <strong>hoe u aan nieuws komt<\/strong> ?","Choices":{"1":{"Display":"Ik krijg meestal nieuws omdat ik ernaar op zoek ben"},"2":{"Display":"Ik krijg het nieuws meestal doordat ik het tegenkom"},"3":{"Display":"Beide"},"4":{"Display":"Weet niet \/ Geen antwoord"}}},"ET":{"QuestionText":"[K6] Milline v\u00e4ide kirjeldab <strong>k\u00f5ige paremini<\/strong> , <strong>kuidas te uudiseid saate<\/strong> ?","Choices":{"1":{"Display":"Ma saan uudiseid enamasti seet\u00f5ttu, et ma neid otsin."},"2":{"Display":"Saan uudiseid enamasti seet\u00f5ttu, et puutun nendega kokku"},"3":{"Display":"M\u00f5lemad"},"4":{"Display":"Ei tea \/ Vastus puudub"}}},"FR":{"QuestionText":"[Q6] Quelle affirmation d\u00e9crit <strong>le mieux<\/strong> <strong>la mani\u00e8re dont vous obtenez des nouvelles<\/strong> ?","Choices":{"1":{"Display":"Je re\u00e7ois surtout des nouvelles parce que je les cherche."},"2":{"Display":"Je re\u00e7ois surtout des nouvelles parce que je les croise par hasard."},"3":{"Display":"Les deux"},"4":{"Display":"Je ne sais pas \/ Pas de r\u00e9ponse"}}},"KAT":{"QuestionText":"[Q6] \u10e0\u10dd\u10db\u10d4\u10da\u10d8 \u10d2\u10d0\u10dc\u10ea\u10ee\u10d0\u10d3\u10d4\u10d1\u10d0 \u10d0\u10e6\u10ec\u10d4\u10e0\u10e1 <strong>\u10e1\u10d0\u10e3\u10d9\u10d4\u10d7\u10d4\u10e1\u10dd\u10d3<\/strong> , <strong>\u10d7\u10e3 \u10e0\u10dd\u10d2\u10dd\u10e0 \u10d8\u10d2\u10d4\u10d1\u10d7 \u10e1\u10d8\u10d0\u10ee\u10da\u10d4\u10d4\u10d1\u10e1<\/strong> ?","Choices":{"1":{"Display":"\u10e1\u10d8\u10d0\u10ee\u10da\u10d4\u10d4\u10d1\u10e1 \u10eb\u10d8\u10e0\u10d8\u10d7\u10d0\u10d3\u10d0\u10d3 \u10d8\u10db\u10d8\u10e2\u10dd\u10db \u10d5\u10d8\u10d2\u10d4\u10d1, \u10e0\u10dd\u10db \u10d5\u10d4\u10eb\u10d4\u10d1"},"2":{"Display":"\u10e1\u10d8\u10d0\u10ee\u10da\u10d4\u10d4\u10d1\u10e1 \u10eb\u10d8\u10e0\u10d8\u10d7\u10d0\u10d3\u10d0\u10d3 \u10d8\u10db\u10d8\u10e2\u10dd\u10db \u10d5\u10d8\u10d2\u10d4\u10d1, \u10e0\u10dd\u10db \u10e8\u10d4\u10db\u10d7\u10ee\u10d5\u10d4\u10d5\u10d8\u10d7 \u10ec\u10d0\u10d5\u10d0\u10ec\u10e7\u10d3\u10d4\u10d1\u10d8"},"3":{"Display":"\u10dd\u10e0\u10d8\u10d5\u10d4"},"4":{"Display":"\u10d0\u10e0 \u10d5\u10d8\u10ea\u10d8 \/ \u10de\u10d0\u10e1\u10e3\u10ee\u10d8 \u10d0\u10e0 \u10db\u10d0\u10e5\u10d5\u10e1"}}},"DE":{"QuestionText":"[Q6] Welche Aussage beschreibt <strong>am besten<\/strong> <strong>, wie Sie an Nachrichten gelangen<\/strong> ?","Choices":{"1":{"Display":"Ich bekomme Nachrichten meistens, weil ich danach suche"},"2":{"Display":"Ich erfahre Nachrichten haupts\u00e4chlich, weil ich zuf\u00e4llig darauf sto\u00dfe"},"3":{"Display":"Beide"},"4":{"Display":"Wei\u00df nicht \/ Keine Antwort"}}},"HU":{"QuestionText":"[6. k\u00e9rd\u00e9s] Melyik \u00e1ll\u00edt\u00e1s \u00edrja le <strong>legjobban<\/strong> <strong>a h\u00edrekhez val\u00f3 hozz\u00e1jut\u00e1s m\u00f3dj\u00e1t<\/strong> ?","Choices":{"1":{"Display":"Legink\u00e1bb az\u00e9rt kapok h\u00edreket, mert keresem \u0151ket."},"2":{"Display":"Legink\u00e1bb az\u00e9rt kapok h\u00edreket, mert belefutok rajtuk"},"3":{"Display":"Mindk\u00e9t"},"4":{"Display":"Nem tudom \/ Nincs v\u00e1lasz"}}},"IT":{"QuestionText":"[Q6] Quale affermazione descrive <strong>meglio<\/strong> <strong>il modo in cui ricevi le notizie<\/strong> ?","Choices":{"1":{"Display":"Ricevo le notizie soprattutto perch\u00e9 le cerco"},"2":{"Display":"Ricevo le notizie principalmente perch\u00e9 le incontro per caso"},"3":{"Display":"Entrambi"},"4":{"Display":"Non so \/ Nessuna risposta"}}},"LV":{"QuestionText":"[6. jaut\u0101jums] Kur\u0161 apgalvojums <strong>vislab\u0101k<\/strong> raksturo <strong>to, k\u0101 j\u016bs sa\u0146emat zi\u0146as<\/strong> ?","Choices":{"1":{"Display":"Es galvenok\u0101rt sa\u0146emu zi\u0146as, jo es t\u0101s mekl\u0113ju."},"2":{"Display":"Es galvenok\u0101rt sa\u0146emu zi\u0146as, jo uz t\u0101m uzduros."},"3":{"Display":"Abi"},"4":{"Display":"Nezinu \/ Nav atbildes"}}},"LT":{"QuestionText":"[6 klausimas] Kuris teiginys <strong>geriausiai<\/strong> apib\u016bdina, <strong>kaip j\u016bs gaunate naujienas<\/strong> ?","Choices":{"1":{"Display":"Da\u017eniausiai gaunu naujienas, nes j\u0173 ie\u0161kau"},"2":{"Display":"Da\u017eniausiai gaunu naujienas, nes \u012f jas nety\u010dia u\u017ekli\u016bvu"},"3":{"Display":"Abu"},"4":{"Display":"Ne\u017einau \/ N\u0117ra atsakymo"}}},"FA":{"QuestionText":"[\u0633\u0648\u0627\u06446] \u06a9\u062f\u0627\u0645 \u062c\u0645\u0644\u0647 <strong>\u0628\u0647 \u0628\u0647\u062a\u0631\u06cc\u0646 \u0634\u06a9\u0644<\/strong> <strong>\u0646\u062d\u0648\u0647 \u062f\u0631\u06cc\u0627\u0641\u062a \u0627\u062e\u0628\u0627\u0631 \u062a\u0648\u0633\u0637 \u0634\u0645\u0627<\/strong> \u0631\u0627 \u062a\u0648\u0635\u06cc\u0641 \u0645\u06cc\u200c\u06a9\u0646\u062f\u061f","Choices":{"1":{"Display":"\u0645\u0646 \u0628\u06cc\u0634\u062a\u0631 \u0628\u0647 \u0627\u06cc\u0646 \u062f\u0644\u06cc\u0644 \u0627\u062e\u0628\u0627\u0631 \u0631\u0627 \u062f\u0631\u06cc\u0627\u0641\u062a \u0645\u06cc\u200c\u06a9\u0646\u0645 \u06a9\u0647 \u062f\u0646\u0628\u0627\u0644\u0634\u0627\u0646 \u0645\u06cc\u200c\u06af\u0631\u062f\u0645"},"2":{"Display":"\u0645\u0646 \u0628\u06cc\u0634\u062a\u0631 \u0627\u062e\u0628\u0627\u0631 \u0631\u0627 \u0628\u0647 \u0627\u06cc\u0646 \u062f\u0644\u06cc\u0644 \u062f\u0631\u06cc\u0627\u0641\u062a \u0645\u06cc\u200c\u06a9\u0646\u0645 \u06a9\u0647 \u0628\u0647 \u0622\u0646\u0647\u0627 \u0628\u0631\u062e\u0648\u0631\u062f \u0645\u06cc\u200c\u06a9\u0646\u0645"},"3":{"Display":"\u0647\u0631 \u062f\u0648"},"4":{"Display":"\u0646\u0645\u06cc\u200c\u062f\u0627\u0646\u0645 \/ \u0628\u062f\u0648\u0646 \u067e\u0627\u0633\u062e"}}},"PL":{"QuestionText":"[P6] Kt\u00f3re stwierdzenie <strong>najlepiej<\/strong> opisuje <strong>spos\u00f3b, w jaki zdobywasz wiadomo\u015bci<\/strong> ?","Choices":{"1":{"Display":"Wiadomo\u015bci dostaj\u0119 g\u0142\u00f3wnie dlatego, \u017ce ich szukam"},"2":{"Display":"Wiadomo\u015bci dostaj\u0119 g\u0142\u00f3wnie dlatego, \u017ce na nie trafiam"},"3":{"Display":"Obydwa"},"4":{"Display":"Nie wiem \/ Brak odpowiedzi"}}},"RU":{"QuestionText":"[Q6] \u041a\u0430\u043a\u043e\u0435 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435 <strong>\u043b\u0443\u0447\u0448\u0435 \u0432\u0441\u0435\u0433\u043e<\/strong> \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442, <strong>\u043a\u0430\u043a \u0432\u044b \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0435 \u043d\u043e\u0432\u043e\u0441\u0442\u0438<\/strong> ?","Choices":{"1":{"Display":"\u042f \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c \u0443\u0437\u043d\u0430\u044e \u043d\u043e\u0432\u043e\u0441\u0442\u0438, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0438\u0449\u0443 \u0438\u0445."},"2":{"Display":"\u042f \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c \u0443\u0437\u043d\u0430\u044e \u043d\u043e\u0432\u043e\u0441\u0442\u0438, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043d\u0430\u0442\u044b\u043a\u0430\u044e\u0441\u044c \u043d\u0430 \u043d\u0438\u0445."},"3":{"Display":"\u041e\u0431\u0430"},"4":{"Display":"\u041d\u0435 \u0437\u043d\u0430\u044e \/ \u041d\u0435\u0442 \u043e\u0442\u0432\u0435\u0442\u0430"}}},"SR":{"QuestionText":"[Q6] \u041a\u043e\u0458\u0430 \u0438\u0437\u0458\u0430\u0432\u0430 <strong>\u043d\u0430\u0458\u0431\u043e\u0459\u0435<\/strong> \u043e\u043f\u0438\u0441\u0443\u0458\u0435 <strong>\u043a\u0430\u043a\u043e \u0434\u043e\u0431\u0438\u0458\u0430\u0442\u0435 \u0432\u0435\u0441\u0442\u0438<\/strong> ?","Choices":{"1":{"Display":"\u0423\u0433\u043b\u0430\u0432\u043d\u043e\u043c \u0434\u043e\u0431\u0438\u0458\u0430\u043c \u0432\u0435\u0441\u0442\u0438 \u0437\u0430\u0442\u043e \u0448\u0442\u043e \u0438\u0445 \u0442\u0440\u0430\u0436\u0438\u043c"},"2":{"Display":"\u0423\u0433\u043b\u0430\u0432\u043d\u043e\u043c \u0434\u043e\u0431\u0438\u0458\u0430\u043c \u0432\u0435\u0441\u0442\u0438 \u0458\u0435\u0440 \u043d\u0430 \u045a\u0438\u0445 \u043d\u0430\u0438\u0452\u0435\u043c."},"3":{"Display":"\u041e\u0431\u043e\u0458\u0435"},"4":{"Display":"\u041d\u0435 \u0437\u043d\u0430\u043c \/ \u0411\u0435\u0437 \u043e\u0434\u0433\u043e\u0432\u043e\u0440\u0430"}}},"TR":{"QuestionText":"[S6] <strong>Haberleri nas\u0131l ald\u0131\u011f\u0131n\u0131z\u0131<\/strong> <strong>en iyi<\/strong> a\u00e7\u0131klayan ifade hangisidir?","Choices":{"1":{"Display":"Haberleri \u00e7o\u011funlukla arad\u0131\u011f\u0131m i\u00e7in al\u0131yorum"},"2":{"Display":"Haberleri \u00e7o\u011funlukla ona \u00e7arpt\u0131\u011f\u0131m i\u00e7in al\u0131yorum"},"3":{"Display":"\u0130kisi birden"},"4":{"Display":"Bilmiyorum \/ Cevap yok"}}},"UK":{"QuestionText":"[Q6] \u042f\u043a\u0435 \u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043d\u043d\u044f <strong>\u043d\u0430\u0439\u043a\u0440\u0430\u0449\u0435<\/strong> \u043e\u043f\u0438\u0441\u0443\u0454 <strong>, \u044f\u043a \u0432\u0438 \u043e\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u0435 \u043d\u043e\u0432\u0438\u043d\u0438<\/strong> ?","Choices":{"1":{"Display":"\u042f \u0437\u0434\u0435\u0431\u0456\u043b\u044c\u0448\u043e\u0433\u043e \u043e\u0442\u0440\u0438\u043c\u0443\u044e \u043d\u043e\u0432\u0438\u043d\u0438, \u0431\u043e \u0448\u0443\u043a\u0430\u044e \u0457\u0445"},"2":{"Display":"\u042f \u0437\u0434\u0435\u0431\u0456\u043b\u044c\u0448\u043e\u0433\u043e \u043e\u0442\u0440\u0438\u043c\u0443\u044e \u043d\u043e\u0432\u0438\u043d\u0438, \u0431\u043e \u043d\u0430 \u043d\u0438\u0445 \u043d\u0430\u0442\u0440\u0430\u043f\u043b\u044f\u044e."},"3":{"Display":"\u041e\u0431\u0438\u0434\u0432\u0430"},"4":{"Display":"\u041d\u0435 \u0437\u043d\u0430\u044e \/ \u041d\u0435\u043c\u0430\u0454 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0456"}}}},"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID20","QuestionText_Unsafe":"[Q6] Which statement <strong>best<\/strong> describes <strong>how you get news<\/strong>?"}},{"SurveyID":"SV_ehNvPC5ntZii634","Element":"SQ","PrimaryAttribute":"QID200","SecondaryAttribute":"Thank you for participating in our survey!\u00a0 PLEASE PRESS NEXT TO SUBMIT YOUR ANSWERS In the inter..","TertiaryAttribute":null,"Payload":{"QuestionText":"Thank you for participating in our survey!&nbsp;<br>\n<br>\n<strong>PLEASE PRESS NEXT TO SUBMIT YOUR ANSWERS<\/strong><br>\n<br>\nIn the interactive module, you were shown false or misleading headlines as part of our experimental study.<br>\nFor a <strong>debrief<\/strong> and to learn more about digital literacy, along with other useful resources, visit <a href=\"https:\/\/deconspirator.eu\/survey-1\/\">https:\/\/deconspirator.eu\/survey-1\/<\/a>.<br>\n<br>\nFor questions or comments, please contact us at <a href=\"mailto:https:\/\/deconspirator.eu\/survey-1\/\">info@deconspirator.eu<\/a>.<br>\n<br>\n<br>\n&nbsp;","DefaultChoices":false,"DataExportTag":" ","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Thank you for participating in our survey!\u00a0 PLEASE PRESS NEXT TO SUBMIT YOUR ANSWERS In the inter...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":{"AR":{"QuestionText":"<strong data-end=\"100\" data-start=\"68\">\u0634\u0643\u0631\u064b\u0627 \u0644\u0645\u0634\u0627\u0631\u0643\u062a\u0643 \u0641\u064a \u0627\u0633\u062a\u0637\u0644\u0627\u0639\u0646\u0627!<\/strong><br \/>\n<br \/>\n<meta charset=\"UTF-8\" \/><strong>\u064a\u0631\u062c\u0649 \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \"\u0627\u0644\u062a\u0627\u0644\u064a\" \u0644\u062a\u0642\u062f\u064a\u0645 \u0625\u062c\u0627\u0628\u0627\u062a\u0643.<\/strong><br \/>\n<br \/>\n<meta charset=\"UTF-8\" \/>\n<p data-end=\"190\" data-start=\"102\">\u0641\u064a \u0627\u0644\u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u0641\u0627\u0639\u0644\u064a\u0629\u060c \u0639\u064f\u0631\u0636\u062a \u0639\u0644\u064a\u0643 \u0639\u0646\u0627\u0648\u064a\u0646 \u0625\u062e\u0628\u0627\u0631\u064a\u0629 \u0643\u0627\u0630\u0628\u0629 \u0623\u0648 \u0645\u0636\u0644\u0644\u0629 \u0643\u062c\u0632\u0621 \u0645\u0646 \u062f\u0631\u0627\u0633\u062a\u0646\u0627 \u0627\u0644\u062a\u062c\u0631\u064a\u0628\u064a\u0629.<\/p>\n\n<p data-end=\"291\" data-start=\"192\">\u0644\u0644\u0627\u0637\u0644\u0627\u0639 \u0639\u0644\u0649 \u0634\u0631\u062d \u0645\u0641\u0635\u0644 \u0648\u0644\u0645\u0639\u0631\u0641\u0629 \u0627\u0644\u0645\u0632\u064a\u062f \u0639\u0646 \u0627\u0644\u062b\u0642\u0627\u0641\u0629 \u0627\u0644\u0631\u0642\u0645\u064a\u0629\u060c \u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0645\u0648\u0627\u0631\u062f \u0645\u0641\u064a\u062f\u0629 \u0623\u062e\u0631\u0649\u060c \u064a\u064f\u0631\u062c\u0649 \u0632\u064a\u0627\u0631\u0629:<a href=\"https:\/\/deconspirator.eu\/survey-1\/\">https:\/\/deconspirator.eu\/survey-1\/<\/a>.<\/p>\n\n<p data-end=\"338\" data-start=\"293\">\u0644\u0623\u064a \u0623\u0633\u0626\u0644\u0629 \u0623\u0648 \u062a\u0639\u0644\u064a\u0642\u0627\u062a\u060c \u064a\u064f\u0631\u062c\u0649 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0645\u0639\u0646\u0627 \u0639\u0628\u0631:<a href=\"mailto:info@deconspirator.eu\">info@deconspirator.eu<\/a>.<\/p>\n"},"BG":{"QuestionText":"\u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u0438\u043c \u0412\u0438, \u0447\u0435 \u0443\u0447\u0430\u0441\u0442\u0432\u0430\u0445\u0442\u0435 \u0432 \u043d\u0430\u0448\u0435\u0442\u043e \u043f\u0440\u043e\u0443\u0447\u0432\u0430\u043d\u0435!<br \/>\n<br \/>\n<strong>\u041c\u041e\u041b\u042f, \u041d\u0410\u0422\u0418\u0421\u041d\u0415\u0422\u0415 \u201e\u041d\u0410\u041f\u0420\u0415\u0414\u201c, \u0417\u0410 \u0414\u0410 \u0418\u0417\u041f\u0420\u0410\u0422\u0418\u0422\u0415 \u041e\u0422\u0413\u041e\u0412\u041e\u0420\u0418<\/strong><br \/>\n\u00a0\n<p>\u0412 \u0440\u0430\u043c\u043a\u0438\u0442\u0435 \u043d\u0430 \u0438\u043d\u0442\u0435\u0440\u0430\u043a\u0442\u0438\u0432\u043d\u0438\u044f \u043c\u043e\u0434\u0443\u043b \u0412\u0438 \u0431\u044f\u0445\u0430 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0435\u043d\u0438 \u043d\u0435\u0432\u0435\u0440\u043d\u0438 \u0438\u043b\u0438 \u043f\u043e\u0434\u0432\u0435\u0436\u0434\u0430\u0449\u0438 \u0437\u0430\u0433\u043b\u0430\u0432\u0438\u044f \u043a\u0430\u0442\u043e \u0447\u0430\u0441\u0442 \u043e\u0442 \u0435\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u043b\u043d\u043e\u0442\u043e \u0438\u0437\u0441\u043b\u0435\u0434\u0432\u0430\u043d\u0435.<\/p>\n\n<p>\u0417\u0430\u00a0<b>\u043f\u043e\u0432\u0435\u0447\u0435 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f<\/b>\u00a0\u0438 \u0437\u0430 \u043f\u043e\u043b\u0435\u0437\u043d\u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u0438, \u0441\u0432\u044a\u0440\u0437\u0430\u043d\u0438 \u0441 \u0434\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u0430\u0442\u0430 \u0433\u0440\u0430\u043c\u043e\u0442\u043d\u043e\u0441\u0442, \u043f\u043e\u0441\u0435\u0442\u0435\u0442\u0435:\u00a0\u00a0<a data-outlook-id=\"74ca45ac-5af3-4c56-923a-3aeb7a9d120b\" href=\"https:\/\/deconspirator.eu\/survey-1\/\" target=\"_blank\" title=\"https:\/\/deconspirator.eu\/survey-1\/\">https:\/\/deconspirator.eu\/survey-1\/<\/a>.<\/p>\n\n<p>\u0417\u0430 \u0432\u044a\u043f\u0440\u043e\u0441\u0438 \u0438\u043b\u0438 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0438, \u043c\u043e\u043b\u044f \u0441\u0432\u044a\u0440\u0436\u0435\u0442\u0435 \u0441\u0435 \u0441 \u043d\u0430\u0441 \u043d\u0430:\u00a0<a href=\"mailto:info@deconspirator.eu\">info@deconspirator.eu<\/a>.<\/p>\n"},"ZH-S":{"QuestionText":"\u611f\u8c22\u60a8\u53c2\u4e0e\u6211\u4eec\u7684\u95ee\u5377\u8c03\u67e5\uff01<br \/>\n<br \/>\n<strong>\u8bf7\u6309\u201c\u4e0b\u4e00\u6b65\u201d\u63d0\u4ea4\u60a8\u7684\u7b54\u6848<\/strong><br \/>\n\u00a0\n<p data-end=\"158\" data-start=\"119\">\u5728\u4e92\u52a8\u6a21\u5757\u4e2d\uff0c\u60a8\u770b\u5230\u4e86\u4e00\u4e9b\u865a\u5047\u6216\u5177\u6709\u8bef\u5bfc\u6027\u7684\u6807\u9898\uff0c\u8fd9\u662f\u6211\u4eec\u5b9e\u9a8c\u6027\u7814\u7a76\u7684\u4e00\u90e8\u5206\u3002<\/p>\n\n<p data-end=\"218\" data-start=\"160\"><strong>\u5982\u9700\u67e5\u770b\u603b\u7ed3\u8bf4\u660e<\/strong>\u5e76\u4e86\u89e3\u66f4\u591a\u5173\u4e8e\u6570\u5b57\u7d20\u517b\u7684\u4fe1\u606f\u4ee5\u53ca\u5176\u4ed6\u6709\u7528\u7684\u8d44\u6e90\uff0c\u8bf7\u8bbf\u95ee\u00a0<a href=\"https:\/\/deconspirator.eu\/survey-1\/\">https:\/\/deconspirator.eu\/survey-1\/<\/a>.<\/p>\n\n<p>\u5982\u6709\u4efb\u4f55\u95ee\u9898\u6216\u610f\u89c1\uff0c\u8bf7\u901a\u8fc7\u4ee5\u4e0b\u65b9\u5f0f\u4e0e\u6211\u4eec\u8054\u7cfb\uff1a\u00a0<a href=\"mailto:info@deconspirator.eu\">info@deconspirator.eu<\/a>.<\/p>\n<br \/>\n<br \/>\n\u00a0"},"NL":{"QuestionText":"Bedankt voor uw deelname aan onze enqu\u00eate!<br \/>\n<br \/>\n<strong>Druk op VOLGENDE om uw antwoorden in te dienen<\/strong><br \/>\n\u00a0\n<p data-end=\"206\" data-start=\"90\">In de interactieve module kreeg u valse of misleidende koppen te zien als onderdeel van ons experimentele onderzoek.<\/p>\n\n<p data-end=\"329\" data-start=\"208\">Voor\u00a0<strong>een<\/strong>\u00a0<strong>toelichting<\/strong>\u00a0en om meer te leren over digitale geletterdheid, samen met andere nuttige bronnen, kunt u terecht op\u00a0<a href=\"https:\/\/deconspirator.eu\/survey-1\/\">https:\/\/deconspirator.eu\/survey-1\/<\/a>.<\/p>\n\n<p>Voor vragen of opmerkingen kunt u contact met ons opnemen via\u00a0<a href=\"mailto:info@deconspirator.eu\">info@deconspirator.eu<\/a>.<\/p>\n<br \/>\n\u00a0"},"ET":{"QuestionText":"Ait\u00e4h, et osalesite meie k\u00fcsitluses!<br \/>\n<br \/>\n<strong>VASTUSTE ESITAMISEKS VAJUTA PALUN EDASI<\/strong><br \/>\n\u00a0\n<p data-end=\"189\" data-start=\"83\">Interaktiivses moodulis n\u00e4idati teile eksitavaid v\u00f5i valesid pealkirju osana meie eksperimentaaluuringust.<\/p>\n\n<p data-end=\"285\" data-start=\"191\"><strong>Lisateabe saamiseks<\/strong>, sealhulgas digip\u00e4devuste ja teiste kasulike ressursside kohta, k\u00fclastage:\u00a0<a href=\"https:\/\/deconspirator.eu\/survey-1\/\">https:\/\/deconspirator.eu\/survey-1\/<\/a>.<\/p>\n\n<p>K\u00fcsimuste v\u00f5i kommentaaride korral v\u00f5tke meiega \u00fchendust aadressil:\u00a0<a href=\"mailto:info@deconspirator.eu\">info@deconspirator.eu<\/a>.<\/p>\n<br \/>\n\u00a0"},"FR":{"QuestionText":"Merci d\u2019avoir particip\u00e9 \u00e0 notre sondage !<br \/>\n<br \/>\n<strong>VEUILLEZ APPUYER SUR SUIVANT POUR SOUMETTRE VOS R\u00c9PONSES<\/strong><br \/>\n\u00a0\n<p data-end=\"214\" data-start=\"102\">Dans le module interactif, vous avez vu des titres faux ou trompeurs dans le cadre de notre \u00e9tude exp\u00e9rimentale.<\/p>\n\n<p data-end=\"349\" data-start=\"216\">Pour\u00a0<strong>un d\u00e9briefing<\/strong>\u00a0et pour en savoir plus sur la litt\u00e9ratie num\u00e9rique, ainsi que pour acc\u00e9der \u00e0 d\u2019autres ressources utiles, visitez:\u00a0<a href=\"https:\/\/deconspirator.eu\/survey-1\/\">https:\/\/deconspirator.eu\/survey-1\/<\/a>.<\/p>\n\n<p>Pour toute question ou tout commentaire, veuillez nous contacter \u00e0:\u00a0<a href=\"mailto:info@deconspirator.eu\">info@deconspirator.eu<\/a>.<\/p>\n<br \/>\n\u00a0"},"KAT":{"QuestionText":"\u10d2\u10db\u10d0\u10d3\u10da\u10dd\u10d1\u10d7, \u10e0\u10dd\u10db \u10db\u10dd\u10dc\u10d0\u10ec\u10d8\u10da\u10d4\u10dd\u10d1\u10d3\u10d8\u10d7 \u10e9\u10d5\u10d4\u10dc\u10e1 \u10d2\u10d0\u10db\u10dd\u10d9\u10d8\u10d7\u10ee\u10d5\u10d0\u10e8\u10d8!<br \/>\n<br \/>\n<strong>\u10d2\u10d7\u10ee\u10dd\u10d5\u10d7, \u10d3\u10d0\u10d0\u10ed\u10d8\u10e0\u10dd\u10d7 \u10e8\u10d4\u10db\u10d3\u10d4\u10d2\u10e1 \u10d7\u10e5\u10d5\u10d4\u10dc\u10d8 \u10de\u10d0\u10e1\u10e3\u10ee\u10d4\u10d1\u10d8\u10e1 \u10d2\u10d0\u10e1\u10d0\u10d2\u10d6\u10d0\u10d5\u10dc\u10d0\u10d3<\/strong><br \/>\n<meta charset=\"UTF-8\" \/>\n<p data-end=\"102\" data-start=\"55\">\u00a0<\/p>\n\n<p data-end=\"217\" data-start=\"104\">\u10d8\u10dc\u10e2\u10d4\u10e0\u10e5\u10e2\u10d8\u10e3\u10da \u10db\u10dd\u10d3\u10e3\u10da\u10e8\u10d8 \u10d7\u10e5\u10d5\u10d4\u10dc \u10d3\u10d0\u10d2\u10d0\u10dc\u10d0\u10ee\u10d5\u10d4\u10e1 \u10e7\u10d0\u10da\u10d1\u10d8 \u10d0\u10dc \u10e8\u10d4\u10ea\u10d3\u10dd\u10db\u10d0\u10e8\u10d8 \u10e8\u10d4\u10db\u10e7\u10d5\u10d0\u10dc\u10d8 \u10e1\u10d0\u10d7\u10d0\u10e3\u10e0\u10d4\u10d1\u10d8 \u10e9\u10d5\u10d4\u10dc\u10d8 \u10d4\u10e5\u10e1\u10de\u10d4\u10e0\u10d8\u10db\u10d4\u10dc\u10e2\u10e3\u10da\u10d8 \u10d9\u10d5\u10da\u10d4\u10d5\u10d8\u10e1 \u10e4\u10d0\u10e0\u10d2\u10da\u10d4\u10d1\u10e8\u10d8.<\/p>\n\n<p data-end=\"321\" data-start=\"219\"><strong>\u10e8\u10d4\u10e1\u10d0\u10ef\u10d0\u10db\u10d4\u10d1\u10da\u10d0\u10d3<\/strong>\u00a0\u10d3\u10d0 \u10ea\u10d8\u10e4\u10e0\u10e3\u10da \u10e1\u10d8\u10eb\u10dc\u10d4\u10da\u10d4\u10d4\u10d1\u10d6\u10d4 \u10db\u10d4\u10e2\u10d8 \u10d8\u10dc\u10e4\u10dd\u10e0\u10db\u10d0\u10ea\u10d8\u10d8\u10e1\u10d7\u10d5\u10d8\u10e1, \u10d0\u10e1\u10d4\u10d5\u10d4 \u10e1\u10ee\u10d5\u10d0 \u10e1\u10d0\u10e1\u10d0\u10e0\u10d2\u10d4\u10d1\u10da\u10dd \u10e0\u10d4\u10e1\u10e3\u10e0\u10e1\u10d4\u10d1\u10d8\u10e1\u10d7\u10d5\u10d8\u10e1, \u10d4\u10ec\u10d5\u10d8\u10d4\u10d7:\u00a0<a href=\"https:\/\/deconspirator.eu\/survey-1\/\">https:\/\/deconspirator.eu\/survey-1\/<\/a>.<\/p>\n\n<p>\u10d9\u10d8\u10d7\u10ee\u10d5\u10d4\u10d1\u10d8\u10e1\u10d0 \u10d3\u10d0 \u10d9\u10dd\u10db\u10d4\u10dc\u10e2\u10d0\u10e0\u10d4\u10d1\u10d8\u10e1 \u10e8\u10d4\u10db\u10d7\u10ee\u10d5\u10d4\u10d5\u10d0\u10e8\u10d8, \u10d2\u10d7\u10ee\u10dd\u10d5\u10d7 \u10d3\u10d0\u10d2\u10d5\u10d8\u10d9\u10d0\u10d5\u10e8\u10d8\u10e0\u10d3\u10d4\u10d7 \u10e8\u10d4\u10db\u10d3\u10d4\u10d2 \u10db\u10d8\u10e1\u10d0\u10db\u10d0\u10e0\u10d7\u10d6\u10d4:\u00a0<a href=\"mailto:info@deconspirator.eu\">info@deconspirator.eu<\/a>.<\/p>\n<br \/>\n<br \/>\n\u00a0"},"DE":{"QuestionText":"<span style=\"font-size:16px;\">Vielen Dank f\u00fcr Ihre Teilnahme an unserer Umfrage!<br \/>\n<br \/>\n<strong>BITTE DR\u00dcCKEN SIE WEITER, UM IHRE ANTWORTEN EINZUREICHEN<\/strong><\/span><br \/>\n\u00a0\n<p data-end=\"218\" data-start=\"95\"><span style=\"font-size:16px;\">Im interaktiven Modul wurden Ihnen falsche oder irref\u00fchrende Schlagzeilen im Rahmen unserer experimentellen Studie gezeigt.<\/span><\/p>\n\n<p data-end=\"344\" data-start=\"220\"><span style=\"font-size:16px;\">F\u00fcr eine\u00a0<strong>Auswertung<\/strong>\u00a0und um mehr \u00fcber digitale Kompetenzen sowie weitere n\u00fctzliche Ressourcen zu erfahren, besuchen Sie:\u00a0<a href=\"https:\/\/deconspirator.eu\/survey-1\/\">https:\/\/deconspirator.eu\/survey-1\/<\/a>.<\/span><\/p>\n\n<p><span style=\"font-size:16px;\">Bei Fragen oder Anmerkungen kontaktieren Sie uns bitte unter\u00a0<a href=\"mailto:info@deconspirator.eu\">info@deconspirator.eu<\/a>.<\/span><\/p>\n<br \/>\n\u00a0"},"HU":{"QuestionText":"K\u00f6sz\u00f6nj\u00fck, hogy r\u00e9szt vett k\u00e9rd\u0151\u00edv\u00fcnkben!<br \/>\n<br \/>\n<strong>K\u00c9RJ\u00dcK, NYOMJA MEG A K\u00d6VETKEZ\u0150 GOMBOT A V\u00c1LASZOK BEK\u00dcLD\u00c9S\u00c9HEZ<\/strong><br \/>\n\u00a0\n<p data-end=\"198\" data-start=\"89\">Az interakt\u00edv modul sor\u00e1n hamis vagy megt\u00e9veszt\u0151 c\u00edmsorokat mutattunk \u00d6nnek k\u00eds\u00e9rleti tanulm\u00e1nyunk r\u00e9szek\u00e9nt.<\/p>\n\n<p data-end=\"337\" data-start=\"200\"><strong>Az eredm\u00e9nyek \u00f6sszefoglal\u00e1s\u00e1\u00e9rt<\/strong>, valamint a digit\u00e1lis \u00edr\u00e1stud\u00e1sr\u00f3l \u00e9s egy\u00e9b hasznos forr\u00e1sokr\u00f3l tov\u00e1bbi inform\u00e1ci\u00f3k\u00e9rt l\u00e1togasson el ide:\u00a0<a href=\"https:\/\/deconspirator.eu\/survey-1\/\">https:\/\/deconspirator.eu\/survey-1\/<\/a>.<\/p>\n\n<p>K\u00e9rd\u00e9s vagy \u00e9szrev\u00e9tel eset\u00e9n k\u00e9rj\u00fck, l\u00e9pjen kapcsolatba vel\u00fcnk a k\u00f6vetkez\u0151 c\u00edmen:\u00a0<a href=\"mailto:info@deconspirator.eu\">info@deconspirator.eu<\/a>.<\/p>\n<br \/>\n<br \/>\n\u00a0"},"IT":{"QuestionText":"Grazie per aver partecipato al nostro sondaggio!<br \/>\n<br \/>\n<strong>PREMI AVANTI PER INVIARE LE TUE RISPOSTE<\/strong><br \/>\n\u00a0\n<p data-end=\"209\" data-start=\"94\">Nel modulo interattivo ti sono stati mostrati titoli falsi o fuorvianti nell\u2019ambito del nostro studio sperimentale.<\/p>\n\n<p data-end=\"320\" data-start=\"211\">Per\u00a0<strong>un<\/strong>\u00a0<strong>resoconto<\/strong>\u00a0e per saperne di pi\u00f9 sull\u2019alfabetizzazione digitale, insieme ad altre risorse utili, visita:\u00a0<a href=\"https:\/\/deconspirator.eu\/survey-1\/\">https:\/\/deconspirator.eu\/survey-1\/<\/a>.<\/p>\n\n<p>Per domande o commenti, vi preghiamo di contattarci a:\u00a0<a href=\"mailto:info@deconspirator.eu\">info@deconspirator.eu<\/a>.<\/p>\n<br \/>\n<br \/>\n\u00a0"},"LV":{"QuestionText":"Paldies, ka piedal\u012bj\u0101ties m\u016bsu aptauj\u0101!<br \/>\n<br \/>\n<strong>L\u016aDZU, NOSPIE\u017dIET T\u0100L\u0100K, LAI IESNIEGTU SAVAS ATBILDES<\/strong><br \/>\n\u00a0\n<p data-end=\"200\" data-start=\"85\">Interakt\u012bvaj\u0101 modul\u012b jums tika par\u0101d\u012bti nepatiesi vai maldino\u0161i virsraksti k\u0101 da\u013ca no m\u016bsu eksperiment\u0101l\u0101 p\u0113t\u012bjuma.<\/p>\n\n<p data-end=\"309\" data-start=\"202\">Lai sa\u0146emtu\u00a0<strong>atskaiti<\/strong>\u00a0un uzzin\u0101tu vair\u0101k par digit\u0101lo prat\u012bbu, k\u0101 ar\u012b citas noder\u012bgas resursus, apmekl\u0113jiet\u00a0<a href=\"https:\/\/deconspirator.eu\/survey-1\/\">https:\/\/deconspirator.eu\/survey-1\/<\/a>.<\/p>\n\n<p>Jaut\u0101jumu vai koment\u0101ru gad\u012bjum\u0101, l\u016bdzu, sazinieties ar mums pa:\u00a0<a href=\"mailto:info@deconspirator.eu\">info@deconspirator.eu<\/a>.<\/p>\n<br \/>\n<br \/>\n\u00a0"},"LT":{"QuestionText":"A\u010di\u016b, kad dalyvavote m\u016bs\u0173 apklausoje!<br \/>\n<br \/>\n<strong>PRA\u0160OME PASPAUSTI TOLIAU, KAD PATEIKTUM\u0116TE SAVO ATSAKYMUS<\/strong><br \/>\n\u00a0\n<p data-end=\"221\" data-start=\"86\">Interaktyviame modulyje jums buvo pateikti klaidingi arba klaidinantys antra\u0161tiniai prane\u0161imai, kaip m\u016bs\u0173 eksperimentinio tyrimo dalis.<\/p>\n\n<p data-end=\"340\" data-start=\"223\">Nor\u0117dami gauti\u00a0<strong>ap\u017evalg\u0105<\/strong>\u00a0ir su\u017einoti daugiau apie skaitmenin\u012f ra\u0161tingum\u0105 bei kitas naudingas i\u0161teklius, apsilankykite:\u00a0<a href=\"https:\/\/deconspirator.eu\/survey-1\/\">https:\/\/deconspirator.eu\/survey-1\/<\/a>.<\/p>\n\n<p>Jei turite klausim\u0173 ar pastab\u0173, pra\u0161ome susisiekti su mumis adresu:\u00a0<a href=\"mailto:info@deconspirator.eu\">info@deconspirator.eu<\/a>.<\/p>\n"},"FA":{"QuestionText":"\u0627\u0632 \u0627\u06cc\u0646\u06a9\u0647 \u062f\u0631 \u0646\u0638\u0631\u0633\u0646\u062c\u06cc \u0645\u0627 \u0634\u0631\u06a9\u062a \u06a9\u0631\u062f\u06cc\u062f\u060c \u0633\u067e\u0627\u0633\u06af\u0632\u0627\u0631\u06cc\u0645!<br \/>\n<br \/>\n<strong>\u0644\u0637\u0641\u0627 \u0628\u0631\u0627\u06cc \u0627\u0631\u0633\u0627\u0644 \u067e\u0627\u0633\u062e\u200c\u0647\u0627\u06cc \u062e\u0648\u062f\u060c \u0631\u0648\u06cc \u06af\u0632\u06cc\u0646\u0647 \u0628\u0639\u062f\u06cc \u06a9\u0644\u06cc\u06a9 \u06a9\u0646\u06cc\u062f<\/strong><br \/>\n\u00a0\n<p data-end=\"200\" data-start=\"97\">\u062f\u0631 \u0628\u062e\u0634 \u062a\u0639\u0627\u0645\u0644\u06cc\u060c \u0639\u0646\u0648\u0627\u0646\u200c\u0647\u0627\u06cc \u0646\u0627\u062f\u0631\u0633\u062a \u06cc\u0627 \u06af\u0645\u0631\u0627\u0647\u200c\u06a9\u0646\u0646\u062f\u0647\u200c\u0627\u06cc \u0628\u0647 \u0634\u0645\u0627 \u0646\u0634\u0627\u0646 \u062f\u0627\u062f\u0647 \u0634\u062f \u06a9\u0647 \u0628\u062e\u0634\u06cc \u0627\u0632 \u0645\u0637\u0627\u0644\u0639\u0647\u200c\u06cc \u062a\u062c\u0631\u0628\u06cc \u0645\u0627 \u0628\u0648\u062f.<\/p>\n\n<p data-end=\"299\" data-start=\"202\">\u0628\u0631\u0627\u06cc \u062f\u0631\u06cc\u0627\u0641\u062a \u06af\u0632\u0627\u0631\u0634 \u0648 \u0622\u0634\u0646\u0627\u06cc\u06cc \u0628\u06cc\u0634\u062a\u0631 \u0628\u0627 \u0633\u0648\u0627\u062f \u062f\u06cc\u062c\u06cc\u062a\u0627\u0644\u060c \u0647\u0645\u0631\u0627\u0647 \u0628\u0627 \u0633\u0627\u06cc\u0631 \u0645\u0646\u0627\u0628\u0639 \u0645\u0641\u06cc\u062f\u060c \u0628\u0647 \u0627\u06cc\u0646\u062c\u0627 \u0645\u0631\u0627\u062c\u0639\u0647 \u06a9\u0646\u06cc\u062f:<a href=\"https:\/\/deconspirator.eu\/survey-1\/\">https:\/\/deconspirator.eu\/survey-1\/<\/a>.<\/p>\n\n<p>\u0628\u0631\u0627\u06cc \u0633\u0648\u0627\u0644\u0627\u062a \u06cc\u0627 \u0646\u0638\u0631\u0627\u062a\u060c \u0644\u0637\u0641\u0627\u064b \u0628\u0627 \u0645\u0627 \u062a\u0645\u0627\u0633 \u0628\u06af\u06cc\u0631\u06cc\u062f \u0627\u0632 \u0637\u0631\u06cc\u0642:<a href=\"mailto:info@deconspirator.eu\">info@deconspirator.eu<\/a><\/p>\n\n<p>\u00a0<\/p>\n"},"PL":{"QuestionText":"Dzi\u0119kujemy za udzia\u0142 w naszej ankiecie!<br \/>\n<br \/>\n<strong>PROSZ\u0118 NACISN\u0104\u0106 DALEJ, ABY WYS\u0141A\u0106 SWOJE ODPOWIEDZI<\/strong><br \/>\n\u00a0\n<p data-end=\"214\" data-start=\"93\">W module interaktywnym pokazano Ci fa\u0142szywe lub wprowadzaj\u0105ce w b\u0142\u0105d nag\u0142\u00f3wki w ramach naszego badania eksperymentalnego.<\/p>\n\n<p data-end=\"366\" data-start=\"216\">Aby zapozna\u0107 si\u0119 z\u00a0<strong>podsumowaniem<\/strong>\u00a0oraz dowiedzie\u0107 si\u0119 wi\u0119cej na temat kompetencji cyfrowych i innych przydatnych zasob\u00f3w, odwied\u017a\u00a0<a href=\"https:\/\/deconspirator.eu\/survey-1\/\">https:\/\/deconspirator.eu\/survey-1\/<\/a>.<\/p>\n\n<p>W przypadku pyta\u0144 lub uwag prosimy o kontakt pod adresem:\u00a0<a href=\"mailto:info@deconspirator.eu\">info@deconspirator.eu<\/a>.<\/p>\n<br \/>\n\u00a0"},"RU":{"QuestionText":"\u0421\u043f\u0430\u0441\u0438\u0431\u043e \u0437\u0430 \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \u043d\u0430\u0448\u0435\u043c \u043e\u043f\u0440\u043e\u0441\u0435!<br \/>\n<br \/>\n<strong>\u041d\u0410\u0416\u041c\u0418\u0422\u0415 \u00ab\u0414\u0410\u041b\u0415\u0415\u00bb, \u0427\u0422\u041e\u0411\u042b \u041e\u0422\u041f\u0420\u0410\u0412\u0418\u0422\u042c \u0421\u0412\u041e\u0418 \u041e\u0422\u0412\u0415\u0422\u042b.<\/strong><br \/>\n\u00a0\n<p data-end=\"269\" data-start=\"136\">\u0412 \u0438\u043d\u0442\u0435\u0440\u0430\u043a\u0442\u0438\u0432\u043d\u043e\u043c \u043c\u043e\u0434\u0443\u043b\u0435 \u0432\u0430\u043c \u0431\u044b\u043b\u0438 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u044b \u043b\u043e\u0436\u043d\u044b\u0435 \u0438\u043b\u0438 \u0432\u0432\u043e\u0434\u044f\u0449\u0438\u0435 \u0432 \u0437\u0430\u0431\u043b\u0443\u0436\u0434\u0435\u043d\u0438\u0435 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u0438 \u0432 \u0440\u0430\u043c\u043a\u0430\u0445 \u043d\u0430\u0448\u0435\u0433\u043e \u044d\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430.<\/p>\n\n<p data-end=\"418\" data-start=\"271\">\u0427\u0442\u043e\u0431\u044b \u043e\u0437\u043d\u0430\u043a\u043e\u043c\u0438\u0442\u044c\u0441\u044f \u0441\u00a0<strong data-end=\"304\" data-start=\"292\">\u0440\u0430\u0437\u0431\u043e\u0440\u043e\u043c<\/strong>\u00a0\u0438 \u0443\u0437\u043d\u0430\u0442\u044c \u0431\u043e\u043b\u044c\u0448\u0435 \u043e \u0446\u0438\u0444\u0440\u043e\u0432\u043e\u0439 \u0433\u0440\u0430\u043c\u043e\u0442\u043d\u043e\u0441\u0442\u0438, \u0430 \u0442\u0430\u043a\u0436\u0435 \u0434\u0440\u0443\u0433\u0438\u043c\u0438 \u043f\u043e\u043b\u0435\u0437\u043d\u044b\u043c\u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u0430\u043c\u0438, \u043f\u043e\u0441\u0435\u0442\u0438\u0442\u0435\u00a0<a href=\"https:\/\/deconspirator.eu\/survey-1\/\">https:\/\/deconspirator.eu\/survey-1\/<\/a>.<\/p>\n\n<p>\u0412 \u0441\u043b\u0443\u0447\u0430\u0435 \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432 \u0438\u043b\u0438 \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0435\u0432, \u043f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u0441\u0432\u044f\u0436\u0438\u0442\u0435\u0441\u044c \u0441 \u043d\u0430\u043c\u0438 \u043f\u043e \u0430\u0434\u0440\u0435\u0441\u0443:\u00a0<a href=\"mailto:info@deconspirator.eu\">info@deconspirator.eu<\/a>.<\/p>\n<br \/>\n\u00a0"},"SR":{"QuestionText":"\u0425\u0432\u0430\u043b\u0430 \u0432\u0430\u043c \u0448\u0442\u043e \u0441\u0442\u0435 \u0443\u0447\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0438 \u0443 \u043d\u0430\u0448\u043e\u0458 \u0430\u043d\u043a\u0435\u0442\u0438!<br \/>\n<br \/>\n<strong>\u041c\u041e\u041b\u0418\u041c\u041e \u0412\u0410\u0421 \u0414\u0410 \u041f\u0420\u0418\u0422\u0418\u0421\u041d\u0415\u0422\u0415 \u0414\u0410\u0409\u0415 \u0414\u0410 \u0411\u0418\u0421\u0422\u0415 \u041f\u041e\u0428\u0410\u041b\u0418 \u0421\u0412\u041e\u0408\u0415 \u041e\u0414\u0413\u041e\u0412\u041e\u0420\u0415<\/strong><br \/>\n\u00a0\n<p>\u0418\u043d\u0442\u0435\u0440\u0430\u043a\u0442\u0438\u0432\u043d\u0438 \u043c\u043e\u0434\u0443\u043b \u0432\u0430\u043c \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430 \u043b\u0430\u0436\u043d\u0435 \u0438\u043b\u0438 \u043e\u0431\u043c\u0430\u045a\u0443\u0458\u0443\u045b\u0435 \u043d\u0430\u0441\u043b\u043e\u0432\u0435 \u043a\u0430\u043e \u0434\u0435\u043e \u043d\u0430\u0448\u0435\u0433 \u0435\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u043b\u043d\u043e\u0433 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0430. \u0417\u0430\u00a0<b>\u0440\u0435\u0437\u0438\u043c\u0435<\/b>\u00a0\u0438 \u0432\u0438\u0448\u0435 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0458\u0430 \u043e \u0434\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u043e\u0458 \u043f\u0438\u0441\u043c\u0435\u043d\u043e\u0441\u0442\u0438, \u043a\u0430\u043e \u0438 \u0434\u0440\u0443\u0433\u0435 \u043a\u043e\u0440\u0438\u0441\u043d\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u0435, \u043f\u043e\u0441\u0435\u0442\u0438\u0442\u0435\u00a0<a href=\"https:\/\/deconspirator.eu\/survey-1\/\">https:\/\/deconspirator.eu\/survey-1\/<\/a>.<\/p>\n\n<p>\u0417\u0430 \u043f\u0438\u0442\u0430\u045a\u0430 \u0438\u043b\u0438 \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0435, \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u0438\u0440\u0430\u0458\u0442\u0435 \u043d\u0430\u0441 \u043d\u0430\u00a0<a href=\"mailto:info@deconspirator.eu\">info@deconspirator.eu<\/a>.<\/p>\n"},"TR":{"QuestionText":"Anketimize kat\u0131ld\u0131\u011f\u0131n\u0131z i\u00e7in te\u015fekk\u00fcr ederiz!<br \/>\n<br \/>\n<strong>CEVAPLARINIZI G\u00d6NDERMEK \u0130\u00c7\u0130N L\u00dcTFEN \u0130LER\u0130'YE BASIN<\/strong><br \/>\n\u00a0\n<p data-end=\"236\" data-start=\"120\">Etkile\u015fimli mod\u00fclde, deneysel \u00e7al\u0131\u015fmam\u0131z\u0131n bir par\u00e7as\u0131 olarak size sahte veya yan\u0131lt\u0131c\u0131 haber ba\u015fl\u0131klar\u0131 g\u00f6sterildi.<\/p>\n\n<p data-end=\"416\" data-start=\"238\"><strong>De\u011ferlendirme s\u00fcreci hakk\u0131nda bilgi almak<\/strong>\u00a0ve dijital okuryazarl\u0131k ile ilgili daha fazla bilgi edinmek, ayr\u0131ca di\u011fer faydal\u0131 kaynaklara ula\u015fmak i\u00e7in l\u00fctfen \u015fu adresi ziyaret edin:\u00a0<a href=\"https:\/\/deconspirator.eu\/survey-1\/\">https:\/\/deconspirator.eu\/survey-1\/<\/a>.<\/p>\n\n<p>Sorular\u0131n\u0131z veya yorumlar\u0131n\u0131z i\u00e7in l\u00fctfen bizimle \u015fu adresten ileti\u015fime ge\u00e7in:\u00a0<a href=\"mailto:info@deconspirator.eu\">info@deconspirator.eu<\/a>.<\/p>\n<br \/>\n\u00a0"},"UK":{"QuestionText":"\u0414\u044f\u043a\u0443\u0454\u043c\u043e \u0437\u0430 \u0443\u0447\u0430\u0441\u0442\u044c \u0443 \u043d\u0430\u0448\u043e\u043c\u0443 \u043e\u043f\u0438\u0442\u0443\u0432\u0430\u043d\u043d\u0456!<br \/>\n<br \/>\n<strong>\u0411\u0423\u0414\u042c \u041b\u0410\u0421\u041a\u0410, \u041d\u0410\u0422\u0418\u0421\u041d\u0406\u0422\u042c \u0414\u0410\u041b\u0406, \u0429\u041e\u0411 \u041d\u0410\u0414\u0406\u0421\u041b\u0410\u0422\u0418 \u0421\u0412\u041e\u0407 \u0412\u0406\u0414\u041f\u041e\u0412\u0406\u0414\u0406<\/strong><br \/>\n\u00a0\n<p data-end=\"238\" data-start=\"120\">\u0423 \u0456\u043d\u0442\u0435\u0440\u0430\u043a\u0442\u0438\u0432\u043d\u043e\u043c\u0443 \u043c\u043e\u0434\u0443\u043b\u0456 \u0432\u0430\u043c \u043f\u043e\u043a\u0430\u0437\u0443\u0432\u0430\u043b\u0438 \u0444\u0430\u043b\u044c\u0448\u0438\u0432\u0456 \u0430\u0431\u043e \u043e\u043c\u0430\u043d\u043b\u0438\u0432\u0456 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u0438 \u0432 \u0440\u0430\u043c\u043a\u0430\u0445 \u043d\u0430\u0448\u043e\u0433\u043e \u0435\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u044f.<\/p>\n\n<p data-end=\"383\" data-start=\"240\">\u0429\u043e\u0431 \u043e\u0437\u043d\u0430\u0439\u043e\u043c\u0438\u0442\u0438\u0441\u044f \u0437\u00a0<strong data-end=\"272\" data-start=\"259\">\u043f\u0456\u0434\u0441\u0443\u043c\u043a\u043e\u043c<\/strong>\u00a0\u0442\u0430 \u0434\u0456\u0437\u043d\u0430\u0442\u0438\u0441\u044f \u0431\u0456\u043b\u044c\u0448\u0435 \u043f\u0440\u043e \u0446\u0438\u0444\u0440\u043e\u0432\u0443 \u0433\u0440\u0430\u043c\u043e\u0442\u043d\u0456\u0441\u0442\u044c, \u0430 \u0442\u0430\u043a\u043e\u0436 \u0456\u043d\u0448\u0456 \u043a\u043e\u0440\u0438\u0441\u043d\u0456 \u0440\u0435\u0441\u0443\u0440\u0441\u0438, \u0432\u0456\u0434\u0432\u0456\u0434\u0430\u0439\u0442\u0435\u00a0<a href=\"https:\/\/deconspirator.eu\/survey-1\/\">https:\/\/deconspirator.eu\/survey-1\/<\/a>.<\/p>\n\n<p>\u042f\u043a\u0449\u043e \u0443 \u0432\u0430\u0441 \u0454 \u043f\u0438\u0442\u0430\u043d\u043d\u044f \u0430\u0431\u043e \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0456, \u0431\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u0437\u0432\u2019\u044f\u0436\u0456\u0442\u044c\u0441\u044f \u0437 \u043d\u0430\u043c\u0438 \u0437\u0430 \u0430\u0434\u0440\u0435\u0441\u043e\u044e:\u00a0<a href=\"mailto:info@deconspirator.eu\">info@deconspirator.eu<\/a>.<\/p>\n<br \/>\n<br \/>\n\u00a0"}},"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID200"}},{"SurveyID":"SV_ehNvPC5ntZii634","Element":"SQ","PrimaryAttribute":"QID21","SecondaryAttribute":"[Q6] How much false or misleading content do you think is created by foreign actors about each of...","TertiaryAttribute":null,"Payload":{"QuestionText":"[Q6] How much<strong> <\/strong>false or misleading content do you think is created by foreign actors<strong> about each of the following topics<\/strong>?&nbsp;<br \/>\nPlease rate from 1 (None at all) to 7 (Very much)","DefaultChoices":false,"DataExportTag":"Q6\u00a0","QuestionID":"QID21","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"WhiteSpace":"OFF","MobileFirst":true,"RepeatHeaders":"none"},"QuestionDescription":"[Q6] How much false or misleading content do you think is created by foreign actors about each of...","Choices":{"1":{"Display":"Politics and elections"},"2":{"Display":"Science and technology"},"3":{"Display":"Emergencies, such as shootings or natural disasters"},"4":{"Display":"Health and medicine"},"5":{"Display":"War and conflicts"},"6":{"Display":"National issues, events and public figures"},"7":{"Display":"Business and finance"},"8":{"Display":"Sports"},"9":{"Display":"Entertainment and celebrities"}},"ChoiceOrder":[1,2,3,4,5,6,7,8,9],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":{"AR":{"QuestionText":"[\u06336] \u0645\u0627 \u0647\u064a \u0643\u0645\u064a\u0629\u00a0\u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0643\u0627\u0630\u0628 \u0623\u0648 \u0627\u0644\u0645\u0636\u0644\u0644 \u062a\u0645 \u0625\u0646\u0634\u0627\u0624\u0647 \u0645\u0646 \u0642\u0628\u0644 \u062c\u0647\u0627\u062a \u0623\u062c\u0646\u0628\u064a\u0629 \u0628\u0627\u0639\u062a\u0642\u0627\u062f\u0643\u00a0<strong>\u062d\u0648\u0644 \u0643\u0644 \u0645\u0646 \u0627\u0644\u0645\u0648\u0636\u0648\u0639\u0627\u062a \u0627\u0644\u062a\u0627\u0644\u064a\u0629<\/strong> \u061f<br \/>\n\u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u0642\u064a\u064a\u0645 \u0645\u0646 1 (\u0644\u0627 \u0634\u064a\u0621 \u0639\u0644\u0649 \u0627\u0644\u0625\u0637\u0644\u0627\u0642) \u0625\u0644\u0649 7 (\u062c\u064a\u062f \u062c\u062f\u064b\u0627)","Choices":{"1":{"Display":"\u0627\u0644\u0633\u064a\u0627\u0633\u0629 \u0648\u0627\u0644\u0627\u0646\u062a\u062e\u0627\u0628\u0627\u062a"},"2":{"Display":"\u0627\u0644\u0639\u0644\u0648\u0645 \u0648\u0627\u0644\u062a\u0643\u0646\u0648\u0644\u0648\u062c\u064a\u0627"},"3":{"Display":"\u062d\u0627\u0644\u0627\u062a \u0627\u0644\u0637\u0648\u0627\u0631\u0626\u060c \u0645\u062b\u0644 \u0625\u0637\u0644\u0627\u0642 \u0627\u0644\u0646\u0627\u0631 \u0623\u0648 \u0627\u0644\u0643\u0648\u0627\u0631\u062b \u0627\u0644\u0637\u0628\u064a\u0639\u064a\u0629"},"4":{"Display":"\u0627\u0644\u0635\u062d\u0629 \u0648\u0627\u0644\u0637\u0628"},"5":{"Display":"\u0627\u0644\u062d\u0631\u0628 \u0648\u0627\u0644\u0635\u0631\u0627\u0639\u0627\u062a"},"6":{"Display":"\u0627\u0644\u0642\u0636\u0627\u064a\u0627 \u0627\u0644\u0648\u0637\u0646\u064a\u0629 \u0648\u0627\u0644\u0623\u062d\u062f\u0627\u062b \u0648\u0627\u0644\u0634\u062e\u0635\u064a\u0627\u062a \u0627\u0644\u0639\u0627\u0645\u0629"},"7":{"Display":"\u0627\u0644\u0623\u0639\u0645\u0627\u0644 \u0648\u0627\u0644\u062a\u0645\u0648\u064a\u0644"},"8":{"Display":"\u0627\u0644\u0631\u064a\u0627\u0636\u0629"},"9":{"Display":"\u0627\u0644\u062a\u0631\u0641\u064a\u0647 \u0648\u0627\u0644\u0645\u0634\u0627\u0647\u064a\u0631"}},"Answers":{"1":{"Display":"1- \u0644\u0627 \u0634\u064a\u0621 \u0639\u0644\u0649 \u0627\u0644\u0625\u0637\u0644\u0627\u0642"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 - \u0643\u062b\u064a\u0631\u064b\u0627 \u062c\u062f\u064b\u0627"}}},"BG":{"QuestionText":"[Q6] <meta charset=\"UTF-8\" \/>\u0421\u043f\u043e\u0440\u0435\u0434 \u0432\u0430\u0441, \u043a\u043e\u043b\u043a\u043e \u043d\u0435\u0432\u044f\u0440\u043d\u043e \u0438\u043b\u0438 \u043f\u043e\u0434\u0432\u0435\u0436\u0434\u0430\u0449\u043e \u0441\u044a\u0434\u044a\u0440\u0436\u0430\u043d\u0438\u0435 \u0435 \u0441\u044a\u0437\u0434\u0430\u0434\u0435\u043d\u043e \u043e\u0442 \u0447\u0443\u0436\u0434\u0435\u0441\u0442\u0440\u0430\u043d\u043d\u0438\u00a0\u0441\u0443\u0431\u0435\u043a\u0442\u0438<strong>\u00a0\u043f\u043e \u0432\u0441\u044f\u043a\u0430 \u043e\u0442 \u0441\u043b\u0435\u0434\u043d\u0438\u0442\u0435 \u0442\u0435\u043c\u0438<\/strong>?<br \/>\n\u041c\u043e\u043b\u044f, \u043e\u0446\u0435\u043d\u0435\u0442\u0435 \u043e\u0442 1 (<meta charset=\"UTF-8\" \/>\u0410\u0431\u0441\u043e\u043b\u044e\u0442\u043d\u043e \u043d\u0438\u043a\u0430\u043a\u0432\u043e) \u0434\u043e 7 (<meta charset=\"UTF-8\" \/>\u041c\u043d\u043e\u0433\u043e \u0433\u043e\u043b\u044f\u043c\u043e \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e)","Choices":{"1":{"Display":"\u041f\u043e\u043b\u0438\u0442\u0438\u043a\u0430 \u0438 \u0438\u0437\u0431\u043e\u0440\u0438"},"2":{"Display":"\u041d\u0430\u0443\u043a\u0430 \u0438 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0438"},"3":{"Display":"<meta charset=\"UTF-8\" \/>\u0418\u0437\u0432\u044a\u043d\u0440\u0435\u0434\u043d\u0438 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438, \u043a\u0430\u0442\u043e \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440\u00a0\u043c\u0430\u0441\u043e\u0432\u0438\u00a0\u0441\u0442\u0440\u0435\u043b\u0431\u0438 \u0438\u043b\u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u0438 \u0431\u0435\u0434\u0441\u