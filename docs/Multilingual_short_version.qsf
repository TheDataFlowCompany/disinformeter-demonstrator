9 \u0627\u0644\u0643\u0627\u0630\u0628 \u0623\u0648 \u0627\u0644\u0645\u0636\u0644\u0644<\/strong> \u061f<br> \u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u0642\u064a\u064a\u0645 \u0645\u0646 1 (\u0644\u0627 \u064a\u0648\u062c\u062f \u0623\u064a \u062a\u062d\u062f \u0639\u0644\u0649 \u0627\u0644\u0625\u0637\u0644\u0627\u0642) \u0625\u0644\u0649 7 (\u062a\u062d\u062f\u064d \u0643\u0628\u064a\u0631)<br>","Choices":{"1":{"Display":"\u0627\u0644\u0627\u0633\u062a\u0642\u0637\u0627\u0628 \u0627\u0644\u0633\u064a\u0627\u0633\u064a (\u0627\u0644\u0627\u0646\u0642\u0633\u0627\u0645\u0627\u062a \u0627\u0644\u0633\u064a\u0627\u0633\u064a\u0629\u060c \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0627\u0633\u062a\u0642\u0637\u0627\u0628\u064a)"},"2":{"Display":"\u0639\u062f\u0645 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 (\u0642\u0644\u0629 \u0627\u0644\u062c\u0647\u062f\u060c \u0627\u0646\u062e\u0641\u0627\u0636 \u0627\u0644\u0648\u0639\u064a)"},"3":{"Display":"\u0636\u0639\u0641 \u0627\u0644\u062b\u0642\u0627\u0641\u0629 \u0627\u0644\u0625\u0639\u0644\u0627\u0645\u064a\u0629 \u0648\u0627\u0644\u0631\u0642\u0645\u064a\u0629 (\u0641\u062c\u0648\u0627\u062a \u0627\u0644\u062b\u0642\u0627\u0641\u0629 \u0627\u0644\u0625\u0639\u0644\u0627\u0645\u064a\u0629\u060c \u0648\u0646\u0642\u0635 \u0627\u0644\u062a\u0639\u0644\u064a\u0645)"},"4":{"Display":"\u0627\u0644\u062d\u0648\u0627\u0641\u0632 \u0627\u0644\u0645\u0627\u0644\u064a\u0629 (\u0627\u0644\u0627\u0633\u062a\u0641\u0627\u062f\u0629 \u0645\u0646 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0645\u0636\u0644\u0644\u0629)"},"5":{"Display":"\u0646\u0641\u0648\u0630 \u0627\u0644\u062d\u0643\u0648\u0645\u0629 (\u0627\u0644\u0633\u064a\u0637\u0631\u0629 \u0627\u0644\u0645\u0641\u0631\u0637\u0629 \u0623\u0648 \u0627\u0644\u062a\u062f\u062e\u0644 \u0627\u0644\u062d\u0643\u0648\u0645\u064a)"},"6":{"Display":"\u0642\u064a\u0648\u062f \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u062d\u0642\u0627\u0626\u0642 (\u0627\u0644\u0627\u0641\u062a\u0642\u0627\u0631 \u0625\u0644\u0649 \u0627\u0644\u062a\u0646\u0633\u064a\u0642\u060c \u0648\u0642\u0644\u0629 \u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0644\u0644\u062c\u0647\u0648\u062f)"},"7":{"Display":"\u0627\u0644\u062d\u0648\u0627\u062c\u0632 \u0627\u0644\u062b\u0642\u0627\u0641\u064a\u0629 \u0648\u0627\u0644\u0644\u063a\u0648\u064a\u0629 (\u0641\u062c\u0648\u0627\u062a \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0628\u064a\u0646 \u0627\u0644\u0645\u062c\u062a\u0645\u0639\u0627\u062a)"},"8":{"Display":"\u0639\u062f\u0645 \u0627\u0644\u062b\u0642\u0629 \u0641\u064a \u0627\u0644\u0645\u0624\u0633\u0633\u0627\u062a (\u0627\u0644\u0639\u0627\u0645\u0629 \u0623\u0648 \u0627\u0644\u062e\u0627\u0635\u0629)"},"9":{"Display":"\u0623\u062c\u0646\u062f\u0627\u062a \u0627\u0644\u0634\u0631\u0643\u0627\u062a\/\u0648\u0633\u0627\u0626\u0644 \u0627\u0644\u0625\u0639\u0644\u0627\u0645 (\u0646\u0641\u0648\u0630 \u0627\u0644\u0634\u0631\u0643\u0627\u062a\u060c \u0648\u0627\u0644\u0645\u0635\u0627\u0644\u062d \u0627\u0644\u0633\u064a\u0627\u0633\u064a\u0629 \u0644\u0644\u0645\u0646\u0627\u0641\u0630 \u0627\u0644\u0625\u0639\u0644\u0627\u0645\u064a\u0629)"},"10":{"Display":"\u0627\u0644\u0645\u0624\u062b\u0631\u0648\u0646 \u0648\u0627\u0644\u0645\u0634\u0627\u0647\u064a\u0631 (\u062f\u0648\u0631\u0647\u0645 \u0641\u064a \u062a\u0636\u062e\u064a\u0645 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0645\u0636\u0644\u0644\u0629)"}},"Answers":{"1":{"Display":"\u0644\u0627 \u064a\u0648\u062c\u062f \u0623\u064a \u062a\u062d\u062f\u064a \u0639\u0644\u0649 \u0627\u0644\u0625\u0637\u0644\u0627\u0642"},"2":{"Display":"\u062a\u062d\u062f\u064a \u0643\u0628\u064a\u0631"}}},"BG":{"QuestionText":"[Q26] <strong>\u041a\u043e\u043b\u043a\u043e \u0433\u043e\u043b\u044f\u043c\u043e \u043f\u0440\u0435\u0434\u0438\u0437\u0432\u0438\u043a\u0430\u0442\u0435\u043b\u0441\u0442\u0432\u043e<\/strong> \u0441\u043f\u043e\u0440\u0435\u0434 \u0432\u0430\u0441 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0432\u0430 \u0432\u0441\u044f\u043a\u043e \u043e\u0442 \u0441\u043b\u0435\u0434\u043d\u0438\u0442\u0435 \u043d\u0435\u0449\u0430 <strong>\u043f\u0440\u0438<\/strong> <strong>\u0441\u043f\u0440\u0430\u0432\u044f\u043d\u0435\u0442\u043e \u0441 \u043d\u0435\u0432\u044f\u0440\u043d\u043e \u0438\u043b\u0438 \u043f\u043e\u0434\u0432\u0435\u0436\u0434\u0430\u0449\u043e \u0441\u044a\u0434\u044a\u0440\u0436\u0430\u043d\u0438\u0435<\/strong> ?<br> \u041c\u043e\u043b\u044f, \u043e\u0446\u0435\u043d\u0435\u0442\u0435 \u043e\u0442 1 (\u041d\u044f\u043c\u0430 \u043d\u0438\u043a\u0430\u043a\u0432\u043e \u043f\u0440\u0435\u0434\u0438\u0437\u0432\u0438\u043a\u0430\u0442\u0435\u043b\u0441\u0442\u0432\u043e) \u0434\u043e 7 (\u041e\u0433\u0440\u043e\u043c\u043d\u043e \u043f\u0440\u0435\u0434\u0438\u0437\u0432\u0438\u043a\u0430\u0442\u0435\u043b\u0441\u0442\u0432\u043e)<br>","Choices":{"1":{"Display":"\u041f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0430 \u043f\u043e\u043b\u044f\u0440\u0438\u0437\u0430\u0446\u0438\u044f (\u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u044f, \u043f\u043e\u043b\u044f\u0440\u0438\u0437\u0438\u0440\u0430\u0449\u043e \u0441\u044a\u0434\u044a\u0440\u0436\u0430\u043d\u0438\u0435)"},"2":{"Display":"\u041e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u0430 \u043d\u0435\u0430\u043d\u0433\u0430\u0436\u0438\u0440\u0430\u043d\u043e\u0441\u0442 (\u043b\u0438\u043f\u0441\u0430 \u043d\u0430 \u0443\u0441\u0438\u043b\u0438\u044f, \u043d\u0438\u0441\u043a\u0430 \u043e\u0441\u0432\u0435\u0434\u043e\u043c\u0435\u043d\u043e\u0441\u0442)"},"3":{"Display":"\u0421\u043b\u0430\u0431\u0430 \u043c\u0435\u0434\u0438\u0439\u043d\u0430 \u0438 \u0434\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u0430 \u0433\u0440\u0430\u043c\u043e\u0442\u043d\u043e\u0441\u0442 (\u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0438 \u0432 \u043c\u0435\u0434\u0438\u0439\u043d\u0430\u0442\u0430 \u0433\u0440\u0430\u043c\u043e\u0442\u043d\u043e\u0441\u0442, \u043b\u0438\u043f\u0441\u0430 \u043d\u0430 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435)"},"4":{"Display":"\u0424\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u0438 \u0441\u0442\u0438\u043c\u0443\u043b\u0438 (\u043f\u0435\u0447\u0430\u043b\u0431\u0430 \u043e\u0442 \u0434\u0435\u0437\u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f)"},"5":{"Display":"\u041f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u0441\u0442\u0432\u0435\u043d\u043e \u0432\u043b\u0438\u044f\u043d\u0438\u0435 (\u043f\u0440\u0435\u043a\u043e\u043c\u0435\u0440\u0435\u043d \u0434\u044a\u0440\u0436\u0430\u0432\u0435\u043d \u043a\u043e\u043d\u0442\u0440\u043e\u043b \u0438\u043b\u0438 \u043d\u0430\u043c\u0435\u0441\u0430)"},"6":{"Display":"\u041e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u044f \u043f\u0440\u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0430\u0442\u0430 \u043d\u0430 \u0444\u0430\u043a\u0442\u0438\u0442\u0435 (\u043b\u0438\u043f\u0441\u0430 \u043d\u0430 \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0446\u0438\u044f, \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u044a\u0447\u043d\u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u0438)"},"7":{"Display":"\u041a\u0443\u043b\u0442\u0443\u0440\u043d\u0438 \u0438 \u0435\u0437\u0438\u043a\u043e\u0432\u0438 \u0431\u0430\u0440\u0438\u0435\u0440\u0438 (\u043a\u043e\u043c\u0443\u043d\u0438\u043a\u0430\u0446\u0438\u043e\u043d\u043d\u0438 \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0438 \u043c\u0435\u0436\u0434\u0443 \u043e\u0431\u0449\u043d\u043e\u0441\u0442\u0438\u0442\u0435)"},"8":{"Display":"\u041d\u0435\u0434\u043e\u0432\u0435\u0440\u0438\u0435 \u0432 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0446\u0438\u0438\u0442\u0435 (\u043f\u0443\u0431\u043b\u0438\u0447\u043d\u0438 \u0438\u043b\u0438 \u0447\u0430\u0441\u0442\u043d\u0438)"},"9":{"Display":"\u041a\u043e\u0440\u043f\u043e\u0440\u0430\u0442\u0438\u0432\u043d\u0438\/\u043c\u0435\u0434\u0438\u0439\u043d\u0438 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 (\u043a\u043e\u0440\u043f\u043e\u0440\u0430\u0442\u0438\u0432\u043d\u043e \u0432\u043b\u0438\u044f\u043d\u0438\u0435, \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0438 \u043d\u0430 \u043c\u0435\u0434\u0438\u0438\u0442\u0435)"},"10":{"Display":"\u0418\u043d\u0444\u043b\u0443\u0435\u043d\u0441\u044a\u0440\u0438 \u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u0438 \u043b\u0438\u0447\u043d\u043e\u0441\u0442\u0438 (\u0442\u044f\u0445\u043d\u0430\u0442\u0430 \u0440\u043e\u043b\u044f \u0432 \u0440\u0430\u0437\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435\u0442\u043e \u043d\u0430 \u0434\u0435\u0437\u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f)"}},"Answers":{"1":{"Display":"\u041d\u044f\u043c\u0430 \u043d\u0438\u043a\u0430\u043a\u0432\u043e \u043f\u0440\u0435\u0434\u0438\u0437\u0432\u0438\u043a\u0430\u0442\u0435\u043b\u0441\u0442\u0432\u043e"},"2":{"Display":"\u041e\u0433\u0440\u043e\u043c\u043d\u043e \u043f\u0440\u0435\u0434\u0438\u0437\u0432\u0438\u043a\u0430\u0442\u0435\u043b\u0441\u0442\u0432\u043e"}}},"DE":{"QuestionText":"[Q26] <strong>Wie gro\u00df ist Ihrer Meinung nach die Herausforderung<\/strong> , <strong>auf<\/strong> <strong>falsche oder irref\u00fchrende Inhalte einzugehen<\/strong> ?<br> Bitte bewerten Sie von 1 (\u00fcberhaupt keine Herausforderung) bis 7 (eine gro\u00dfe Herausforderung)<br>","Choices":{"1":{"Display":"Politische Polarisierung (politische Spaltungen, polarisierende Inhalte)"},"2":{"Display":"Desinteresse der \u00d6ffentlichkeit (mangelnde Anstrengung, geringes Bewusstsein)"},"3":{"Display":"Schwache Medien- und Digitalkompetenz (Medienkompetenzl\u00fccken, mangelnde Bildung)"},"4":{"Display":"Finanzielle Anreize (Profitieren von Fehlinformationen)"},"5":{"Display":"Einfluss der Regierung (\u00fcberm\u00e4\u00dfige staatliche Kontrolle oder Einmischung)"},"6":{"Display":"Einschr\u00e4nkungen bei der Faktenpr\u00fcfung (mangelnde Koordination, unzureichende Ressourcenausstattung)"},"7":{"Display":"Kulturelle und sprachliche Barrieren (Kommunikationsl\u00fccken zwischen den Gemeinschaften)"},"8":{"Display":"Misstrauen gegen\u00fcber Institutionen (\u00f6ffentlich oder privat)"},"9":{"Display":"Unternehmens-\/Medienagenden (Unternehmenseinfluss, politische Interessen der Medien)"},"10":{"Display":"Influencer und Prominente (ihre Rolle bei der Verbreitung von Fehlinformationen)"}},"Answers":{"1":{"Display":"\u00dcberhaupt keine Herausforderung"},"2":{"Display":"Eine gro\u00dfe Herausforderung"}}},"ET":{"QuestionText":"[K26] <strong>Kui suureks v\u00e4ljakutseks<\/strong> peate iga j\u00e4rgnevat <strong>vale v\u00f5i eksitava sisuga tegelemisel<\/strong> <strong>?<\/strong><br> Palun hinnake skaalal 1 (mingit v\u00e4ljakutset pole) kuni 7 (tohutu v\u00e4ljakutse)<br>","Choices":{"1":{"Display":"Poliitiline polariseerumine (poliitilised l\u00f5hed, polariseeriv sisu)"},"2":{"Display":"Avalik eemalehoidmine (pingutuste puudumine, madal teadlikkus)"},"3":{"Display":"N\u00f5rk meedia- ja digitaalne kirjaoskus (meediakirjaoskuse l\u00fcngad, hariduse puudumine)"},"4":{"Display":"Rahalised stiimulid (valeinfost kasu saamine)"},"5":{"Display":"Valitsuse m\u00f5ju (liigne riiklik kontroll v\u00f5i sekkumine)"},"6":{"Display":"Faktide kontrollimise piirangud (koordineerimise puudumine, ressursside puudus)"},"7":{"Display":"Kultuurilised ja keelelised barj\u00e4\u00e4rid (kogukondadevahelised suhtlusl\u00fcngad)"},"8":{"Display":"Usaldamatus institutsioonide (avalike v\u00f5i era\u00f5iguslike) vastu"},"9":{"Display":"Ettev\u00f5tete\/meedia tegevuskavad (ettev\u00f5tete m\u00f5juv\u00f5im, meediav\u00e4ljaannete poliitilised huvid)"},"10":{"Display":"M\u00f5jutajad ja kuulsused (nende roll v\u00e4\u00e4rinfo v\u00f5imendamisel)"}},"Answers":{"1":{"Display":"Pole mingit v\u00e4ljakutset"},"2":{"Display":"Tohutu v\u00e4ljakutse"}}},"FA":{"QuestionText":"[\u0633\u0648\u0627\u064426] \u0628\u0647 \u0646\u0638\u0631 \u0634\u0645\u0627 \u0647\u0631 \u06cc\u06a9 \u0627\u0632 \u0645\u0648\u0627\u0631\u062f \u0632\u06cc\u0631 <strong>\u0686\u0642\u062f\u0631<\/strong> <strong>\u062f\u0631<\/strong> <strong>\u0645\u0642\u0627\u0628\u0644\u0647 \u0628\u0627 \u0645\u062d\u062a\u0648\u0627\u06cc \u0646\u0627\u062f\u0631\u0633\u062a \u06cc\u0627 \u06af\u0645\u0631\u0627\u0647\u200c\u06a9\u0646\u0646\u062f\u0647<\/strong> \u0686\u0627\u0644\u0634\u200c\u0628\u0631\u0627\u0646\u06af\u06cc\u0632 \u0627\u0633\u062a\u061f<br> \u0644\u0637\u0641\u0627 \u0627\u0632 \u06f1 (\u0627\u0635\u0644\u0627 \u0686\u0627\u0644\u0634\u06cc \u0648\u062c\u0648\u062f \u0646\u062f\u0627\u0631\u062f) \u062a\u0627 \u06f7 (\u0686\u0627\u0644\u0634 \u0628\u0632\u0631\u06af\u06cc \u0627\u0633\u062a) \u0627\u0645\u062a\u06cc\u0627\u0632 \u062f\u0647\u06cc\u062f.<br>","Choices":{"1":{"Display":"\u0642\u0637\u0628\u200c\u0628\u0646\u062f\u06cc \u0633\u06cc\u0627\u0633\u06cc (\u0634\u06a9\u0627\u0641\u200c\u0647\u0627\u06cc \u0633\u06cc\u0627\u0633\u06cc\u060c \u0645\u062d\u062a\u0648\u0627\u06cc \u0642\u0637\u0628\u06cc\u200c\u06a9\u0646\u0646\u062f\u0647)"},"2":{"Display":"\u0628\u06cc\u200c\u062a\u0641\u0627\u0648\u062a\u06cc \u0639\u0645\u0648\u0645\u06cc (\u06a9\u0645\u0628\u0648\u062f \u062a\u0644\u0627\u0634\u060c \u0622\u06af\u0627\u0647\u06cc \u06a9\u0645)"},"3":{"Display":"\u0633\u0648\u0627\u062f \u0631\u0633\u0627\u0646\u0647\u200c\u0627\u06cc \u0648 \u062f\u06cc\u062c\u06cc\u062a\u0627\u0644\u06cc \u0636\u0639\u06cc\u0641 (\u0634\u06a9\u0627\u0641\u200c\u0647\u0627\u06cc \u0633\u0648\u0627\u062f \u0631\u0633\u0627\u0646\u0647\u200c\u0627\u06cc\u060c \u06a9\u0645\u0628\u0648\u062f \u0622\u0645\u0648\u0632\u0634)"},"4":{"Display":"\u0627\u0646\u06af\u06cc\u0632\u0647\u200c\u0647\u0627\u06cc \u0645\u0627\u0644\u06cc (\u0633\u0648\u062f \u0628\u0631\u062f\u0646 \u0627\u0632 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0646\u0627\u062f\u0631\u0633\u062a)"},"5":{"Display":"\u0646\u0641\u0648\u0630 \u062f\u0648\u0644\u062a (\u06a9\u0646\u062a\u0631\u0644 \u06cc\u0627 \u062f\u062e\u0627\u0644\u062a \u0628\u06cc\u0634 \u0627\u0632 \u062d\u062f \u062f\u0648\u0644\u062a)"},"6":{"Display":"\u0645\u062d\u062f\u0648\u062f\u06cc\u062a\u200c\u0647\u0627\u06cc \u0628\u0631\u0631\u0633\u06cc \u0648\u0627\u0642\u0639\u06cc\u062a (\u0639\u062f\u0645 \u0647\u0645\u0627\u0647\u0646\u06af\u06cc\u060c \u062a\u0644\u0627\u0634\u200c\u0647\u0627\u06cc \u06a9\u0645 \u0645\u0646\u0627\u0628\u0639)"},"7":{"Display":"\u0645\u0648\u0627\u0646\u0639 \u0641\u0631\u0647\u0646\u06af\u06cc \u0648 \u0632\u0628\u0627\u0646\u06cc (\u0634\u06a9\u0627\u0641\u200c\u0647\u0627\u06cc \u0627\u0631\u062a\u0628\u0627\u0637\u06cc \u062f\u0631 \u062c\u0648\u0627\u0645\u0639 \u0645\u062e\u062a\u0644\u0641)"},"8":{"Display":"\u0628\u06cc\u200c\u0627\u0639\u062a\u0645\u0627\u062f\u06cc \u0628\u0647 \u0646\u0647\u0627\u062f\u0647\u0627 (\u062f\u0648\u0644\u062a\u06cc \u06cc\u0627 \u062e\u0635\u0648\u0635\u06cc)"},"9":{"Display":"\u062f\u0633\u062a\u0648\u0631 \u06a9\u0627\u0631\u0647\u0627\u06cc \u0634\u0631\u06a9\u062a\u200c\u0647\u0627\/\u0631\u0633\u0627\u0646\u0647\u200c\u0647\u0627 (\u0646\u0641\u0648\u0630 \u0634\u0631\u06a9\u062a\u200c\u0647\u0627\u060c \u0645\u0646\u0627\u0641\u0639 \u0633\u06cc\u0627\u0633\u06cc \u0631\u0633\u0627\u0646\u0647\u200c\u0647\u0627\u06cc \u062e\u0628\u0631\u06cc)"},"10":{"Display":"\u0627\u06cc\u0646\u0641\u0644\u0648\u0626\u0646\u0633\u0631\u0647\u0627 \u0648 \u0633\u0644\u0628\u0631\u06cc\u062a\u06cc\u200c\u0647\u0627 (\u0646\u0642\u0634 \u0622\u0646\u0647\u0627 \u062f\u0631 \u062a\u0642\u0648\u06cc\u062a \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0646\u0627\u062f\u0631\u0633\u062a)"}},"Answers":{"1":{"Display":"\u0627\u0635\u0644\u0627 \u0686\u0627\u0644\u0634\u06cc \u062f\u0631 \u06a9\u0627\u0631 \u0646\u06cc\u0633\u062a"},"2":{"Display":"\u06cc\u06a9 \u0686\u0627\u0644\u0634 \u0639\u0638\u06cc\u0645"}}},"FR":{"QuestionText":"[Q26] Selon vous, <strong>dans quelle mesure chacune des mesures suivantes repr\u00e9sente-t-elle un d\u00e9fi<\/strong> <strong>pour<\/strong> <strong>lutter contre les contenus faux ou trompeurs<\/strong> ?<br> Veuillez noter de 1 (aucun d\u00e9fi du tout) \u00e0 7 (un \u00e9norme d\u00e9fi)<br>","Choices":{"1":{"Display":"Polarisation politique (divisions politiques, contenu polarisant)"},"2":{"Display":"D\u00e9sengagement du public (manque d\u2019effort, faible sensibilisation)"},"3":{"Display":"Faible niveau d&#39;\u00e9ducation aux m\u00e9dias et au num\u00e9rique (lacunes en mati\u00e8re d&#39;\u00e9ducation aux m\u00e9dias, manque d&#39;\u00e9ducation)"},"4":{"Display":"Incitations financi\u00e8res (profiter de la d\u00e9sinformation)"},"5":{"Display":"Influence du gouvernement (contr\u00f4le ou ing\u00e9rence excessifs de l&#39;\u00c9tat)"},"6":{"Display":"Limites de la v\u00e9rification des faits (manque de coordination, efforts sous-financ\u00e9s)"},"7":{"Display":"Barri\u00e8res culturelles et linguistiques (lacunes de communication entre les communaut\u00e9s)"},"8":{"Display":"M\u00e9fiance envers les institutions (publiques ou priv\u00e9es)"},"9":{"Display":"Agendas des entreprises\/m\u00e9dias (influence des entreprises, int\u00e9r\u00eats politiques des m\u00e9dias)"},"10":{"Display":"Influenceurs et c\u00e9l\u00e9brit\u00e9s (leur r\u00f4le dans l&#39;amplification de la d\u00e9sinformation)"}},"Answers":{"1":{"Display":"Aucun d\u00e9fi du tout"},"2":{"Display":"Un d\u00e9fi de taille"}}},"HU":{"QuestionText":"[26. k\u00e9rd\u00e9s] <strong>Mekkora kih\u00edv\u00e1st<\/strong> jelent \u00d6nnek a k\u00f6vetkez\u0151k mindegyike <strong>a hamis vagy f\u00e9lrevezet\u0151 tartalmak kezel\u00e9s\u00e9ben<\/strong> <strong>?<\/strong><br> K\u00e9rlek, \u00e9rt\u00e9kelj 1-t\u0151l (Egy\u00e1ltal\u00e1n nem jelent kih\u00edv\u00e1st) 7-ig (Hatalmas kih\u00edv\u00e1s).<br>","Choices":{"1":{"Display":"Politikai polariz\u00e1ci\u00f3 (politikai megosztotts\u00e1g, polariz\u00e1l\u00f3 tartalom)"},"2":{"Display":"Nyilv\u00e1nos elz\u00e1rk\u00f3z\u00e1s (er\u0151fesz\u00edt\u00e9sek hi\u00e1nya, alacsony tudatoss\u00e1g)"},"3":{"Display":"Gyenge m\u00e9dia- \u00e9s digit\u00e1lis j\u00e1rtass\u00e1g (m\u00e9diaj\u00e1rtass\u00e1gi hi\u00e1nyoss\u00e1gok, oktat\u00e1s hi\u00e1nya)"},"4":{"Display":"P\u00e9nz\u00fcgyi \u00f6szt\u00f6nz\u0151k (a f\u00e9lret\u00e1j\u00e9koztat\u00e1sb\u00f3l sz\u00e1rmaz\u00f3 haszonszerz\u00e9s)"},"5":{"Display":"Korm\u00e1nyzati befoly\u00e1s (t\u00falzott \u00e1llami ellen\u0151rz\u00e9s vagy beavatkoz\u00e1s)"},"6":{"Display":"T\u00e9nyellen\u0151rz\u00e9si korl\u00e1tok (koordin\u00e1ci\u00f3 hi\u00e1nya, alulfinansz\u00edrozott er\u0151fesz\u00edt\u00e9sek)"},"7":{"Display":"Kultur\u00e1lis \u00e9s nyelvi akad\u00e1lyok (kommunik\u00e1ci\u00f3s hi\u00e1nyoss\u00e1gok a k\u00f6z\u00f6ss\u00e9gek k\u00f6z\u00f6tt)"},"8":{"Display":"Bizalmatlans\u00e1g az int\u00e9zm\u00e9nyekkel (\u00e1llami vagy mag\u00e1n) szemben"},"9":{"Display":"V\u00e1llalati\/m\u00e9dia-programok (v\u00e1llalati befoly\u00e1s, m\u00e9diaorg\u00e1numok politikai \u00e9rdekei)"},"10":{"Display":"Influenszerek \u00e9s h\u00edress\u00e9gek (szerep\u00fck a f\u00e9lret\u00e1j\u00e9koztat\u00e1s feler\u0151s\u00edt\u00e9s\u00e9ben)"}},"Answers":{"1":{"Display":"Semmi kih\u00edv\u00e1s"},"2":{"Display":"Egy hatalmas kih\u00edv\u00e1s"}}},"IT":{"QuestionText":"[Q26] <strong>Quanto ritieni che sia difficile<\/strong> affrontare ciascuno dei seguenti aspetti <strong>nel<\/strong> <strong>contrastare i contenuti falsi o fuorvianti<\/strong> ?<br> Si prega di valutare da 1 (Nessuna sfida) a 7 (Una sfida enorme)<br>","Choices":{"1":{"Display":"Polarizzazione politica (divisioni politiche, contenuti polarizzanti)"},"2":{"Display":"Disimpegno pubblico (mancanza di impegno, scarsa consapevolezza)"},"3":{"Display":"Debole alfabetizzazione mediatica e digitale (lacune nell&#39;alfabetizzazione mediatica, mancanza di istruzione)"},"4":{"Display":"Incentivi finanziari (profitto derivante dalla disinformazione)"},"5":{"Display":"Influenza del governo (eccessivo controllo o interferenza statale)"},"6":{"Display":"Limitazioni del fact-checking (mancanza di coordinamento, sforzi con risorse insufficienti)"},"7":{"Display":"Barriere culturali e linguistiche (lacune di comunicazione tra le comunit\u00e0)"},"8":{"Display":"Sfiducia nelle istituzioni (pubbliche o private)"},"9":{"Display":"Agende aziendali\/mediatiche (influenza aziendale, interessi politici dei media)"},"10":{"Display":"Influencer e celebrit\u00e0 (il loro ruolo nell&#39;amplificazione della disinformazione)"}},"Answers":{"1":{"Display":"Nessuna sfida"},"2":{"Display":"Una sfida enorme"}}},"KAT":{"QuestionText":"[Q26] <strong>\u10e0\u10d0\u10db\u10d3\u10d4\u10dc\u10d0\u10d3 \u10d3\u10d8\u10d3 \u10e1\u10d8\u10e0\u10d7\u10e3\u10da\u10d4\u10e1<\/strong> \u10ec\u10d0\u10e0\u10db\u10dd\u10d0\u10d3\u10d2\u10d4\u10dc\u10e1 \u10e5\u10d5\u10d4\u10db\u10dd\u10d7 \u10e9\u10d0\u10db\u10dd\u10d7\u10d5\u10da\u10d8\u10da\u10d8 \u10d7\u10d8\u10d7\u10dd\u10d4\u10e3\u10da\u10d8 \u10e1\u10d0\u10d9\u10d8\u10d7\u10ee\u10d8 <strong>\u10ea\u10e0\u10e3 \u10d0\u10dc \u10e8\u10d4\u10ea\u10d3\u10dd\u10db\u10d0\u10e8\u10d8 \u10e8\u10d4\u10db\u10e7\u10d5\u10d0\u10dc\u10d8 \u10d9\u10dd\u10dc\u10e2\u10d4\u10dc\u10e2\u10d8\u10e1 \u10ec\u10d8\u10dc\u10d0\u10d0\u10e6\u10db\u10d3\u10d4\u10d2 \u10d1\u10e0\u10eb\u10dd\u10da\u10d0\u10e8\u10d8<\/strong> <strong>?<\/strong><br> \u10d2\u10d7\u10ee\u10dd\u10d5\u10d7, \u10e8\u10d4\u10d0\u10e4\u10d0\u10e1\u10dd\u10d7 1-\u10d3\u10d0\u10dc (\u10e1\u10d0\u10d4\u10e0\u10d7\u10dd\u10d3 \u10d0\u10e0\u10d0\u10dc\u10d0\u10d8\u10e0\u10d8 \u10d2\u10d0\u10db\u10dd\u10ec\u10d5\u10d4\u10d5\u10d0) 7-\u10db\u10d3\u10d4 (\u10d3\u10d8\u10d3\u10d8 \u10d2\u10d0\u10db\u10dd\u10ec\u10d5\u10d4\u10d5\u10d0)<br>","Choices":{"1":{"Display":"\u10de\u10dd\u10da\u10d8\u10e2\u10d8\u10d9\u10e3\u10e0\u10d8 \u10de\u10dd\u10da\u10d0\u10e0\u10d8\u10d6\u10d0\u10ea\u10d8\u10d0 (\u10de\u10dd\u10da\u10d8\u10e2\u10d8\u10d9\u10e3\u10e0\u10d8 \u10e3\u10d7\u10d0\u10dc\u10ee\u10db\u10dd\u10d4\u10d1\u10d0, \u10de\u10dd\u10da\u10d0\u10e0\u10d8\u10d6\u10d4\u10d1\u10e3\u10da\u10d8 \u10e8\u10d8\u10dc\u10d0\u10d0\u10e0\u10e1\u10d8)"},"2":{"Display":"\u10e1\u10d0\u10d6\u10dd\u10d2\u10d0\u10d3\u10dd\u10d4\u10d1\u10d8\u10e1 \u10e9\u10d0\u10e0\u10d7\u10e3\u10da\u10dd\u10d1\u10d8\u10e1 \u10dc\u10d0\u10d9\u10da\u10d4\u10d1\u10dd\u10d1\u10d0 (\u10eb\u10d0\u10da\u10d8\u10e1\u10ee\u10db\u10d4\u10d5\u10d8\u10e1 \u10dc\u10d0\u10d9\u10da\u10d4\u10d1\u10dd\u10d1\u10d0, \u10d3\u10d0\u10d1\u10d0\u10da\u10d8 \u10ea\u10dc\u10dd\u10d1\u10d8\u10d4\u10e0\u10d4\u10d1\u10d0)"},"3":{"Display":"\u10e1\u10e3\u10e1\u10e2\u10d8 \u10db\u10d4\u10d3\u10d8\u10d0 \u10d3\u10d0 \u10ea\u10d8\u10e4\u10e0\u10e3\u10da\u10d8 \u10ec\u10d8\u10d2\u10dc\u10d8\u10d4\u10e0\u10d4\u10d1\u10d0 (\u10db\u10d4\u10d3\u10d8\u10d0\u10ec\u10d8\u10d2\u10dc\u10d8\u10d4\u10e0\u10d4\u10d1\u10d8\u10e1 \u10ee\u10d0\u10e0\u10d5\u10d4\u10d6\u10d4\u10d1\u10d8, \u10d2\u10d0\u10dc\u10d0\u10d7\u10da\u10d4\u10d1\u10d8\u10e1 \u10dc\u10d0\u10d9\u10da\u10d4\u10d1\u10dd\u10d1\u10d0)"},"4":{"Display":"\u10e4\u10d8\u10dc\u10d0\u10dc\u10e1\u10e3\u10e0\u10d8 \u10ec\u10d0\u10ee\u10d0\u10da\u10d8\u10e1\u10d4\u10d1\u10d0 (\u10d3\u10d4\u10d6\u10d8\u10dc\u10e4\u10dd\u10e0\u10db\u10d0\u10ea\u10d8\u10d8\u10d7 \u10db\u10dd\u10d2\u10d4\u10d1\u10d8\u10e1 \u10db\u10d8\u10e6\u10d4\u10d1\u10d0)"},"5":{"Display":"\u10db\u10d7\u10d0\u10d5\u10e0\u10dd\u10d1\u10d8\u10e1 \u10d2\u10d0\u10d5\u10da\u10d4\u10dc\u10d0 (\u10e1\u10d0\u10ee\u10d4\u10da\u10db\u10ec\u10d8\u10e4\u10dd \u10d9\u10dd\u10dc\u10e2\u10e0\u10dd\u10da\u10d8 \u10d0\u10dc \u10e9\u10d0\u10e0\u10d4\u10d5\u10d0 \u10d2\u10d0\u10d3\u10d0\u10ed\u10d0\u10e0\u10d1\u10d4\u10d1\u10e3\u10da\u10d8)"},"6":{"Display":"\u10e4\u10d0\u10e5\u10e2\u10d4\