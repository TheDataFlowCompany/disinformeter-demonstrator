u043b\u0438\u0440\u0430\u043d\u043e \u043e\u0442 \u0447\u0443\u0436\u0434\u0435\u0441\u0442\u0440\u0430\u043d\u043d\u0438 \u0432\u0440\u0430\u0436\u0434\u0435\u0431\u043d\u0438 \u0434\u044a\u0440\u0436\u0430\u0432\u0438. \u041a\u044a\u0434\u0435\u0442\u043e 1 = \u201e\u0442\u043e\u0432\u0430 \u0437\u0430\u0433\u043b\u0430\u0432\u0438\u0435 \u0441\u044a\u0441 \u0441\u0438\u0433\u0443\u0440\u043d\u043e\u0441\u0442 \u041d\u0415 \u0435 \u043c\u0430\u043d\u0438\u043f\u0443\u043b\u0438\u0440\u0430\u043d\u043e\u201c, 7 = \u201e\u0442\u043e\u0432\u0430 \u0437\u0430\u0433\u043b\u0430\u0432\u0438\u0435 \u0441\u044a\u0441 \u0441\u0438\u0433\u0443\u0440\u043d\u043e\u0441\u0442 \u0435 \u043c\u0430\u043d\u0438\u043f\u0443\u043b\u0438\u0440\u0430\u043d\u043e\u201c","Choices":{"1":{"Display":"\u0417\u0435\u043b\u0435\u043d\u0441\u043a\u0438 \u043a\u0443\u043f\u0438 \u0431\u0440\u0438\u0442\u0430\u043d\u0441\u043a\u043e \u0438\u043c\u0435\u043d\u0438\u0435 \u043e\u0442 \u043a\u0440\u0430\u043b \u0427\u0430\u0440\u043b\u0437 \u0437\u0430 20 \u043c\u0438\u043b\u0438\u043e\u043d\u0430 \u043f\u0430\u0443\u043d\u0434\u0430"},"2":{"Display":"\u0424\u0440\u0430\u043d\u0446\u0438\u044f \u043f\u043e\u0438\u0441\u043a\u0430 \u043e\u0442 \u0420\u0443\u0441\u0438\u044f \u0434\u0430 \u043d\u0435 \u0434\u043e\u043a\u043e\u0441\u0432\u0430 \u0444\u0440\u0435\u043d\u0441\u043a\u0438\u0442\u0435 \u0432\u043e\u0435\u043d\u043d\u0438 \u0432 \u0423\u043a\u0440\u0430\u0439\u043d\u0430"},"3":{"Display":"\u041e\u043b\u0438\u043c\u043f\u0438\u0439\u0441\u043a\u0438\u0442\u0435 \u0438 \u041f\u0430\u0440\u0430\u043e\u043b\u0438\u043c\u043f\u0438\u0439\u0441\u043a\u0438\u0442\u0435 \u0438\u0433\u0440\u0438 \u041c\u0438\u043b\u0430\u043d\u043e-\u041a\u043e\u0440\u0442\u0438\u043d\u0430 \u0434&#39;\u0410\u043c\u043f\u0435\u0446\u043e \u043f\u0440\u0435\u0437 2026 \u0433. \u0449\u0435 \u0431\u044a\u0434\u0430\u0442 \u043e\u0442\u043a\u0440\u0438\u0442\u043e \u041b\u0413\u0411\u0422+"},"4":{"Display":"\u0423\u043a\u0440\u0430\u0438\u043d\u0441\u043a\u0430\u0442\u0430 \u0430\u0440\u043c\u0438\u044f \u0442\u044a\u0440\u0441\u0438 \u043c\u0435\u043d\u0442\u043e\u0440 \u043f\u043e \u0442\u043e\u043b\u0435\u0440\u0430\u043d\u0442\u043d\u043e\u0441\u0442, \u0440\u0430\u0431\u043e\u0442\u0435\u0449 \u0441 \u0432\u043e\u0439\u0441\u043a\u0438 \u043d\u0430 \u0444\u0440\u043e\u043d\u0442\u043e\u0432\u0430\u0442\u0430 \u043b\u0438\u043d\u0438\u044f"},"5":{"Display":"\u0413\u0435\u0439\u043e\u0432\u0435 \u0438 \u0442\u0440\u0430\u0432\u0435\u0441\u0442\u0438\u0442\u0438 \u0432 \u041a\u0438\u0435\u0432 \u0441\u0430 \u043f\u043e\u043a\u0430\u043d\u0435\u043d\u0438 \u0434\u0430 \u0441\u0435 \u043f\u0440\u0438\u0441\u044a\u0435\u0434\u0438\u043d\u044f\u0442 \u043a\u044a\u043c \u041b\u0413\u0411\u0422 \u0432\u043e\u0435\u043d\u043d\u0438 \u0431\u0440\u0438\u0433\u0430\u0434\u0438"},"6":{"Display":"\u041b\u0438-\u041c\u0435\u043d\u0433 \u042f\u043d, \u043a\u0438\u0442\u0430\u0439\u0441\u043a\u0438 \u0432\u0438\u0440\u0443\u0441\u043e\u043b\u043e\u0433, \u043a\u043e\u0439\u0442\u043e \u0442\u0432\u044a\u0440\u0434\u0438, \u0447\u0435 \u0432\u0438\u0440\u0443\u0441\u044a\u0442 COVID-19 \u043f\u0440\u043e\u0438\u0437\u0445\u043e\u0436\u0434\u0430 \u043e\u0442 \u043a\u0438\u0442\u0430\u0439\u0441\u043a\u0430 \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u0441\u0442\u0432\u0435\u043d\u0430 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u0438\u044f, \u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d \u043a\u0430\u0442\u043e \u0440\u0430\u0437\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0438\u0442\u0435\u043b \u043d\u0430 \u0441\u043b\u0443\u0445\u043e\u0432\u0435."},"7":{"Display":"CGTN: \u041f\u043e-\u0442\u0435\u0441\u043d\u0438\u0442\u0435 \u043c\u0435\u0436\u0434\u0443\u043b\u0438\u0447\u043d\u043e\u0441\u0442\u043d\u0438 \u0432\u0440\u044a\u0437\u043a\u0438 \u043d\u0430\u0441\u044a\u0440\u0447\u0430\u0432\u0430\u0442 \u043f\u0440\u0438\u044f\u0442\u0435\u043b\u0441\u0442\u0432\u043e\u0442\u043e \u043c\u0435\u0436\u0434\u0443 \u041a\u0438\u0442\u0430\u0439 \u0438 \u0412\u0438\u0435\u0442\u043d\u0430\u043c"},"8":{"Display":"\u041f\u043e\u0434\u043e\u0431\u043d\u043e\u0442\u043e \u043d\u0430 \u0447\u0443\u043c\u0430 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043d\u0430 \u043a\u0440\u0430\u0439\u043d\u043e\u0434\u0435\u0441\u043d\u0438\u044f \u0440\u0435\u043b\u0438\u0433\u0438\u043e\u0437\u0435\u043d \u043b\u0438\u0434\u0435\u0440 \u041b\u0438 \u0425\u043e\u043d\u0433\u0434\u0436\u044a \u0435 \u0437\u0430\u0431\u0440\u0430\u043d\u0435\u043d\u043e \u0432 \u041a\u0438\u0442\u0430\u0439"}},"Answers":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7"}},"Labels":{"1":{"Display":"\u0422\u043e\u0432\u0430 \u0437\u0430\u0433\u043b\u0430\u0432\u0438\u0435 \u0441\u044a\u0441 \u0441\u0438\u0433\u0443\u0440\u043d\u043e\u0441\u0442 \u041d\u0415 \u0435 \u043c\u0430\u043d\u0438\u043f\u0443\u043b\u0438\u0440\u0430\u043d\u043e"},"2":{"Display":"\u0422\u043e\u0432\u0430 \u0437\u0430\u0433\u043b\u0430\u0432\u0438\u0435 \u0441\u044a\u0441 \u0441\u0438\u0433\u0443\u0440\u043d\u043e\u0441\u0442 \u0435 \u043c\u0430\u043d\u0438\u043f\u0443\u043b\u0438\u0440\u0430\u043d\u043e"}}},"FA":{"QuestionText":"[\u0633\u0648\u0627\u0644 \u06f9] \u0627\u06a9\u0646\u0648\u0646\u060c \u0686\u0646\u062f\u06cc\u0646 \u062a\u06cc\u062a\u0631 \u062e\u0628\u0631\u06cc \u0628\u0647 \u0634\u0645\u0627 \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f. \u0627\u0631\u0632\u06cc\u0627\u0628\u06cc \u06a9\u0646\u06cc\u062f \u06a9\u0647 \u0686\u0642\u062f\u0631 \u0627\u062d\u062a\u0645\u0627\u0644 \u062f\u0627\u0631\u062f \u0627\u06cc\u0646 \u062a\u06cc\u062a\u0631 \u062a\u0648\u0633\u0637 \u06a9\u0634\u0648\u0631\u0647\u0627\u06cc \u0645\u062a\u062e\u0627\u0635\u0645 \u062e\u0627\u0631\u062c\u06cc \u062f\u0633\u062a\u06a9\u0627\u0631\u06cc \u0634\u062f\u0647 \u0628\u0627\u0634\u062f. \u06a9\u0647 \u062f\u0631 \u0622\u0646 \u06f1 = \u00ab\u0627\u06cc\u0646 \u062a\u06cc\u062a\u0631 \u0642\u0637\u0639\u0627\u064b \u062f\u0633\u062a\u06a9\u0627\u0631\u06cc \u0646\u0634\u062f\u0647 \u0627\u0633\u062a\u00bb\u060c \u06f7 = \u00ab\u0627\u06cc\u0646 \u062a\u06cc\u062a\u0631 \u0642\u0637\u0639\u0627\u064b \u062f\u0633\u062a\u06a9\u0627\u0631\u06cc \u0634\u062f\u0647 \u0627\u0633\u062a\u00bb","Choices":{"1":{"Display":"\u0632\u0644\u0646\u0633\u06a9\u06cc \u0639\u0645\u0627\u0631\u062a\u06cc \u0628\u0631\u06cc\u062a\u0627\u0646\u06cc\u0627\u06cc\u06cc \u0631\u0627 \u0627\u0632 \u0634\u0627\u0647 \u0686\u0627\u0631\u0644\u0632 \u0628\u0647 \u0642\u06cc\u0645\u062a \u06f2\u06f0 \u0645\u06cc\u0644\u06cc\u0648\u0646 \u067e\u0648\u0646\u062f \u062e\u0631\u06cc\u062f\u0627\u0631\u06cc \u06a9\u0631\u062f"},"2":{"Display":"\u0641\u0631\u0627\u0646\u0633\u0647 \u0627\u0632 \u0631\u0648\u0633\u06cc\u0647 \u062e\u0648\u0627\u0633\u062a \u0628\u0647 \u0646\u0638\u0627\u0645\u06cc\u0627\u0646 \u0641\u0631\u0627\u0646\u0633\u0648\u06cc \u0645\u0633\u062a\u0642\u0631 \u062f\u0631 \u0627\u0648\u06a9\u0631\u0627\u06cc\u0646 \u0622\u0633\u06cc\u0628\u06cc \u0646\u0631\u0633\u0627\u0646\u062f"},"3":{"Display":"\u0627\u0644\u0645\u067e\u06cc\u06a9 \u0648 \u067e\u0627\u0631\u0627\u0644\u0645\u067e\u06cc\u06a9 \u0645\u06cc\u0644\u0627\u0646-\u06a9\u0648\u0631\u062a\u06cc\u0646\u0627 \u062f\u0627\u0645\u067e\u062a\u0632\u0648 \u06f2\u06f0\u06f2\u06f6 \u0622\u0634\u06a9\u0627\u0631\u0627 \u0645\u062a\u0639\u0644\u0642 \u0628\u0647 \u0627\u0641\u0631\u0627\u062f LGBT+ \u062e\u0648\u0627\u0647\u062f \u0628\u0648\u062f."},"4":{"Display":"\u0627\u0631\u062a\u0634 \u0627\u0648\u06a9\u0631\u0627\u06cc\u0646 \u0628\u0647 \u062f\u0646\u0628\u0627\u0644 \u0645\u0631\u0628\u06cc\u200c\u0627\u06cc \u0628\u0631\u0627\u06cc \u0622\u0645\u0648\u0632\u0634 \u0645\u062f\u0627\u0631\u0627 \u0628\u0627 \u0646\u06cc\u0631\u0648\u0647\u0627\u06cc \u062e\u0637 \u0645\u0642\u062f\u0645 \u0627\u0633\u062a"},"5":{"Display":"\u0627\u0632 \u0647\u0645\u062c\u0646\u0633\u06af\u0631\u0627\u06cc\u0627\u0646 \u0648 \u062a\u0631\u0627\u062c\u0646\u0633\u06cc\u062a\u06cc\u200c\u0647\u0627 \u062f\u0631 \u06a9\u06cc\u0641 \u062f\u0639\u0648\u062a \u0645\u06cc\u200c\u0634\u0648\u062f \u062a\u0627 \u0628\u0647 \u062a\u06cc\u067e\u200c\u0647\u0627\u06cc \u0646\u0638\u0627\u0645\u06cc LGBT \u0628\u067e\u06cc\u0648\u0646\u062f\u0646\u062f."},"6":{"Display":"\u0644\u06cc-\u0645\u0646\u06af \u06cc\u0627\u0646\u060c \u0648\u06cc\u0631\u0648\u0633\u200c\u0634\u0646\u0627\u0633 \u0686\u06cc\u0646\u06cc \u06a9\u0647 \u0627\u062f\u0639\u0627 \u0645\u06cc\u200c\u06a9\u0646\u062f \u0648\u06cc\u0631\u0648\u0633 \u06a9\u0648\u0648\u06cc\u062f-\u06f1\u06f9 \u0627\u0632 \u06cc\u06a9 \u0622\u0632\u0645\u0627\u06cc\u0634\u06af\u0627\u0647 \u062f\u0648\u0644\u062a\u06cc \u0686\u06cc\u0646 \u0633\u0631\u0686\u0634\u0645\u0647 \u06af\u0631\u0641\u062a\u0647\u060c \u0628\u0647 \u0634\u0627\u06cc\u0639\u0647\u200c\u067e\u0631\u0627\u06a9\u0646\u06cc \u0645\u0639\u0631\u0648\u0641 \u0627\u0633\u062a."},"7":{"Display":"CGTN: \u067e\u06cc\u0648\u0646\u062f\u0647\u0627\u06cc \u0646\u0632\u062f\u06cc\u06a9\u200c\u062a\u0631 \u0645\u0631\u062f\u0645\u06cc\u060c \u062f\u0648\u0633\u062a\u06cc \u0686\u06cc\u0646 \u0648 \u0648\u06cc\u062a\u0646\u0627\u0645 \u0631\u0627 \u062a\u0642\u0648\u06cc\u062a \u0645\u06cc\u200c\u06a9\u0646\u062f"},"8":{"Display":"\u062d\u06a9\u0648\u0645\u062a \u0637\u0627\u0639\u0648\u0646\u200c\u0645\u0627\u0646\u0646\u062f \u0644\u06cc \u0647\u0646\u06af\u062c\u06cc\u060c \u0631\u0647\u0628\u0631 \u0645\u0630\u0647\u0628\u06cc \u0631\u0627\u0633\u062a \u0627\u0641\u0631\u0627\u0637\u06cc\u060c \u062f\u0631 \u0686\u06cc\u0646 \u0645\u0645\u0646\u0648\u0639 \u0634\u062f."}},"Answers":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7"}},"Labels":{"1":{"Display":"\u0627\u06cc\u0646 \u062a\u06cc\u062a\u0631 \u0642\u0637\u0639\u0627\u064b \u062f\u0633\u062a\u06a9\u0627\u0631\u06cc \u0646\u0634\u062f\u0647 \u0627\u0633\u062a"},"2":{"Display":"\u0627\u06cc\u0646 \u062a\u06cc\u062a\u0631 \u0642\u0637\u0639\u0627\u064b \u062f\u0633\u062a\u06a9\u0627\u0631\u06cc \u0634\u062f\u0647 \u0627\u0633\u062a"}}},"UK":{"QuestionText":"[Q9] \u0422\u0435\u043f\u0435\u0440 \u0432\u0430\u043c \u0431\u0443\u0434\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043e \u043a\u0456\u043b\u044c\u043a\u0430 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u0456\u0432 \u043d\u043e\u0432\u0438\u043d. \u041e\u0446\u0456\u043d\u0456\u0442\u044c, \u043d\u0430\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u0439\u043c\u043e\u0432\u0456\u0440\u043d\u043e, \u0449\u043e \u0446\u0435\u0439 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a \u043c\u0430\u043d\u0456\u043f\u0443\u043b\u044c\u043e\u0432\u0430\u043d\u0438\u0439 \u0456\u043d\u043e\u0437\u0435\u043c\u043d\u0438\u043c\u0438 \u0432\u043e\u0440\u043e\u0436\u0438\u043c\u0438 \u043a\u0440\u0430\u0457\u043d\u0430\u043c\u0438. \u0414\u0435 1 = \u00ab\u0446\u0435\u0439 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a \u0442\u043e\u0447\u043d\u043e \u041d\u0415 \u043c\u0430\u043d\u0456\u043f\u0443\u043b\u044c\u043e\u0432\u0430\u043d\u0438\u0439\u00bb, 7 = \u00ab\u0446\u0435\u0439 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a \u0442\u043e\u0447\u043d\u043e \u043c\u0430\u043d\u0456\u043f\u0443\u043b\u044c\u043e\u0432\u0430\u043d\u0438\u0439\u00bb","Choices":{"1":{"Display":"\u0417\u0435\u043b\u0435\u043d\u0441\u044c\u043a\u0438\u0439 \u043a\u0443\u043f\u0438\u0432 \u0431\u0440\u0438\u0442\u0430\u043d\u0441\u044c\u043a\u0438\u0439 \u043e\u0441\u043e\u0431\u043d\u044f\u043a \u0443 \u043a\u043e\u0440\u043e\u043b\u044f \u0427\u0430\u0440\u043b\u044c\u0437\u0430 \u0437\u0430 20 \u043c\u0456\u043b\u044c\u0439\u043e\u043d\u0456\u0432 \u0444\u0443\u043d\u0442\u0456\