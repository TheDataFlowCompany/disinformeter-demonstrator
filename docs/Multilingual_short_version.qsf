a\u0443, <strong>\u043a\u043e\u043b\u0438\u043a\u043e \u0431\u0438 \u0441\u0432\u0430\u043a\u0438 \u043e\u0434 \u0430\u043a\u0442\u0435\u0440\u0430 \u0442\u0440\u0435\u0431\u0430\u043b\u043e \u0434\u0430 \u0431\u0443\u0434\u0435 \u043e\u0434\u0433\u043e\u0432\u043e\u0440\u0430\u043d<\/strong> \u0437\u0430 <strong>\u0441\u043f\u0440\u0435\u0447\u0430\u0432\u0430\u045a\u0435 \u0448\u0438\u0440\u0435\u045a\u0430 \u043b\u0430\u0436\u043d\u043e\u0433 \u0438\u043b\u0438 \u043e\u0431\u043c\u0430\u045a\u0443\u0458\u0443\u045b\u0435\u0433 \u0441\u0430\u0434\u0440\u0436\u0430\u0458\u0430<\/strong>?<br \/>\n\u041c\u043e\u043b\u0438\u043c\u043e \u0432\u0430\u0441 \u0434\u0430 \u043e\u0446\u0435\u043d\u0438\u0442\u0435 \u043e\u0434 1 (<meta charset=\"UTF-8\" \/>\u041d\u0435\u043c\u0430 \u043d\u0438\u043a\u0430\u043a\u0432\u0435 \u043e\u0434\u0433\u043e\u0432\u043e\u0440\u043d\u043e\u0441\u0442\u0438) \u0434\u043e 7 (<meta charset=\"UTF-8\" \/>\u0412\u0435\u043b\u0438\u043a\u0430 \u043e\u0434\u0433\u043e\u0432\u043e\u0440\u043d\u043e\u0441\u0442)","Choices":{"1":{"Display":"\u0428\u0438\u0440\u0430 \u0458\u0430\u0432\u043d\u043e\u0441\u0442"},"2":{"Display":"\u0412\u043b\u0430\u0434\u0430 \u0438 \u0438\u0437\u0430\u0431\u0440\u0430\u043d\u0438 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0438\u0446\u0438"},"3":{"Display":"\u0408\u0430\u0432\u043d\u0435 \u0438\/\u0438\u043b\u0438 \u043b\u043e\u043a\u0430\u043b\u043d\u0435 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0446\u0438\u0458\u0435"},"4":{"Display":"\u041c\u0435\u0452\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0435 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0446\u0438\u0458\u0435"},"5":{"Display":"\u0423\u0440\u0435\u0434\u043d\u0438\u0446\u0438 \u0438 \u043d\u043e\u0432\u0438\u043d\u0430\u0440\u0438"},"6":{"Display":"<meta charset=\"UTF-8\" \/>\u041f\u0440\u043e\u0444\u0435\u0441\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u0441\u0442\u0440\u0443\u0447\u045a\u0430\u0446\u0438 \u0437\u0430 \u043f\u0440\u043e\u0432\u0435\u0440