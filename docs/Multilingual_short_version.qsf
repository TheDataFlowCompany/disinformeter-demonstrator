e\u0627\u0644\u0641"},"5":{"Display":"\u062a\u0627 \u062d\u062f\u0648\u062f\u06cc \u0645\u0648\u0627\u0641\u0642\u0645"},"6":{"Display":"\u0645\u0648\u0627\u0641\u0642"},"7":{"Display":"\u06a9\u0627\u0645\u0644\u0627\u064b \u0645\u0648\u0627\u0641\u0642\u0645"}}},"FR":{"QuestionText":"[Q10.5] Il vous sera maintenant demand\u00e9 d&#39;indiquer dans quelle mesure vous \u00eates d&#39;accord avec les affirmations suivantes, o\u00f9 1 = Tout \u00e0 fait en d\u00e9saccord et 7 = Tout \u00e0 fait d&#39;accord (\u00e9chelle de 1 \u00e0 7)","Choices":{"1":{"Display":"Dans une certaine mesure, j&#39;admire la Russie"},"2":{"Display":"Parfois, je me sens inspir\u00e9 par la Russie"},"3":{"Display":"La Russie me donne de l&#39;espoir"}},"Answers":{"1":{"Display":"Fortement en d\u00e9saccord"},"2":{"Display":"\u00catre en d\u00e9saccord"},"3":{"Display":"Plut\u00f4t en d\u00e9saccord"},"4":{"Display":"Ni d&#39;accord ni en d\u00e9saccord"},"5":{"Display":"Plut\u00f4t d&#39;accord"},"6":{"Display":"Accepter"},"7":{"Display":"Tout \u00e0 fait d&#39;accord"}}},"HU":{"QuestionText":"[10.5. k\u00e9rd\u00e9s] Most arra kell majd jeleznie, hogy mennyire \u00e9rt egyet a k\u00f6vetkez\u0151 \u00e1ll\u00edt\u00e1sokkal, ahol 1 = Hat\u00e1rozottan nem \u00e9rtek egyet \u00e9s 7 = Hat\u00e1rozottan egyet\u00e9rtek (1-7-es sk\u00e1l\u00e1n)","Choices":{"1":{"Display":"Bizonyos m\u00e9rt\u00e9kig csod\u00e1lom Oroszorsz\u00e1got"},"2":{"Display":"N\u00e9ha \u00fagy \u00e9rzem, hogy Oroszorsz\u00e1g inspir\u00e1l."},"3":{"Display":"Oroszorsz\u00e1g rem\u00e9nyt ad nekem"}},"Answers":{"1":{"Display":"Hat\u00e1rozottan nem \u00e9rtek egyet"},"2":{"Display":"Nem \u00e9rt egyet"},"3":{"Display":"Kiss\u00e9 nem \u00e9rtek egyet"},"4":{"Display":"Sem egyet\u00e9rt\u00e9s, sem ellentmond\u00e1s"},"5":{"Display":"R\u00e9szben egyet\u00e9rtek"},"6":{"Display":"Egyet\u00e9rt"},"7":{"Display":"Teljesen egyet\u00e9rtek"}}},"IT":{"QuestionText":"[Q10.5] Ora ti verr\u00e0 chiesto di indicare il tuo grado di accordo con le seguenti affermazioni, dove 1 = Fortemente in disaccordo e 7 = Fortemente d&#39;accordo (scala da 1 a 7)","Choices":{"1":{"Display":"In una certa misura ammiro la Russia"},"2":{"Display":"A volte mi sento ispirato dalla Russia"},"3":{"Display":"La Russia mi d\u00e0 speranza"}},"Answers":{"1":{"Display":"Fortemente in disaccordo"},"2":{"Display":"Non sono d&#39;accordo"},"3":{"Display":"Un po&#39; in disaccordo"},"4":{"Display":"N\u00e9 d&#39;accordo n\u00e9 in disaccordo"},"5":{"Display":"Abbastanza d&#39;accordo"},"6":{"Display":"Essere d&#39;accordo"},"7":{"Display":"Sono assolutamente d&#39;accordo"}}},"KAT":{"QuestionText":"[Q10.5] \u10d0\u10ee\u10da\u10d0 \u10d7\u10e5\u10d5\u10d4\u10dc \u10db\u10dd\u10d2\u10d4\u10d7\u10ee\u10dd\u10d5\u10d4\u10d1\u10d0\u10d7 \u10db\u10d8\u10e3\u10d7\u10d8\u10d7\u10dd\u10d7 \u10d7\u10e5\u10d5\u10d4\u10dc\u10d8 \u10d7\u10d0\u10dc\u10ee\u10db\u10dd\u10d1\u10d8\u10e1 \u10ee\u10d0\u10e0\u10d8\u10e1\u10ee\u10d8 \u10e8\u10d4\u10db\u10d3\u10d4\u10d2 \u10d2\u10d0\u10dc\u10ea\u10ee\u10d0\u10d3\u10d4\u10d1\u10d4\u10d1\u10d7\u10d0\u10dc, \u10e1\u10d0\u10d3\u10d0\u10ea 1 = \u10d9\u10d0\u10e2\u10d4\u10d2\u10dd\u10e0\u10d8\u10e3\u10da\u10d0\u10d3 \u10d0\u10e0 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8 \u10d3\u10d0 7 = \u10e1\u10e0\u10e3\u10da\u10d8\u10d0\u10d3 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8 (1-7 \u10e8\u10d9\u10d0\u10da\u10d0)","Choices":{"1":{"Display":"\u10d2\u10d0\u10e0\u10d9\u10d5\u10d4\u10e3\u10da\u10ec\u10d8\u10da\u10d0\u10d3, \u10db\u10d4 \u10d0\u10e6\u10e4\u10e0\u10d7\u10dd\u10d5\u10d0\u10dc\u10d4\u10d1\u10e3\u10da\u10d8 \u10d5\u10d0\u10e0 \u10e0\u10e3\u10e1\u10d4\u10d7\u10d8\u10d7"},"2":{"Display":"\u10ee\u10d0\u10dc\u10d3\u10d0\u10ee\u10d0\u10dc \u10e0\u10e3\u10e1\u10d4\u10d7\u10d8\u10d7 \u10d5\u10d0\u10e0 \u10e8\u10d7\u10d0\u10d2\u10dd\u10dc\u10d4\u10d1\u10e3\u10da\u10d8"},"3":{"Display":"\u10e0\u10e3\u10e1\u10d4\u10d7\u10d8 \u10d8\u10db\u10d4\u10d3\u10e1 \u10db\u10d0\u10eb\u10da\u10d4\u10d5\u10e1"}},"Answers":{"1":{"Display":"\u10d9\u10d0\u10e2\u10d4\u10d2\u10dd\u10e0\u10d8\u10e3\u10da\u10d0\u10d3 \u10d0\u10e0 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"},"2":{"Display":"\u10d0\u10e0 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"},"3":{"Display":"\u10d2\u10d0\u10e0\u10d9\u10d5\u10d4\u10e3\u10da\u10ec\u10d8\u10da\u10d0\u10d3 \u10d0\u10e0 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"},"4":{"Display":"\u10d0\u10e0\u10ea \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8 \u10d3\u10d0 \u10d0\u10e0\u10ea \u10d0\u10e0 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"},"5":{"Display":"\u10dc\u10d0\u10ec\u10d8\u10da\u10dd\u10d1\u10e0\u10d8\u10d5 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"},"6":{"Display":"\u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"},"7":{"Display":"\u10e1\u10e0\u10e3\u10da\u10d8\u10d0\u10d3 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"}}},"LT":{"QuestionText":"[10.5 klausimas] Dabar j\u016bs\u0173 bus papra\u0161yta nurodyti, kiek sutinkate su \u0161iais teiginiais, kur 1 = Visi\u0161kai nesutinku ir 7 = Visi\u0161kai sutinku (1\u20137 bal\u0173 skal\u0117)","Choices":{"1":{"Display":"Tam tikra prasme a\u0161 \u017eaviuosi Rusija"},"2":{"Display":"Kartais mane \u012fkvepia Rusija"},"3":{"Display":"Rusija man suteikia vilties"}},"Answers":{"1":{"Display":"Visi\u0161kai nesutinku"},"2":{"Display":"Nesutinku"},"3":{"Display":"\u0160iek tiek nesutinku"},"4":{"Display":"Nei sutinku, nei nesutinku"},"5":{"Display":"I\u0161 dalies sutinku"},"6":{"Display":"Sutinku"},"7":{"Display":"Visi\u0161kai sutinku"}}},"LV":{"QuestionText":"[10.5.\u00a0jaut\u0101jums] Tagad jums tiks l\u016bgts nor\u0101d\u012bt, cik liel\u0101 m\u0113r\u0101 j\u016bs piekr\u012btat \u0161\u0101diem apgalvojumiem, kur 1\u00a0=\u00a0piln\u012bb\u0101 nepiekr\u012btu un 7\u00a0=\u00a0piln\u012bb\u0101 piekr\u012btu (skala no 1\u00a0l\u012bdz 7)","Choices":{"1":{"Display":"Zin\u0101m\u0101 m\u0113r\u0101 es apbr\u012bnoju Krieviju"},"2":{"Display":"Da\u017ereiz mani iedvesmo Krievija"},"3":{"Display":"Krievija man dod cer\u012bbu"}},"Answers":{"1":{"Display":"Piln\u012bb\u0101 nepiekr\u012btu"},"2":{"Display":"Nepiekr\u012btu"},"3":{"Display":"Da\u013c\u0113ji nepiekr\u012btu"},"4":{"Display":"Ne piekr\u012btu, ne nepiekr\u012btu"},"5":{"Display":"Da\u013c\u0113ji piekr\u012btu"},"6":{"Display":"Piekr\u012btu"},"7":{"Display":"Piln\u012bb\u0101 piekr\u012btu"}}},"NL":{"QuestionText":"[Q10.5] Nu wordt u gevraagd aan te geven in hoeverre u het eens bent met de volgende stellingen, waarbij 1 = Sterk oneens en 7 = Sterk eens (schaal van 1-7)","Choices":{"1":{"Display":"Tot op zekere hoogte bewonder ik Rusland"},"2":{"Display":"Soms voel ik mij ge\u00efnspireerd door Rusland"},"3":{"Display":"Rusland geeft mij hoop"}},"Answers":{"1":{"Display":"Ik ben het er absoluut niet mee eens"},"2":{"Display":"Niet mee eens"},"3":{"Display":"Ik ben het er enigszins mee oneens"},"4":{"Display":"Noch eens, noch oneens"},"5":{"Display":"enigszins mee eens"},"6":{"Display":"Mee eens zijn"},"7":{"Display":"Helemaal mee eens"}}},"PL":{"QuestionText":"[Q10.5] Teraz zostaniesz poproszony o wskazanie stopnia, w jakim zgadzasz si\u0119 z nast\u0119puj\u0105cymi stwierdzeniami, gdzie 1 = Zdecydowanie si\u0119 nie zgadzam, a 7 = Zdecydowanie si\u0119 zgadzam (skala 1-7)","Choices":{"1":{"Display":"Do pewnego stopnia podziwiam Rosj\u0119"},"2":{"Display":"Czasami czuj\u0119 si\u0119 zainspirowany Rosj\u0105"},"3":{"Display":"Rosja daje mi nadziej\u0119"}},"Answers":{"1":{"Display":"Zdecydowanie si\u0119 nie zgadzam"},"2":{"Display":"Nie zgadza\u0107 si\u0119"},"3":{"Display":"Raczej si\u0119 nie zgadzam"},"4":{"Display":"Ani si\u0119 zgadzam, ani nie zgadzam"},"5":{"Display":"Raczej si\u0119 zgadzam"},"6":{"Display":"Zgadza\u0107 si\u0119"},"7":{"Display":"Zdecydowanie si\u0119 zgadzam"}}},"RU":{"QuestionText":"[Q10.5] \u0422\u