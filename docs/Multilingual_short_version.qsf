35 \u0437\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u044f\u0442\u0430 \u043e\u0442 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442 \u0441\u044a\u0441 \u0441\u0442\u0440\u0430\u043d\u0438 \u043a\u0430\u0442\u043e \u0420\u0443\u0441\u0438\u044f \u0438\u043b\u0438 \u041a\u0438\u0442\u0430\u0439"}},"Answers":{"1":{"Display":"\u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0447\u043d\u043e \u043d\u0435 \u0441\u044a\u043c \u0441\u044a\u0433\u043b\u0430\u0441\u0435\u043d\/\u0430"},"2":{"Display":"\u041d\u0435 \u0441\u044a\u043c \u0441\u044a\u0433\u043b\u0430\u0441\u0435\u043d\/\u0430"},"3":{"Display":"\u0414\u043e\u043d\u044f\u043a\u044a\u0434\u0435 \u043d\u0435 \u0441\u044a\u043c \u0441\u044a\u0433\u043b\u0430\u0441\u0435\u043d\/\u0430"},"4":{"Display":"\u041d\u0438\u0442\u043e \u0441\u044a\u043c \u0441\u044a\u0433\u043b\u0430\u0441\u0435\u043d, \u043d\u0438\u0442\u043e \u0441\u044a\u043c \u043d\u0435\u0441\u044a\u0433\u043b\u0430\u0441\u0435\u043d"},"5":{"Display":"\u0414\u043e\u043d\u044f\u043a\u044a\u0434\u0435 \u0441\u044a\u043c \u0441\u044a\u0433\u043b\u0430\u0441\u0435\u043d\/\u0441\u044a\u0433\u043b\u0430\u0441\u043d\u0430"},"6":{"Display":"\u0421\u044a\u0433\u043b\u0430\u0441\u0435\u043d\/\u0430"},"7":{"Display":"\u041d\u0430\u043f\u044a\u043b\u043d\u043e \u0441\u044a\u0433\u043b\u0430\u0441\u0435\u043d\/\u0430"}}},"DE":{"QuestionText":"[Q10.4] Nun werden Sie gebeten, anzugeben, inwieweit Sie den folgenden Aussagen zustimmen, wobei 1 = Stimme \u00fcberhaupt nicht zu und 7 = Stimme voll und ganz zu (Skala 1-7)","Choices":{"1":{"Display":"Ich f\u00fchle mich angespannt, wenn ich an m\u00f6gliche Konflikte mit L\u00e4ndern wie Russland oder China denke"},"2":{"Display":"Ich w\u00fcrde mich sicherer f\u00fchlen, wenn um jeden Preis Frieden mit L\u00e4ndern wie Russland oder China geschlossen w\u00fcrde"},"3":{"Display":"Ich mache mir Sorgen \u00fcber die Folgen eines Konflikts mit L\u00e4ndern wie Russland oder China"}},"Answers":{"1":{"Display":"Stimme \u00fcberhaupt nicht zu"},"2":{"Display":"Verschiedener Meinung sein"},"3":{"Display":"Stimme eher nicht zu"},"4":{"Display":"Weder zustimmen noch nicht zustimmen"},"5":{"Display":"Stimme eher zu"},"6":{"Display":"Zustimmen"},"7":{"Display":"Stimme voll und ganz zu"}}},"ET":{"QuestionText":"[K10.4] N\u00fc\u00fcd palutakse teil m\u00e4rkida, kui suurel m\u00e4\u00e4ral te n\u00f5ustute j\u00e4rgmiste v\u00e4idetega, kus 1 = T\u00e4iesti ei ole n\u00f5us ja 7 = T\u00e4iesti n\u00f5us (skaala 1\u20137)","Choices":{"1":{"Display":"Tunnen pinget, kui m\u00f5tlen v\u00f5imalikele konfliktidele selliste riikidega nagu Venemaa v\u00f5i Hiina"},"2":{"Display":"Tunneksin end turvalisemalt, kui selliste riikidega nagu Venemaa v\u00f5i Hiina saavutatakse rahu iga hinna eest."},"3":{"Display":"Olen mures konflikti tagaj\u00e4rgede p\u00e4rast selliste riikidega nagu Venemaa v\u00f5i Hiina"}},"Answers":{"1":{"Display":"Kindlalt ei n\u00f5ustu"},"2":{"Display":"Ei n\u00f5ustu"},"3":{"Display":"Pole eriti n\u00f5us"},"4":{"Display":"Ei n\u00f5ustu ega ole eriarvamusel"},"5":{"Display":"Enam-v\u00e4hem n\u00f5us"},"6":{"Display":"N\u00f5ustun"},"7":{"Display":"T\u00e4iesti n\u00f5us"}}},"FA":{"QuestionText":"[\u0633\u0648\u0627\u0644 \u06f1\u06f0.\u06f4] \u0627\u06a9\u0646\u0648\u0646 \u0627\u0632 \u0634\u0645\u0627 \u062e\u0648\u0627\u0633\u062a\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f \u0645\u06cc\u0632\u0627\u0646 \u0645\u0648\u0627\u0641\u0642\u062a \u062e\u0648\u062f \u0631\u0627 \u0628\u0627 \u062c\u0645\u0644\u0627\u062a \u0632\u06cc\u0631 \u0645\u0634\u062e\u0635 \u06a9\u0646\u06cc\u062f\u060c \u06a9\u0647 \u062f\u0631 \u0622\u0646 \u06f1 = \u06a9\u0627\u0645\u0644\u0627\u064b \u0645\u062e\u0627\u0644\u0641 \u0648 \u06f7 = \u06a9\u0627\u0645\u0644\u0627\u064b \u0645\u0648\u0627\u0641\u0642 (\u0645\u0642\u06cc\u0627\u0633 \u06f1 \u062a\u0627 \u06f7)","Choices":{"1":{"Display":"\u0648\u0642\u062a\u06cc \u0628\u0647 \u062f\u0631\u06af\u06cc\u0631\u06cc\u200c\u0647\u0627\u06cc \u0627\u062d\u062a\u0645\u0627\u0644\u06cc \u0628\u0627 \u06a9\u0634\u0648\u0631\u0647\u0627\u06cc\u06cc \u0645\u062b\u0644 \u0631\u0648\u0633\u06cc\u0647 \u06cc\u0627 \u0686\u06cc\u0646 \u0641\u06a9\u0631 \u0645\u06cc\u200c\u06a9\u0646\u0645\u060c \u0627\u062d\u0633\u0627\u0633 \u062a\u0646\u0634 \u0645\u06cc\u200c\u06a9\u0646\u0645."},"2":{"Display":"\u0627\u06af\u0631 \u0635\u0644\u062d \u0628\u0627 \u06a9\u0634\u0648\u0631\u0647\u0627\u06cc\u06cc \u0645\u0627\u0646\u0646\u062f \u0631\u0648\u0633\u06cc\u0647 \u06cc\u0627 \u0686\u06cc\u0646 \u0628\u0647 \u0647\u0631 \u0642\u06cc\u0645\u062a\u06cc \u0628\u0631\u0642\u0631\u0627\u0631 \u0634\u0648\u062f\u060c \u0627\u062d\u0633\u0627\u0633 \u0627\u0645\u0646\u06cc\u062a \u0628\u06cc\u0634\u062a\u0631\u06cc \u062e\u0648\u0627\u0647\u0645 \u06a9\u0631\u062f."},"3":{"Display":"\u0645\u0646 \u0646\u06af\u0631\u0627\u0646 \u0639\u0648\u0627\u0642\u0628 \u062f\u0631\u06af\u06cc\u0631\u06cc \u0628\u0627 \u06a9\u0634\u0648\u0631\u0647\u0627\u06cc\u06cc \u0645\u0627\u0646\u0646\u062f \u0631\u0648\u0633\u06cc\u0647 \u06cc\u0627 \u0686\u06cc\u0646 \u0647\u0633\u062a\u0645."}},"Answers":{"1":{"Display":"\u06a9\u0627\u0645\u0644\u0627\u064b \u0645\u062e\u0627\u0644\u0641\u0645"},"2":{"Display":"\u0645\u062e\u0627\u0644\u0641"},"3":{"Display":"\u062a\u0627 \u062d\u062f\u0648\u062f\u06cc \u0645\u062e\u0627\u0644\u0641\u0645"},"4":{"Display":"\u0646\u0647 \u0645\u0648\u0627\u0641\u0642 \u0648 \u0646\u0647 \u0645\u062e\u0627\u0644\u0641"},"5":{"Display":"\u062a\u0627 \u062d\u062f\u0648\u062f\u06cc \u0645\u0648\u0627\u0641\u0642\u0645"},"6":{"Display":"\u0645\u0648\u0627\u0641\u0642"},"7":{"Display":"\u06a9\u0627\u0645\u0644\u0627\u064b \u0645\u0648\u0627\u0641\u0642\u0645"}}},"FR":{"QuestionText":"[Q10.4] Il vous sera maintenant demand\u00e9 d&#39;indiquer dans quelle mesure vous \u00eates d&#39;accord avec les affirmations suivantes, o\u00f9 1 = Tout \u00e0 fait en d\u00e9saccord et 7 = Tout \u00e0 fait d&#39;accord (\u00e9chelle de 1 \u00e0 7)","Choices":{"1":{"Display":"Je me sens tendu lorsque je pense \u00e0 des conflits potentiels avec des pays comme la Russie ou la Chine."},"2":{"Display":"Je me sentirais plus en s\u00e9curit\u00e9 si la paix avec des pays comme la Russie ou la Chine \u00e9tait conclue \u00e0 tout prix."},"3":{"Display":"Je suis inquiet des cons\u00e9quences d\u2019un conflit avec des pays comme la Russie ou la Chine."}},"Answers":{"1":{"Display":"Fortement en d\u00e9saccord"},"2":{"Display":"\u00catre en d\u00e9saccord"},"3":{"Display":"Plut\u00f4t en d\u00e9saccord"},"4":{"Display":"Ni d&#39;accord ni en d\u00e9saccord"},"5":{"Display":"Plut\u00f4t d&#39;accord"},"6":{"Display":"Accepter"},"7":{"Display":"Tout \u00e0 fait d&#39;accord"}}},"HU":{"QuestionText":"[10.4. k\u00e9rd\u00e9s] Most arra kell majd jeleznie, hogy mennyire \u00e9rt egyet a k\u00f6vetkez\u0151 \u00e1ll\u00edt\u00e1sokkal, ahol 1 = Hat\u00e1rozottan nem \u00e9rtek egyet \u00e9s 7 = Hat\u00e1rozottan egyet\u00e9rtek (1-7-es sk\u00e1la)","Choices":{"1":{"Display":"Fesz\u00fcltnek \u00e9rzem magam, amikor olyan orsz\u00e1gokkal, mint Oroszorsz\u00e1g vagy K\u00edna, lehets\u00e9ges konfliktusokra gondolok."},"2":{"Display":"Biztons\u00e1gosabbnak \u00e9rezn\u00e9m magam, ha b\u00e1rmi \u00e1ron b\u00e9k\u00e9t k\u00f6tn\u00e9nek olyan orsz\u00e1gokkal, mint Oroszorsz\u00e1g vagy K\u00edna."},"3":{"Display":"Agg\u00f3dok egy olyan orsz\u00e1gokkal val\u00f3 konfliktus k\u00f6vetkezm\u00e9nyei miatt, mint Oroszorsz\u00e1g vagy K\u00edna."}},"Answers":{"1":{"Display":"Hat\u00e1rozottan nem \u00e9rtek egyet"},"2":{"Display":"Nem \u00e9rt egyet"},"3":{"Display":"Kiss\u00e9 nem \u00e9rtek egyet"},"4":{"Display":"Sem egyet\u00e9rt\u00e9s, sem ellentmond\u00e1s"},"5":{"Display":"R\u00e9szben egyet\u00e9rtek"},"6":{"Display":"Egyet\u00e9rt"},"7":{"Display":"Teljesen egyet\u00e9rtek"}}},"IT":{"QuestionText":"[Q10.4] Ora ti verr\u00e0 chiesto di indicare il tuo grado di accordo con le seguenti affermazioni, dove 1 = Fortemente in disaccordo e 7 = Fortemente d&#39;accordo (scala da 1 a 7)","Choices":{"1":{"Display":"Mi sento teso quando penso a potenziali conflitti con paesi come la Russia o la Cina"},"2":{"Display":"Mi sentirei pi\u00f9 sicuro se la pace con paesi come la Russia o la Cina venisse raggiunta a qualunque costo"},"3":{"Display":"Sono preoccupato per le conseguenze di un conflitto con paesi come la Russia o la Cina"}},"Answers":{"1":{"Display":"Fortemente in disaccordo"},"2":{"Display":"Non sono d&#39;accordo"},"3":{"Display":"Un po&#39; in disaccordo"},"4":{"Display":"N\u00e9 d&#39;accordo n\u00e9 in disaccordo"},"5":{"Display":"Abbastanza d&#39;accordo"},"6":{"Display":"Essere d&#39;accordo"},"7":{"Display":"Sono assolutamente d&#39;accordo"}}},"KAT":{"QuestionText":"[Q10.4] \u10d0\u10ee\u10da\u10d0 \u10d7\u10e5\u10d5\u10d4\u10dc \u10db\u10dd\u10d2\u10d4\u10d7\u10ee\u10dd\u10d5\u10d4\u10d1\u10d0\u10d7 \u10db\u10d8\u10e3\u10d7\u10d8\u10d7\u10dd\u10d7 \u10d7\u10e5\u10d5\u10d4\u10dc\u10d8 \u10d7\u10d0\u10dc\u10ee\u10db\u10dd\u10d1\u10d8\u10e1 \u10ee\u10d0\u10e0\u10d8\u10e1\u10ee\u10d8 \u10e8\u10d4\u10db\u10d3\u10d4\u10d2 \u10d2\u10d0\u10dc\u10ea\u10ee\u10d0\u10d3\u10d4\u10d1\u10d4\u10d1\u10d7\u10d0\u10dc, \u10e1\u10d0\u10d3\u10d0\u10ea 1 = \u10d9\u10d0\u10e2\u10d4\u10d2\u10dd\u10e0\u10d8\u10e3\u10da\u10d0\u10d3 \u10d0\u10e0 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8 \u10d3\u10d0 7 = \u10e1\u10e0\u10e3\u10da\u10d8\u10d0\u10d3 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8 (1-7 \u10e8\u10d9\u10d0\u10da\u10d0)","Choices":{"1":{"Display":"\u10d3\u10d0\u10eb\u10d0\u10d1\u10e3\u10da\u10dd\u10d1\u10d0\u10e1 \u10d5\u10d2\u10e0\u10eb\u10dc\u10dd\u10d1, \u10e0\u10dd\u10d3\u10d4\u10e1\u10d0\u10ea \u10d5\u10e4\u10d8\u10e5\u10e0\u10dd\u10d1 \u10de\u10dd\u10e2\u10d4\u10dc\u10ea\u10d8\u10e3\u10e0 \u10d9\u10dd\u10dc\u10e4\u10da\u10d8\u10e5\u10e2\u10d4\u10d1\u10d6\u10d4 \u10d8\u10e1\u10d4\u10d7 \u10e5\u10d5\u10d4\u10e7\u10dc\u10d4\u10d1\u10d7\u10d0\u10dc, \u10e0\u10dd\u10d2\u10dd\u10e0\u10d8\u10ea\u10d0\u10d0 \u10e0\u10e3\u10e1\u10d4\u10d7\u10d8 \u10d0\u10dc \u10e9\u10d8\u10dc\u10d4\u10d7\u10d8."},"2":{"Display":"\u10d7\u10d0\u10d5\u10e1 \u10e3\u10e4\u10e0\u10dd \u10e3\u10e1\u10d0\u10e4\u10e0\u10d7\u10ee\u10dd\u10d3 \u10d5\u10d8\u10d2\u10e0\u10eb\u10dc\u10dd\u10d1\u10d3\u10d8, \u10d7\u10e3 \u10e0\u10e3\u10e1\u10d4\u10d7\u10d8 \u10d0\u10dc \u10e9\u10d8\u10dc\u10d4\u10d7\u10d8\u10e1 \u10db\u10e1\u10d2\u10d0\u10d5\u10e1 \u10e5\u10d5\u10d4\u10e7\u10dc\u10d4\u10d1\u10d7\u10d0\u10dc \u10db\u10e8\u10d5\u10d8\u10d3\u10dd\u10d1\u10d0 \u10dc\u10d4\u10d1\u10d8\u10e1\u10db\u10d8\u10d4\u10e0 \u10e4\u10d0\u10e1\u10d0\u10d3 \u10d8\u10e5\u10dc\u10d4\u10d1\u10dd\u10d3\u10d0 \u10d3\u10d0\u10db\u10e7\u10d0\u10e0\u10d4\u10d1\u10e3\u10da\u10d8."},"3":{"Display":"\u10db\u10d4 \u10e8\u10d4\u10e8\u10e4\u10dd\u10d7\u10d4\u10d1\u10e3\u10da\u10d8 \u10d5\u10d0\u10e0 \u10e0\u10e3\u10e1\u10d4\u10d7\u10d8\u10e1 \u10d0\u10dc \u10e9\u10d8\u10dc\u10d4\u10d7\u10d8\u10e1 \u10db\u10e1\u10d2\u10d0\u10d5\u10e1 \u10e5\u10d5\u10d4\u10e7\u10dc\u10d4\u10d1\u10d7\u10d0\u10dc \u10d9\u10dd\u10dc\u10e4\u10da\u10d8\u10e5\u10e2\u10d8\u10e1 \u10e8\u10d4\u10d3\u10d4\u10d2\u10d4\u10d1\u10d8\u10d7."}},"Answers":{"1":{"Display":"\u10d9\u10d0\u10e2\u10d4\u10d2\u10dd\u10e0\u10d8\u10e3\u10da\u10d0\u10d3 \u10d0\u10e0 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"},"2":{"Display":"\u10d0\u10e0 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"},"3":{"Display":"\u10d2\u10d0\u10e0\u10d9\u10d5\u10d4\u10e3\u10da\u10ec\u10d8\u10da\u10d0\u10d3 \u10d0\u10e0 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"},"4":{"Display":"\u10d0\u10e0\u10ea \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8 \u10d3\u10d0 \u10d0\u10e0\u10ea \u10d0\u10e0 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"},"5":{"Display":"\u10dc\u10d0\u10ec\u10d8\u10da\u10dd\u10d1\u10e0\u10d8\u10d5 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"},"6":{"Display":"\u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"},"7":{"Display":"\u10e1\u10e0\u10e3\u10da\u10d8\u10d0\u10d3 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"}}},"LT":{"QuestionText":"[10.4 klausimas] Dabar j\u016bs\u0173 bus papra\u0161yta nurodyti, kiek sutinkate su \u0161iais teiginiais, kur 1 = Visi\u0161kai nesutinku ir 7 = Visi\u0161kai sutinku (1\u20137 bal\u0173 skal\u0117)","Choices":{"1":{"Display":"Jau\u010diu \u012ftamp\u0105 galvodamas apie galimus konfliktus su tokiomis \u0161alimis kaip Rusija ar Kinija"},"2":{"Display":"Jaus\u010diausi saugiau, jei bet kokia kaina b\u016bt\u0173 sudaryta taika su tokiomis \u0161alimis kaip Rusija ar Kinija."},"3":{"Display":"Nerimauju d\u0117l konflikto su tokiomis \u0161alimis kaip Rusija ar Kinija pasekmi\u0173"}},"Answers":{"1":{"Display":"Visi\u0161kai nesutinku"},"2":{"Display":"Nesutinku"},"3":{"Display":"\u0160iek tiek nesutinku"},"4":{"Display":"Nei sutinku, nei nesutinku"},"5":{"Display":"I\u0161 dalies sutinku"},"6":{"Display":"Sutinku"},"7":{"Display":"Visi\u0161kai sutinku"}}},"LV":{"QuestionText":"[10.4.\u00a0jaut\u0101jums] Tagad jums tiks l\u016bgts nor\u0101d\u012bt, cik liel\u0101 m\u0113r\u0101 j\u016bs piekr\u012btat \u0161\u0101diem apgalvojumiem, kur 1\u00a0=\u00a0piln\u012bb\u0101 nepiekr\u012btu un 7\u00a0=\u00a0piln\u012bb\u0101 piekr\u012btu (skala no 1\u00a0l\u012bdz 7)","Choices":{"1":{"Display":"Es j\u016btos saspringts, dom\u0101jot par iesp\u0113jamiem konfliktiem ar t\u0101d\u0101m valst\u012bm k\u0101 Krievija vai \u0136\u012bna"},"2":{"Display":"Es justos dro\u0161\u0101k, ja par katru cenu tiktu pan\u0101kts miers ar t\u0101d\u0101m valst\u012bm k\u0101 Krievija vai \u0136\u012bna."},"3":{"Display":"Esmu noraiz\u0113jies par sek\u0101m, ko var\u0113tu rad\u012bt konflikts ar t\u0101d\u0101m valst\u012bm k\u0101 Krievija vai \u0136\u012bna."}},"Answers":{"1":{"Display":"Piln\u012bb\u0101 nepiekr\u012btu"},"2":{"Display":"Nepiekr\u012btu"},"3":{"Display":"Da\u013c\u0113ji nepiekr\u012btu"},"4":{"Display":"Ne piekr\u012btu, ne nepiekr\u012btu"},"5":{"Display":"Da\u013c\u0113ji piekr\u012btu"},"6":{"Display":"Piekr\u012btu"},"7":{"Display":"Piln\u012bb\u0101 piekr\u012btu"}}},"NL":{"QuestionText":"[Q10.4] Nu wordt u gevraagd aan te geven in hoeverre u het eens bent met de volgende stellingen, waarbij 1 = Sterk oneens en 7 = Sterk eens (schaal van 1-7)","Choices":{"1":{"Display":"Ik voel me gespannen als ik denk aan mogelijke conflicten met landen als Rusland of China"},"2":{"Display":"Ik zou me veiliger voelen als er tegen elke prijs vrede wordt gesloten met landen als Rusland of China"},"3":{"Display":"Ik maak me zorgen over de gevolgen van een conflict met landen als Rusland of China"}},"Answers":{"1":{"Display":"Ik ben het er absoluut niet mee eens"},"2":{"Display":"Niet mee eens"},"3":{"Display":"Ik ben het er enigszins mee oneens"},"4":{"Display":"Noch eens, noch oneens"},"5":{"Display":"enigszins mee eens"},"6":{"Display":"Mee eens zijn"},"7":{"Display":"Helemaal mee eens"}}},"PL":{"QuestionText":"[Q10.4] Teraz zostaniesz poproszony o wskazanie stopnia, w jakim zgadzasz si\u0119 z nast\u0119puj\u0105cymi stwierdzeniami, gdzie 1 = Zdecydowanie si\u0119 nie zgadzam, a 7 = Zdecydowanie si\u0119 zgadzam (skala 1-7)","Choices":{"1":{"Display":"Czuj\u0119 napi\u0119cie, gdy my\u015bl\u0119 o potencjalnych konfliktach z krajami takimi jak Rosja czy Chiny"},"2":{"Display":"Czu\u0142bym si\u0119 bezpieczniej, gdyby za wszelk\u0105 cen\u0119 uda\u0142o si\u0119 zawrze\u0107 pok\u00f3j z krajami takimi jak Rosja czy Chiny"},"3":{"Display":"Martwi\u0105 mnie konsekwencje konfliktu z krajami takimi jak Rosja czy Chiny"}},"Answers":{"1":{"Display":"Zdecydowanie si\u0119 nie zgadzam"},"2":{"Display":"Nie zgadza\u0107 si\u0119"},"3":{"Display":"Raczej si\u0119 nie zgadzam"},"4":{"Display":"Ani si\u0119 zgadzam, ani nie zgadzam"},"5":{"Display":"Raczej si\u0119 zgadzam"},"6":{"Display":"Zgadza\u0107 si\u0119"},"7":{"Display":"Zdecydowanie si\u0119 zgadzam"}}},"RU":{"QuestionText":"[Q10.4] \u0422\u0435\u043f\u0435\u0440\u044c \u0432\u0430\u043c \u0431\u0443\u0434\u0435\u0442 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u043e \u0443\u043a\u0430\u0437\u0430\u0442\u044c \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0432\u0430\u0448\u0435\u0433\u043e \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u044f \u0441\u043e \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u043c\u0438 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f\u043c\u0438, \u0433\u0434\u0435 1 = \u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u0435 \u0441\u043e\u0433\u043b\u0430\u0441\u0435\u043d \u0438 7 = \u041f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0441\u043e\u0433\u043b\u0430\u0441\u0435\u043d (\u0448\u043a\u0430\u043b\u0430 \u043e\u0442 1 \u0434\u043e 7)","Choices":{"1":{"Display":"\u042f \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044e \u043d\u0430\u043f\u0440\u044f\u0436\u0435\u043d\u0438\u0435, \u043a\u043e\u0433\u0434\u0430 \u0434\u0443\u043c\u0430\u044e \u043e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0445 \u043a\u043e\u043d\u0444\u043b\u0438\u043a\u0442\u0430\u0445 \u0441 \u0442\u0430\u043a\u0438\u043c\u0438 \u0441\u0442\u0440\u0430\u043d\u0430\u043c\u0438, \u043a\u0430\u043a \u0420\u043e\u0441\u0441\u0438\u044f \u0438\u043b\u0438 \u041a\u0438\u0442\u0430\u0439."},"2":{"Display":"\u042f \u0431\u044b \u0447\u0443\u0432\u0441\u0442\u0432\u043e\u0432\u0430\u043b \u0441\u0435\u0431\u044f \u0432 \u0431\u043e\u043b\u044c\u0448\u0435\u0439 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438, \u0435\u0441\u043b\u0438 \u0431\u044b \u043c\u0438\u0440 \u0441 \u0442\u0430\u043a\u0438\u043c\u0438 \u0441\u0442\u0440\u0430\u043d\u0430\u043c\u0438, \u043a\u0430\u043a \u0420\u043e\u0441\u0441\u0438\u044f \u0438\u043b\u0438 \u041a\u0438\u0442\u0430\u0439, \u0431\u044b\u043b \u0434\u043e\u0441\u0442\u043