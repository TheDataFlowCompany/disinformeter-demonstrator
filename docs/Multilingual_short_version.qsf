38\u0442\u0430\u0439\u0441\u044c\u043a\u0438\u0439 \u0432\u0456\u0440\u0443\u0441\u043e\u043b\u043e\u0433, \u044f\u043a\u0438\u0439 \u0441\u0442\u0432\u0435\u0440\u0434\u0436\u0443\u0454, \u0449\u043e \u0432\u0456\u0440\u0443\u0441 COVID-19 \u043f\u043e\u0445\u043e\u0434\u0438\u0442\u044c \u0437 \u043a\u0438\u0442\u0430\u0439\u0441\u044c\u043a\u043e\u0457 \u0443\u0440\u044f\u0434\u043e\u0432\u043e\u0457 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u0456\u0457, \u0454 \u0432\u0456\u0434\u043e\u043c\u0438\u043c \u043f\u043e\u0448\u0438\u0440\u044e\u0432\u0430\u0447\u0435\u043c \u0447\u0443\u0442\u043e\u043a."},"7":{"Display":"CGTN: \u0422\u0456\u0441\u043d\u0456\u0448\u0456 \u043c\u0456\u0436\u043e\u0441\u043e\u0431\u0438\u0441\u0442\u0456\u0441\u043d\u0456 \u0437\u0432&#39;\u044f\u0437\u043a\u0438 \u0441\u043f\u0440\u0438\u044f\u044e\u0442\u044c \u0434\u0440\u0443\u0436\u0431\u0456 \u043c\u0456\u0436 \u041a\u0438\u0442\u0430\u0454\u043c \u0442\u0430 \u0412&#39;\u0454\u0442\u043d\u0430\u043c\u043e\u043c"},"8":{"Display":"\u0423 \u041a\u0438\u0442\u0430\u0457 \u0437\u0430\u0431\u043e\u0440\u043e\u043d\u0435\u043d\u043e \u043f\u0440\u0430\u0432\u043b\u0456\u043d\u043d\u044f \u0443\u043b\u044c\u0442\u0440\u0430\u043f\u0440\u0430\u0432\u043e\u0433\u043e \u0440\u0435\u043b\u0456\u0433\u0456\u0439\u043d\u043e\u0433\u043e \u043b\u0456\u0434\u0435\u0440\u0430 \u041b\u0456 \u0425\u0443\u043d\u0447\u0436\u0456, \u0441\u0445\u043e\u0436\u0435 \u043d\u0430 \u0447\u0443\u043c\u0443."}},"Answers":{"1":{"Display":"1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7"}},"Labels":{"1":{"Display":"\u0426\u0435\u0439 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a \u0442\u043e\u0447\u043d\u043e \u041d\u0415 \u043f\u0456\u0434\u0440\u043e\u0431\u043b\u0435\u043d\u0438\u0439"},"2":{"Display":"\u0426\u0435\u0439 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a, \u0431\u0435\u0437\u0443\u043c\u043e\u