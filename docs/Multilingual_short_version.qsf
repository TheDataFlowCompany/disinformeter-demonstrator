 censored in my country"},"6":{"Display":"I'm frustrated because my state bans the media I want to access"}},"ChoiceOrder":[1,2,3,4,5,6],"Randomization":{"Advanced":null,"ConsistentScaleReversal":true,"TotalRandSubset":"","Type":"None"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":{"AR":{"QuestionText":"[\u063310.3] \u0627\u0644\u0622\u0646 \u0633\u064a\u064f\u0637\u0644\u0628 \u0645\u0646\u0643 \u062a\u062d\u062f\u064a\u062f \u0645\u062f\u0649 \u0645\u0648\u0627\u0641\u0642\u062a\u0643 \u0639\u0644\u0649 \u0627\u0644\u0639\u0628\u0627\u0631\u0627\u062a \u0627\u0644\u062a\u0627\u0644\u064a\u0629\u060c \u062d\u064a\u062b 1 = \u0623\u062e\u062a\u0644\u0641 \u0628\u0634\u062f\u0629 \u06487 = \u0623\u0648\u0627\u0641\u0642 \u0628\u0634\u062f\u0629 (\u0645\u0642\u064a\u0627\u0633 \u0645\u0646 1 \u0625\u0644\u0649 7)","Choices":{"1":{"Display":"\u0628\u0634\u0643\u0644 \u0639\u0627\u0645\u060c \u0623\u0646\u0627 \u0644\u0627 \u0623\u062b\u0642 \u0628\u062d\u0644\u0641\u0627\u0626\u0646\u0627 \u0627\u0644\u062f\u0648\u0644\u064a\u064a\u0646"},"2":{"Display":"\u0623\u0634\u0639\u0631 \u0628\u062e\u064a\u0628\u0629 \u0623\u0645\u0644 \u0625\u0632\u0627\u0621 \u062a\u0635\u0631\u0641\u0627\u062a \u0627\u0644\u0645\u062c\u062a\u0645\u0639 \u0627\u0644\u062f\u0648\u0644\u064a \u0641\u064a \u062d\u0645\u0627\u064a\u0629 \u0628\u0644\u062f\u064a"},"3":{"Display":"\u0623\u0634\u0639\u0631 \u0628\u0627\u0644\u0625\u062d\u0628\u0627\u0637 \u0645\u0646 \u0627\u0644\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062a\u064a \u062a\u062a\u0639\u0627\u0645\u0644 \u0628\u0647\u0627 \u0648\u0644\u0627\u064a\u062a\u064a \u0645\u0639 \u0627\u062d\u062a\u064a\u0627\u062c\u0627\u062a \u0627\u0644\u0645\u0648\u0627\u0637\u0646\u064a\u0646"},"4":{"Display":"\u0623\u0646\u0627 \u063a\u0627\u0636\u0628 \u0645\u0646 \u0648\u0644\u0627\u064a\u062a\u064a \u0644\u0641\u0634\u0644\u0647\u0627 \u0641\u064a \u062d\u0645\u0627\u064a\u0629