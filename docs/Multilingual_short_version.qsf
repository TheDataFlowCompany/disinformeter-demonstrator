 kat\u0131lm\u0131yorum"},"5":{"Display":"Biraz kat\u0131l\u0131yorum"},"6":{"Display":"Kabul etmek"},"7":{"Display":"Kesinlikle kat\u0131l\u0131yorum"}}},"UK":{"QuestionText":"[Q10.1] \u0422\u0435\u043f\u0435\u0440 \u0432\u0430\u0441 \u043f\u043e\u043f\u0440\u043e\u0441\u044f\u0442\u044c \u0432\u043a\u0430\u0437\u0430\u0442\u0438 \u0441\u0442\u0443\u043f\u0456\u043d\u044c \u0432\u0430\u0448\u043e\u0457 \u0437\u0433\u043e\u0434\u0438 \u0437 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u043c\u0438 \u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043d\u043d\u044f\u043c\u0438, \u0434\u0435 1 = \u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0447\u043d\u043e \u043d\u0435 \u0437\u0433\u043e\u0434\u0435\u043d, \u0430 7 = \u041f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u0437\u0433\u043e\u0434\u0435\u043d (\u0448\u043a\u0430\u043b\u0430 \u0432\u0456\u0434 1 \u0434\u043e 7)","Choices":{"1":{"Display":"\u0423 \u043c\u0435\u043d\u0435 \u0434\u0443\u0436\u0435 \u043d\u0435\u0433\u0430\u0442\u0438\u0432\u043d\u0435 \u0432\u0456\u0434\u0447\u0443\u0442\u0442\u044f \u0449\u043e\u0434\u043e \u0442\u043e\u0433\u043e, \u044f\u043a \u043c\u043e\u044f \u0434\u0435\u0440\u0436\u0430\u0432\u0430 \u0441\u043f\u0440\u0430\u0432\u043b\u044f\u0454\u0442\u044c\u0441\u044f \u0437\u0456 \u0437\u043e\u0432\u043d\u0456\u0448\u043d\u0456\u043c\u0438 \u0437\u0430\u0433\u0440\u043e\u0437\u0430\u043c\u0438"},"2":{"Display":"\u041c\u0435\u043d\u0456 \u043d\u0435 \u043f\u043e\u0434\u043e\u0431\u0430\u044e\u0442\u044c\u0441\u044f \u0434\u0456\u0457 \u043d\u0430\u0448\u0438\u0445 \u043c\u0456\u0436\u043d\u0430\u0440\u043e\u0434\u043d\u0438\u0445 \u0441\u043e\u044e\u0437\u043d\u0438\u043a\u0456\u0432 \u0449\u043e\u0434\u043e \u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0435\u043d\u043d\u044f \u0431\u0435\u0437\u043f\u0435\u043a\u0438 \u043c\u043e\u0454\u0457 \u0434\u0435\u0440\u0436\u0430\u0432\u0438"},"3":{"Display":"\u042f \u0431\u043e\u044e\u0441\u044f \u043d\u0430\u0441\u043b\u0456\u0434\u043a\u0456\u0432 \u043f\u0440\u043e\u0432\u043e\u043a\u0430\u0446\u0456\u0457 \u0442\u0430\u043a\u0438\u0445 \u043a\u0440\u0430\u0457\u043d, \u044f\u043a \u0420\u043e\u0441\u0456\u044f \u0447\u0438 \u041a\u0438\u0442\u0430\u0439."},"4":{"Display":"\u041c\u0435\u043d\u0456 \u043f\u043e\u0434\u043e\u0431\u0430\u0454\u0442\u044c\u0441\u044f \u0420\u043e\u0441\u0456\u044f"},"5":{"Display":"\u041c\u0435\u043d\u0456 \u043f\u043e\u0434\u043e\u0431\u0430\u0454\u0442\u044c\u0441\u044f \u041a\u0438\u0442\u0430\u0439"}},"Answers":{"1":{"Display":"\u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0447\u043d\u043e \u043d\u0435 \u0437\u0433\u043e\u0434\u0435\u043d"},"2":{"Display":"\u041d\u0435 \u043f\u043e\u0433\u043e\u0434\u0436\u0443\u044e\u0441\u044f"},"3":{"Display":"\u0421\u043a\u043e\u0440\u0456\u0448\u0435 \u043d\u0435 \u0437\u0433\u043e\u0434\u0435\u043d\/\u043d\u0435 \u0437\u0433\u043e\u0434\u043d\u0430"},"4":{"Display":"\u041d\u0456 \u0437\u0433\u043e\u0434\u0435\u043d, \u043d\u0456 \u043d\u0435 \u0437\u0433\u043e\u0434\u0435\u043d"},"5":{"Display":"\u0427\u0430\u0441\u0442\u043a\u043e\u0432\u043e \u0437\u0433\u043e\u0434\u0435\u043d"},"6":{"Display":"\u0417\u0433\u043e\u0434\u0435\u043d"},"7":{"Display":"\u041f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u0437\u0433\u043e\u0434\u0435\u043d"}}},"ZH-S":{"QuestionText":"[Q10.1] \u73b0\u5728\uff0c\u60a8\u9700\u8981\u8868\u660e\u60a8\u5bf9\u4ee5\u4e0b\u9648\u8ff0\u7684\u540c\u610f\u7a0b\u5ea6\uff0c\u5176\u4e2d 1 = \u975e\u5e38\u4e0d\u540c\u610f\uff0c7 = \u975e\u5e38\u540c\u610f\uff081-7 \u7ea7\uff09","Choices":{"1":{"Display":"\u6211\u5bf9\u6211\u7684\u56fd\u5bb6\u5e94\u5bf9\u5916\u90e8\u5a01\u80c1\u7684\u65b9\u5f0f\u611f\u5230\u975e\u5e38\u8d1f\u9762"},"2":{"Display":"\u6211\u4e0d\u559c\u6b22\u6211\u4eec\u7684\u56fd\u9645\u76df\u53cb\u4e3a\u786e\u4fdd\u6211\u56fd\u5b89\u5168\u6240\u91c7\u53d6\u7684\u884c\u52a8"},"3":{"Display":"\u6211\u62c5\u5fc3\u6fc0\u6012\u4fc4\u7f57\u65af\u6216\u4e2d\u56fd\u7b49\u56fd\u5bb6\u4f1a\u4ea7\u751f\u540e\u679c"},"4":{"Display":"\u6211\u559c\u6b22\u4fc4\u7f57\u65af"},"5":{"Display":"\u6211\u559c\u6b22\u4e2d\u56fd"}},"Answers":{"1":{"Display":"\u5f3a\u70c8\u53cd\u5bf9"},"2":{"Display":"\u4e0d\u540c\u610f"},"3":{"Display":"\u6709\u70b9\u4e0d\u540c\u610f"},"4":{"Display":"\u65e2\u4e0d\u540c\u610f\u4e5f\u4e0d\u53cd\u5bf9"},"5":{"Display":"\u6709\u70b9\u540c\u610f"},"6":{"Display":"\u540c\u610f"},"7":{"Display":"\u975e\u5e38\u540c\u610f"}}}},"NextChoiceId":6,"NextAnswerId":8,"Answers":{"1":{"Display":"1 - strongly disagree"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 - strongly agree"}},"AnswerOrder":[1,2,3,4,5,6,7],"ChoiceDataExportTags":false,"QuestionText_Unsafe":"[Q10.1] Now you will be asked to indicate the extent of your agreement with the following statements, where 1 = Strongly disagree and 7 = Strongly agree (1-7 scale)"}},{"SurveyID":"SV_ehNvPC5ntZii634","Element":"SQ","PrimaryAttribute":"QID40","SecondaryAttribute":"Interactive Module 1. Building Your Shield Against Information Attacks. You might have noticed th...","TertiaryAttribute":null,"Payload":{"QuestionText":"Interactive Module 1.<br>\n<br>\n<strong>Building Your Shield Against Information Attacks.<\/strong><br>\n<br>\nYou might have noticed that every day, people are exposed to information trying to shape&nbsp;their beliefs. Sometimes, foreign actors deliberately spread misleading content to manipulate people. Recognising these patterns is the first defence against foreign manipulation by deceptive news and social media. The following section aims to strengthen our protection against deliberate information attacks. Independent security advisors say that the most important tactic to spot is the DISMISS tactic.","DefaultChoices":false,"DataExportTag":"IM1.1 ","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Interactive Module 1. Building Your Shield Against Information Attacks. You might have noticed th...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":{"AR":{"QuestionText":"\u00a0<br \/>\n\u0627\u0644\u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u0641\u0627\u0639\u0644\u064a\u0629 1.<br \/>\n<br \/>\n<strong>\u0628\u0646\u0627\u0621 \u062f\u0631\u0639\u0643 \u0636\u062f \u0647\u062c\u0645\u0627\u062a \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a.<\/strong><br \/>\n<br \/>\n\u0644\u0639\u0644\u0651\u0643 \u0644\u0627\u062d\u0638\u062a\u064e \u0623\u0646 \u0627\u0644\u0646\u0627\u0633 \u064a\u062a\u0639\u0631\u0636\u0648\u0646 \u064a\u0648\u0645\u064a\u064b\u0627 \u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a\u064d \u062a\u064f\u062d\u0627\u0648\u0644 \u0627\u0644\u062a\u0623\u062b\u064a\u0631 \u0639\u0644\u0649 \u0645\u0639\u062a\u0642\u062f\u0627\u062a\u0647\u0645. \u0623\u062d\u064a\u0627\u0646\u064b\u0627\u060c \u062a\u0646\u0634\u0631 \u062c\u0647\u0627\u062a\u064c \u0623\u062c\u0646\u0628\u064a\u0629\u064c \u0645\u062d\u062a\u0648\u0649\u064b \u0645\u064f\u0636\u0644\u0650\u0651\u0644\u064b\u0627 \u0639\u0645\u062f\u064b\u0627 \u0644\u0644\u062a\u0644\u0627\u0639\u0628 \u0628\u0627\u0644\u0646\u0627\u0633. \u064a\u064f\u0639\u062f\u0651 \u0625\u062f\u0631\u0627\u0643 \u0647\u0630\u0647 \u0627\u0644\u0623\u0646\u0645\u0627\u0637 \u0623\u0648\u0644\u064e \u062f\u0641\u0627\u0639\u064d \u0636\u062f\u0651 \u0627\u0644\u062a\u0644\u0627\u0639\u0628 \u0627\u0644\u0623\u062c\u0646\u0628\u064a\u0651 \u0639\u0628\u0631 \u0627\u0644\u0623\u062e\u0628\u0627\u0631 \u0627\u0644\u0645\u064f\u0636\u0644\u0650\u0651\u0644\u0629 \u0648\u0648\u0633\u0627\u0626\u0644 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a. \u064a\u0647\u062f\u0641 \u0627\u0644\u0642\u0633\u0645 \u0627\u0644\u062a\u0627\u0644\u064a \u0625\u0644\u0649 \u062a\u0639\u0632\u064a\u0632 \u062d\u0645\u0627\u064a\u062a\u0646\u0627 \u0645\u0646 \u0647\u062c\u0645\u0627\u062a \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0645\u064f\u062a\u0639\u0645\u064e\u0651\u062f\u0629. \u064a\u0642\u0648\u0644 \u0645\u064f\u0633\u062a\u0634\u0627\u0631\u0648 \u0627\u0644\u0623\u0645\u0646 \u0627\u0644\u0645\u064f\u0633\u062a\u0642\u0644\u0651\u0648\u0646 \u0625\u0646\u0651 \u0623\u0647\u0645\u0651 \u062a\u0643\u062a\u064a\u0643\u064d \u064a\u062c\u0628 \u0631\u0635\u062f\u0647 \u0647\u0648 \u062a\u0643\u062a\u064a\u0643 \"\u0627\u0644\u0631\u0641\u0636\".<br \/>\n\u00a0"},"BG":{"QuestionText":"\u0418\u043d\u0442\u0435\u0440\u0430\u043a\u0442\u0438\u0432\u0435\u043d \u043c\u043e\u0434\u0443\u043b 1.<br \/>\n<br \/>\n<strong>\u0418\u0437\u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0435 \u043d\u0430 \u0432\u0430\u0448\u0438\u044f \u0449\u0438\u0442 \u0441\u0440\u0435\u0449\u0443 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u0438 \u0430\u0442\u0430\u043a\u0438.<\/strong><br \/>\n<br \/>\n\u041c\u043e\u0436\u0435 \u0431\u0438 \u0441\u0442\u0435 \u0437\u0430\u0431\u0435\u043b\u044f\u0437\u0430\u043b\u0438, \u0447\u0435 \u0432\u0441\u0435\u043a\u0438 \u0434\u0435\u043d \u0445\u043e\u0440\u0430\u0442\u0430 \u0441\u0430 \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438 \u043d\u0430 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f, \u043a\u043e\u044f\u0442\u043e \u0441\u0435 \u043e\u043f\u0438\u0442\u0432\u0430 \u0434\u0430 \u043e\u0444\u043e\u0440\u043c\u0438 \u0442\u0435\u0445\u043d\u0438\u0442\u0435 \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u0438\u044f. \u041f\u043e\u043d\u044f\u043a\u043e\u0433\u0430 \u0447\u0443\u0436\u0434\u0435\u0441\u0442\u0440\u0430\u043d\u043d\u0438 <meta charset=\"UTF-8\" \/>\u0441\u0443\u0431\u0435\u043a\u0442\u0438\u00a0\u0443\u043c\u0438\u0448\u043b\u0435\u043d\u043e \u0440\u0430\u0437\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u044f\u0432\u0430\u0442 \u043f\u043e\u0434\u0432\u0435\u0436\u0434\u0430\u0449\u043e \u0441\u044a\u0434\u044a\u0440\u0436\u0430\u043d\u0438\u0435, \u0437\u0430 \u0434\u0430 \u043c\u0430\u043d\u0438\u043f\u0443\u043b\u0438\u0440\u0430\u0442 \u0445\u043e\u0440\u0430\u0442\u0430. \u0420\u0430\u0437\u043f\u043e\u0437\u043d\u0430\u0432\u0430\u043d\u0435\u0442\u043e \u043d\u0430 \u0442\u0435\u0437\u0438 \u043c\u043e\u0434\u0435\u043b\u0438 \u0435 \u043f\u044a\u0440\u0432\u0430\u0442\u0430 \u0437\u0430\u0449\u0438\u0442\u0430 \u0441\u0440\u0435\u0449\u0443 \u0447\u0443\u0436\u0434\u0435\u0441\u0442\u0440\u0430\u043d\u043d\u0430 \u043c\u0430\u043d\u0438\u043f\u0443\u043b\u0430\u0446\u0438\u044f \u0447\u0440\u0435\u0437 \u043f\u043e\u0434\u0432\u0435\u0436\u0434\u0430\u0449\u0438 \u043d\u043e\u0432\u0438\u043d\u0438 \u0438 \u0441\u043e\u0446\u0438\u0430\u043b\u043d\u0438 \u043c\u0435\u0434\u0438\u0438. \u0421\u043b\u0435\u0434\u0432\u0430\u0449\u0438\u044f\u0442 \u0440\u0430\u0437\u0434\u0435\u043b \u0438\u043c\u0430 \u0437\u0430 \u0446\u0435\u043b \u0434\u0430 \u0437\u0430\u0441\u0438\u043b\u0438 \u0437\u0430\u0449\u0438\u0442\u0430\u0442\u0430 \u043d\u0438 \u0441\u0440\u0435\u0449\u0443 \u0437\u043b\u043e\u0432\u0440\u0435\u0434\u043d\u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u0438 \u0430\u0442\u0430\u043a\u0438. \u041d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u0438 \u0441\u044a\u0432\u0435\u0442\u043d\u0438\u0446\u0438 \u043f\u043e \u0441\u0438\u0433\u0443\u0440\u043d\u043e\u0441\u0442\u0442\u0430 \u0442\u0432\u044a\u0440\u0434\u044f\u0442, \u0447\u0435 \u043d\u0430\u0439-\u0432\u0430\u0436\u043d\u0430\u0442\u0430 \u0442\u0430\u043a\u0442\u0438\u043a\u0430, \u043a\u043e\u044f\u0442\u043e \u0442\u0440\u044f\u0431\u0432\u0430 \u0434\u0430 \u0441\u0435 \u0440\u0430\u0437\u043f\u043e\u0437\u043d\u0430\u0435, \u0435 \u0442\u0430\u043a\u0442\u0438\u043a\u0430\u0442\u0430 \u201e\u041e\u0422\u0425\u0412\u042a\u0420\u041b\u042f\u041d\u0415\u201c (DISMISS)."},"DE":{"QuestionText":"Interaktives Modul 1.<br \/>\n<br \/>\n<meta charset=\"UTF-8\" \/><b>Informationsangriffe erkennen und abwehren.<\/b>\u00a0\u00a0\u00a0<br \/>\n<br \/>\nSie haben vielleicht schon bemerkt, dass Menschen t\u00e4glich Informationen ausgesetzt sind, die versuchen, ihre \u00dcberzeugungen zu beeinflussen. Manchmal verbreiten ausl\u00e4ndische Akteure gezielt irref\u00fchrende Inhalte, um Menschen zu manipulieren. Solche Muster zu erkennen ist die erste Verteidigungslinie gegen ausl\u00e4ndische Manipulation durch irref\u00fchrende Nachrichten und soziale Medien. Der folgende Abschnitt soll unseren Schutz vor gezielten Informationsangriffen st\u00e4rken. Unabh\u00e4ngige Sicherheitsberater sagen, dass die wichtigste Taktik, die es zu erkennen gilt, ist die Taktik des ABTUNS (DISMISS)."},"ET":{"QuestionText":"Interaktiivne moodul 1.<br \/>\n<br \/>\n<meta charset=\"UTF-8\" \/><b>Kaitsekilbi\u00a0loomine infor\u00fcnnakute vastu.<\/b>\u00a0\u00a0\u00a0<br \/>\n<br \/>\nV\u00f5ib-olla olete m\u00e4rganud, et iga p\u00e4ev puutuvad inimesed kokku teabega, mis p\u00fc\u00fcab kujundada nende uskumusi. M\u00f5nikord levitavad v\u00e4lismaised\u00a0osapooled\u00a0inimeste manipuleerimiseks tahtlikult eksitavat sisu. Nende mustrite \u00e4ratundmine on esimene kaitse petlike uudiste ja sotsiaalmeedia abil toimuva v\u00e4lismaise manipuleerimise vastu. J\u00e4rgmise osa eesm\u00e4rk on tugevdada meie kaitset tahtlike infor\u00fcnnakute eest. S\u00f5ltumatud turvan\u00f5ustajad \u00fctlevad, et k\u00f5ige olulisem taktika, mida m\u00e4rgata, on\u00a0MAHA SALGAMISE\u00a0(DISMISS) taktika ."},"FA":{"QuestionText":"\u00a0<br \/>\n\u0628\u062e\u0634 \u06f1 \u0633\u0648\u0644\u0627\u062a \u062a\u0639\u0627\u0645\u0644\u06cc.<br \/>\n<br \/>\n<strong>\u0627\u06cc\u062c\u0627\u062f \u0633\u067e\u0631 \u062f\u0641\u0627\u0639\u06cc \u062f\u0631 \u0628\u0631\u0627\u0628\u0631 \u062d\u0645\u0644\u0627\u062a \u0627\u0637\u0644\u0627\u0639\u0627\u062a\u06cc<\/strong><br \/>\n<br \/>\n\u0634\u0627\u06cc\u062f \u0645\u062a\u0648\u062c\u0647 \u0634\u062f\u0647 \u0628\u0627\u0634\u06cc\u062f \u06a9\u0647 \u0647\u0631 \u0631\u0648\u0632\u060c \u0645\u0631\u062f\u0645 \u062f\u0631 \u0645\u0639\u0631\u0636 \u0627\u0637\u0644\u0627\u0639\u0627\u062a\u06cc \u0642\u0631\u0627\u0631 \u0645\u06cc\u200c\u06af\u06cc\u0631\u0646\u062f \u06a9\u0647 \u062a\u0644\u0627\u0634 \u062f\u0631 \u0634\u06a9\u0644\u200c\u062f\u0647\u06cc \u0628\u0647 \u0628\u0627\u0648\u0631\u0647\u0627\u06cc\u0634\u0627\u0646 \u062f\u0627\u0631\u062f. \u06af\u0627\u0647\u06cc \u0627\u0648\u0642\u0627\u062a\u060c \u0628\u0627\u0632\u06cc\u06af\u0631\u0627\u0646 \u062e\u0627\u0631\u062c\u06cc \u0639\u0645\u062f\u0627\u064b \u0645\u062d\u062a\u0648\u0627\u06cc \u06af\u0645\u0631\u0627\u0647\u200c\u06a9\u0646\u0646\u062f\u0647\u200c\u0627\u06cc \u0631\u0627 \u0628\u0631\u0627\u06cc \u062f\u0633\u062a\u06a9\u0627\u0631\u06cc \u0645\u0631\u062f\u0645 \u0645\u0646\u062a\u0634\u0631 \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f. \u0634\u0646\u0627\u062e\u062a \u0627\u06cc\u0646 \u0627\u0644\u06af\u0648\u0647\u0627 \u0627\u0648\u0644\u06cc\u0646 \u062f\u0641\u0627\u0639 \u062f\u0631 \u0628\u0631\u0627\u0628\u0631 \u062f\u0633\u062a\u06a9\u0627\u0631\u06cc \u062e\u0627\u0631\u062c\u06cc \u062a\u0648\u0633\u0637 \u0627\u062e\u0628\u0627\u0631 \u0641\u0631\u06cc\u0628\u0646\u062f\u0647 \u0648 \u0631\u0633\u0627\u0646\u0647\u200c\u0647\u0627\u06cc \u0627\u062c\u062a\u0645\u0627\u0639\u06cc \u0627\u0633\u062a. \u0628\u062e\u0634 \u0628\u0639\u062f\u06cc \u0628\u0627 \u0647\u062f\u0641 \u062a\u0642\u0648\u06cc\u062a \u0645\u062d\u0627\u0641\u0638\u062a \u0645\u0627 \u062f\u0631 \u0628\u0631\u0627\u0628\u0631 \u062d\u0645\u0644\u0627\u062a \u0627\u0637\u0644\u0627\u0639\u0627\u062a\u06cc \u0639\u0645\u062f\u06cc \u0627\u0633\u062a. \u0645\u0634\u0627\u0648\u0631\u0627\u0646 \u0627\u0645\u0646\u06cc\u062a\u06cc \u0645\u0633\u062a\u0642\u0644 \u0645\u06cc\u200c\u06af\u0648\u06cc\u0646\u062f \u06a9\u0647 \u0645\u0647\u0645\u062a\u0631\u06cc\u0646 \u062a\u0627\u06a9\u062a\u06cc\u06a9\u06cc \u06a9\u0647 \u0628\u0627\u06cc\u062f \u062a\u0634\u062e\u06cc\u0635 \u062f\u0627\u062f\u0647 \u0634\u0648\u062f\u060c \u062a\u0627\u06a9\u062a\u06cc\u06a9 \u0631\u062f \u06a9\u0631\u062f\u0646 \u0627\u0633\u062a.<br \/>\n\u00a0"},"FR":{"QuestionText":"Module interactif 1.<br \/>\n<br \/>\n<strong>Construisez votre bouclier contre les attaques informationnelles<\/strong><strong>.<\/strong><br \/>\n<br \/>\nVous avez peut-\u00eatre remarqu\u00e9 que chaque jour, des individus sont expos\u00e9s \u00e0 des informations visant \u00e0 fa\u00e7onner leurs convictions. Parfois, des acteurs \u00e9trangers diffusent d\u00e9lib\u00e9r\u00e9ment des contenus trompeurs pour manipuler les individus. Reconna\u00eetre ces sch\u00e9mas est la premi\u00e8re d\u00e9fense contre la manipulation \u00e9trang\u00e8re par des informations et des m\u00e9dias sociaux trompeurs. La section suivante vise \u00e0 renforcer notre protection contre les attaques informationnelles d\u00e9lib\u00e9r\u00e9es. Des conseillers en s\u00e9curit\u00e9 ind\u00e9pendants affirment que la tactique la plus importante \u00e0 rep\u00e9rer est la tactique REJETER (DISMISS)."},"HU":{"QuestionText":"Interakt\u00edv modul 1.<br \/>\n<br \/>\n<strong>Pajzs ki\u00e9p\u00edt\u00e9se az inform\u00e1ci\u00f3s t\u00e1mad\u00e1sok ellen.<\/strong><br \/>\n<br \/>\nTal\u00e1n \u00e9szrevette, hogy az emberek nap mint nap olyan inform\u00e1ci\u00f3kkal tal\u00e1lkoznak, amelyek megpr\u00f3b\u00e1lj\u00e1k befoly\u00e1solni a hiedelmeiket. El\u0151fordul, hogy k\u00fclf\u00f6ldi szerepl\u0151k sz\u00e1nd\u00e9kosan f\u00e9lrevezet\u0151 tartalmakat terjesztenek, hogy manipul\u00e1lj\u00e1k az embereket. Ezen mint\u00e1k felismer\u00e9se az els\u0151dleges v\u00e9dekez\u00e9s a megt\u00e9veszt\u0151 h\u00edrek \u00e9s a k\u00f6z\u00f6ss\u00e9gi m\u00e9dia \u00e1ltali k\u00fclf\u00f6ldi manipul\u00e1ci\u00f3 ellen. A k\u00f6vetkez\u0151 szakasz c\u00e9lja, hogy meger\u0151s\u00edtse v\u00e9delm\u00fcnket a sz\u00e1nd\u00e9kos inform\u00e1ci\u00f3s t\u00e1mad\u00e1sokkal szemben. F\u00fcggetlen biztons\u00e1gi tan\u00e1csad\u00f3k szerint a legfontosabb felismerend\u0151 taktika a\n<p><b>Elutas\u00edt\u00e1s <\/b>(DISMISS) taktika.<\/p>\n"},"IT":{"QuestionText":"Modulo interattivo 1.<br \/>\n<br \/>\n<strong>Costruisci il tuo scudo contro gli attacchi informatici.<\/strong><br \/>\n<br \/>\nPotreste aver notato che ogni giorno le persone sono esposte a informazioni che cercano di plasmare le loro convinzioni. A volte, attori stranieri diffondono deliberatamente contenuti fuorvianti per manipolare le persone. Riconoscere questi schemi \u00e8 la prima difesa contro la manipolazione straniera tramite notizie ingannevoli e social media. La sezione seguente mira a rafforzare la nostra protezione contro gli attacchi informatici intenzionali. I consulenti di sicurezza indipendenti affermano che la tattica pi\u00f9 importante da individuare \u00e8 la tattica del RIFIUTARE (DISMISS)."},"KAT":{"QuestionText":"\u10d8\u10dc\u10e2\u10d4\u10e0\u10d0\u10e5\u10e2\u10d8\u10e3\u10da\u10d8 \u10db\u10dd\u10d3\u10e3\u10da\u10d8 1.<br \/>\n<br \/>\n<strong>\u10d8\u10dc\u10e4\u10dd\u10e0\u10db\u10d0\u10ea\u10d8\u10e3\u10da\u10d8 \u10d7\u10d0\u10d5\u10d3\u10d0\u10e1\u10ee\u10db\u10d4\u10d1\u10d8\u10e1\u10d2\u10d0\u10dc \u10d7\u10e5\u10d5\u10d4\u10dc\u10d8 \u10e4\u10d0\u10e0\u10d8\u10e1 \u10e8\u10d4\u10e5\u10db\u10dc\u10d0.\u00a0\u00a0 <\/strong><br \/>\n<br \/>\n\u10e8\u10d4\u10e1\u10d0\u10eb\u10da\u10dd\u10d0 \u10e8\u10d4\u10d2\u10d8\u10db\u10e9\u10dc\u10d4\u10d5\u10d8\u10d0\u10d7, \u10e0\u10dd\u10db \u10e7\u10dd\u10d5\u10d4\u10da\u10d3\u10e6\u10d8\u10e3\u10e0\u10d0\u10d3 \u10d0\u10d3\u10d0\u10db\u10d8\u10d0\u10dc\u10d4\u10d1\u10d8 \u10d4\u10ea\u10dc\u10dd\u10d1\u10d8\u10d0\u10dc \u10d8\u10dc\u10e4\u10dd\u10e0\u10db\u10d0\u10ea\u10d8\u10d0\u10e1, \u10e0\u10dd\u10db\u10d4\u10da\u10d8\u10ea \u10db\u10d0\u10d7\u10d8 \u10e8\u10d4\u10ee\u10d4\u10d3\u10e3\u10da\u10d4\u10d1\u10d4\u10d1\u10d8\u10e1 \u10e9\u10d0\u10db\u10dd\u10e7\u10d0\u10da\u10d8\u10d1\u10d4\u10d1\u10d0\u10e1 \u10ea\u10d3\u10d8\u10da\u10dd\u10d1\u10e1. \u10d6\u10dd\u10d2\u10ef\u10d4\u10e0 \u10e3\u10ea\u10ee\u10dd\u10d4\u10da\u10d8 \u10d0\u10e5\u10e2\u10dd\u10e0\u10d4\u10d1\u10d8 \u10d2\u10d0\u10dc\u10d6\u10e0\u10d0\u10ee \u10d0\u10d5\u10e0\u10ea\u10d4\u10da\u10d4\u10d1\u10d4\u10dc \u10e8\u10d4\u10ea\u10d3\u10dd\u10db\u10d0\u10e8\u10d8 \u10e8\u10d4\u10db\u10e7\u10d5\u10d0\u10dc \u10d9\u10dd\u10dc\u10e2\u10d4\u10dc\u10e2\u10e1 \u10d0\u10d3\u10d0\u10db\u10d8\u10d0\u10dc\u10d4\u10d1\u10d8\u10e1 \u10db\u10d0\u10dc\u10d8\u10de\u10e3\u10da\u10d8\u10e0\u10d4\u10d1\u10d8\u10e1\u10d7\u10d5\u10d8\u10e1. \u10d0\u10db \u10dc\u10d8\u10db\u10e3\u10e8\u10d4\u10d1\u10d8\u10e1 \u10d0\u10db\u10dd\u10ea\u10dc\u10dd\u10d1\u10d0 \u10de\u10d8\u10e0\u10d5\u10d4\u10da\u10d8 \u10d3\u10d0\u10ea\u10d5\u10d0\u10d0 \u10e8\u10d4\u10ea\u10d3\u10dd\u10db\u10d0\u10e8\u10d8 \u10e8\u10d4\u10db\u10e7\u10d5\u10d0\u10dc\u10d8 \u10d0\u10db\u10d1\u10d4\u10d1\u10d8\u10d7\u10d0 \u10d3\u10d0 \u10e1\u10dd\u10ea\u10d8\u10d0\u10da\u10e3\u10e0\u10d8 \u10db\u10d4\u10d3\u10d8\u10d8\u10d7 \u10e3\u10ea\u10ee\u10dd\u10e3\u10e0\u10d8 \u10db\u10d0\u10dc\u10d8\u10de\u10e3\u10da\u10d0\u10ea\u10d8\u10d4\u10d1\u10d8\u10e1\u10d2\u10d0\u10dc. \u10e8\u10d4\u10db\u10d3\u10d4\u10d2\u10d8 \u10dc\u10d0\u10ec\u10d8\u10da\u10d8\u10e1 \u10db\u10d8\u10d6\u10d0\u10dc\u10d8\u10d0 \u10d2\u10d0\u10d0\u10eb\u10da\u10d8\u10d4\u10e0\u10dd\u10e1 \u10e9\u10d5\u10d4\u10dc\u10d8 \u10d3\u10d0\u10ea\u10d5\u10d0 \u10d2\u10d0\u10dc\u10d6\u10e0\u10d0\u10ee \u10e1\u10d0\u10d8\u10dc\u10e4\u10dd\u10e0\u10db\u10d0\u10ea\u10d8\u10dd \u10d7\u10d0\u10d5\u10d3\u10d0\u10e1\u10ee\u10db\u10d4\u10d1\u10d8\u10e1\u10d2\u10d0\u10dc. \u10e3\u10e1\u10d0\u10e4\u10e0\u10d7\u10ee\u10dd\u10d4\u10d1\u10d8\u10e1 \u10d3\u10d0\u10db\u10dd\u10e3\u10d9\u10d8\u10d3\u10d4\u10d1\u10d4\u10da\u10d8 \u10d4\u10e5\u10e1\u10de\u10d4\u10e0\u10e2\u10d4\u10d1\u10d8 \u10d0\u10db\u10d1\u10dd\u10d1\u10d4\u10dc, \u10e0\u10dd\u10db \u10e7\u10d5\u10d4\u10da\u10d0\u10d6\u10d4 \u10db\u10dc\u10d8\u10e8\u10d5\u10dc\u10d4\u10da\u10dd\u10d5\u10d0\u10dc\u10d8 \u10e2\u10d0\u10e5\u10e2\u10d8\u10d9\u10d0, \u10e0\u10dd\u10db\u10d4\u10da\u10d8\u10ea \u10e3\u10dc\u10d3\u10d0 \u10d0\u10e6\u10db\u10dd\u10d5\u10d0\u10e9\u10d8\u10dc\u10dd\u10d7 \u10e1\u10d0\u10d8\u10dc\u10e4\u10dd\u10e0\u10db\u10d0\u10ea\u10d8\u10dd \u10e8\u10d4\u10e2\u10d4\u10d5\u10d0, \u10d0\u10e0\u10d8\u10e1 DISMISS \u10e2\u10d0\u10e5\u10e2\u10d8\u10d9\u10d0."},"LT":{"QuestionText":"Interaktyvus modulis 1.<br \/>\n<br \/>\n<strong>Kurkite savo skyd\u0105 nuo informacini\u0173 atak\u0173.<\/strong><br \/>\n<br \/>\n<meta charset=\"UTF-8\" \/>\n<p data-pm-slice=\"1 1 []\">Galb\u016bt pasteb\u0117jote, kad kiekvien\u0105 dien\u0105 \u017emon\u0117s susiduria su informacija, kuria bandoma formuoti j\u0173 \u012fsitikinimus. Kartais prie\u0161i\u0161kos u\u017esienio \u0161alys s\u0105moningai skleid\u017eia klaidinant\u012f turin\u012f, kad manipuliuot\u0173 \u017emon\u0117mis. \u0160i\u0173 taktik\u0173 atpa\u017einimas yra pirmoji gynyba nuo u\u017esienio manipuliavimo apgaulingomis naujienomis ir socialine \u017einiasklaida. \u0160iame skyriuje siekiama sustiprinti m\u016bs\u0173 apsaug\u0105 nuo ty\u010dini\u0173 informacini\u0173 atak\u0173. Nepriklausomi saugumo patar\u0117jai teigia, kad svarbiausia pasteb\u0117ti yra SUMENKINIMO taktik\u0105.\u00a0<\/p>\n"},"LV":{"QuestionText":"Interakt\u012bvais modulis 1.<br \/>\n<br \/>\n<meta charset=\"UTF-8\" \/><b>Veidojiet savu vairogu pret inform\u0101cijas uzbrukumiem.<\/b>\u00a0\u00a0\u00a0<br \/>\n<br \/>\nJ\u016bs, iesp\u0113jams, esat paman\u012bju\u0161i, ka katru dienu cilv\u0113ki tiek pak\u013cauti inform\u0101cijai, kas cen\u0161as veidot vi\u0146u uzskatus. Da\u017ereiz \u0101rvalstu aktori apzin\u0101ti izplata maldino\u0161u saturu, lai manipul\u0113tu ar cilv\u0113kiem. \u0160o mode\u013cu atpaz\u012b\u0161ana ir pirm\u0101 aizsardz\u012bba pret \u0101rvalstu manipul\u0101cij\u0101m, ko veic maldino\u0161as zi\u0146as un soci\u0101lie mediji. N\u0101kam\u0101s sada\u013cas m\u0113r\u0137is ir stiprin\u0101t m\u016bsu aizsardz\u012bbu pret apzin\u0101tiem inform\u0101cijas uzbrukumiem. Neatkar\u012bgi dro\u0161\u012bbas konsultanti apgalvo, ka vissvar\u012bg\u0101k\u0101 taktika, kas j\u0101atpaz\u012bst, ir DISMISS (NORAID\u012a\u0160ANAS) taktika."},"NL":{"QuestionText":"Interactieve module 1.<br \/>\n<br \/>\n<strong>Een schild bouwen tegen informatieaanvallen.\u00a0\u00a0<\/strong><br \/>\n<br \/>\nU hebt misschien gemerkt dat we dagelijks worden blootgesteld aan informatie die onze overtuigingen probeert te be\u00efnvloeden. Soms verspreiden buitenlandse actoren opzettelijk misleidende content om mensen te manipuleren. Het herkennen van deze patronen is de eerste verdediging tegen buitenlandse manipulatie door misleidend nieuws en sociale media. De volgende sectie heeft als doel onze bescherming tegen opzettelijke informatieaanvallen te versterken. Onafhankelijke beveiligingsadviseurs zeggen dat de DISMISS-tactiek de belangrijkste tactiek is om te herkennen."},"PL":{"QuestionText":"Modu\u0142 interaktywny 1.<br \/>\n<br \/>\n<strong>Budowanie ochrony przed atakami informacyjnymi.<\/strong><br \/>\n<br \/>\nBy\u0107 mo\u017ce zauwa\u017cy\u0142e\u015b\/a\u015b, \u017ce ka\u017cdego dnia ludzie s\u0105 nara\u017ceni na informacje pr\u00f3buj\u0105ce kszta\u0142towa\u0107 ich przekonania. Czasami zagraniczni aktorzy celowo rozpowszechniaj\u0105 wprowadzaj\u0105ce w b\u0142\u0105d tre\u015bci, aby manipulowa\u0107 lud\u017ami. Rozpoznanie tych wzorc\u00f3w to pierwsza linia obrony przed zagraniczn\u0105 manipulacj\u0105 za pomoc\u0105 fa\u0142szywych wiadomo\u015bci i medi\u00f3w spo\u0142eczno\u015bciowych. Poni\u017csza sekcja ma na celu wzmocnienie naszej ochrony przed celowymi atakami informacyjnymi. Eksperci ds. bezpiecze\u0144stwa twierdz\u0105, \u017ce najwa\u017cniejsz\u0105 taktyk\u0105, kt\u00f3r\u0105 nale\u017cy zidentyfikowa\u0107, jest taktyka ODRZUCANIA."},"RU":{"QuestionText":"\u0418\u043d\u0442\u0435\u0440\u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u043c\u043e\u0434\u0443\u043b\u044c 1.<br \/>\n<br \/>\n<strong>\u0421\u043e\u0437\u0434\u0430\u0439\u0442\u0435 \u0449\u0438\u0442 \u043f\u0440\u043e\u0442\u0438\u0432 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u0430\u0442\u0430\u043a.<\/strong><br \/>\n<br \/>\n\u0412\u044b, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0437\u0430\u043c\u0435\u0447\u0430\u043b\u0438, \u0447\u0442\u043e \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c \u043b\u044e\u0434\u0438 \u0441\u0442\u0430\u043b\u043a\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u0441 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0435\u0439, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u044b\u0442\u0430\u0435\u0442\u0441\u044f \u0441\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0438\u0445 \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u0438\u044f. \u0418\u043d\u043e\u0433\u0434\u0430 \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0435 \u0441\u0443\u0431\u044a\u0435\u043a\u0442\u044b \u043d\u0430\u043c\u0435\u0440\u0435\u043d\u043d\u043e \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u044f\u044e\u0442 \u0432\u0432\u043e\u0434\u044f\u0449\u0438\u0439 \u0432 \u0437\u0430\u0431\u043b\u0443\u0436\u0434\u0435\u043d\u0438\u0435 \u043a\u043e\u043d\u0442\u0435\u043d\u0442, \u0447\u0442\u043e\u0431\u044b \u043c\u0430\u043d\u0438\u043f\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c <meta charset=\"UTF-8\" \/>\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u043c\u043d\u0435\u043d\u0438\u0435\u043c. \u0420\u0430\u0441\u043f\u043e\u0437\u043d\u0430\u0432\u0430\u043d\u0438\u0435 \u044d\u0442\u0438\u0445 \u0437\u0430\u043a\u043e\u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0441\u0442\u0435\u0439 \u2014 \u043f\u0435\u0440\u0432\u0430\u044f \u0437\u0430\u0449\u0438\u0442\u0430 \u043e\u0442 \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0445 \u043c\u0430\u043d\u0438\u043f\u0443\u043b\u044f\u0446\u0438\u0439 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043b\u043e\u0436\u043d\u044b\u0445 \u043d\u043e\u0432\u043e\u0441\u0442\u0435\u0439 \u0438 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u0441\u0435\u0442\u0435\u0439. <meta charset=\"UTF-8\" \/>\u0421\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0440\u0430\u0437\u0434\u0435\u043b \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d \u043d\u0430 \u0443\u0441\u0438\u043b\u0435\u043d\u0438\u0435 \u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u043e\u0441\u0442\u0438 \u043a \u0446\u0435\u043b\u0435\u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u043c \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u043c \u0430\u0442\u0430\u043a\u0430\u043c. \u041d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0435 \u044d\u043a\u0441\u043f\u0435\u0440\u0442\u044b \u043f\u043e \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044e\u0442, \u0447\u0442\u043e \u043e\u0434\u043d\u0430 \u0438\u0437 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0445 \u0442\u0430\u043a\u0442\u0438\u043a, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0443\u043c\u0435\u0442\u044c \u0440\u0430\u0441\u043f\u043e\u0437\u043d\u0430\u0432\u0430\u0442\u044c, \u2014 \u044d\u0442\u043e \u0442\u0430\u043a\u0442\u0438\u043a\u0430\u00a0<strong data-end=\"729\" data-start=\"713\">\u041e\u0422\u0412\u0415\u0420\u0416\u0415\u041d\u0418\u042f (<\/strong><strong>DISMISS)<\/strong>."},"SR":{"QuestionText":"\u0418\u043d\u0442\u0435\u0440\u0430\u043a\u0442\u0438\u0432\u043d\u0438 \u043c\u043e\u0434\u0443\u043b 1.<br \/>\n<br \/>\n<strong>\u0418\u0437\u0433\u0440\u0430\u0434\u045a\u0430 \u0432\u0430\u0448\u0435\u0433 \u0448\u0442\u0438\u0442\u0430 \u043f\u0440\u043e\u0442\u0438\u0432 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u0438\u0445 \u043d\u0430\u043f\u0430\u0434\u0430.<\/strong><br \/>\n<br \/>\n\u041c\u043e\u0436\u0434\u0430 \u0441\u0442\u0435 \u043f\u0440\u0438\u043c\u0435\u0442\u0438\u043b\u0438 \u0434\u0430 \u0441\u0443 \u0459\u0443\u0434\u0438 \u0441\u0432\u0430\u043a\u043e\u0434\u043d\u0435\u0432\u043d\u043e \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0458\u0430\u043c\u0430 \u043a\u043e\u0458\u0435 \u043f\u043e\u043a\u0443\u0448\u0430\u0432\u0430\u0458\u0443 \u0434\u0430 \u043e\u0431\u043b\u0438\u043a\u0443\u0458\u0443 \u045a\u0438\u0445\u043e\u0432\u0430 \u0443\u0432\u0435\u0440\u0435\u045a\u0430. \u041f\u043e\u043d\u0435\u043a\u0430\u0434 \u0441\u0442\u0440\u0430\u043d\u0438 \u0430\u043a\u0442\u0435\u0440\u0438 \u043d\u0430\u043c\u0435\u0440\u043d\u043e \u0448\u0438\u0440\u0435 \u043e\u0431\u043c\u0430\u045a\u0443\u0458\u0443\u045b\u0438 \u0441\u0430\u0434\u0440\u0436\u0430\u0458 \u043a\u0430\u043a\u043e \u0431\u0438 \u043c\u0430\u043d\u0438\u043f\u0443\u043b\u0438\u0441\u0430\u043b\u0438 \u0459\u0443\u0434\u0438\u043c\u0430. \u041f\u0440\u0435\u043f\u043e\u0437\u043d\u0430\u0432\u0430\u045a\u0435 \u043e\u0432\u0438\u0445 \u043e\u0431\u0440\u0430\u0437\u0430\u0446\u0430 \u0458\u0435 \u043f\u0440\u0432\u0430 \u043e\u0434\u0431\u0440\u0430\u043d\u0430 \u043e\u0434 \u0441\u0442\u0440\u0430\u043d\u0435 \u043c\u0430\u043d\u0438\u043f\u0443\u043b\u0430\u0446\u0438\u0458\u0435 \u043f\u0443\u0442\u0435\u043c \u043e\u0431\u043c\u0430\u045a\u0443\u0458\u0443\u045b\u0438\u0445 \u0432\u0435\u0441\u0442\u0438 \u0438 \u0434\u0440\u0443\u0448\u0442\u0432\u0435\u043d\u0438\u0445 \u043c\u0435\u0434\u0438\u0458\u0430. \u0421\u043b\u0435\u0434\u0435\u045b\u0438 \u043e\u0434\u0435\u0459\u0430\u043a \u0438\u043c\u0430 \u0437\u0430 \u0446\u0438\u0459 \u0434\u0430 \u043e\u0458\u0430\u0447\u0430 \u043d\u0430\u0448\u0443 \u0437\u0430\u0448\u0442\u0438\u0442\u0443 \u043e\u0434 \u043d\u0430\u043c\u0435\u0440\u043d\u0438\u0445 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u0438\u0445 \u043d\u0430\u043f\u0430\u0434\u0430. \u041d\u0435\u0437\u0430\u0432\u0438\u0441\u043d\u0438 \u0441\u0430\u0432\u0435\u0442\u043d\u0438\u0446\u0438 \u0437\u0430 \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442 \u043a\u0430\u0436\u0443 \u0434\u0430 \u0458\u0435 \u043d\u0430\u0458\u0432\u0430\u0436\u043d\u0438\u0458\u0430 \u0442\u0430\u043a\u0442\u0438\u043a\u0430 \u043a\u043e\u0458\u0443 \u0442\u0440\u0435\u0431\u0430 \u0443\u043e\u0447\u0438\u0442\u0438 \u0442\u0430\u043a\u0442\u0438\u043a\u0430 \u041e\u0414\u0411\u0410\u0426\u0418\u0412\u0410\u040a\u0410 (DISMISS)."},"TR":{"QuestionText":"Etkile\u015fimli Mod\u00fcl 1.<br \/>\n<br \/>\n<strong>Bilgi Sald\u0131r\u0131lar\u0131na Kar\u015f\u0131 Kalkan\u0131n\u0131z\u0131 Olu\u015fturun.<\/strong><br \/>\n<br \/>\n\u0130nsanlar\u0131n inan\u00e7lar\u0131n\u0131 \u015fekillendirmeye \u00e7al\u0131\u015fan bilgilere her g\u00fcn maruz kald\u0131\u011f\u0131n\u0131 fark etmi\u015f olabilirsiniz. Bazen yabanc\u0131 akt\u00f6rler, insanlar\u0131 manip\u00fcle etmek i\u00e7in kas\u0131tl\u0131 olarak yan\u0131lt\u0131c\u0131 i\u00e7erikler yaymaktad\u0131r. Bu kal\u0131plar\u0131 fark etmek, aldat\u0131c\u0131 haberler ve sosyal medya arac\u0131l\u0131\u011f\u0131yla yabanc\u0131 manip\u00fclasyonuna kar\u015f\u0131 ilk savunmad\u0131r. A\u015fa\u011f\u0131daki b\u00f6l\u00fcm, kas\u0131tl\u0131 bilgi sald\u0131r\u0131lar\u0131na kar\u015f\u0131 korumam\u0131z\u0131 g\u00fc\u00e7lendirmeyi ama\u00e7lamaktad\u0131r. Ba\u011f\u0131ms\u0131z g\u00fcvenlik dan\u0131\u015fmanlar\u0131, tespit edilmesi gereken en \u00f6nemli takti\u011fin <meta charset=\"UTF-8\" \/>DE\u011eERS\u0130Z G\u00d6STERME takti\u011fi oldu\u011funu s\u00f6yl\u00fcyor."},"UK":{"QuestionText":"\u0406\u043d\u0442\u0435\u0440\u0430\u043a\u0442\u0438\u0432\u043d\u0438\u0439 \u043c\u043e\u0434\u0443\u043b\u044c 1.<br \/>\n<br \/>\n<!--%3Cmeta%20charset%3D%22UTF-8%22%20%2F%3E-->\n<p data-end=\"41\" data-start=\"0\"><strong>\u0411\u0443\u0434\u0443\u0454\u043c\u043e \u0432\u0430\u0448 \u0449\u0438\u0442 \u043f\u0440\u043e\u0442\u0438 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u0439\u043d\u0438\u0445 \u0430\u0442\u0430\u043a.<\/strong><br \/>\n\u00a0<\/p>\n\n<p data-end=\"541\" data-is-last-node=\"\" data-is-only-node=\"\" data-start=\"43\">\u041c\u043e\u0436\u043b\u0438\u0432\u043e, \u0432\u0438 \u043f\u043e\u043c\u0456\u0447\u0430\u043b\u0438, \u0449\u043e \u0449\u043e\u0434\u043d\u044f \u043b\u044e\u0434\u0438 \u043f\u0456\u0434\u0434\u0430\u044e\u0442\u044c\u0441\u044f \u0432\u043f\u043b\u0438\u0432\u0443 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u0457, \u044f\u043a\u0430 \u043d\u0430\u043c\u0430\u0433\u0430\u0454\u0442\u044c\u0441\u044f \u0444\u043e\u0440\u043c\u0443\u0432\u0430\u0442\u0438 \u0457\u0445\u043d\u0456 \u043f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u043d\u043d\u044f. \u0406\u043d\u043e\u0434\u0456 \u0456\u043d\u043e\u0437\u0435\u043c\u043d\u0456 \u0430\u043a\u0442\u043e\u0440\u0438 \u0441\u0432\u0456\u0434\u043e\u043c\u043e \u043f\u043e\u0448\u0438\u0440\u044e\u044e\u0442\u044c \u043e\u043c\u0430\u043d\u043b\u0438\u0432\u0438\u0439 \u043a\u043e\u043d\u0442\u0435\u043d\u0442, \u0449\u043e\u0431 \u043c\u0430\u043d\u0456\u043f\u0443\u043b\u044e\u0432\u0430\u0442\u0438 \u043b\u044e\u0434\u044c\u043c\u0438. \u0412\u0438\u044f\u0432\u043b\u0435\u043d\u043d\u044f \u0442\u0430\u043a\u0438\u0445 \u0441\u0445\u0435\u043c \u2014 \u043f\u0435\u0440\u0448\u0438\u0439 \u0437\u0430\u0445\u0438\u0441\u0442 \u0432\u0456\u0434 \u0456\u043d\u043e\u0437\u0435\u043c\u043d\u043e\u0457 \u043c\u0430\u043d\u0456\u043f\u0443\u043b\u044f\u0446\u0456\u0457 \u0447\u0435\u0440\u0435\u0437 \u0444\u0435\u0439\u043a\u043e\u0432\u0456 \u043d\u043e\u0432\u0438\u043d\u0438 \u0442\u0430 \u0441\u043e\u0446\u0456\u0430\u043b\u044c\u043d\u0456 \u043c\u0435\u0440\u0435\u0436\u0456. \u041d\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u0440\u043e\u0437\u0434\u0456\u043b \u043c\u0430\u0454 \u043d\u0430 \u043c\u0435\u0442\u0456 \u043f\u043e\u0441\u0438\u043b\u0438\u0442\u0438 \u043d\u0430\u0448 \u0437\u0430\u0445\u0438\u0441\u0442 \u0432\u0456\u0434 \u043d\u0430\u0432\u043c\u0438\u0441\u043d\u0438\u0445 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u0439\u043d\u0438\u0445 \u0430\u0442\u0430\u043a. \u041d\u0435\u0437\u0430\u043b\u0435\u0436\u043d\u0456 \u0435\u043a\u0441\u043f\u0435\u0440\u0442\u0438 \u0437 \u0431\u0435\u0437\u043f\u0435\u043a\u0438 \u0437\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0442\u044c, \u0449\u043e \u043d\u0430\u0439\u0432\u0430\u0436\u043b\u0438\u0432\u0456\u0448\u043e\u044e \u0442\u0430\u043a\u0442\u0438\u043a\u043e\u044e \u0434\u043b\u044f \u0440\u043e\u0437\u043f\u0456\u0437\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0454 \u0442\u0430\u043a\u0442\u0438\u043a\u0430 <strong>\u0412\u0406\u0414\u0425\u0418\u041b\u0415\u041d\u041d\u042f (DISMISS).<\/strong><\/p>\n"},"ZH-S":{"QuestionText":"<meta charset=\"UTF-8\" \/>\u4ea4\u4e92\u5f0f\u6a21\u5757\u00a01.\u00a0\u00a0<br \/>\n\u00a0\u00a0<br \/>\n<b>\u6253\u9020\u4fe1\u606f\u9632\u62a4\u76fe\u3002\u00a0\u00a0<\/b>\u00a0\u00a0\u00a0\u00a0<br \/>\n<br \/>\n\u60a8\u53ef\u80fd\u5df2\u7ecf\u6ce8\u610f\u5230\uff0c\u6211\u4eec\u6bcf\u5929\u63a5\u89e6\u7684\u4fe1\u606f\u90fd\u5728\u8bd5\u56fe\u5851\u9020\u6211\u4eec\u7684\u8ba4\u77e5\u3002\u6709\u65f6\uff0c\u5916\u56fd\u52bf\u529b\u4f1a\u6545\u610f\u6563\u64ad\u8bef\u5bfc\u6027\u5185\u5bb9\u6765\u64cd\u7eb5\u6c11\u4f17\u3002\u8bc6\u522b\u8fd9\u4e9b\u64cd\u7eb5\u6a21\u5f0f\uff0c\u6b63\u662f\u9632\u8303\u5883\u5916\u865a\u5047\u65b0\u95fb\u548c\u793e\u4ea4\u5a92\u4f53\u7684\u7b2c\u4e00\u6b65\u3002\u672c\u6a21\u5757\u65e8\u5728\u589e\u5f3a\u6211\u4eec\u5e94\u5bf9\u6076\u610f\u4fe1\u606f\u653b\u51fb\u7684\u80fd\u529b\u3002\u636e\u72ec\u7acb\u5b89\u5168\u987e\u95ee\u5206\u6790\uff0c\u6700\u9700\u8981\u8b66\u60d5\u7684\u5c31\u662f\u201c\u9a73\u65a5\u201d\u6218\u672f\u3002"}},"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID40","QuestionText_Unsafe":"Interactive Module 1.<br>\n<br>\n<strong>Building Your Shield Against Information Attacks.<\/strong><br>\n<br>\nYou might have noticed that every day, people are exposed to information trying to shape&nbsp;their beliefs. Sometimes, foreign actors deliberately spread misleading content to manipulate people. Recognising these patterns is the first defence against foreign manipulation by deceptive news and social media. The following section aims to strengthen our protection against deliberate information attacks. Independent security advisors say that the most important tactic to spot is the DISMISS tactic.","DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">C<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> dismiss <\/span>","LeftOperand":"C","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"dismiss","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_ehNvPC5ntZii634","Element":"SQ","PrimaryAttribute":"QID41","SecondaryAttribute":"Please confirm your consent to participate in this study:","TertiaryAttribute":null,"Payload":{"QuestionText":"Please confirm your <strong>consent<\/strong> to participate in this study:","DefaultChoices":false,"DataExportTag":"Consent","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please confirm your consent to participate in this study:","Choices":{"1":{"Display":"Yes, I agree to participate. Please proceed with the survey."},"2":{"Display":"No, I do not agree to participate. Please end the survey."}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":{"AR":{"QuestionText":"\u064a\u0631\u062c\u0649 \u062a\u0623\u0643\u064a\u062f <strong>\u0645\u0648\u0627\u0641\u0642\u062a\u0643<\/strong> \u0639\u0644\u0649 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u062f\u0631\u0627\u0633\u0629:","Choices":{"1":{"Display":"\u0646\u0639\u0645\u060c \u0623\u0648\u0627\u0641\u0642 \u0639\u0644\u0649 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629. \u064a\u064f\u0631\u062c\u0649 \u0645\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u0627\u0633\u062a\u0628\u064a\u0627\u0646."},"2":{"Display":"\u0644\u0627\u060c \u0644\u0627 \u0623\u0648\u0627\u0641\u0642 \u0639\u0644\u0649 \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629. \u064a\u064f\u0631\u062c\u0649 \u0625\u0646\u0647\u0627\u0621 \u0627\u0644\u0627\u0633\u062a\u0628\u064a\u0627\u0646."}}},"BG":{"QuestionText":"\u041c\u043e\u043b\u044f, \u043f\u043e\u0442\u0432\u044a\u0440\u0434\u0435\u0442\u0435 <strong>\u0441\u044a\u0433\u043b\u0430\u0441\u0438\u0435\u0442\u043e<\/strong> \u0441\u0438 \u0437\u0430 \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \u0442\u043e\u0432\u0430 \u043f\u0440\u043e\u0443\u0447\u0432\u0430\u043d\u0435:","Choices":{"1":{"Display":"\u0414\u0430, \u0441\u044a\u0433\u043b\u0430\u0441\u0435\u043d\/\u0441\u044a\u0433\u043b\u0430\u0441\u043d\u0430 \u0441\u044a\u043c \u0434\u0430 \u0443\u0447\u0430\u0441\u0442\u0432\u0430\u043c. \u041c\u043e\u043b\u044f, \u043f\u0440\u043e\u0434\u044a\u043b\u0436\u0435\u0442\u0435 \u0441 \u0430\u043d\u043a\u0435\u0442\u0430\u0442\u0430."},"2":{"Display":"\u041d\u0435, \u043d\u0435 \u0441\u044a\u043c \u0441\u044a\u0433\u043b\u0430\u0441\u0435\u043d\/\u0441\u044a\u0433\u043b\u0430\u0441\u043d\u0430 \u0434\u0430 \u0443\u0447\u0430\u0441\u0442\u0432\u0430\u043c. \u041c\u043e\u043b\u044f, \u043f\u0440\u0435\u043a\u0440\u0430\u0442\u0435\u0442\u0435 \u0430\u043d\u043a\u0435\u0442\u0430\u0442\u0430."}}},"DE":{"QuestionText":"Bitte best\u00e4tigen Sie Ihr <strong>Einverst\u00e4ndnis<\/strong> zur Teilnahme an dieser Studie:","Choices":{"1":{"Display":"<meta charset=\"UTF-8\" \/>Ja, ich stimme der Teilnahme an dieser Umfrage zu. Bitte fahren Sie fort.\u00a0\u00a0"},"2":{"Display":"<meta charset=\"UTF-8\" \/>Nein, ich stimme der Teilnahme an dieser Umfrage nicht zu. Bitte beenden Sie die Umfrage.\u00a0\u00a0"}}},"ET":{"QuestionText":"Palun andke oma <strong>n\u00f5usolekut<\/strong> selles uuringus osalemiseks:","Choices":{"1":{"Display":"Jah, ma n\u00f5ustun osalema. Palun j\u00e4tkake k\u00fcsitlusega."},"2":{"Display":"Ei, ma ei n\u00f5ustu osalema. Palun l\u00f5petage k\u00fcsitlus."}}},"FA":{"QuestionText":"\u0644\u0637\u0641\u0627 <strong>\u0631\u0636\u0627\u06cc\u062a<\/strong> \u062e\u0648\u062f \u0631\u0627 \u0628\u0631\u0627\u06cc \u0634\u0631\u06a9\u062a \u062f\u0631 \u0627\u06cc\u0646 \u0645\u0637\u0627\u0644\u0639\u0647 \u062a\u0623\u06cc\u06cc\u062f \u06a9\u0646\u06cc\u062f:","Choices":{"1":{"Display":"\u0628\u0644\u0647\u060c \u0645\u0646 \u0645\u0648\u0627\u0641\u0642\u0645 \u06a9\u0647 \u0634\u0631\u06a9\u062a \u06a9\u0646\u0645. \u0644\u0637\u0641\u0627\u064b \u0646\u0638\u0631\u0633\u0646\u062c\u06cc \u0631\u0627 \u0627\u062f\u0627\u0645\u0647 \u062f\u0647\u06cc\u062f."},"2":{"Display":"\u0646\u0647\u060c \u0645\u0646 \u0645\u0648\u0627\u0641\u0642 \u0634\u0631\u06a9\u062a \u0646\u06cc\u0633\u062a\u0645. \u0644\u0637\u0641\u0627\u064b \u0646\u0638\u0631\u0633\u0646\u062c\u06cc \u0631\u0627 \u067e\u0627\u06cc\u0627\u0646 \u062f\u0647\u06cc\u062f."}}},"FR":{"QuestionText":"Veuillez confirmer votre <strong>consentement<\/strong> \u00e0 participer \u00e0 cette \u00e9tude :","Choices":{"1":{"Display":"Oui, j&#39;accepte de participer. Veuillez poursuivre l&#39;enqu\u00eate."},"2":{"Display":"Non, je n&#39;accepte pas de participer. Veuillez mettre fin \u00e0 l&#39;enqu\u00eate."}}},"HU":{"QuestionText":"<p>K\u00e9rj\u00fck, <strong>er\u0151s\u00edtse<\/strong> meg, hogy r\u00e9szt k\u00edv\u00e1n venni a tanulm\u00e1nyban:\u00a0<\/p>\n","Choices":{"1":{"Display":"<p>Igen, r\u00e9szt k\u00edv\u00e1nok venni. K\u00e9rem, folytassa a k\u00e9rd\u0151\u00edvet.<\/p>\n"},"2":{"Display":"<p>Nem, nem k\u00edv\u00e1nok r\u00e9szt venni. K\u00e9rem, fejezze be a k\u00e9rd\u0151\u00edvet.<\/p>\n"}}},"IT":{"QuestionText":"Si prega di confermare il <strong>consenso<\/strong> a partecipare a questo studio:","Choices":{"1":{"Display":"S\u00ec, accetto di partecipare. Procedi con il sondaggio."},"2":{"Display":"No, non accetto di partecipare. Per favore, termina il sondaggio."}}},"KAT":{"QuestionText":"\u10d2\u10d7\u10ee\u10dd\u10d5\u10d7, \u10d3\u10d0\u10d0\u10d3\u10d0\u10e1\u10e2\u10e3\u10e0\u10dd\u10d7 \u10d7\u10e5\u10d5\u10d4\u10dc\u10d8 <strong>\u10d7\u10d0\u10dc\u10ee\u10db\u10dd\u10d1\u10d0<\/strong> \u10d9\u10d5\u10da\u10d4\u10d5\u10d0\u10e8\u10d8 \u10db\u10dd\u10dc\u10d0\u10ec\u10d8\u10da\u10d4\u10dd\u10d1\u10d0\u10d6\u10d4:","Choices":{"1":{"Display":"<meta charset=\"UTF-8\" \/>\u10d3\u10d8\u10d0\u10ee, \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8\u00a0\u10d9\u10d5\u10da\u10d4\u10d5\u10d0\u10e8\u10d8\u00a0\u10db\u10dd\u10dc\u10d0\u10ec\u10d8\u10da\u10d4\u10dd\u10d1\u10d0\u10e1. \u10d2\u10d7\u10ee\u10dd\u10d5\u10d7, \u10d2\u10d0\u10d0\u10d2\u10e0\u10eb\u10d4\u10da\u10dd\u10d7\u00a0\u10d2\u10d0\u10db\u10dd\u10d9\u10d8\u10d7\u10ee\u10d5\u10d0.\u00a0\u00a0"},"2":{"Display":"<meta charset=\"UTF-8\" \/>\u10d0\u10e0\u10d0, \u10d0\u10e0 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8\u00a0\u10d9\u10d5\u10da\u10d4\u10d5\u10d0\u10e8\u10d8 \u10db\u10dd\u10dc\u10d0\u10ec\u10d8\u10da\u10d4\u10dd\u10d1\u10d0\u10e1.\u00a0\u10d2\u10d7\u10ee\u10dd\u10d5\u10d7, \u10d3\u10d0\u10d0\u10e1\u10e0\u10e3\u10da\u10dd\u10d7 \u10d2\u10d0\u10db\u10dd\u10d9\u10d8\u10d7\u10ee\u10d5\u10d0.\u00a0\u00a0"}}},"LT":{"QuestionText":"Pra\u0161ome patvirtinti savo <strong>sutikim\u0105<\/strong> dalyvauti \u0161iame tyrime:","Choices":{"1":{"Display":"Taip, dalyvauti sutinku. Pra\u0161au t\u0119sti apklaus\u0105."},"2":{"Display":"Ne, dalyvauti nesutinku. Pra\u0161au baigti apklaus\u0105."}}},"LV":{"QuestionText":"L\u016bdzu, apstipriniet savu <strong>piekri\u0161anu<\/strong> dal\u012bbai \u0161aj\u0101 p\u0113t\u012bjum\u0101:","Choices":{"1":{"Display":"J\u0101, es piekr\u012btu piedal\u012bties. <meta charset=\"UTF-8\" \/>L\u016bdzu, ies\u0101ciet aptauju.\u00a0\u00a0"},"2":{"Display":"N\u0113, es nepiekr\u012btu piedal\u012bties. L\u016bdzu, beidziet aptauju."}}},"NL":{"QuestionText":"Bevestig uw <strong>toestemming<\/strong> voor deelname aan deze studie:","Choices":{"1":{"Display":"Ja, ik ga akkoord met deelname. Ga verder met de enqu\u00eate."},"2":{"Display":"Nee, ik ga niet akkoord met deelname. Sluit de enqu\u00eate af."}}},"PL":{"QuestionText":"Prosimy o potwierdzenie <strong>zgody<\/strong> na udzia\u0142 w badaniu:","Choices":{"1":{"Display":"Tak, zgadzam si\u0119 na udzia\u0142 w badaniu. Chc\u0119 kontynuowa\u0107 ankiet\u0119."},"2":{"Display":"Nie, nie zgadzam si\u0119 na udzia\u0142a badaniu. Chc\u0119 zako\u0144czy\u0107 ankiet\u0119."}}},"RU":{"QuestionText":"\u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0435 \u0441\u0432\u043e\u0435 <strong>\u0441\u043e\u0433\u043b\u0430\u0441\u0438\u0435<\/strong> \u043d\u0430 \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \u0434\u0430\u043d\u043d\u043e\u043c \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0438:","Choices":{"1":{"Display":"\u0414\u0430, \u044f \u0441\u043e\u0433\u043b\u0430\u0441\u0435\u043d \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c. \u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u0435 \u043e\u043f\u0440\u043e\u0441."},"2":{"Display":"\u041d\u0435\u0442, \u044f \u043d\u0435 \u0441\u043e\u0433\u043b\u0430\u0441\u0435\u043d \u0443\u0447\u0430\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c. \u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u043e\u043f\u0440\u043e\u0441."}}},"SR":{"QuestionText":"<meta charset=\"UTF-8\" \/>\u041c\u043e\u043b\u0438\u043c\u043e \u0432\u0430\u0441 \u0434\u0430 \u043f\u043e\u0442\u0432\u0440\u0434\u0438\u0442\u0435\u00a0<strong>\u0441\u0432\u043e\u0458\u0443<\/strong> <strong>\u0441\u0430\u0433\u043b\u0430\u0441\u043d\u043e\u0441\u0442<\/strong>\u00a0\u0437\u0430 \u0443\u0447\u0435\u0448\u045b\u0435 \u0443 \u043e\u0432\u043e\u0458 \u0441\u0442\u0443\u0434\u0438\u0458\u0438:\u00a0","Choices":{"1":{"Display":"<meta charset=\"UTF-8\" \/>\u0414\u0430,\u00a0\u043f\u0440\u0438\u0441\u0442\u0430\u0458\u0435\u043c \u0434\u0430 \u0443\u0447\u0435\u0441\u0442\u0432\u0443\u0458\u0435\u043c \u0443 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0443.\u00a0\u041c\u043e\u043b\u0438\u043c \u0432\u0430\u0441,\u00a0\u043d\u0430\u0441\u0442\u0430\u0432\u0438\u0442\u0435 \u0441\u0430 \u0430\u043d\u043a\u0435\u0442\u043e\u043c."},"2":{"Display":"<meta charset=\"UTF-8\" \/>\u041d\u0435, \u043d\u0435 \u043f\u0440\u0438\u0441\u0442\u0430\u0458\u0435\u043c \u0434\u0430 \u0443\u0447\u0435\u0441\u0442\u0432\u0443\u0458\u0435\u043c\u00a0\u0443 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0443.\u00a0\u041c\u043e\u043b\u0438\u043c \u0432\u0430\u0441,\u00a0\u0437\u0430\u0432\u0440\u0448\u0438\u0442\u0435 \u0430\u043d\u043a\u0435\u0442\u0443."}}},"TR":{"QuestionText":"L\u00fctfen bu \u00e7al\u0131\u015fmaya kat\u0131lmay\u0131 <strong>kabul<\/strong> etti\u011finizi onaylay\u0131n:","Choices":{"1":{"Display":"Evet, kat\u0131lmay\u0131 kabul ediyorum. L\u00fctfen ankete devam edin."},"2":{"Display":"Hay\u0131r, kat\u0131lmay\u0131 kabul etmiyorum. L\u00fctfen anketi sonland\u0131r\u0131n."}}},"UK":{"QuestionText":"\u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0456\u0442\u044c \u0441\u0432\u043e\u044e <strong>\u0437\u0433\u043e\u0434\u0443<\/strong> \u043d\u0430 \u0443\u0447\u0430\u0441\u0442\u044c \u0443 \u0446\u044c\u043e\u043c\u0443 \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0435\u043d\u043d\u0456:","Choices":{"1":{"Display":"\u0422\u0430\u043a, \u044f \u043f\u043e\u0433\u043e\u0434\u0436\u0443\u044e\u0441\u044f \u0432\u0437\u044f\u0442\u0438 \u0443\u0447\u0430\u0441\u0442\u044c. \u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0443\u0439\u0442\u0435 \u043e\u043f\u0438\u0442\u0443\u0432\u0430\u043d\u043d\u044f."},"2":{"Display":"\u041d\u0456, \u044f \u043d\u0435 \u0437\u0433\u043e\u0434\u0435\u043d(\u043d\u0430) \u0431\u0440\u0430\u0442\u0438 \u0443\u0447\u0430\u0441\u0442\u044c. \u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u0437\u0430\u0432\u0435\u0440\u0448\u0456\u0442\u044c \u043e\u043f\u0438\u0442\u0443\u0432\u0430\u043d\u043d\u044f."}}},"ZH-S":{"QuestionText":"\u8bf7\u786e\u8ba4\u60a8<strong>\u540c\u610f<\/strong>\u53c2\u52a0\u672c\u7814\u7a76\uff1a","Choices":{"1":{"Display":"\u662f\u7684\uff0c\u6211\u540c\u610f\u53c2\u4e0e\u3002\u8bf7\u7ee7\u7eed\u5b8c\u6210\u8c03\u67e5\u3002"},"2":{"Display":"\u4e0d\uff0c\u6211\u4e0d\u540c\u610f\u53c2\u4e0e\u3002\u8bf7\u7ed3\u675f\u8c03\u67e5\u3002"}}}},"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID41","QuestionText_Unsafe":"Please confirm your <strong>consent<\/strong> to participate in this study:"}},{"SurveyID":"SV_ehNvPC5ntZii634","Element":"SQ","PrimaryAttribute":"QID49","SecondaryAttribute":"[Q10.2] Now you will be asked to indicate the extent of your agreement with the following stateme...","TertiaryAttribute":null,"Payload":{"QuestionText":"[Q10.2] Now you will be asked to indicate the extent of your agreement with the following statements, where 1 = Strongly disagree and 7 = Strongly agree (1-7 scale)","DefaultChoices":false,"DataExportTag":"Q10.2","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"[Q10.2] Now you will be asked to indicate the extent of your agreement with the following stateme...","Choices":{"1":{"Display":"I\u2019m worried that our way of life is under attack"},"2":{"Display":"I\u2019m worried that my country is being exploited by foreign countries"},"3":{"Display":"I am angry when I think about how my country is being used by foreign countries"},"4":{"Display":"I am angry because immigration is changing our way of life for the worse"},"5":{"Display":"I feel worried because of uncontrolled immigration"},"6":{"Display":"I am worried by the spread of LGBT+ propaganda"},"7":{"Display":"I\u2019m outraged when thinking about the promotion of LGBT+ ideas"}},"ChoiceOrder":[1,2,3,4,5,6,7],"Randomization":{"Advanced":null,"ConsistentScaleReversal":true,"TotalRandSubset":"","Type":"None"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":{"AR":{"QuestionText":"[\u063310.2] \u0627\u0644\u0622\u0646 \u0633\u064a\u064f\u0637\u0644\u0628 \u0645\u0646\u0643 \u062a\u062d\u062f\u064a\u062f \u0645\u062f\u0649 \u0645\u0648\u0627\u0641\u0642\u062a\u0643 \u0639\u0644\u0649 \u0627\u0644\u0639\u0628\u0627\u0631\u0627\u062a \u0627\u0644\u062a\u0627\u0644\u064a\u0629\u060c \u062d\u064a\u062b 1 = \u0623\u062e\u062a\u0644\u0641 \u0628\u0634\u062f\u0629 \u06487 = \u0623\u0648\u0627\u0641\u0642 \u0628\u0634\u062f\u0629 (\u0645\u0642\u064a\u0627\u0633 \u0645\u0646 1 \u0625\u0644\u0649 7)","Choices":{"1":{"Display":"\u0623\u0646\u0627 \u0642\u0644\u0642 \u0645\u0646 \u0623\u0646 \u0623\u0633\u0644\u0648\u0628 \u062d\u064a\u0627\u062a\u0646\u0627 \u064a\u062a\u0639\u0631\u0636 \u0644\u0644