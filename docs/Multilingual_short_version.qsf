43e\u043b\u044f, \u043e\u0446\u0435\u043d\u0435\u0442\u0435 \u043e\u0442 1 (\u041d\u0435 \u0435 \u043f\u0440\u0438\u0447\u0438\u043d\u0430) \u0434\u043e 7 (\u041e\u0441\u043d\u043e\u0432\u043d\u0430 \u043f\u0440\u0438\u0447\u0438\u043d\u0430)","Choices":{"1":{"Display":"\u0412\u0435\u0447\u0435 \u0441\u043b\u0435\u0434\u044f\u0445 \u0442\u0435\u043c\u0430\u0442\u0430 \u043f\u043e \u043d\u043e\u0432\u0438\u043d\u0438\u0442\u0435"},"2":{"Display":"\u041f\u0440\u0435\u043f\u043e\u0440\u044a\u0447\u0430\u043d\u043e \u043c\u0438 \u0431\u0435\u0448\u0435 \u043e\u0442 \u043d\u044f\u043a\u043e\u0433\u043e, \u043a\u043e\u0433\u043e\u0442\u043e \u043f\u043e\u0437\u043d\u0430\u0432\u0430\u043c \u0438\u043b\u0438 \u043d\u0430 \u043a\u043e\u0433\u043e\u0442\u043e \u0438\u043c\u0430\u043c \u0434\u043e\u0432\u0435\u0440\u0438\u0435"},"3":{"Display":"\u0414\u043e\u0439\u0434\u0435 \u043e\u0442 \u0438\u0437\u0442\u043e\u0447\u043d\u0438\u043a, \u043a\u043e\u0439\u0442\u043e \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u043c"},"4":{"Display":"\u0418\u043c\u0430\u0448\u0435 \u043c\u043d\u043e\u0433\u043e \u0441\u043f\u043e\u0434\u0435\u043b\u044f\u043d\u0438\u044f, \u043a\u043e\u043c\u0435\u043d\u0442\u0430\u0440\u0438 \u0438 \u0445\u0430\u0440\u0435\u0441\u0432\u0430\u043d\u0438\u044f"},"5":{"Display":"\u0417\u0430\u0433\u043b\u0430\u0432\u0438\u0435\u0442\u043e \u0438\u043b\u0438 \u0441\u044a\u0434\u044a\u0440\u0436\u0430\u043d\u0438\u0435\u0442\u043e \u043f\u0440\u0435\u0434\u0438\u0437\u0432\u0438\u043a\u0430 \u0441\u0438\u043b\u043d\u0430 \u0435\u043c\u043e\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0430 \u0440\u0435\u0430\u043a\u0446\u0438\u044f"},"6":{"Display":"\u0418\u043c\u0430\u0448\u0435 \u0437\u0430\u043a\u0430\u0447\u043b\u0438\u0432\u043e \u0437\u0430\u0433\u043b\u0430\u0432\u0438\u0435 \u0438\u043b\u0438 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435"}},"Answers":{"1":{"Display":"1 - \u041d\u0435 \u0435 \u043f\u0440\u0438\u0447\u0438