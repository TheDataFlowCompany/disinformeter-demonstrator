0131"},"8":{"Display":"Sivil toplum"},"9":{"Display":"\u00dcniversiteler ve ara\u015ft\u0131rma enstit\u00fcleri"}},"Answers":{"1":{"Display":"1 - Hi\u00e7bir sorumluluk yok"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 - <meta charset=\"UTF-8\" \/>B\u00fcy\u00fck sorumlulu\u011fu var"}}},"UK":{"QuestionText":"[Q15] \u041d\u0430 \u0432\u0430\u0448\u0443 \u0434\u0443\u043c\u043a\u0443, <strong>\u043d\u0430\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0430\u043b\u044c\u043d\u043e\u044e<\/strong> \u043c\u0430\u0454 \u0431\u0443\u0442\u0438 \u043a\u043e\u0436\u043d\u0430 \u0437 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u0445 \u0433\u0440\u0443\u043f \u0437\u0430 <strong>\u0437\u0430\u043f\u043e\u0431\u0456\u0433\u0430\u043d\u043d\u044f \u043f\u043e\u0448\u0438\u0440\u0435\u043d\u043d\u044e \u043d\u0435\u043f\u0440\u0430\u0432\u0434\u0438\u0432\u043e\u0433\u043e \u0430\u0431\u043e \u043e\u043c\u0430\u043d\u043b\u0438\u0432\u043e\u0433\u043e \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u0443<\/strong>?<br \/>\n\u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u043e\u0446\u0456\u043d\u0456\u0442\u044c \u0432\u0456\u0434 1 (\u0417\u043e\u0432\u0441\u0456\u043c \u043d\u0435\u043c\u0430\u0454 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0456) \u0434\u043e 7 (\u0417\u043d\u0430\u0447\u043d\u0430 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0430\u043b\u044c\u043d\u0456\u0441\u0442\u044c)","Choices":{"1":{"Display":"\u0428\u0438\u0440\u043e\u043a\u0430 \u0433\u0440\u043e\u043c\u0430\u0434\u0441\u044c\u043a\u0456\u0441\u0442\u044c"},"2":{"Display":"\u0423\u0440\u044f\u0434 \u0442\u0430 \u043e\u0431\u0440\u0430\u043d\u0456 \u043f\u043e\u0441\u0430\u0434\u043e\u0432\u0446\u0456"},"3":{"Display":"\u0414\u0435\u0440\u0436\u0430\u0432\u043d\u0456 \u0442\u0430\/\u0430\u0431\u043e \u043c\u0456\u0441\u044