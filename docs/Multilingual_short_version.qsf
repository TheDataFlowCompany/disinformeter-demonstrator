isplay":"Verschiedener Meinung sein"},"3":{"Display":"Stimme eher nicht zu"},"4":{"Display":"Weder zustimmen noch nicht zustimmen"},"5":{"Display":"Stimme eher zu"},"6":{"Display":"Zustimmen"},"7":{"Display":"Stimme voll und ganz zu"}}},"ET":{"QuestionText":"[K10.6] N\u00fc\u00fcd palutakse teil m\u00e4rkida, kui suurel m\u00e4\u00e4ral te n\u00f5ustute j\u00e4rgmiste v\u00e4idetega, kus 1 = T\u00e4iesti ei ole n\u00f5us ja 7 = T\u00e4iesti n\u00f5us (skaala 1\u20137)","Choices":{"1":{"Display":"Teatud m\u00e4\u00e4ral imetlen Hiinat"},"2":{"Display":"Vahel tunnen end Hiinast inspireerituna"},"3":{"Display":"Hiina annab mulle lootust"}},"Answers":{"1":{"Display":"Kindlalt ei n\u00f5ustu"},"2":{"Display":"Ei n\u00f5ustu"},"3":{"Display":"Pole eriti n\u00f5us"},"4":{"Display":"Ei n\u00f5ustu ega ole eriarvamusel"},"5":{"Display":"Enam-v\u00e4hem n\u00f5us"},"6":{"Display":"N\u00f5ustun"},"7":{"Display":"T\u00e4iesti n\u00f5us"}}},"FA":{"QuestionText":"[\u0633\u0648\u0627\u0644 \u06f1\u06f0.\u06f6] \u0627\u06a9\u0646\u0648\u0646 \u0627\u0632 \u0634\u0645\u0627 \u062e\u0648\u0627\u0633\u062a\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f \u0645\u06cc\u0632\u0627\u0646 \u0645\u0648\u0627\u0641\u0642\u062a \u062e\u0648\u062f \u0631\u0627 \u0628\u0627 \u062c\u0645\u0644\u0627\u062a \u0632\u06cc\u0631 \u0645\u0634\u062e\u0635 \u06a9\u0646\u06cc\u062f\u060c \u06a9\u0647 \u062f\u0631 \u0622\u0646 \u06f1 = \u06a9\u0627\u0645\u0644\u0627\u064b \u0645\u062e\u0627\u0644\u0641 \u0648 \u06f7 = \u06a9\u0627\u0645\u0644\u0627\u064b \u0645\u0648\u0627\u0641\u0642 (\u0645\u0642\u06cc\u0627\u0633 \u06f1 \u062a\u0627 \u06f7)","Choices":{"1":{"Display":"\u062a\u0627 \u062d\u062f\u0648\u062f\u06cc\u060c \u0645\u0646 \u0686\u06cc\u0646 \u0631\u0627 \u062a\u062d\u0633\u06cc\u0646 \u0645\u06cc\u200c\u06a9\u0646\u0645."},"2":{"Display":"\u0628\u0639\u0636\u06cc \u0648\u0642\u062a\u200c\u0647\u0627 \u0627\u0632 \u0686\u06cc\u0646 \u0627\u0644\u0647\u0627\u0645 \u0645\u06cc\u200c\u06af\u06cc\u0631\u