y":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 - \u00c7ok fazla etkisi var"}}},"UK":{"QuestionText":"[Q14] \u0417\u0430\u0433\u0430\u043b\u043e\u043c, <strong>\u044f\u043a \u0441\u0438\u043b\u044c\u043d\u043e<\/strong>, \u043d\u0430 \u0432\u0430\u0448\u0443 \u0434\u0443\u043c\u043a\u0443, \u043d\u0435\u043f\u0440\u0430\u0432\u0434\u0438\u0432\u0430 \u0430\u0431\u043e <strong>\u043e\u043c\u0430\u043d\u043b\u0438\u0432\u0430 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044f<\/strong> \u0432\u043f\u043b\u0438\u0432\u0430\u0454 \u043d\u0430 \u043a\u043e\u0436\u0435\u043d \u0456\u0437 \u043d\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u0445 \u043d\u0438\u0436\u0447\u0435 \u0430\u0441\u043f\u0435\u043a\u0442\u0456\u0432?<br \/>\n\u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u043e\u0446\u0456\u043d\u0456\u0442\u044c \u0432\u0456\u0434 1 (\u0417\u043e\u0432\u0441\u0456\u043c \u043d\u0435 \u0432\u043f\u043b\u0438\u0432\u0430\u0454) \u0434\u043e 7 (\u0414\u0443\u0436\u0435 \u0432\u0435\u043b\u0438\u043a\u0438\u0439 \u0432\u043f\u043b\u0438\u0432)","Choices":{"1":{"Display":"\u0414\u043e\u0432\u0456\u0440\u0430 \u0434\u043e \u0443\u0440\u044f\u0434\u0443 \u0442\u0430 \u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0456\u0457"},"2":{"Display":"<meta charset=\"UTF-8\" \/>\u041f\u043e\u043b\u0456\u0442\u0438\u0447\u043d\u0430 \u0443\u0447\u0430\u0441\u0442\u044c \u0433\u0440\u043e\u043c\u0430\u0434\u044f\u043d \u0442\u0430 \u0433\u043e\u043b\u043e\u0441\u0443\u0432\u0430\u043d\u043d\u044f"},"3":{"Display":"\u0414\u043e\u0432\u0456\u0440\u0430 \u043c\u0456\u0436 \u0433\u0440\u043e\u043c\u0430\u0434\u044f\u043d\u0430\u043c\u0438"},"4":{"Display":"\u0417\u0434\u0430\u0442\u043d\u0456\u0441\u0442\u044c \u043f\u043e\u043b\u0456\u0442\u0438\u043a\u0456\u0432 \u0432\u0438\u043a\u043e\u043d\u0443\u0432\u0430\u0442\u0438 \u0441\u0432\u043e\u044e \u0440\u043e\u0431\u043e\u0442\u0443"},"5":{"Display":"\u0413\u043b\u043e\u0431\u0430\u043b\u044c\u043d