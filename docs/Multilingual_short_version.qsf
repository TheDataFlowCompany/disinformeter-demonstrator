 \u043d\u0435\u0441\u044a\u0433\u043b\u0430\u0441\u0435\u043d"},"5":{"Display":"\u0414\u043e\u043d\u044f\u043a\u044a\u0434\u0435 \u0441\u044a\u043c \u0441\u044a\u0433\u043b\u0430\u0441\u0435\u043d\/\u0441\u044a\u0433\u043b\u0430\u0441\u043d\u0430"},"6":{"Display":"\u0421\u044a\u0433\u043b\u0430\u0441\u0435\u043d\/\u0430"},"7":{"Display":"\u041d\u0430\u043f\u044a\u043b\u043d\u043e \u0441\u044a\u0433\u043b\u0430\u0441\u0435\u043d\/\u0430"}}},"DE":{"QuestionText":"[Q10.2] Nun werden Sie gebeten, anzugeben, inwieweit Sie den folgenden Aussagen zustimmen, wobei 1 = Stimme \u00fcberhaupt nicht zu und 7 = Stimme voll und ganz zu (Skala 1-7)","Choices":{"1":{"Display":"Ich mache mir Sorgen, dass unsere Lebensweise angegriffen wird"},"2":{"Display":"Ich habe Angst, dass mein Land von anderen L\u00e4ndern ausgebeutet wird"},"3":{"Display":"Ich bin w\u00fctend, wenn ich daran denke, wie mein Land vom Ausland ausgenutzt wird"},"4":{"Display":"Ich bin w\u00fctend, weil die Einwanderung unsere Lebensweise zum Schlechteren ver\u00e4ndert"},"5":{"Display":"Ich bin besorgt wegen der unkontrollierten Einwanderung"},"6":{"Display":"Ich bin besorgt \u00fcber die Verbreitung von LGBT+-Propaganda"},"7":{"Display":"Ich bin emp\u00f6rt, wenn ich an die F\u00f6rderung von LGBT+-Ideen denke"}},"Answers":{"1":{"Display":"Stimme \u00fcberhaupt nicht zu"},"2":{"Display":"Verschiedener Meinung sein"},"3":{"Display":"Stimme eher nicht zu"},"4":{"Display":"Weder zustimmen noch nicht zustimmen"},"5":{"Display":"Stimme eher zu"},"6":{"Display":"Zustimmen"},"7":{"Display":"Stimme voll und ganz zu"}}},"ET":{"QuestionText":"[K10.2] N\u00fc\u00fcd palutakse teil m\u00e4rkida, kui suurel m\u00e4\u00e4ral te n\u00f5ustute j\u00e4rgmiste v\u00e4idetega, kus 1 = T\u00e4iesti ei ole n\u00f5us ja 7 = T\u00e4iesti n\u00f5us (skaala 1\u20137)","Choices":{"1":{"Display":"Ma olen mures, et meie eluviis on r\u00fcnnaku all"},"2":{"Display":"Ma olen mures, et v\u00e4lisriigid ekspluateerivad minu riiki"},"3":{"Display":"Mind ajab vihale m\u00f5te sellest, kuidas v\u00f5\u00f5rad riigid minu riiki \u00e4ra kasutavad."},"4":{"Display":"Ma olen vihane, sest immigratsioon muudab meie eluviisi halvemaks."},"5":{"Display":"Olen mures kontrollimatu immigratsiooni p\u00e4rast"},"6":{"Display":"Olen mures LGBT+ propaganda leviku p\u00e4rast."},"7":{"Display":"Olen n\u00f6rdinud, kui m\u00f5tlen LGBT+ ideede propageerimisele."}},"Answers":{"1":{"Display":"Kindlalt ei n\u00f5ustu"},"2":{"Display":"Ei n\u00f5ustu"},"3":{"Display":"Pole eriti n\u00f5us"},"4":{"Display":"Ei n\u00f5ustu ega ole eriarvamusel"},"5":{"Display":"Enam-v\u00e4hem n\u00f5us"},"6":{"Display":"N\u00f5ustun"},"7":{"Display":"T\u00e4iesti n\u00f5us"}}},"FA":{"QuestionText":"[\u0633\u0648\u0627\u0644 \u06f1\u06f0.\u06f2] \u0627\u06a9\u0646\u0648\u0646 \u0627\u0632 \u0634\u0645\u0627 \u062e\u0648\u0627\u0633\u062a\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f \u0645\u06cc\u0632\u0627\u0646 \u0645\u0648\u0627\u0641\u0642\u062a \u062e\u0648\u062f \u0631\u0627 \u0628\u0627 \u062c\u0645\u0644\u0627\u062a \u0632\u06cc\u0631 \u0645\u0634\u062e\u0635 \u06a9\u0646\u06cc\u062f\u060c \u06a9\u0647 \u062f\u0631 \u0622\u0646 \u06f1 = \u06a9\u0627\u0645\u0644\u0627\u064b \u0645\u062e\u0627\u0644\u0641 \u0648 \u06f7 = \u06a9\u0627\u0645\u0644\u0627\u064b \u0645\u0648\u0627\u0641\u0642 (\u0645\u0642\u06cc\u0627\u0633 \u06f1 \u062a\u0627 \u06f7)","Choices":{"1":{"Display":"\u0645\u0646 \u0646\u06af\u0631\u0627\u0646\u0645 \u06a9\u0647 \u0633\u0628\u06a9 \u0632\u0646\u062f\u06af\u06cc \u0645\u0627 \u0645\u0648\u0631\u062f \u062d\u0645\u0644\u0647 \u0642\u0631\u0627\u0631 \u06af\u0631\u0641\u062a\u0647 \u0628\u0627\u0634\u062f"},"2":{"Display":"\u0645\u0646 \u0646\u06af\u0631\u0627\u0646\u0645 \u06a9\u0647 \u06a9\u0634\u0648\u0631\u0645 \u062a\u0648\u0633\u0637 \u06a9\u0634\u0648\u0631\u0647\u0627\u06cc \u062e\u0627\u0631\u062c\u06cc \u0645\u0648\u0631\u062f \u0633\u0648\u0621\u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0642\u0631\u0627\u0631 \u06af\u06cc\u0631\u062f."},"3":{"Display":"\u0648\u0642\u062a\u06cc \u0628\u0647 \u0627\u06cc\u0646 \u0641\u06a9\u0631 \u0645\u06cc\u200c\u06a9\u0646\u0645 \u06a9\u0647 \u06a9\u0634\u0648\u0631\u0647\u0627\u06cc \u062e\u0627\u0631\u062c\u06cc \u0686\u0637\u0648\u0631 \u0627\u0632 \u06a9\u0634\u0648\u0631\u0645 \u0633\u0648\u0621\u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f\u060c \u0639\u0635\u0628\u0627\u0646\u06cc \u0645\u06cc\u200c\u0634\u0648\u0645."},"4":{"Display":"\u0645\u0646 \u0639\u0635\u0628\u0627\u0646\u06cc \u0647\u0633\u062a\u0645 \u0686\u0648\u0646 \u0645\u0647\u0627\u062c\u0631\u062a \u062f\u0627\u0631\u062f \u0633\u0628\u06a9 \u0632\u0646\u062f\u06af\u06cc \u0645\u0627 \u0631\u0627 \u0628\u062f\u062a\u0631 \u0645\u06cc\u200c\u06a9\u0646\u062f."},"5":{"Display":"\u0645\u0646 \u0628\u0647 \u062f\u0644\u06cc\u0644 \u0645\u0647\u0627\u062c\u0631\u062a \u0628\u06cc \u0631\u0648\u06cc\u0647 \u0646\u06af\u0631\u0627\u0646 \u0647\u0633\u062a\u0645"},"6":{"Display":"\u0645\u0646 \u0646\u06af\u0631\u0627\u0646 \u06af\u0633\u062a\u0631\u0634 \u062a\u0628\u0644\u06cc\u063a\u0627\u062a LGBT+ \u0647\u0633\u062a\u0645"},"7":{"Display":"\u0648\u0642\u062a\u06cc \u0628\u0647 \u062a\u0631\u0648\u06cc\u062c \u0627\u06cc\u062f\u0647\u200c\u0647\u0627\u06cc LGBT+ \u0641\u06a9\u0631 \u0645\u06cc\u200c\u06a9\u0646\u0645\u060c \u0639\u0635\u0628\u0627\u0646\u06cc \u0645\u06cc\u200c\u0634\u0648\u0645."}},"Answers":{"1":{"Display":"\u06a9\u0627\u0645\u0644\u0627\u064b \u0645\u062e\u0627\u0644\u0641\u0645"},"2":{"Display":"\u0645\u062e\u0627\u0644\u0641"},"3":{"Display":"\u062a\u0627 \u062d\u062f\u0648\u062f\u06cc \u0645\u062e\u0627\u0644\u0641\u0645"},"4":{"Display":"\u0646\u0647 \u0645\u0648\u0627\u0641\u0642 \u0648 \u0646\u0647 \u0645\u062e\u0627\u0644\u0641"},"5":{"Display":"\u062a\u0627 \u062d\u062f\u0648\u062f\u06cc \u0645\u0648\u0627\u0641\u0642\u0645"},"6":{"Display":"\u0645\u0648\u0627\u0641\u0642"},"7":{"Display":"\u06a9\u0627\u0645\u0644\u0627\u064b \u0645\u0648\u0627\u0641\u0642\u0645"}}},"FR":{"QuestionText":"[Q10.2] Il vous sera maintenant demand\u00e9 d&#39;indiquer dans quelle mesure vous \u00eates d&#39;accord avec les affirmations suivantes, o\u00f9 1 = Tout \u00e0 fait en d\u00e9saccord et 7 = Tout \u00e0 fait d&#39;accord (\u00e9chelle de 1 \u00e0 7)","Choices":{"1":{"Display":"Je crains que notre mode de vie soit menac\u00e9."},"2":{"Display":"Je crains que mon pays soit exploit\u00e9 par des pays \u00e9trangers."},"3":{"Display":"Je suis en col\u00e8re quand je pense \u00e0 la fa\u00e7on dont mon pays est utilis\u00e9 par des pays \u00e9trangers."},"4":{"Display":"Je suis en col\u00e8re parce que l\u2019immigration change notre mode de vie pour le pire."},"5":{"Display":"Je me sens inquiet \u00e0 cause de l&#39;immigration incontr\u00f4l\u00e9e"},"6":{"Display":"Je suis pr\u00e9occup\u00e9 par la propagation de la propagande LGBT+"},"7":{"Display":"Je suis indign\u00e9 quand je pense \u00e0 la promotion des id\u00e9es LGBT+"}},"Answers":{"1":{"Display":"Fortement en d\u00e9saccord"},"2":{"Display":"\u00catre en d\u00e9saccord"},"3":{"Display":"Plut\u00f4t en d\u00e9saccord"},"4":{"Display":"Ni d&#39;accord ni en d\u00e9saccord"},"5":{"Display":"Plut\u00f4t d&#39;accord"},"6":{"Display":"Accepter"},"7":{"Display":"Tout \u00e0 fait d&#39;accord"}}},"HU":{"QuestionText":"[10.2. k\u00e9rd\u00e9s] Most arra kell majd jeleznie, hogy mennyire \u00e9rt egyet a k\u00f6vetkez\u0151 \u00e1ll\u00edt\u00e1sokkal, ahol 1 = Hat\u00e1rozottan nem \u00e9rtek egyet \u00e9s 7 = Hat\u00e1rozottan egyet\u00e9rtek (1-7-es sk\u00e1la)","Choices":{"1":{"Display":"Agg\u00f3dom, hogy az \u00e9letm\u00f3dunkat t\u00e1madj\u00e1k"},"2":{"Display":"Agg\u00f3dom, hogy k\u00fclf\u00f6ldi orsz\u00e1gok kizs\u00e1km\u00e1nyolj\u00e1k az orsz\u00e1gomat"},"3":{"Display":"D\u00fch\u00f6s vagyok, amikor arra gondolok, hogyan haszn\u00e1lj\u00e1k fel a haz\u00e1mat k\u00fclf\u00f6ldi orsz\u00e1gok."},"4":{"Display":"D\u00fch\u00f6s vagyok, mert a bev\u00e1ndorl\u00e1s rosszabbra v\u00e1ltoztatja az \u00e9letm\u00f3dunkat"},"5":{"Display":"Agg\u00f3dom az ellen\u0151rizetlen bev\u00e1ndorl\u00e1s miatt"},"6":{"Display":"Agg\u00f3dom az LMBT+ propaganda terjed\u00e9se miatt."},"7":{"Display":"Felh\u00e1bor\u00edt az LMBT+ eszm\u00e9k n\u00e9pszer\u0171s\u00edt\u00e9se"}},"Answers":{"1":{"Display":"Hat\u00e1rozottan nem \u00e9rtek egyet"},"2":{"Display":"Nem \u00e9rt egyet"},"3":{"Display":"Kiss\u00e9 nem \u00e9rtek egyet"},"4":{"Display":"Sem egyet\u00e9rt\u00e9s, sem ellentmond\u00e1s"},"5":{"Display":"R\u00e9szben egyet\u00e9rtek"},"6":{"Display":"Egyet\u00e9rt"},"7":{"Display":"Teljesen egyet\u00e9rtek"}}},"IT":{"QuestionText":"[Q10.2] Ora ti verr\u00e0 chiesto di indicare il tuo grado di accordo con le seguenti affermazioni, dove 1 = Fortemente in disaccordo e 7 = Fortemente d&#39;accordo (scala da 1 a 7)","Choices":{"1":{"Display":"Sono preoccupato che il nostro stile di vita sia sotto attacco"},"2":{"Display":"Sono preoccupato che il mio paese venga sfruttato da paesi stranieri"},"3":{"Display":"Mi arrabbio quando penso a come il mio paese viene usato dai paesi stranieri"},"4":{"Display":"Sono arrabbiato perch\u00e9 l&#39;immigrazione sta cambiando in peggio il nostro stile di vita"},"5":{"Display":"Mi sento preoccupato a causa dell&#39;immigrazione incontrollata"},"6":{"Display":"Sono preoccupato per la diffusione della propaganda LGBT+"},"7":{"Display":"Mi indigno quando penso alla promozione delle idee LGBT+"}},"Answers":{"1":{"Display":"Fortemente in disaccordo"},"2":{"Display":"Non sono d&#39;accordo"},"3":{"Display":"Un po&#39; in disaccordo"},"4":{"Display":"N\u00e9 d&#39;accordo n\u00e9 in disaccordo"},"5":{"Display":"Abbastanza d&#39;accordo"},"6":{"Display":"Essere d&#39;accordo"},"7":{"Display":"Sono assolutamente d&#39;accordo"}}},"KAT":{"QuestionText":"[Q10.2] \u10d0\u10ee\u10da\u10d0 \u10d7\u10e5\u10d5\u10d4\u10dc \u10db\u10dd\u10d2\u10d4\u10d7\u10ee\u10dd\u10d5\u10d4\u10d1\u10d0\u10d7 \u10db\u10d8\u10e3\u10d7\u10d8\u10d7\u10dd\u10d7 \u10d7\u10e5\u10d5\u10d4\u10dc\u10d8 \u10d7\u10d0\u10dc\u10ee\u10db\u10dd\u10d1\u10d8\u10e1 \u10ee\u10d0\u10e0\u10d8\u10e1\u10ee\u10d8 \u10e8\u10d4\u10db\u10d3\u10d4\u10d2 \u10d2\u10d0\u10dc\u10ea\u10ee\u10d0\u10d3\u10d4\u10d1\u10d4\u10d1\u10d7\u10d0\u10dc, \u10e1\u10d0\u10d3\u10d0\u10ea 1 = \u10d9\u10d0\u10e2\u10d4\u10d2\u10dd\u10e0\u10d8\u10e3\u10da\u10d0\u10d3 \u10d0\u10e0 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8 \u10d3\u10d0 7 = \u10e1\u10e0\u10e3\u10da\u10d8\u10d0\u10d3 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8 (1-7 \u10e8\u10d9\u10d0\u10da\u10d0)","Choices":{"1":{"Display":"\u10db\u10d4\u10e8\u10d8\u10dc\u10d8\u10d0, \u10e0\u10dd\u10db \u10e9\u10d5\u10d4\u10dc\u10d8 \u10ea\u10ee\u10dd\u10d5\u10e0\u10d4\u10d1\u10d8\u10e1 \u10ec\u10d4\u10e1\u10d8 \u10e1\u10d0\u10e4\u10e0\u10d7\u10ee\u10d8\u10e1 \u10e5\u10d5\u10d4\u10e8\u10d0\u10d0"},"2":{"Display":"\u10db\u10d4\u10e8\u10d8\u10dc\u10d8\u10d0, \u10e0\u10dd\u10db \u10e9\u10d4\u10db\u10e1 \u10e5\u10d5\u10d4\u10e7\u10d0\u10dc\u10d0\u10e1 \u10e3\u10ea\u10ee\u10dd \u10e5\u10d5\u10d4\u10e7\u10dc\u10d4\u10d1\u10d8 \u10d4\u10e5\u10e1\u10de\u10da\u10e3\u10d0\u10e2\u10d0\u10ea\u10d8\u10d0\u10e1 \u10e3\u10ec\u10d4\u10d5\u10d4\u10dc"},"3":{"Display":"\u10d5\u10d1\u10e0\u10d0\u10d6\u10d3\u10d4\u10d1\u10d8, \u10e0\u10dd\u10ea\u10d0 \u10d5\u10e4\u10d8\u10e5\u10e0\u10dd\u10d1, \u10e0\u10dd\u10d2\u10dd\u10e0 \u10d8\u10e7\u10d4\u10dc\u10d4\u10d1\u10d4\u10dc \u10e9\u10d4\u10db\u10e1 \u10e5\u10d5\u10d4\u10e7\u10d0\u10dc\u10d0\u10e1 \u10e3\u10ea\u10ee\u10dd \u10e5\u10d5\u10d4\u10e7\u10dc\u10d4\u10d1\u10d8."},"4":{"Display":"\u10d2\u10d0\u10d1\u10e0\u10d0\u10d6\u10d4\u10d1\u10e3\u10da\u10d8 \u10d5\u10d0\u10e0, \u10e0\u10d0\u10d3\u10d2\u10d0\u10dc \u10d8\u10db\u10d8\u10d2\u10e0\u10d0\u10ea\u10d8\u10d0 \u10e9\u10d5\u10d4\u10dc\u10d8 \u10ea\u10ee\u10dd\u10d5\u10e0\u10d4\u10d1\u10d8\u10e1 \u10ec\u10d4\u10e1\u10e1 \u10e3\u10d0\u10e0\u10d4\u10e1\u10dd\u10d1\u10d8\u10e1\u10d9\u10d4\u10dc \u10ea\u10d5\u10da\u10d8\u10e1."},"5":{"Display":"\u10db\u10d4 \u10e8\u10d4\u10e8\u10e4\u10dd\u10d7\u10d4\u10d1\u10e3\u10da\u10d8 \u10d5\u10d0\u10e0 \u10e3\u10d9\u10dd\u10dc\u10e2\u10e0\u10dd\u10da\u10dd \u10d8\u10db\u10d8\u10d2\u10e0\u10d0\u10ea\u10d8\u10d8\u10e1 \u10d2\u10d0\u10db\u10dd"},"6":{"Display":"\u10db\u10d4 \u10e8\u10d4\u10e8\u10e4\u10dd\u10d7\u10d4\u10d1\u10e3\u10da\u10d8 \u10d5\u10d0\u10e0 \u10da\u10d2\u10d1\u10e2+ \u10de\u10e0\u10dd\u10de\u10d0\u10d2\u10d0\u10dc\u10d3\u10d8\u10e1 \u10d2\u10d0\u10d5\u10e0\u10ea\u10d4\u10da\u10d4\u10d1\u10d8\u10d7"},"7":{"Display":"\u10d0\u10e6\u10e8\u10e4\u10dd\u10d7\u10d4\u10d1\u10e3\u10da\u10d8 \u10d5\u10d0\u10e0, \u10e0\u10dd\u10d3\u10d4\u10e1\u10d0\u10ea \u10da\u10d2\u10d1\u10e2+ \u10d8\u10d3\u10d4\u10d4\u10d1\u10d8\u10e1 \u10de\u10dd\u10de\u10e3\u10da\u10d0\u10e0\u10d8\u10d6\u10d0\u10ea\u10d8\u10d0\u10d6\u10d4 \u10d5\u10e4\u10d8\u10e5\u10e0\u10dd\u10d1."}},"Answers":{"1":{"Display":"\u10d9\u10d0\u10e2\u10d4\u10d2\u10dd\u10e0\u10d8\u10e3\u10da\u10d0\u10d3 \u10d0\u10e0 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"},"2":{"Display":"\u10d0\u10e0 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"},"3":{"Display":"\u10d2\u10d0\u10e0\u10d9\u10d5\u10d4\u10e3\u10da\u10ec\u10d8\u10da\u10d0\u10d3 \u10d0\u10e0 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"},"4":{"Display":"\u10d0\u10e0\u10ea \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8 \u10d3\u10d0 \u10d0\u10e0\u10ea \u10d0\u10e0 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"},"5":{"Display":"\u10dc\u10d0\u10ec\u10d8\u10da\u10dd\u10d1\u10e0\u10d8\u10d5 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"},"6":{"Display":"\u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"},"7":{"Display":"\u10e1\u10e0\u10e3\u10da\u10d8\u10d0\u10d3 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"}}},"LT":{"QuestionText":"[10.2 klausimas] Dabar j\u016bs\u0173 bus papra\u0161yta nurodyti, kiek sutinkate su \u0161iais teiginiais, kur 1 = Visi\u0161kai nesutinku ir 7 = Visi\u0161kai sutinku (1\u20137 bal\u0173 skal\u0117)","Choices":{"1":{"Display":"Nerimauju, kad m\u016bs\u0173 gyvenimo b\u016bdas puolamas"},"2":{"Display":"Nerimauju, kad mano \u0161al\u012f i\u0161naudoja u\u017esienio \u0161alys"},"3":{"Display":"Mane pykina, kai pagalvoju, kaip mano \u0161alimi naudojasi u\u017esienio \u0161alys."},"4":{"Display":"Esu piktas, nes imigracija kei\u010dia m\u016bs\u0173 gyvenimo b\u016bd\u0105 \u012f blog\u0105j\u0105 pus\u0119."},"5":{"Display":"Jau\u010diu nerim\u0105 d\u0117l nekontroliuojamos imigracijos"},"6":{"Display":"Mane neramina LGBT+ propagandos plitimas."},"7":{"Display":"Esu pasipiktin\u0119s galvodamas apie LGBT+ id\u0117j\u0173 propagavim\u0105."}},"Answers":{"1":{"Display":"Visi\u0161kai nesutinku"},"2":{"Display":"Nesutinku"},"3":{"Display":"\u0160iek tiek nesutinku"},"4":{"Display":"Nei sutinku, nei nesutinku"},"5":{"Display":"I\u0161 dalies sutinku"},"6":{"Display":"Sutinku"},"7":{"Display":"Visi\u0161kai sutinku"}}},"LV":{"QuestionText":"[10.2.\u00a0jaut\u0101jums] Tagad jums tiks l\u016bgts nor\u0101d\u012bt, cik liel\u0101 m\u0113r\u0101 j\u016bs piekr\u012btat \u0161\u0101diem apgalvojumiem, kur 1\u00a0=\u00a0piln\u012bb\u0101 nepiekr\u012btu un 7\u00a0=\u00a0piln\u012bb\u0101 piekr\u012btu (skala no 1\u00a0l\u012bdz 7)","Choices":{"1":{"Display":"Mani uztrauc, ka m\u016bsu dz\u012bvesveids tiek apdraud\u0113ts"},"2":{"Display":"Mani uztrauc, ka manu valsti ekspluat\u0113 \u0101rvalstis"},"3":{"Display":"Mani dusmo, kad dom\u0101ju par to, k\u0101 \u0101rvalstis izmanto manu valsti."},"4":{"Display":"Esmu dusm\u012bgs, jo imigr\u0101cija maina m\u016bsu dz\u012bvesveidu uz slikto pusi."},"5":{"Display":"Mani uztrauc nekontrol\u0113t\u0101 imigr\u0101cija"},"6":{"Display":"Mani uztrauc LGBT+ propagandas izplat\u012bba."},"7":{"Display":"Esmu sa\u0161utis, dom\u0101jot par LGBT+ ideju populariz\u0113\u0161anu."}},"Answers":{"1":{"Display":"Piln\u012bb\u0101 nepiekr\u012btu"},"2":{"Display":"Nepiekr\u012btu"},"3":{"Display":"Da\u013c\u0113ji nepiekr\u012btu"},"4":{"Display":"Ne piekr\u012btu, ne nepiekr\u012btu"},"5":{"Display":"Da\u013c\u0113ji piekr\u012btu"},"6":{"Display":"Piekr\u012btu"},"7":{"Display":"Piln\u012bb\u0101 piekr\u012btu"}}},"NL":{"QuestionText":"[Q10.2] Nu wordt u gevraagd aan te geven in hoeverre u het eens bent met de volgende stellingen, waarbij 1 = Sterk oneens en 7 = Sterk eens (schaal van 1-7)","Choices":{"1":{"Display":"Ik maak me zorgen dat onze manier van leven wordt aangevallen"},"2":{"Display":"Ik maak me zorgen dat mijn land wordt uitgebuit door andere landen"},"3":{"Display":"Ik word boos als ik denk aan de manier waarop mijn land door andere landen wordt gebruikt"},"4":{"Display":"Ik ben boos omdat immigratie onze manier van leven ten kwade verandert"},"5":{"Display":"Ik maak me zorgen vanwege de ongecontroleerde immigratie"},"6":{"Display":"Ik maak me zorgen over de verspreiding van LGBT+-propaganda"},"7":{"Display":"Ik word woedend als ik denk aan de promotie van LGBT+-idee\u00ebn"}},"Answers":{"1":{"Display":"Ik ben het er absoluut niet mee eens"},"2":{"Display":"Niet mee eens"},"3":{"Display":"Ik ben het er enigszins mee oneens"},"4":{"Display":"Noch eens, noch oneens"},"5":{"Display":"enigszins mee eens"},"6":{"Display":"Mee eens zijn"},"7":{"Display":"Helemaal mee eens"}}},"PL":{"QuestionText":"[Q10.2] Teraz zostaniesz poproszony o wskazanie stopnia, w jakim zgadzasz si\u0119 z nast\u0119puj\u0105cymi stwierdzeniami, gdzie 1 = Zdecydowanie si\u0119 nie zgadzam, a 7 = Zdecydowanie si\u0119 zgadzam (skala 1-7)","Choices":{"1":{"Display":"Martwi\u0119 si\u0119, \u017ce nasz styl \u017cycia jest zagro\u017cony"},"2":{"Display":"Martwi\u0119 si\u0119, \u017ce m\u00f3j kraj jest wykorzystywany przez kraje zagraniczne"},"3":{"Display":"Z\u0142o\u015bci mnie my\u015bl o tym, jak m\u00f3j kraj jest wykorzystywany przez kraje zagraniczne"},"4":{"Display":"Jestem z\u0142y, bo imigracja zmienia nasz styl \u017cycia na gorsze"},"5":{"Display":"Martwi\u0119 si\u0119 niekontrolowan\u0105 imigracj\u0105"},"6":{"Display":"Martwi mnie rozprzestrzenianie si\u0119 propagandy LGBT+"},"7":{"Display":"Oburzam si\u0119, gdy my\u015bl\u0119 o promowaniu idei LGBT+"}},"Answers":{"1":{"Display":"Zdecydowanie si\u0119 nie zgadzam"},"2":{"Display":"Nie zgadza\u0107 si\u0119"},"3":{"Display":"Raczej si\u0119 nie zgadzam"},"4":{"Display":"Ani si\u0119 zgadzam, ani nie zgadzam"},"5":{"Display":"Raczej si\u0119 zgadzam"},"6":{"Display":"Zgadza\u0107 si\u0119"},"7":{"Display":"Zdecydowanie si\u0119 zgadzam"}}},"RU":{"QuestionText":"[Q10.2] \u0422\u0435\u043f\u0435\u0440\u044c \u0432\u0430\u043c \u0431\u0443\u0434\u0435\u0442 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u043e \u0443\u043a\u0430\u0437\u0430\u0442\u044c \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0432\u0430\u0448\u0435\u0433\u043e \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u044f \u0441\u043e \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u043c\u0438 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f\u043c\u0438, \u0433\u0434\u0435 1 = \u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u0435 \u0441\u043e\u0433\u043b\u0430\u0441\u0435\u043d \u0438 7 = \u041f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0441\u043e\u0433\u043b\u0430\u0441\u0435\u043d (\u0448\u043a\u0430\u043b\u0430 \u043e\u0442 1 \u0434\u043e 7)","Choices":{"1":{"Display":"\u042f \u0431\u0435\u0441\u043f\u043e\u043a\u043e\u044e\u0441\u044c, \u0447\u0442\u043e \u043d\u0430\u0448 \u043e\u0431\u0440\u0430\u0437 \u0436\u0438\u0437\u043d\u0438 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043f\u043e\u0434 \u0443\u0433\u0440\u043e\u0437\u043e\u0439."},"2":{"Display":"\u042f \u043e\u0431\u0435\u0441\u043f\u043e\u043a\u043e\u0435\u043d \u0442\u0435\u043c, \u0447\u0442\u043e \u043c\u043e\u044e \u0441\u0442\u0440\u0430\u043d\u0443 \u044d\u043a\u0441\u043f\u043b\u0443\u0430\u0442\u0438\u0440\u0443\u044e\u0442 \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0435 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0430."},"3":{"Display":"\u042f \u0437\u043b\u044e\u0441\u044c, \u043a\u043e\u0433\u0434\u0430 \u0434\u0443\u043c\u0430\u044e \u043e \u0442\u043e\u043c, \u043a\u0430\u043a \u043c\u043e\u044e \u0441\u0442\u0440\u0430\u043d\u0443 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442 \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0435 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0430."},"4":{"Display":"\u042f \u0437\u043b\u044e\u0441\u044c, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0438\u043c\u043c\u0438\u0433\u0440\u0430\u0446\u0438\u044f \u043c\u0435\u043d\u044f\u0435\u0442 \u043d\u0430\u0448 \u043e\u0431\u0440\u0430\u0437 \u0436\u0438\u0437\u043d\u0438 \u0432 \u0445\u0443\u0434\u0448\u0443\u044e \u0441\u0442\u043e\u0440\u043e\u043d\u0443."},"5":{"Display":"\u042f \u043e\u0431\u0435\u0441\u043f\u043e\u043a\u043e\u0435\u043d \u043d\u0435\u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0443\u0435\u043c\u043e\u0439 \u0438\u043c\u043c\u0438\u0433\u0440\u0430\u0446\u0438\u0435\u0439."},"6":{"Display":"\u041c\u0435\u043d\u044f \u0431\u0435\u0441\u043f\u043e\u043a\u043e\u0438\u0442 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u043f\u0430\u0433\u0430\u043d\u0434\u044b \u041b\u0413\u0411\u0422+"},"7":{"Display":"\u042f \u0432\u043e\u0437\u043c\u0443\u0449\u0435\u043d, \u043a\u043e\u0433\u0434\u0430 \u0434\u0443\u043c\u0430\u044e \u043e \u043f\u0440\u043e\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0438 \u0438\u0434\u0435\u0439 \u041b\u0413\u0411\u0422+"}},"Answers":{"1":{"Display":"\u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u0435 \u0441\u043e\u0433\u043b\u0430\u04