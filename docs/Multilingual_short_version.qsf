c\u6c11\u793e\u4f1a"},"9":{"Display":"\u5927\u5b66\u548c\u79d1\u7814\u673a\u6784"}},"Answers":{"1":{"Display":"1 - <meta charset=\"UTF-8\" \/>\u5b8c\u5168\u4e0d\u9700\u8981\u627f\u62c5\u8d23\u4efb"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 -\u00a0\u5e94\u627f\u62c5\u91cd\u5927\u8d23\u4efb"}}},"NL":{"QuestionText":"[Q15] <strong>Hoe verantwoordelijk<\/strong> zou volgens u elke actor moeten zijn voor <strong>het voorkomen van de verspreiding van valse of misleidende inhoud<\/strong>?<br \/>\nGeef een beoordeling van 1 (Geen enkele verantwoordelijkheid) tot 7 (Een grote verantwoordelijkheid)","Choices":{"1":{"Display":"Algemeen publiek"},"2":{"Display":"De regering en verkozen functionarissen"},"3":{"Display":"Publieke en\/of lokale instellingen"},"4":{"Display":"Internationale instellingen"},"5":{"Display":"Redacteuren en journalisten"},"6":{"Display":"Professionele factcheckers"},"7":{"Display":"Technologiebedrijven\/Social media platforms"},"8":{"Display":"Burgermaatschappij"},"9":{"Display":"Universiteiten en onderzoeksinstituten"}},"Answers":{"1":{"Display":"1 - Geen enkele verantwoordelijkheid"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 - Een grote verantwoordelijkheid"}}},"ET":{"QuestionText":"[K15] <strong>Kui vastutustundlik<\/strong> peaks teie arvates iga osapool olema <strong>vale v\u00f5i eksitava sisu leviku t\u00f5kestamise<\/strong> ees?<br \/>\nPalun hinnake skaalal 1 (Ei ole \u00fcldse vastutav) kuni 7 (Suur vastutus)","Choices":{"1":{"Display":"\u00dcldsus"},"2":{"Display":"Valitsus ja valitud ametnikud"},"3":{"Display":"Avalikud ja\/v\u00f5i kohalikud asutused"},"4":{"Display":"Rahvusvahelised institutsioonid"},"5":{"Display":"Toimetajad ja ajakirjanikud"},"6":{"Display":"Professionaalsed faktikontrollijad"},"7":{"Display":"Tehnoloogiaettev\u00f5tted\/sotsiaalmeedia platvormid"},"8":{"Display":"Kodaniku\u00fchiskond"},"9":{"Display":"\u00dclikoolid ja teadusinstituudid"}},"Answers":{"1":{"Display":"1 \u2013 <meta charset=\"UTF-8\" \/>Ei ole \u00fcldse vastutav"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 - Suur vastutus"}}},"FR":{"QuestionText":"[Q15] Selon vous, <strong>dans quelle mesure chaque acteur devrait-il \u00eatre responsable<\/strong> de <strong>la pr\u00e9vention de la diffusion de contenus faux ou trompeurs<\/strong> ?<br \/>\nVeuillez noter de 1 (Pas du tout responsable) \u00e0 7 (Fortement\u00a0responsable)","Choices":{"1":{"Display":"Grand public"},"2":{"Display":"Gouvernement et \u00e9lus"},"3":{"Display":"Institutions publiques et\/ou locales"},"4":{"Display":"Institutions internationales"},"5":{"Display":"R\u00e9dacteurs et journalistes"},"6":{"Display":"V\u00e9rificateurs de faits professionnels"},"7":{"Display":"Entreprises technologiques\/Plateformes de m\u00e9dias sociaux"},"8":{"Display":"Soci\u00e9t\u00e9 civile"},"9":{"Display":"Universit\u00e9s et instituts de recherche"}},"Answers":{"1":{"Display":"1 - Pas du tout responsable"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 - Fortement responsable"}}},"KAT":{"QuestionText":"[Q15] \u10d7\u10e5\u10d5\u10d4\u10dc\u10d8 \u10d0\u10d6\u10e0\u10d8\u10d7, <strong>\u10e0\u10d0\u10db\u10d3\u10d4\u10dc\u10d0\u10d3 \u10de\u10d0\u10e1\u10e3\u10ee\u10d8\u10e1\u10db\u10d2\u10d4\u10d1\u10d4\u10da\u10d8<\/strong> \u10e3\u10dc\u10d3\u10d0 \u10d8\u10e7\u10dd\u10e1 \u10d7\u10d8\u10d7\u10dd\u10d4\u10e3\u10da\u10d8 \u10d0\u10e5\u10e2\u10dd\u10e0\u10d8 <strong>\u10ea\u10e0\u10e3 \u10d0\u10dc \u10e8\u10d4\u10ea\u10d3\u10dd\u10db\u10d0\u10e8\u10d8 \u10e8\u10d4\u10db\u10e7\u10d5\u10d0\u10dc\u10d8 \u10d9\u10dd\u10dc\u10e2\u10d4\u10dc\u10e2\u10d8\u10e1 \u10d2\u10d0\u10d5\u10e0\u10ea\u10d4\u10da\u10d4\u10d1\u10d8\u10e1 \u10d7\u10d0\u10d5\u10d8\u10d3\u10d0\u10dc \u10d0\u10e1\u10d0\u10ea\u10d8\u10da\u10d4\u10d1\u10da\u10d0\u10d3<\/strong>?<br \/>\n\u10d2\u10d7\u10ee\u10dd\u10d5\u10d7, \u10e8\u10d4\u10d0\u10e4\u10d0\u10e1\u10dd\u10d7 1-\u10d3\u10d0\u10dc (\u10e1\u10d0\u10d4\u10e0\u10d7\u10dd\u10d3 \u10d0\u10e0 \u10db\u10d0\u10e5\u10d5\u10e1 \u10de\u10d0\u10e1\u10e3\u10ee\u10d8\u10e1\u10db\u10d2\u10d4\u10d1\u10da\u10dd\u10d1\u10d0) 7-\u10db\u10d3\u10d4 (\u10d3\u10d8\u10d3\u10d8 \u10de\u10d0\u10e1\u10e3\u10ee\u10d8\u10e1\u10db\u10d2\u10d4\u10d1\u10da\u10dd\u10d1\u10d0)","Choices":{"1":{"Display":"\u10e4\u10d0\u10e0\u10d7\u10dd \u10e1\u10d0\u10d6\u10dd\u10d2\u10d0\u10d3\u10dd\u10d4\u10d1\u10d0"},"2":{"Display":"\u10db\u10d7\u10d0\u10d5\u10e0\u10dd\u10d1\u10d0 \u10d3\u10d0 \u10d0\u10e0\u10e9\u10d4\u10e3\u10da\u10d8 \u10d7\u10d0\u10dc\u10d0\u10db\u10d3\u10d4\u10d1\u10dd\u10d1\u10d8\u10e1 \u10de\u10d8\u10e0\u10d4\u10d1\u10d8"},"3":{"Display":"\u10e1\u10d0\u10ef\u10d0\u10e0\u10dd \u10d3\u10d0\/\u10d0\u10dc \u10d0\u10d3\u10d2\u10d8\u10da\u10dd\u10d1\u10e0\u10d8\u10d5\u10d8 \u10d3\u10d0\u10ec\u10d4\u10e1\u10d4\u10d1\u10e3\u10da\u10d4\u10d1\u10d4\u10d1\u10d8"},"4":{"Display":"\u10e1\u10d0\u10d4\u10e0\u10d7\u10d0\u10e8\u10dd\u10e0\u10d8\u10e1\u10dd \u10d8\u10dc\u10e1\u10e2\u10d8\u10e2\u10e3\u10e2\u10d4\u10d1\u10d8"},"5":{"Display":"\u10e0\u10d4\u10d3\u10d0\u10e5\u10e2\u10dd\u10e0\u10d4\u10d1\u10d8 \u10d3\u10d0 \u10df\u10e3\u10e0\u10dc\u10d0\u10da\u10d8\u10e1\u10e2\u10d4\u10d1\u10d8"},"6":{"Display":"<meta charset=\"UTF-8\" \/>\u10de\u10e0\u10dd\u10e4\u10d4\u10e1\u10d8\u10dd\u10dc\u10d0\u10da\u10d8 \u10e4\u10d0\u10e5\u10e2\u10d4\u10d1\u10d8\u10e1 \u10e8\u10d4\u10db\u10db\u10dd\u10ec\u10db\u10d4\u10d1\u10da\u10d4\u10d1\u10d8"},"7":{"Display":"\u10e2\u10d4\u10e5\u10dc\u10dd\u10da\u10dd\u10d2\u10d8\u10e3\u10e0\u10d8 \u10d9\u10dd\u10db\u10de\u10d0\u10dc\u10d8\u10d4\u10d1\u10d8\/\u10e1\u10dd\u10ea\u10d8\u10d0\u10da\u10e3\u10e0\u10d8 \u10db\u10d4\u10d3\u10d8\u10d8\u10e1 \u10de\u10da\u10d0\u10e2\u10e4\u10dd\u10e0\u10db\u10d4\u10d1\u10d8"},"8":{"Display":"\u10e1\u10d0\u10db\u10dd\u10e5\u10d0\u10da\u10d0\u10e5\u10dd \u10e1\u10d0\u10d6\u10dd\u10d2\u10d0\u10d3\u10dd\u10d4\u10d1\u10d0"},"9":{"Display":"\u10e3\u10dc\u10d8\u10d5\u10d4\u10e0\u10e1\u10d8\u10e2\u10d4\u10e2\u10d4\u10d1\u10d8 \u10d3\u10d0 \u10d9\u10d5\u10da\u10d4\u10d5\u10d8\u10d7\u10d8 \u10d8\u10dc\u10e1\u10e2\u10d8\u10e2\u10e3\u10e2\u10d4\u10d1\u10d8"}},"Answers":{"1":{"Display":"1 - \u10d0\u10e0\u10d0\u10dc\u10d0\u10d8\u10e0\u10d8 \u10de\u10d0\u10e1\u10e3\u10ee\u10d8\u10e1\u10db\u10d2\u10d4\u10d1\u10da\u10dd\u10d1\u10d0"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 - \u10d3\u10d8\u10d3\u10d8 \u10de\u10d0\u10e1\u10e3\u10ee\u10d8\u10e1\u10db\u10d2\u10d4\u10d1\u10da\u10dd\u10d1\u10d0"}}},"DE":{"QuestionText":"[Q15] <strong>Wie gro\u00df ist Ihrer Meinung nach die Verantwortung<\/strong> jedes einzelnen Akteurs, die Verbreitung <strong>falscher oder irref\u00fchrender Inhalte zu verhindern<\/strong>?<br \/>\nBitte bewerten Sie von 1 (\u00dcberhaupt keine Verantwortung) bis 7 (Sehr gro\u00dfe Verantwortung)","Choices":{"1":{"Display":"\u00d6ffentlichkeit"},"2":{"Display":"Die Regierung und gew\u00e4hlte Amtstr\u00e4ger"},"3":{"Display":"\u00d6ffentliche und\/oder lokale Institutionen"},"4":{"Display":"Internationale Institutionen"},"5":{"Display":"Redaktionen und Journalisten"},"6":{"Display":"Professionelle Faktenchecker"},"7":{"Display":"Technologieunternehmen\/Social-Media-Plattformen"},"8":{"Display":"Zivilgesellschaft"},"9":{"Display":"Universit\u00e4ten und Forschungsinstitute"}},"Answers":{"1":{"Display":"1 \u2013 \u00dcberhaupt keine Verantwortung"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 - Sehr gro\u00dfe Verantwortung"}}},"HU":{"QuestionText":"[15. k\u00e9rd\u00e9s] V\u00e9lem\u00e9nye szerint <strong>mennyire kellene az egyes szerepl\u0151knek felel\u0151ss\u00e9get<\/strong> v\u00e1llalniuk <strong>a hamis vagy f\u00e9lrevezet\u0151 tartalom terjed\u00e9s\u00e9nek megakad\u00e1lyoz\u00e1s\u00e1ban<\/strong>?<br \/>\nK\u00e9rlek, \u00e9rt\u00e9kelj 1-t\u0151l (Egy\u00e1ltal\u00e1n ne v\u00e1llaljanak felel\u0151ss\u00e9get) 7-ig (Nagy felel\u0151ss\u00e9get v\u00e1llaljanak)!","Choices":{"1":{"Display":"Nagyk\u00f6z\u00f6ns\u00e9g"},"2":{"Display":"A korm\u00e1ny \u00e9s a v\u00e1lasztott tiszts\u00e9gvisel\u0151k"},"3":{"Display":"K\u00f6z-\u00e9s\/vagy helyi int\u00e9zm\u00e9nyek"},"4":{"Display":"Nemzetk\u00f6zi int\u00e9zm\u00e9nyek"},"5":{"Display":"Szerkeszt\u0151k \u00e9s \u00fajs\u00e1g\u00edr\u00f3k"},"6":{"Display":"Professzion\u00e1lis t\u00e9nyellen\u0151rz\u0151k"},"7":{"Display":"Technol\u00f3giai v\u00e1llalatok\/K\u00f6z\u00f6ss\u00e9gi m\u00e9dia platformok"},"8":{"Display":"Civil t\u00e1rsadalom"},"9":{"Display":"Egyetemek \u00e9s kutat\u00f3int\u00e9zetek"}},"Answers":{"1":{"Display":"1 \u2013 Egy\u00e1ltal\u00e1n ne v\u00e1llaljanak felel\u0151ss\u00e9get"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 \u2013 Nagy felel\u0151ss\u00e9get v\u00e1llaljanak"}}},"LV":{"QuestionText":"[15.\u00a0jaut\u0101jums] <strong>Cik atbild\u012bgam<\/strong>, j\u016bsupr\u0101t, vajadz\u0113tu b\u016bt katram no dal\u012bbniekiem, lai <strong>nov\u0113rstu nepatiesa vai maldino\u0161a satura<\/strong> izplat\u012b\u0161anos?<br \/>\nL\u016bdzu, nov\u0113rt\u0113jiet no 1 (Nek\u0101das atbild\u012bbas) l\u012bdz 7 (Liela atbild\u012bba)","Choices":{"1":{"Display":"Pla\u0161ai sabiedr\u012bbai"},"2":{"Display":"Vald\u012bba un iev\u0113l\u0113t\u0101s amatpersonas"},"3":{"Display":"Valsts un\/vai viet\u0113j\u0101s iest\u0101des"},"4":{"Display":"Starptautisk\u0101s instit\u016bcijas"},"5":{"Display":"Redaktori un \u017eurn\u0101listi"},"6":{"Display":"Profesion\u0101li faktu p\u0101rbaud\u012bt\u0101ji"},"7":{"Display":"Tehnolo\u0123iju uz\u0146\u0113mumi\/soci\u0101lo mediju platformas"},"8":{"Display":"Pilsonisk\u0101 sabiedr\u012bba"},"9":{"Display":"Universit\u0101tes un p\u0113tniec\u012bbas instit\u016bti"}},"Answers":{"1":{"Display":"1\u00a0\u2014 Nav nek\u0101das atbild\u012bbas"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 \u2014 Liela atbild\u012bba"}}},"IT":{"QuestionText":"[D15] Secondo te, <strong>quanto dovrebbe essere responsabile<\/strong> ciascuno dei seguenti attori nel <strong>prevenire la diffusione di contenuti falsi o fuorvianti<\/strong>?<br \/>\nSi prega di valutare da 1 (Nessuna responsabilit\u00e0) a 7 (Molta responsabilit\u00e0)","Choices":{"1":{"Display":"Pubblico generale"},"2":{"Display":"Il governo e i funzionari eletti"},"3":{"Display":"Istituzioni pubbliche e\/o locali"},"4":{"Display":"Istituzioni internazionali"},"5":{"Display":"Redattori e giornalisti"},"6":{"Display":"Verificatori di fatti professionisti"},"7":{"Display":"Aziende tecnologiche\/Piattaforme di social media"},"8":{"Display":"Societ\u00e0 civile"},"9":{"Display":"Universit\u00e0 e istituti di ricerca"}},"Answers":{"1":{"Display":"1 - Nessuna responsabilit\u00e0"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 - Molta responsabilit\u00e0"}}},"LT":{"QuestionText":"<meta charset=\"UTF-8\" \/>[15 klausimas] <meta charset=\"UTF-8\" \/>J\u016bs\u0173 nuomone,<strong> kiek kiekviena<\/strong> i\u0161 \u0161i\u0173 \u017eemiau i\u0161vardint\u0173 grupi\u0173 tur\u0117t\u0173 b\u016bti atsakinga u\u017e <strong>melagingo ar klaidinan\u010dio turinio plitimo<\/strong> <strong>prevencij\u0105<\/strong>?\u00a0<br \/>\n\u012evertinkite nuo 1 (visi\u0161kai\u00a0neatsakinga (-i)) iki 7 (labai atsakinga (-i))","Choices":{"1":{"Display":"Pla\u010dioji visuomen\u0117"},"2":{"Display":"Vyriausyb\u0117 ir i\u0161rinkti pareig\u016bnai"},"3":{"Display":"Vie\u0161osios ir (arba) vietos institucijos"},"4":{"Display":"Tarptautin\u0117s institucijos"},"5":{"Display":"Redaktoriai ir \u017eurnalistai"},"6":{"Display":"Profesional\u016bs fakt\u0173 tikrintojai"},"7":{"Display":"Technologij\u0173 \u012fmon\u0117s \/ Socialin\u0117s \u017einiasklaidos platformos"},"8":{"Display":"Pilietin\u0117 visuomen\u0117"},"9":{"Display":"Universitetai ir tyrim\u0173 institutai"}},"Answers":{"1":{"Display":"1 \u2013 Visi\u0161kai\u00a0neatsakinga (-i)"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 \u2013 Labai atsakinga (-i)"}}},"FA":{"QuestionText":"[\u0633\u0648\u0627\u0644 \u06f1\u06f5] \u0628\u0647 \u0646\u0638\u0631 \u0634\u0645\u0627\u060c \u0647\u0631 \u06cc\u06a9 \u0627\u0632 \u0628\u0627\u0632\u06cc\u06af\u0631\u0627\u0646 \u0686\u0642\u062f\u0631 \u0628\u0627\u06cc\u062f \u062f\u0631 <strong>\u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u0627\u0632 \u0627\u0646\u062a\u0634\u0627\u0631 \u0645\u062d\u062a\u0648\u0627\u06cc \u0646\u0627\u062f\u0631\u0633\u062a \u06cc\u0627 \u06af\u0645\u0631\u0627\u0647\u200c\u06a9\u0646\u0646\u062f\u0647<\/strong> <strong>\u0645\u0633\u0626\u0648\u0644<\/strong> \u0628\u0627\u0634\u0646\u062f\u061f<br \/>\n\u0644\u0637\u0641\u0627 \u0627\u0632 \u06f1 (\u0647\u06cc\u0686 \u0645\u0633\u0626\u0648\u0644\u06cc\u062a\u06cc \u0646\u062f\u0627\u0631\u062f) \u062a\u0627 \u06f7 (\u0645\u0633\u0626\u0648\u0644\u06cc\u062a \u0628\u0633\u06cc\u0627\u0631 \u0632\u06cc\u0627\u062f\u06cc \u062f\u0627\u0631\u062f) \u0627\u0645\u062a\u06cc\u0627\u0632 \u062f\u0647\u06cc\u062f.","Choices":{"1":{"Display":"\u0639\u0645\u0648\u0645 \u0645\u0631\u062f\u0645"},"2":{"Display":"\u062f\u0648\u0644\u062a \u0648 \u0645\u0642\u0627\u0645\u0627\u062a \u0645\u0646\u062a\u062e\u0628"},"3":{"Display":"\u0646\u0647\u0627\u062f\u0647\u0627\u06cc \u0639\u0645\u0648\u0645\u06cc \u0648\/\u06cc\u0627 \u0645\u062d\u0644\u06cc"},"4":{"Display":"\u0646\u0647\u0627\u062f\u0647\u0627\u06cc \u0628\u06cc\u0646\u200c\u0627\u0644\u0645\u0644\u0644\u06cc"},"5":{"Display":"\u0633\u0631\u062f\u0628\u06cc\u0631\u0627\u0646 \u0648 \u0631\u0648\u0632\u0646\u0627\u0645\u0647\u200c\u0646\u06af\u0627\u0631\u0627\u0646"},"6":{"Display":"\u0628\u0631\u0631\u0633\u06cc\u200c\u06a9\u0646\u0646\u062f\u06af\u0627\u0646 \u062d\u0631\u0641\u0647\u200c\u0627\u06cc \u0627\u0637\u0644\u0627\u0639\u0627\u062a"},"7":{"Display":"\u0634\u0631\u06a9\u062a\u200c\u0647\u0627\u06cc \u0641\u0646\u0627\u0648\u0631\u06cc\/\u067e\u0644\u062a\u0641\u0631\u0645\u200c\u0647\u0627\u06cc \u0631\u0633\u0627\u0646\u0647\u200c\u0647\u0627\u06cc \u0627\u062c\u062a\u0645\u0627\u0639\u06cc"},"8":{"Display":"\u062c\u0627\u0645\u0639\u0647 \u0645\u062f\u0646\u06cc"},"9":{"Display":"\u062f\u0627\u0646\u0634\u06af\u0627\u0647\u200c\u0647\u0627 \u0648 \u0645\u0624\u0633\u0633\u0627\u062a \u062a\u062d\u0642\u06cc\u0642\u0627\u062a\u06cc"}},"Answers":{"1":{"Display":"\u06f1- \u0647\u06cc\u0686 \u0645\u0633\u0626\u0648\u0644\u06cc\u062a\u06cc \u0646\u062f\u0627\u0631\u062f"},"2":{"Display":"\u06f2"},"3":{"Display":"\u06f3"},"4":{"Display":"\u06f4"},"5":{"Display":"\u06f5"},"6":{"Display":"\u06f6"},"7":{"Display":"\u06f7- \u0645\u0633\u0626\u0648\u0644\u06cc\u062a \u0628\u0633\u06cc\u0627\u0631 \u0632\u06cc\u0627\u062f\u06cc \u062f\u0627\u0631\u062f"}}},"PL":{"QuestionText":"[Q15] Pa\u0144stwa zdaniem, <strong>w jakim stopniu ka\u017cdy z aktor\u00f3w powinien by\u0107 odpowiedzialny<\/strong> za <strong>zapobieganie rozprzestrzenianiu si\u0119 fa\u0142szywych lub wprowadzaj\u0105cych w b\u0142\u0105d tre\u015bci<\/strong>?<br \/>\nProsz\u0119 oceni\u0107 w skali od 1 (brak jakiejkolwiek odpowiedzialno\u015bci) do 7 (du\u017ca odpowiedzialno\u015b\u0107)","Choices":{"1":{"Display":"Og\u00f3\u0142 spo\u0142ecze\u0144stwa"},"2":{"Display":"Rz\u0105d i wybieralni urz\u0119dnicy"},"3":{"Display":"Instytucje publiczne i\/lub lokalne"},"4":{"Display":"Instytucje mi\u0119dzynarodowe"},"5":{"Display":"Redaktorzy i dziennikarze"},"6":{"Display":"Profesjonalni weryfikatorzy fakt\u00f3w"},"7":{"Display":"Firmy technologiczne\/Platformy medi\u00f3w spo\u0142eczno\u015bciowych"},"8":{"Display":"Spo\u0142ecze\u0144stwo obywatelskie (np. organizacje pzarz\u0105dowe, zwi\u0105zki zawodowe, aktywi\u015bci)"},"9":{"Display":"Uniwersytety i instytucje badawcze"}},"Answers":{"1":{"Display":"1 - \u017badnej odpowiedzialno\u015bci"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 - Du\u017ca odpowiedzialno\u015b\u0107"}}},"RU":{"QuestionText":"[Q15] <meta charset=\"UTF-8\" \/>\u041d\u0430 \u0432\u0430\u0448 \u0432\u0437\u0433\u043b\u044f\u0434, <strong>\u043a\u0430\u043a\u043e\u0432\u0430 \u043e\u0442\u0432\u0435\u0442\u0441\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c<\/strong> \u043a\u0430\u0436\u0434\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u0437\u0430 <strong>\u043f\u0440\u0435\u0434\u043e\u0442\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u043b\u043e\u0436\u043d\u043e\u0433\u043e \u0438\u043b\u0438 \u0432\u0432\u043e\u0434\u044f\u0449\u0435\u0433\u043e \u0432 \u0437\u0430\u0431\u043b\u0443\u0436\u0434\u0435\u043d\u0438\u0435 \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u0430<\/strong>?<br \/>\n\u041e\u0446\u0435\u043d\u0438\u0442\u0435 \u043e\u0442 1 (\u0421\u043e\u0432\u0441\u0435\u043c \u043d\u0438\u043a\u0430\u043a\u043e\u0439 \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u0438) \u0434\u043e 7 (\u041e\u0447\u0435\u043d\u044c \u0431\u043e\u043b\u044c\u0448\u0430\u044f \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c)","Choices":{"1":{"Display":"\u0413\u0440\u0430\u0436\u0434\u0430\u043d\u0435"},"2":{"Display":"<meta charset=\"UTF-8\" \/>\u0413\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u043e\u0440\u0433\u0430\u043d\u044b"},"3":{"Display":"<meta charset=\"UTF-8\" \/><meta charset=\"UTF-8\" \/>\u041c\u0435\u0441\u0442\u0