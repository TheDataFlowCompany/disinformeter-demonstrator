0dc\u10d2\u10da\u10d8\u10e1\u10e3\u10e0\u10d8"},"5":{"Display":"\u10e1\u10de\u10d0\u10e0\u10e1\u10e3\u10da\u10d8"},"6":{"Display":"\u10e0\u10e3\u10e1\u10e3\u10da\u10d8"},"8":{"Display":"\u10e3\u10d9\u10e0\u10d0\u10d8\u10dc\u10e3\u10da\u10d8"},"9":{"Display":"\u10e1\u10ee\u10d5\u10d0 (\u10d2\u10d7\u10ee\u10dd\u10d5\u10d7, \u10db\u10d8\u10e3\u10d7\u10d8\u10d7\u10dd\u10d7)"}}},"LT":{"QuestionText":"[2 klausimas] Kokia (-iomis)<strong> kalba (-omis)<\/strong> naudojat\u0117s <strong>socialiniais tinklais<\/strong>? (Pa\u017eym\u0117kite VISAS tinkamas)","Choices":{"1":{"Display":"Gimtoji (-osios) \u0161alies, kurioje gyvenu, kalba (-os)"},"2":{"Display":"Arab\u0173"},"3":{"Display":"Kin\u0173"},"4":{"Display":"Angl\u0173"},"5":{"Display":"Pers\u0173"},"6":{"Display":"Rus\u0173"},"8":{"Display":"Ukrainie\u010di\u0173"},"9":{"Display":"Kita (pra\u0161ome nurodyti)"}}},"LV":{"QuestionText":"[2.\u00a0jaut\u0101jums] Kur\u0101 <strong>(-\u0101s) valod\u0101(-\u0101s)<\/strong> j\u016bs lietojat <strong>soci\u0101los medijus<\/strong>? (Atz\u012bm\u0113jiet VISAS atbilsto\u0161\u0101s atbildes)","Choices":{"1":{"Display":"Dzimt\u0101(-\u0101s) valoda(-as) valst\u012b, kur\u0101 es dz\u012bvoju"},"2":{"Display":"Ar\u0101bu"},"3":{"Display":"\u0136\u012bnie\u0161u"},"4":{"Display":"Ang\u013cu"},"5":{"Display":"Persie\u0161u"},"6":{"Display":"Krievu"},"8":{"Display":"Ukrai\u0146u"},"9":{"Display":"Cits (l\u016bdzu, nor\u0101diet)"}}},"NL":{"QuestionText":"[Q2] In welke <strong>taal\/talen<\/strong> gebruikt u <strong>sociale media<\/strong>? (Selecteer ALLE van toepassing zijnde opties)","Choices":{"1":{"Display":"Moedertaal (talen) van het land waar ik woon"},"2":{"Display":"Arabisch"},"3":{"Display":"Chinees"},"4":{"Display":"Engels"},"5":{"Display":"Perzisch"},"6":{"Display":"Russisch"},"8":{"Display":"Oekra\u00efens"},"9":{"Display":"Anders (Specificeer)"}}},"PL":{"QuestionText":"[Q2] W jakim <strong>j\u0119zyku\/j\u0119zykach<\/strong> korzystaj\u0105 Pa\u0144stwo z <strong>medi\u00f3w spo\u0142eczno\u015bciowych<\/strong>? (Prosz\u0119 zaznaczy\u0107 WSZYSTKIE odpowiedzi, kt\u00f3re Pa\u0144stwa dotycz\u0105)","Choices":{"1":{"Display":"j\u0119zyk(i) ojczysty(e) kraju, w kt\u00f3rym mieszkam"},"2":{"Display":"arabski"},"3":{"Display":"chi\u0144ski"},"4":{"Display":"angielski"},"5":{"Display":"perski"},"6":{"Display":"rosyjski"},"8":{"Display":"ukrai\u0144ski"},"9":{"Display":"inny (prosz\u0119 poda\u0107 jaki)"}}},"RU":{"QuestionText":"[Q2] \u041d\u0430 \u043a\u0430\u043a\u043e\u043c <strong>\u044f\u0437\u044b\u043a\u0435 (\u044f\u0437\u044b\u043a\u0430\u0445)<\/strong> \u0432\u044b \u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0435\u0441\u044c <strong>\u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u0441\u0435\u0442\u044f\u043c\u0438<\/strong>? (\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0412\u0421\u0415 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0438\u0435 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b)","Choices":{"1":{"Display":"\u0420\u043e\u0434\u043d\u043e\u0439 \u044f\u0437\u044b\u043a(\u0438) \u0441\u0442\u0440\u0430\u043d\u044b, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u044f \u043f\u0440\u043e\u0436\u0438\u0432\u0430\u044e"},"2":{"Display":"\u0410\u0440\u0430\u0431\u0441\u043a\u0438\u0439"},"3":{"Display":"\u041a\u0438\u0442\u0430\u0439\u0441\u043a\u0438\u0439"},"4":{"Display":"\u0410\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u0438\u0439"},"5":{"Display":"\u041f\u0435\u0440\u0441\u0438\u0434\u0441\u043a\u0438\u0439"},"6":{"Display":"\u0420\u0443\u0441\u0441\u043a\u0438\u0439"},"8":{"Display":"\u0423\u043a\u0440\u0430\u0438\u043d\u0441\u043a\u0438\u0439"},"9":{"Display":"\u0414\u0440\u0443\u0433\u043e\u0439 (\u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430 \u0443\u0442\u043e\u0447\u043d\u0438\u0442\u0435)"}}},"SR":{"QuestionText":"[\u041f2] \u041d\u0430 <strong>\u043a\u043e\u0458\u0438\u043c \u0458\u0435\u0437\u0438\u0446\u0438\u043c\u0430<\/strong> \u043a\u043e\