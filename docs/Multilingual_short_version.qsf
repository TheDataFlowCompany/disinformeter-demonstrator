4a\u0648"},"3":{"Display":"\u0627\u0644\u0635\u062d\u0641 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0648\u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0627\u0644\u0623\u062e\u0628\u0627\u0631"},"4":{"Display":"\u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0627\u0644\u0645\u0631\u0627\u0633\u0644\u0629"},"5":{"Display":"\u0648\u0633\u0627\u0626\u0644 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a \u0648\u0627\u0644\u0628\u0648\u062f\u0643\u0627\u0633\u062a"}},"Answers":{"1":{"Display":"1- \u0623\u0628\u062f\u0627"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 - \u062f\u0627\u0626\u0645\u0627"}}},"BG":{"QuestionText":"[Q3] \u041a\u043e\u043b\u043a\u043e \u0447\u0435\u0441\u0442\u043e \u0438\u0437\u043f\u043e\u043b\u0437\u0432\u0430\u0442\u0435 \u0438\u0437\u0431\u0440\u043e\u0435\u043d\u0438\u0442\u0435 \u043c\u0435\u0434\u0438\u0438, \u0437\u0430 \u0434\u0430 \u0441\u0435 \u0438\u043d\u0444\u043e\u0440\u043c\u0438\u0440\u0430\u0442\u0435 \u0437\u0430 \u043d\u043e\u0432\u0438\u043d\u0438?<br \/>\n\u041c\u043e\u043b\u044f, \u043e\u0446\u0435\u043d\u0435\u0442\u0435 \u043e\u0442 1 (\u041d\u0438\u043a\u043e\u0433\u0430) \u0434\u043e 7 (\u0412\u0438\u043d\u0430\u0433\u0438)","Choices":{"1":{"Display":"\u041f\u0435\u0447\u0430\u0442\u043d\u0438 \u0432\u0435\u0441\u0442\u043d\u0438\u0446\u0438"},"2":{"Display":"\u0422\u0435\u043b\u0435\u0432\u0438\u0437\u0438\u044f, \u0440\u0430\u0434\u0438\u043e"},"3":{"Display":"\u041e\u043d\u043b\u0430\u0439\u043d \u0432\u0435\u0441\u0442\u043d\u0438\u0446\u0438, \u043d\u043e\u0432\u0438\u043d\u0430\u0440\u0441\u043a\u0438 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f"},"4":{"Display":"\u041f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0437\u0430 \u0441\u044a\u043e\u0431\u0449\u0435\u043d\u0438\u044f"},"5":{"Display":"\u0421\u043e\u0446\u0438\u0430\u043b\u043d\u0438