view about each type of news and information? Please rate from 1...","Choices":{"1":{"Display":"False content that is intended to mislead the public"},"2":{"Display":"Spread of satires about a person, issue or event"},"3":{"Display":"Breaking information that is published before everything is verified"},"4":{"Display":"Factual information presented to favor one side of an issue"},"5":{"Display":"A video or image that is altered or made up to mislead the public"},"6":{"Display":"Please select '4' for this item to show you're paying attention"}},"ChoiceOrder":[1,2,3,"6",4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":{"AR":{"QuestionText":"[\u063312] \u0623\u064a\u0647\u0645\u0627 <strong>\u0623\u0642\u0631\u0628 \u0625\u0644\u0649 \u0648\u062c\u0647\u0629 \u0646\u0638\u0631\u0643<\/strong> \u0628\u0634\u0623\u0646 <strong>\u0643\u0644 \u0646\u0648\u0639 \u0645\u0646 \u0623\u0646\u0648\u0627\u0639 \u0627\u0644\u0623\u062e\u0628\u0627\u0631 \u0648\u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a<\/strong> \u061f<br> \u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u0642\u064a\u064a\u0645 \u0645\u0646 1 (\u0623\u062f\u0639\u0645 \u0628\u0634\u062f\u0629 \u0627\u0644\u0642\u064a\u0648\u062f) \u0625\u0644\u0649 7 (\u0623\u062f\u0639\u0645 \u0628\u0634\u062f\u0629 \u062d\u0631\u064a\u0629 \u0627\u0644\u0646\u0634\u0631 \u0648\u0627\u0644\u0648\u0635\u0648\u0644)","Choices":{"1":{"Display":"\u0645\u062d\u062a\u0648\u0649 \u0643\u0627\u0630\u0628 \u064a\u0647\u062f\u0641 \u0625\u0644\u0649 \u062a\u0636\u0644\u064a\u0644 \u0627\u0644\u062c\u0645\u0647\u0648\u0631"},"2":{"Display":"\u0627\u0644\u0633\u062e\u0631\u064a\u0629 \u0645\u0646 \u0634\u062e\u0635 \u0623\u0648 \u0642\u0636\u064a\u0629 \u0623\u0648 \u062d\u062f\u062b"},"3":{"Display":"\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0639\u0627\u062c\u0644\u0629 \u064a\u062a\u0645 \u0646\u0634\u0631\u0647\u0627 \u0642\u0628\u0644 \u0627\u0644\u062a\u0623\u0643\u062f \u0645\u0646 \u0643\u0644 \u0634\u064a\u0621"},"4":{"Display":"\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0648\u0627\u0642\u0639\u064a\u0629 \u0645\u0642\u062f\u0645\u0629 \u0644\u0635\u0627\u0644\u062d \u062c\u0627\u0646\u0628 \u0648\u0627\u062d\u062f \u0645\u0646 \u0627\u0644\u0642\u0636\u064a\u0629"},"5":{"Display":"\u0645\u0642\u0637\u0639 \u0641\u064a\u062f\u064a\u0648 \u0623\u0648 \u0635\u0648\u0631\u0629 \u062a\u0645 \u062a\u0639\u062f\u064a\u0644\u0647\u0627 \u0623\u0648 \u0627\u062e\u062a\u0644\u0627\u0642\u0647\u0627 \u0644\u062a\u0636\u0644\u064a\u0644 \u0627\u0644\u062c\u0645\u0647\u0648\u0631"},"6":{"Display":"\u0627\u0644\u0631\u062c\u0627\u0621 \u062a\u062d\u062f\u064a\u062f &quot;4&quot; \u0644\u0647\u0630\u0627 \u0627\u0644\u0639\u0646\u0635\u0631 \u0644\u0625\u0638\u0647\u0627\u0631 \u0627\u0647\u062a\u0645\u0627\u0645\u0643"}},"Answers":{"1":{"Display":"1- \u0623\u0624\u064a\u062f \u0628\u0634\u062f\u0629 \u0627\u0644\u062a\u0642\u064a\u064a\u062f"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 - \u0646\u062f\u0639\u0645 \u0628\u0642\u0648\u0629 \u062d\u0631\u064a\u0629 \u0627\u0644\u0646\u0634\u0631 \u0648\u0627\u0644\u0648\u0635\u0648\u0644"}}},"BG":{"QuestionText":"[\u041212] \u041a\u043e\u0435 \u0435 <strong>\u043f\u043e-\u0431\u043b\u0438\u0437\u043a\u043e \u0434\u043e \u0432\u0430\u0448\u0435\u0442\u043e \u043c\u043d\u0435\u043d\u0438\u0435<\/strong> \u0437\u0430 <strong>\u0432\u0441\u0435\u043a\u0438 \u0442\u0438\u043f \u043d\u043e\u0432\u0438\u043d\u0438 \u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f<\/strong> ?<br> \u041c\u043e\u043b\u044f, \u043e\u0446\u0435\u043d\u0435\u0442\u0435 \u043e\u0442 1 (\u0421\u0438\u043b\u043d\u043e \u043f\u043e\u0434\u043a\u0440\u0435\u043f\u044f\u043c \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435\u0442\u043e) \u0434\u043e 7 (\u0421\u0438\u043b\u043d\u043e \u043f\u043e\u0434\u043a\u0440\u0435\u043f\u044f\u043c \u0441\u0432\u043e\u0431\u043e\u0434\u0430\u0442\u0430 \u043d\u0430 \u043f\u0443\u0431\u043b\u0438\u043a\u0443\u0432\u0430\u043d\u0435 \u0438 \u0434\u043e\u0441\u0442\u044a\u043f)","Choices":{"1":{"Display":"\u041d\u0435\u0432\u044f\u0440\u043d\u043e \u0441\u044a\u0434\u044a\u0440\u0436\u0430\u043d\u0438\u0435, \u043a\u043e\u0435\u0442\u043e \u0438\u043c\u0430 \u0437\u0430 \u0446\u0435\u043b \u0434\u0430 \u0437\u0430\u0431\u043b\u0443\u0434\u0438 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043e\u0441\u0442\u0442\u0430"},"2":{"Display":"\u0421\u0430\u0442\u0438\u0440\u0430 \u0437\u0430 \u0447\u043e\u0432\u0435\u043a, \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u0438\u043b\u0438 \u0441\u044a\u0431\u0438\u0442\u0438\u0435"},"3":{"Display":"\u0418\u0437\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u043d\u0430 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f, \u043f\u0443\u0431\u043b\u0438\u043a\u0443\u0432\u0430\u043d\u0430 \u043f\u0440\u0435\u0434\u0438 \u0432\u0441\u0438\u0447\u043a\u043e \u0434\u0430 \u0431\u044a\u0434\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u043e"},"4":{"Display":"\u0424\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0430 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f, \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0435\u043d\u0430 \u0432 \u043f\u043e\u043b\u0437\u0430 \u043d\u0430 \u0435\u0434\u043d\u0430\u0442\u0430 \u0441\u0442\u0440\u0430\u043d\u0430 \u043f\u043e \u0434\u0430\u0434\u0435\u043d \u0432\u044a\u043f\u0440\u043e\u0441"},"5":{"Display":"\u0412\u0438\u0434\u0435\u043e\u043a\u043b\u0438\u043f \u0438\u043b\u0438 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435, \u043a\u043e\u0435\u0442\u043e \u0435 \u043f\u0440\u043e\u043c\u0435\u043d\u0435\u043d\u043e \u0438\u043b\u0438 \u0438\u0437\u043c\u0438\u0441\u043b\u0435\u043d\u043e \u0441 \u0446\u0435\u043b \u0434\u0430 \u0437\u0430\u0431\u043b\u0443\u0434\u0438 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043e\u0441\u0442\u0442\u0430"},"6":{"Display":"\u041c\u043e\u043b\u044f, \u0438\u0437\u0431\u0435\u0440\u0435\u0442\u0435 \u201e4\u201c \u0437\u0430 \u0442\u043e\u0437\u0438 \u0435\u043b\u0435\u043c\u0435\u043d\u0442, \u0437\u0430 \u0434\u0430 \u043f\u043e\u043a\u0430\u0436\u0435\u0442\u0435, \u0447\u0435 \u043e\u0431\u0440\u044a\u0449\u0430\u0442\u0435 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435"}},"Answers":{"1":{"Display":"1 - \u0421\u0438\u043b\u043d\u043e \u043f\u043e\u0434\u043a\u0440\u0435\u043f\u044f\u043c \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435\u0442\u043e"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 - \u0421\u0438\u043b\u043d\u043e \u043f\u043e\u0434\u043a\u0440\u0435\u043f\u044f\u043c\u0435 \u0441\u0432\u043e\u0431\u043e\u0434\u0430\u0442\u0430 \u043d\u0430 \u043f\u0443\u0431\u043b\u0438\u043a\u0443\u0432\u0430\u043d\u0435 \u0438 \u0434\u043e\u0441\u0442\u044a\u043f"}}},"DE":{"QuestionText":"[F12] Was kommt <strong>Ihrer Ansicht<\/strong> zu <strong>den einzelnen Nachrichten- und Informationsarten<\/strong> am n\u00e4chsten?<br> Bitte bewerten Sie auf einer Skala von 1 (unterst\u00fctze die Einschr\u00e4nkung voll und ganz) bis 7 (unterst\u00fctze die Freiheit der Ver\u00f6ffentlichung und des Zugriffs voll und ganz).","Choices":{"1":{"Display":"Falsche Inhalte, die die \u00d6ffentlichkeit irref\u00fchren sollen"},"2":{"Display":"Satire \u00fcber eine Person, ein Thema oder ein Ereignis"},"3":{"Display":"Aktuelle Informationen, die ver\u00f6ffentlicht werden, bevor alles \u00fcberpr\u00fcft wurde"},"4":{"Display":"Sachinformationen, die pr\u00e4sentiert werden, um eine Seite eines Problems zu beg\u00fcnstigen"},"5":{"Display":"Ein Video oder Bild, das ver\u00e4ndert oder erfunden wurde, um die \u00d6ffentlichkeit in die Irre zu f\u00fchren"},"6":{"Display":"Bitte w\u00e4hlen Sie f\u00fcr diesen Artikel die Zahl \u201e4\u201c, um zu zeigen, dass Sie aufmerksam sind."}},"Answers":{"1":{"Display":"1 - Bef\u00fcrworte die Einschr\u00e4nkung nachdr\u00fccklich"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 - Unterst\u00fctzen Sie die Freiheit der Ver\u00f6ffentlichung und des Zugangs"}}},"ET":{"QuestionText":"[K12] Milline <strong>neist uudiste ja teabe liikidest<\/strong> on <strong>teie arvamusele l\u00e4hemal<\/strong> ?<br> Palun hinnake skaalal 1 (Toetan kindlalt piirangut) kuni 7 (Toetan kindlalt avaldamis- ja juurdep\u00e4\u00e4suvabadust)","Choices":{"1":{"Display":"Vale sisu, mille eesm\u00e4rk on avalikkust eksitada"},"2":{"Display":"Satiir inimese, teema v\u00f5i s\u00fcndmuse kohta"},"3":{"Display":"Murdev teave, mis avaldatakse enne, kui k\u00f5ik on kinnitatud"},"4":{"Display":"Faktiline teave, mis esitatakse k\u00fcsimuse \u00fche poole kasuks"},"5":{"Display":"Video v\u00f5i pilt, mida on muudetud v\u00f5i mis on loodud avalikkuse eksitamiseks"},"6":{"Display":"Palun vali selle \u00fcksuse jaoks &#39;4&#39;, et n\u00e4idata, et p\u00f6\u00f6rad t\u00e4helepanu."}},"Answers":{"1":{"Display":"1 \u2013 Toetan piirangut tugevalt"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 - Toetan kindlalt avaldamis- ja juurdep\u00e4\u00e4suvabadust"}}},"FA":{"QuestionText":"[\u0633\u0648\u0627\u0644 \u06f1\u06f2] \u06a9\u062f\u0627\u0645 \u06cc\u06a9 <strong>\u0628\u0647 \u0646\u0638\u0631 \u0634\u0645\u0627<\/strong> \u062f\u0631 \u0645\u0648\u0631\u062f <strong>\u0647\u0631 \u0646\u0648\u0639 \u0627\u062e\u0628\u0627\u0631 \u0648 \u0627\u0637\u0644\u0627\u0639\u0627\u062a<\/strong> \u0646\u0632\u062f\u06cc\u06a9\u200c\u062a\u0631 \u0627\u0633\u062a\u061f<br> \u0644\u0637\u0641\u0627 \u0627\u0632 \u06f1 (\u0642\u0648\u06cc\u0627\u064b \u0627\u0632 \u0645\u062d\u062f\u0648\u062f\u06cc\u062a \u062d\u0645\u0627\u06cc\u062a \u0645\u06cc\u200c\u06a9\u0646\u0645) \u062a\u0627 \u06f7 (\u0642\u0648\u06cc\u0627\u064b \u0627\u0632 \u0622\u0632\u0627\u062f\u06cc \u0627\u0646\u062a\u0634\u0627\u0631 \u0648 \u062f\u0633\u062a\u0631\u0633\u06cc \u062d\u0645\u0627\u06cc\u062a \u0645\u06cc\u200c\u06a9\u0646\u0645) \u0627\u0645\u062a\u06cc\u0627\u0632 \u062f\u0647\u06cc\u062f.","Choices":{"1":{"Display":"\u0645\u062d\u062a\u0648\u0627\u06cc \u0646\u0627\u062f\u0631\u0633\u062a\u06cc \u06a9\u0647 \u0628\u0627 \u0647\u062f\u0641 \u06af\u0645\u0631\u0627\u0647 \u06a9\u0631\u062f\u0646 \u0627\u0641\u06a9\u0627\u0631 \u0639\u0645\u0648\u0645\u06cc \u0645\u0646\u062a\u0634\u0631 \u0645\u06cc\u200c\u0634\u0648\u062f"},"2":{"Display":"\u0637\u0646\u0632 \u062f\u0631\u0628\u0627\u0631\u0647 \u06cc\u06a9 \u0634\u062e\u0635\u060c \u0645\u0648\u0636\u0648\u0639 \u06cc\u0627 \u0631\u0648\u06cc\u062f\u0627\u062f"},"3":{"Display":"\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0641\u0648\u0631\u06cc \u06a9\u0647 \u0642\u0628\u0644 \u0627\u0632 \u062a\u0623\u06cc\u06cc\u062f \u0647\u0645\u0647 \u0686\u06cc\u0632 \u0645\u0646\u062a\u0634\u0631 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f"},"4":{"Display":"\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0648\u0627\u0642\u0639\u06cc \u0627\u0631\u0627\u0626\u0647 \u0634\u062f\u0647 \u0628\u0647 \u0646\u0641\u0639 \u06cc\u06a9 \u0637\u0631\u0641 \u0642\u0636\u06cc\u0647"},"5":{"Display":"\u0648\u06cc\u062f\u06cc\u0648 \u06cc\u0627 \u062a\u0635\u0648\u06cc\u0631\u06cc \u06a9\u0647 \u0628\u0631\u0627\u06cc \u06af\u0645\u0631\u0627\u0647 \u06a9\u0631\u062f\u0646 \u0639\u0645\u0648\u0645 \u062a\u063a\u06cc\u06cc\u0631 \u062f\u0627\u062f\u0647 \u0634\u062f\u0647 \u06cc\u0627 \u0633\u0627\u062e\u062a\u0647 \u0634\u062f\u0647 \u0627\u0633\u062a"},"6":{"Display":"\u0644\u0637\u0641\u0627 \u0628\u0631\u0627\u06cc \u0646\u0634\u0627\u0646 \u062f\u0627\u062f\u0646 \u062a\u0648\u062c\u0647 \u062e\u0648\u062f\u060c \u0639\u062f\u062f \u00ab\u06f4\u00bb \u0631\u0627 \u0628\u0631\u0627\u06cc \u0627\u06cc\u0646 \u0645\u0648\u0631\u062f \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f"}},"Answers":{"1":{"Display":"\u06f1 - \u0642\u0648\u06cc\u0627\u064b \u0627\u0632 \u0645\u062d\u062f\u0648\u062f\u06cc\u062a \u062d\u0645\u0627\u06cc\u062a \u06a9\u0646\u06cc\u062f"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"\u06f7 - \u0642\u0648\u06cc\u0627\u064b \u0627\u0632 \u0622\u0632\u0627\u062f\u06cc \u0627\u0646\u062a\u0634\u0627\u0631 \u0648 \u062f\u0633\u062a\u0631\u0633\u06cc \u062d\u0645\u0627\u06cc\u062a \u06a9\u0646\u06cc\u062f"}}},"FR":{"QuestionText":"[Q12] Qu&#39;est-ce qui se <strong>rapproche le plus de votre point de vue<\/strong> sur <strong>chaque type d&#39;actualit\u00e9 et d&#39;information<\/strong> ?<br> Veuillez noter de 1 (soutenir fermement la restriction) \u00e0 7 (soutenir fermement la libert\u00e9 de publication et d&#39;acc\u00e8s)","Choices":{"1":{"Display":"Contenu faux destin\u00e9 \u00e0 induire le public en erreur"},"2":{"Display":"Satire sur une personne, un probl\u00e8me ou un \u00e9v\u00e9nement"},"3":{"Display":"Informations de derni\u00e8re minute publi\u00e9es avant que tout ne soit v\u00e9rifi\u00e9"},"4":{"Display":"Informations factuelles pr\u00e9sent\u00e9es pour favoriser un c\u00f4t\u00e9 d&#39;une question"},"5":{"Display":"Une vid\u00e9o ou une image modifi\u00e9e ou invent\u00e9e pour tromper le public"},"6":{"Display":"Veuillez s\u00e9lectionner \u00ab\u00a04\u00a0\u00bb pour cet \u00e9l\u00e9ment pour montrer que vous y pr\u00eatez attention."}},"Answers":{"1":{"Display":"1 - Soutenir fortement la restriction"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 - Soutenir fermement la libert\u00e9 de publication et d\u2019acc\u00e8s"}}},"HU":{"QuestionText":"[K12] Melyik \u00e1ll k\u00f6zelebb <strong>az egyes h\u00edr- \u00e9s inform\u00e1ci\u00f3t\u00edpusokr\u00f3l<\/strong> alkotott <strong>n\u00e9zet\u00e9hez<\/strong> ?<br> K\u00e9rj\u00fck, \u00e9rt\u00e9keljen 1-t\u0151l (Hat\u00e1rozottan t\u00e1mogatom a korl\u00e1toz\u00e1st) 7-ig (Hat\u00e1rozottan t\u00e1mogatom a publik\u00e1l\u00e1s \u00e9s a hozz\u00e1f\u00e9r\u00e9s szabads\u00e1g\u00e1t)","Choices":{"1":{"Display":"Hamis tartalom, amelynek c\u00e9lja a nyilv\u00e1noss\u00e1g f\u00e9lrevezet\u00e9se"},"2":{"Display":"Szat\u00edra egy szem\u00e9lyr\u0151l, probl\u00e9m\u00e1r\u00f3l vagy esem\u00e9nyr\u0151l"},"3":{"Display":"Friss inform\u00e1ci\u00f3k, amelyek m\u00e9g azel\u0151tt ker\u00fclnek nyilv\u00e1noss\u00e1gra, hogy mindent ellen\u0151riztek volna"},"4":{"Display":"T\u00e9nyszer\u0171 inform\u00e1ci\u00f3k bemutat\u00e1sa egy k\u00e9rd\u00e9s egyik oldal\u00e1nak el\u0151nyben r\u00e9szes\u00edt\u00e9se \u00e9rdek\u00e9ben"},"5":{"Display":"Olyan vide\u00f3 vagy k\u00e9p, amelyet a nyilv\u00e1noss\u00e1g f\u00e9lrevezet\u00e9se c\u00e9lj\u00e1b\u00f3l m\u00f3dos\u00edtottak vagy k\u00e9sz\u00edtettek"},"6":{"Display":"K\u00e9rj\u00fck, v\u00e1lasszon &#39;4&#39;-est ehhez az elemhez, hogy jelezze, figyelmes."}},"Answers":{"1":{"Display":"1 \u2013 Hat\u00e1rozottan t\u00e1mogatom a korl\u00e1toz\u00e1st"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 \u2013 Hat\u00e1rozottan t\u00e1mogatom a publik\u00e1l\u00e1s \u00e9s a hozz\u00e1f\u00e9r\u00e9s szabads\u00e1g\u00e1t"}}},"IT":{"QuestionText":"[Q12] Quale <strong>delle due tipologie di notizie e informazioni<\/strong> si <strong>avvicina di pi\u00f9 alla tua visione<\/strong> ?<br> Si prega di valutare da 1 (Supporto fortemente la restrizione) a 7 (Supporto fortemente la libert\u00e0 di pubblicazione e accesso)","Choices":{"1":{"Display":"Contenuti falsi volti a trarre in inganno il pubblico"},"2":{"Display":"Satira su una persona, un problema o un evento"},"3":{"Display":"Informazioni dell&#39;ultima ora pubblicate prima che tutto sia verificato"},"4":{"Display":"Informazioni fattuali presentate per favorire una parte di una questione"},"5":{"Display":"Un video o un&#39;immagine alterata o creata per trarre in inganno il pubblico"},"6":{"Display":"Seleziona &quot;4&quot; per questo elemento per mostrare che stai prestando attenzione"}},"Answers":{"1":{"Display":"1 - Sostenere fortemente la restrizione"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 - Sostenere fermamente la libert\u00e0 di pubblicazione e di accesso"}}},"KAT":{"QuestionText":"[Q12] \u10e0\u10dd\u10db\u10d4\u10da\u10d8\u10d0 <strong>\u10e3\u10e4\u10e0\u10dd \u10d0\u10ee\u10da\u10dd\u10e1 \u10d7\u10e5\u10d5\u10d4\u10dc\u10e1 \u10e8\u10d4\u10ee\u10d4\u10d3\u10e3\u10da\u10d4\u10d1\u10d0\u10e1\u10d7\u10d0\u10dc<\/strong> <strong>\u10d7\u10d8\u10d7\u10dd\u10d4\u10e3\u10da\u10d8 \u10e2\u10d8\u10de\u10d8\u10e1 \u10e1\u10d8\u10d0\u10ee\u10da\u10d4\u10e1\u10d0 \u10d3\u10d0 \u10d8\u10dc\u10e4\u10dd\u10e0\u10db\u10d0\u10ea\u10d8\u10d0\u10e1\u10d7\u10d0\u10dc<\/strong> \u10d3\u10d0\u10d9\u10d0\u10d5\u10e8\u10d8\u10e0\u10d4\u10d1\u10d8\u10d7?<br> \u10d2\u10d7\u10ee\u10dd\u10d5\u10d7, \u10e8\u10d4\u10d0\u10e4\u10d0\u10e1\u10dd\u10d7 1-\u10d3\u10d0\u10dc (\u10d9\u10d0\u10e2\u10d4\u10d2\u10dd\u10e0\u10d8\u10e3\u10da\u10d0\u10d3 \u10d5\u10e3\u10ed\u10d4\u10e0 \u10db\u10ee\u10d0\u10e0\u10e1 \u10e8\u10d4\u10d6\u10e6\u10e3\u10d3\u10d5\u10d0\u10e1) 7-\u10db\u10d3\u10d4 (\u10d9\u10d0\u10e2\u10d4\u10d2\u10dd\u10e0\u10d8\u10e3\u10da\u10d0\u10d3 \u10d5\u10e3\u10ed\u10d4\u10e0 \u10db\u10ee\u10d0\u10e0\u10e1 \u10d2\u10d0\u10db\u10dd\u10e5\u10d5\u10d4\u10e7\u10dc\u10d4\u10d1\u10d8\u10e1\u10d0 \u10d3\u10d0 \u10ec\u10d5\u10d3\u10dd\u10db\u10d8\u10e1 \u10d7\u10d0\u10d5\u10d8\u10e1\u10e3\u10e4\u10da\u10d4\u10d1\u10d0\u10e1)","Choices":{"1":{"Display":"\u10ea\u10e0\u10e3 \u10e8\u10d8\u10dc\u10d0\u10d0\u10e0\u10e1\u10d8, \u10e0\u10dd\u10db\u10d4\u10da\u10d8\u10ea \u10db\u10d8\u10d6\u10dc\u10d0\u10d3 \u10d8\u10e1\u10d0\u10ee\u10d0\u10d5\u10e1 \u10e1\u10d0\u10d6\u10dd\u10d2\u10d0\u10d3\u10dd\u10d4\u10d1\u10d8\u10e1 \u10e8\u10d4\u10ea\u10d3\u10dd\u10db\u10d0\u10e8\u10d8 \u10e8\u10d4\u10e7\u10d5\u10d0\u10dc\u10d0\u10e1"},"2":{"Display":"\u10e1\u10d0\u10e2\u10d8\u10e0\u10d0 \u10d0\u10d3\u10d0\u10db\u10d8\u10d0\u10dc\u10d6\u10d4, \u10e1\u10d0\u10d9\u10d8\u10d7\u10ee\u10d6\u10d4 \u10d0\u10dc \u10db\u10dd\u10d5\u10da\u10d4\u10dc\u10d0\u10d6\u10d4"},"3":{"Display":"\u10d2\u10d0\u10d3\u10d0\u10db\u10ec\u10e7\u10d5\u10d4\u10e2\u10d8 \u10d8\u10dc\u10e4\u10dd\u10e0\u10db\u10d0\u10ea\u10d8\u10d0, \u10e0\u10dd\u10db\u10d4\u10da\u10d8\u10ea \u10e7\u10d5\u10d4\u10da\u10d0\u10e4\u10e0\u10d8\u10e1 \u10d3\u10d0\u10d3\u10d0\u10e1\u10e2\u10e3\u10e0\u10d4\u10d1\u10d0\u10db\u10d3\u10d4 \u10e5\u10d5\u10d4\u10e7\u10dc\u10d3\u10d4\u10d1\u10d0"},"4":{"Display":"\u10e4\u10d0\u10e5\u10e2\u10dd\u10d1\u10e0\u10d8\u10d5\u10d8 \u10d8\u10dc\u10e4\u10dd\u10e0\u10db\u10d0\u10ea\u10d8\u10d0 \u10ec\u10d0\u10e0\u10db\u10dd\u10d3\u10d2\u10d4\u10dc\u10d8\u10da\u10d8\u10d0 \u10e1\u10d0\u10d9\u10d8\u10d7\u10ee\u10d8\u10e1 \u10d4\u10e0\u10d7\u10d8 \u10db\u10ee\u10d0\u10e0\u10d8\u10e1 \u10e1\u10d0\u10e1\u10d0\u10e0\u10d2\u10d4\u10d1\u10da\u10dd\u10d3"},"5":{"Display":"\u10d5\u10d8\u10d3\u10d4\u10dd \u10d0\u10dc \u10e1\u10e3\u10e0\u10d0\u10d7\u10d8, \u10e0\u10dd\u10db\u10d4\u10da\u10d8\u10ea \u10e8\u10d4\u10ea\u10d5\u10da\u10d8\u10da\u10d8\u10d0 \u10d0\u10dc \u10e8\u10d4\u10e5\u10db\u10dc\u10d8\u10da\u10d8\u10d0 \u10e1\u10d0\u10d6\u10dd\u10d2\u10d0\u10d3\u10dd\u10d4\u10d1\u10d8\u10e1 \u10e8\u10d4\u10ea\u10d3\u10dd\u10db\u10d0\u10e8\u10d8 \u10e8\u10d4\u10e1\u10d0\u10e7\u10d5\u10d0\u10dc\u10d0\u10d3"},"6":{"Display":"\u10d2\u10d7\u10ee\u10dd\u10d5\u10d7, \u10d0\u10db \u10dc\u10d8\u10d5\u10d7\u10d8\u10e1\u10d7\u10d5\u10d8\u10e1 \u10d0\u10d8\u10e0\u10e9\u10d8\u10dd\u10d7 \u201e4\u201c, \u10e0\u10d0\u10d7\u10d0 \u10d0\u10e9\u10d5\u10d4\u10dc\u10dd\u10d7, \u10e0\u10dd\u10db \u10e7\u10e3\u10e0\u10d0\u10d3\u10e6\u10d4\u10d1\u10d0\u10e1 \u10d0\u10e5\u10ea\u10d4\u10d5\u10d7"}},"Answers":{"1":{"Display":"1 - \u10db\u10e2\u10d9\u10d8\u10ea\u10d4\u10d3 \u10d5\u10e3\u10ed\u10d4\u10e0 \u10db\u10ee\u10d0\u10e0\u10e1 \u10e8\u10d4\u10d6\u10e6\u10e3\u10d3\u10d5\u10d0\u10e1"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 - \u10db\u10e2\u10d9\u10d8\u10ea\u10d4\u10d3 \u10d5\u10e3\u10ed\u10d4\u10e0\u10d7 \u10db\u10ee\u10d0\u10e0\u10e1 \u10d2\u10d0\u10db\u10dd\u10e5\u10d5\u10d4\u10e7\u10dc\u10d4\u10d1\u10d8\u10e1\u10d0 \u10d3\u10d0 \u10ec\u10d5\u10d3\u10dd\u10db\u10d8\u10e1 \u10d7\u10d0\u10d5\u10d8\u10e1\u10e3\u10e4\u10da\u10d4\u10d1\u10d0\u10e1"}}},"LT":{"QuestionText":"[12 klausimas] Kuris atsakymas <strong>artimesnis J\u016bs\u0173 po\u017ei\u016briui<\/strong> \u012f <strong>kiekvien\u0105 naujien\u0173 ir informacijos r\u016b\u0161\u012f<\/strong> ?<br> \u012evertinkite nuo 1 (Visi\u0161kai pritariu apribojimui) iki 7 (Visi\u0161kai pritariu laisvei publikuoti ir susipa\u017einti su informacija)","Choices":{"1":{"Display":"Klaidingas turinys, kuriuo siekiama suklaidinti visuomen\u0119"},"2":{"Display":"Satyra apie asmen\u012f, problem\u0105 ar \u012fvyk\u012f"},"3":{"Display":"Skubi informacija, kuri skelbiama dar prie\u0161 viskam patvirtinant"},"4":{"Display":"Pateikta faktin\u0117 informacija, kuria siekiama palankesn\u0117s s\u0105lygos vienai problemos pusei"},"5":{"Display":"Vaizdo \u012fra\u0161as ar vaizdas, kuris yra pakeistas arba sukurtas siekiant suklaidinti visuomen\u0119"},"6":{"Display":"\u0160iam elementui pasirinkite \u201e4\u201c, kad parodytum\u0117te, jog atkreipiate d\u0117mes\u012f."}},"Answers":{"1":{"Display":"1. Grie\u017etai pritariu apribojimui"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7. Tvirtai remti laisv\u0119 publikuoti ir susipa\u017einti su informacija"}}},"LV":{"QuestionText":"[12.\u00a0jaut\u0101jums] Kur\u0161 no \u0161iem <strong>apgalvojumiem atbilst j\u016bsu viedoklim<\/strong> par <strong>katru zi\u0146u un inform\u0101cijas veidu<\/strong> ?<br> L\u016bdzu, nov\u0113rt\u0113jiet no 1 (stingri atbalstu ierobe\u017eojumu) l\u012bdz 7 (stingri atbalstu public\u0113\u0161anas un piek\u013cuves br\u012bv\u012bbu)","Choices":{"1":{"Display":"Nepatiess saturs, kura m\u0113r\u0137is ir maldin\u0101t sabiedr\u012bbu"},"2":{"Display":"Sat\u012bra par personu, probl\u0113mu vai notikumu"},"3":{"Display":"Negaid\u012bta inform\u0101cija, kas tiek public\u0113ta pirms visa apstiprin\u0101\u0161anas"},"4":{"Display":"Faktiska inform\u0101cija, kas sniegta, lai atbalst\u012btu vienu jaut\u0101juma pusi"},"5":{"Display":"Video vai att\u0113ls, kas ir p\u0101rveidots vai p\u0101rveidots, lai maldin\u0101tu sabiedr\u012bbu"},"6":{"Display":"L\u016bdzu, \u0161im vienumam izv\u0113lieties \u201c4\u201d, lai par\u0101d\u012btu, ka piev\u0113r\u0161at uzman\u012bbu."}},"Answers":{"1":{"Display":"1.\u00a0Stingri atbalstu ierobe\u017eojumu"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7.\u00a0Stingri atbalst\u012bt public\u0113\u0161anas un piek\u013cuves br\u012bv\u012bbu"}}},"NL":{"QuestionText":"[Q12] Welke komt <strong>het dichtst bij uw mening<\/strong> over <strong>elk type nieuws en informatie<\/strong> ?<br> Geef een beoordeling van 1 (Sterke steun voor beperking) tot 7 (Sterke steun voor vrijheid van publicatie en toegang)","Choices":{"1":{"Display":"Onjuiste inhoud die bedoeld is om het publiek te misleiden"},"2":{"Display":"Satire over een persoon, kwestie of gebeurtenis"},"3":{"Display":"Breaking news die wordt gepubliceerd voordat alles is geverifieerd"},"4":{"Display":"Feitelijke informatie die wordt gepresenteerd om \u00e9\u00e9n kant van een kwestie te bevoordelen"},"5":{"Display":"Een video of afbeelding die is aangepast of verzonnen om het publiek te misleiden"},"6":{"Display":"Selecteer &#39;4&#39; voor dit item om aan te geven dat u oplet"}},"Answers":{"1":{"Display":"1 - Sterke steun voor beperking"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 - Ondersteun krachtig de vrijheid om te publiceren en toegang te krijgen"}}},"PL":{"QuestionText":"[Q12] Co jest <strong>bli\u017csze Pana\/Pani pogl\u0105dowi<\/strong> na temat <strong>poszczeg\u00f3lnych typ\u00f3w wiadomo\u015bci i informacji<\/strong> ?<br> Oce\u0144 w skali od 1 (Zdecydowanie popieram ograniczenie) do 7 (Zdecydowanie popieram swobod\u0119 publikacji i dost\u0119pu)","Choices":{"1":{"Display":"Fa\u0142szywa tre\u015b\u0107 maj\u0105ca na celu wprowadzenie opinii publicznej w b\u0142\u0105d"},"2":{"Display":"Satyra na temat osoby, problemu lub wydarzenia"},"3":{"Display":"Pilne informacje publikowane zanim wszystko zostanie zweryfikowane"},"4":{"Display":"Informacje faktyczne przedstawione w celu przedstawienia jednej ze stron sporu"},"5":{"Display":"Film lub obraz, kt\u00f3ry zosta\u0142 zmieniony lub stworzony w celu wprowadzenia opinii publicznej w b\u0142\u0105d"},"6":{"Display":"Prosz\u0119 wybra\u0107 \u201e4\u201d dla tej pozycji, aby pokaza\u0107, \u017ce zwracasz uwag\u0119"}},"Answers":{"1":{"Display":"1 - Zdecydowanie popieram ograniczenie"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7. Zdecydowanie popieram wolno\u015b\u0107 publikacji i dost\u0119pu"}}},"RU":{"QuestionText":"[Q12] \u0427\u0442\u043e <strong>\u0431\u043b\u0438\u0436\u0435 \u043a \u0432\u0430\u0448\u0435\u043c\u0443 \u043c\u043d\u0435\u043d\u0438\u044e<\/strong> \u043e <strong>\u043a\u0430\u0436\u0434\u043e\u043c \u0442\u0438\u043f\u0435 \u043d\u043e\u0432\u043e\u0441\u0442\u0435\u0439 \u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438<\/strong> ?<br> \u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u043e\u0446\u0435\u043d\u0438\u0442\u0435 \u043e\u0442 1 (\u0440\u0435\u0448\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435) \u0434\u043e 7 (\u0440\u0435\u0448\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e \u0441\u0432\u043e\u0431\u043e\u0434\u0443 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438 \u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u0430)","Choices":{"1":{"Display":"\u041b\u043e\u0436\u043d\u044b\u0439 \u043a\u043e\u043d\u0442\u0435\u043d\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0438\u043c\u0435\u0435\u0442 \u0446\u0435\u043b\u044c\u044e \u0432\u0432\u0435\u0441\u0442\u0438 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0432 \u0437\u0430\u0431\u043b\u0443\u0436\u0434\u0435\u043d\u0438\u0435"},"2":{"Display":"\u0421\u0430\u0442\u0438\u0440\u0430 \u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0435, \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0435 \u0438\u043b\u0438 \u0441\u043e\u0431\u044b\u0442\u0438\u0438"},"3":{"Display":"\u0421\u0440\u043e\u0447\u043d\u0430\u044f \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u0443\u0431\u043b\u0438\u043a\u0443\u0435\u0442\u0441\u044f \u0434\u043e \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u0432\u0441\u0435 \u0431\u0443\u0434\u0435\u0442 \u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u043e"},"4":{"Display":"\u0424\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f, \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u0430\u044f \u0432 \u043f\u043e\u043b\u044c\u0437\u0443 \u043e\u0434\u043d\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u0432\u043e\u043f\u0440\u043e\u0441\u0430"},"5":{"Display":"\u0412\u0438\u0434\u0435\u043e \u0438\u043b\u0438 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435, \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u043d\u043e\u0435 \u0438\u043b\u0438 \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u043e\u0435 \u0441 \u0446\u0435\u043b\u044c\u044e \u0432\u0432\u0435\u0441\u0442\u0438 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0432 \u0437\u0430\u0431\u043b\u0443\u0436\u0434\u0435\u043d\u0438\u0435."},"6":{"Display":"\u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u00ab4\u00bb \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u043f\u0443\u043d\u043a\u0442\u0430, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c, \u0447\u0442\u043e \u0432\u044b \u043e\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0435 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435"}},"Answers":{"1":{"Display":"1 - \u0420\u0435\u0448\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044e \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 - \u0420\u0435\u0448\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u043c \u0441\u0432\u043e\u0431\u043e\u0434\u0443 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438 \u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u0430"}}},"SR":{"QuestionText":"[\u041f12] \u0428\u0442\u0430 \u0458\u0435 <strong>\u0431\u043b\u0438\u0436\u0435 \u0432\u0430\u0448\u0435\u043c \u0441\u0442\u0430\u0432\u0443<\/strong> \u043e <strong>\u0441\u0432\u0430\u043a\u043e\u0458 \u0432\u0440\u0441\u0442\u0438 \u0432\u0435\u0441\u0442\u0438 \u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0458\u0430<\/strong> ?<br> \u041c\u043e\u043b\u0438\u043c\u043e \u0432\u0430\u0441 \u0434\u0430 \u043e\u0446\u0435\u043d\u0438\u0442\u0435 \u043e\u0434 1 (\u0421\u043d\u0430\u0436\u043d\u043e \u043f\u043e\u0434\u0440\u0436\u0430\u0432\u0430\u043c \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u045a\u0435) \u0434\u043e 7 (\u0421\u043d\u0430\u0436\u043d\u043e \u043f\u043e\u0434\u0440\u0436\u0430\u0432\u0430\u043c \u0441\u043b\u043e\u0431\u043e\u0434\u0443 \u043e\u0431\u0458\u0430\u0432\u0459\u0438\u0432\u0430\u045a\u0430 \u0438 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430)","Choices":{"1":{"Display":"\u041b\u0430\u0436\u043d\u0438 \u0441\u0430\u0434\u0440\u0436\u0430\u0458 \u043a\u043e\u0458\u0438 \u0438\u043c\u0430 \u0437\u0430 \u0446\u0438\u0459 \u0434\u0430 \u043e\u0431\u043c\u0430\u043d\u0435 \u0458\u0430\u0432\u043d\u043e\u0441\u0442"},"2":{"Display":"\u0421\u0430\u0442\u0438\u0440\u0430 \u043e \u043e\u0441\u043e\u0431\u0438, \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443 \u0438\u043b\u0438 \u0434\u043e\u0433\u0430\u0452\u0430\u0458\u0443"},"3":{"Display":"\u0418\u0437\u043d\u0435\u043d\u0430\u0452\u0443\u0458\u0443\u045b\u0435 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0458\u0435 \u043a\u043e\u0458\u0435 \u0441\u0435 \u043e\u0431\u0458\u0430\u0432\u0459\u0443\u0458\u0443 \u043f\u0440\u0435 \u043d\u0435\u0433\u043e \u0448\u0442\u043e \u0458\u0435 \u0441\u0432\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u043e"},"4":{"Display":"\u0427\u0438\u045a\u0435\u043d\u0438\u0447\u043d\u0435 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0458\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0435\u043d\u0435 \u0443 \u043a\u043e\u0440\u0438\u0441\u0442 \u0458\u0435\u0434\u043d\u0435 \u0441\u0442\u0440\u0430\u043d\u0435 \u0443 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443"},"5":{"Display":"\u0412\u0438\u0434\u0435\u043e \u0438\u043b\u0438 \u0441\u043b\u0438\u043a\u0430 \u043a\u043e\u0458\u0430 \u0458\u0435 \u0438\u0437\u043c\u0435\u045a\u0435\u043d\u0430 \u0438\u043b\u0438 \u043d\u0430\u043f\u0440\u0430\u0432\u0459\u0435\u043d\u0430 \u0434\u