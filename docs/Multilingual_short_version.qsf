r\u00fcnt\u00fc"},"6":{"Display":"L\u00fctfen bu \u00f6\u011feye dikkat etti\u011finizi g\u00f6stermek i\u00e7in &#39;4&#39;\u00fc se\u00e7in"}},"Answers":{"1":{"Display":"1 - K\u0131s\u0131tlamay\u0131 g\u00fc\u00e7l\u00fc bir \u015fekilde destekliyorum"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Display":"7 - Yay\u0131mlama ve eri\u015fim \u00f6zg\u00fcrl\u00fc\u011f\u00fcn\u00fc g\u00fc\u00e7l\u00fc bir \u015fekilde destekliyoruz"}}},"UK":{"QuestionText":"[Q12] \u042f\u043a\u0430 \u0437 \u0446\u0438\u0445 <strong>\u0442\u043e\u0447\u043e\u043a \u0437\u043e\u0440\u0443 \u0431\u043b\u0438\u0436\u0447\u0430 \u0434\u043e \u0432\u0430\u0448\u043e\u0457<\/strong> \u0449\u043e\u0434\u043e <strong>\u043a\u043e\u0436\u043d\u043e\u0433\u043e \u0442\u0438\u043f\u0443 \u043d\u043e\u0432\u0438\u043d \u0442\u0430 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u0457<\/strong> ?<br> \u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u043e\u0446\u0456\u043d\u0456\u0442\u044c \u0432\u0456\u0434 1 (\u0440\u0456\u0448\u0443\u0447\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u044e \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u043d\u044f) \u0434\u043e 7 (\u0440\u0456\u0448\u0443\u0447\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u044e \u0441\u0432\u043e\u0431\u043e\u0434\u0443 \u043f\u0443\u0431\u043b\u0456\u043a\u0430\u0446\u0456\u0457 \u0442\u0430 \u0434\u043e\u0441\u0442\u0443\u043f\u0443)","Choices":{"1":{"Display":"\u041d\u0435\u043f\u0440\u0430\u0432\u0434\u0438\u0432\u0438\u0439 \u043a\u043e\u043d\u0442\u0435\u043d\u0442, \u0441\u043f\u0440\u044f\u043c\u043e\u0432\u0430\u043d\u0438\u0439 \u043d\u0430 \u0432\u0432\u0435\u0434\u0435\u043d\u043d\u044f \u0433\u0440\u043e\u043c\u0430\u0434\u0441\u044c\u043a\u043e\u0441\u0442\u0456 \u0432 \u043e\u043c\u0430\u043d\u0443"},"2":{"Display":"\u0421\u0430\u0442\u0438\u0440\u0430 \u043f\u0440\u043e \u043b\u044e\u0434\u0438\u043d\u0443, \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0443 \u0447\u0438 \u043f\u043e\u0434\u0456\u044e"},"3":{"Display":"\u0422\u0435\u0440\u043c\u0456\u043d\u043e\u0432\u0430 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044f, \u043e\u043f\u0443\u0431\u043b\u0456\u043a\u043e\u0432\u0430\u043d\u0430 \u0434\u043e \u0442\u043e\u0433\u043e, \u044f\u043a \u0443\u0441\u0456 \u0434\u0435\u0442\u0430\u043b\u0456 \u0431\u0443\u0434\u0443\u0442\u044c \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0435\u043d\u0456"},"4":{"Display":"\u0424\u0430\u043a\u0442\u0438\u0447\u043d\u0430 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044f, \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430 \u043d\u0430 \u043a\u043e\u0440\u0438\u0441\u0442\u044c \u043e\u0434\u043d\u0456\u0454\u0457 \u0441\u0442\u043e\u0440\u043e\u043d\u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0438"},"5":{"Display":"\u0412\u0456\u0434\u0435\u043e \u0430\u0431\u043e \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f, \u0437\u043c\u0456\u043d\u0435\u043d\u0456 \u0430\u0431\u043e \u0432\u0438\u0433\u0430\u0434\u0430\u043d\u0456 \u0437 \u043c\u0435\u0442\u043e\u044e \u0432\u0432\u0435\u0434\u0435\u043d\u043d\u044f \u0433\u0440\u043e\u043c\u0430\u0434\u0441\u044c\u043a\u043e\u0441\u0442\u0456 \u0432 \u043e\u043c\u0430\u043d\u0443"},"6":{"Display":"\u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u0432\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u00ab4\u00bb \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0430, \u0449\u043e\u0431 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0438, \u0449\u043e \u0432\u0438 \u0443\u0432\u0430\u0436\u043d\u0456"}},"Answers":{"1":{"Display":"1 \u2013 \u0420\u0456\u0448\u0443\u0447\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u044e \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u043d\u044f"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5"},"6":{"Display":"6"},"7":{"Displa