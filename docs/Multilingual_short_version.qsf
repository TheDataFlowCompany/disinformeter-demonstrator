646\u064a\u0646"},"4":{"Display":"\u0623\u0646\u0627 \u063a\u0627\u0636\u0628 \u0645\u0646 \u0648\u0644\u0627\u064a\u062a\u064a \u0644\u0641\u0634\u0644\u0647\u0627 \u0641\u064a \u062d\u0645\u0627\u064a\u0629 \u0645\u0635\u0627\u0644\u062d \u0645\u0648\u0627\u0637\u0646\u064a\u0647\u0627"},"5":{"Display":"\u0623\u0634\u0639\u0631 \u0628\u0627\u0644\u063a\u0636\u0628 \u0644\u0623\u0646 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u062a\u064a \u0623\u0631\u064a\u062f \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u064a\u0647\u0627 \u062a\u062e\u0636\u0639 \u0644\u0644\u0631\u0642\u0627\u0628\u0629 \u0641\u064a \u0628\u0644\u062f\u064a"},"6":{"Display":"\u0623\u0646\u0627 \u0645\u062d\u0628\u0637 \u0644\u0623\u0646 \u0648\u0644\u0627\u064a\u062a\u064a \u062a\u062d\u0638\u0631 \u0648\u0633\u0627\u0626\u0644 \u0627\u0644\u0625\u0639\u0644\u0627\u0645 \u0627\u0644\u062a\u064a \u0623\u0631\u064a\u062f \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u064a\u0647\u0627"}},"Answers":{"1":{"Display":"\u0623\u062e\u062a\u0644\u0641 \u0628\u0634\u062f\u0629"},"2":{"Display":"\u0644\u0627 \u0623\u0648\u0627\u0641\u0642"},"3":{"Display":"\u0644\u0627 \u0623\u062a\u0641\u0642 \u0625\u0644\u0649 \u062d\u062f \u0645\u0627"},"4":{"Display":"\u0644\u0627 \u0623\u0648\u0627\u0641\u0642 \u0648\u0644\u0627 \u0623\u062e\u062a\u0644\u0641"},"5":{"Display":"\u0623\u0648\u0627\u0641\u0642 \u0625\u0644\u0649 \u062d\u062f \u0645\u0627"},"6":{"Display":"\u064a\u0648\u0627\u0641\u0642"},"7":{"Display":"\u0623\u0648\u0627\u0641\u0642 \u0628\u0634\u062f\u0629"}}},"BG":{"QuestionText":"[\u041210.3] \u0421\u0435\u0433\u0430 \u0449\u0435 \u0431\u044a\u0434\u0435\u0442\u0435 \u043f\u043e\u043c\u043e\u043b\u0435\u043d\u0438 \u0434\u0430 \u043f\u043e\u0441\u043e\u0447\u0438\u0442\u0435 \u0441\u0442\u0435\u043f\u0435\u043d\u0442\u0430 \u043d\u0430 \u0432\u0430\u0448\u0435\u0442\u043e \u0441\u044a\u0433\u043b\u0430\u0441\u0438\u0435 \u0441\u044a\u0441 \u0441\u043b\u0435\u0434\u043d\u0438\u0442\u0435 \u0442\u0432\u044a\u0440\u0434\u0435\u043d\u0438\u044f, \u043a\u044a\u0434\u0435\u0442\u043e 1 = \u041d\u0430\u043f\u044a\u043b\u043d\u043e \u043d\u0435\u0441\u044a\u0433\u043b\u0430\u0441\u0435\u043d \u0438 7 = \u041d\u0430\u043f\u044a\u043b\u043d\u043e \u0441\u044a\u0433\u043b\u0430\u0441\u0435\u043d (\u0441\u043a\u0430\u043b\u0430 \u043e\u0442 1 \u0434\u043e 7)","Choices":{"1":{"Display":"\u041a\u0430\u0442\u043e \u0446\u044f\u043b\u043e \u043d\u0435 \u0441\u0435 \u0434\u043e\u0432\u0435\u0440\u044f\u0432\u0430\u043c \u043d\u0430 \u043d\u0430\u0448\u0438\u0442\u0435 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0438 \u0441\u044a\u044e\u0437\u043d\u0438\u0446\u0438."},"2":{"Display":"\u0427\u0443\u0432\u0441\u0442\u0432\u0430\u043c \u0441\u0435 \u0440\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043d \u043e\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f\u0442\u0430 \u043d\u0430 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0442\u0430 \u043e\u0431\u0449\u043d\u043e\u0441\u0442 \u0432 \u0437\u0430\u0449\u0438\u0442\u0430 \u043d\u0430 \u0441\u0442\u0440\u0430\u043d\u0430\u0442\u0430 \u043c\u0438"},"3":{"Display":"\u0427\u0443\u0432\u0441\u0442\u0432\u0430\u043c \u0441\u0435 \u0440\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043d \u043e\u0442 \u043d\u0430\u0447\u0438\u043d\u0430, \u043f\u043e \u043a\u043e\u0439\u0442\u043e \u043c\u043e\u044f\u0442\u0430 \u0434\u044a\u0440\u0436\u0430\u0432\u0430 \u0441\u0435 \u0441\u043f\u0440\u0430\u0432\u044f \u0441 \u043d\u0443\u0436\u0434\u0438\u0442\u0435 \u043d\u0430 \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0438\u0442\u0435"},"4":{"Display":"\u042f\u0434\u043e\u0441\u0430\u043d \u0441\u044a\u043c \u043d\u0430 \u0434\u044a\u0440\u0436\u0430\u0432\u0430\u0442\u0430 \u0441\u0438, \u0447\u0435 \u043d\u0435 \u0443\u0441\u043f\u044f\u0432\u0430 \u0434\u0430 \u0437\u0430\u0449\u0438\u0442\u0438 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0438\u0442\u0435 \u043d\u0430 \u0441\u0432\u043e\u0438\u0442\u0435 \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0438."},"5":{"Display":"\u0427\u0443\u0432\u0441\u0442\u0432\u0430\u043c \u0433\u043d\u044f\u0432, \u0437\u0430\u0449\u043e\u0442\u043e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f\u0442\u0430, \u0434\u043e \u043a\u043e\u044f\u0442\u043e \u0438\u0441\u043a\u0430\u043c \u0434\u0430 \u043f\u043e\u043b\u0443\u0447\u0430 \u0434\u043e\u0441\u0442\u044a\u043f, \u0435 \u0446\u0435\u043d\u0437\u0443\u0440\u0438\u0440\u0430\u043d\u0430 \u0432 \u043c\u043e\u044f\u0442\u0430 \u0441\u0442\u0440\u0430\u043d\u0430."},"6":{"Display":"\u0420\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043d \u0441\u044a\u043c, \u0437\u0430\u0449\u043e\u0442\u043e \u043c\u043e\u044f\u0442 \u0449\u0430\u0442 \u0437\u0430\u0431\u0440\u0430\u043d\u044f\u0432\u0430 \u043c\u0435\u0434\u0438\u0438\u0442\u0435, \u0434\u043e \u043a\u043e\u0438\u0442\u043e \u0438\u0441\u043a\u0430\u043c \u0434\u0430 \u0438\u043c\u0430\u043c \u0434\u043e\u0441\u0442\u044a\u043f"}},"Answers":{"1":{"Display":"\u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0447\u043d\u043e \u043d\u0435 \u0441\u044a\u043c \u0441\u044a\u0433\u043b\u0430\u0441\u0435\u043d\/\u0430"},"2":{"Display":"\u041d\u0435 \u0441\u044a\u043c \u0441\u044a\u0433\u043b\u0430\u0441\u0435\u043d\/\u0430"},"3":{"Display":"\u0414\u043e\u043d\u044f\u043a\u044a\u0434\u0435 \u043d\u0435 \u0441\u044a\u043c \u0441\u044a\u0433\u043b\u0430\u0441\u0435\u043d\/\u0430"},"4":{"Display":"\u041d\u0438\u0442\u043e \u0441\u044a\u043c \u0441\u044a\u0433\u043b\u0430\u0441\u0435\u043d, \u043d\u0438\u0442\u043e \u0441\u044a\u043c \u043d\u0435\u0441\u044a\u0433\u043b\u0430\u0441\u0435\u043d"},"5":{"Display":"\u0414\u043e\u043d\u044f\u043a\u044a\u0434\u0435 \u0441\u044a\u043c \u0441\u044a\u0433\u043b\u0430\u0441\u0435\u043d\/\u0441\u044a\u0433\u043b\u0430\u0441\u043d\u0430"},"6":{"Display":"\u0421\u044a\u0433\u043b\u0430\u0441\u0435\u043d\/\u0430"},"7":{"Display":"\u041d\u0430\u043f\u044a\u043b\u043d\u043e \u0441\u044a\u0433\u043b\u0430\u0441\u0435\u043d\/\u0430"}}},"DE":{"QuestionText":"[Q10.3] Nun werden Sie gebeten, anzugeben, inwieweit Sie den folgenden Aussagen zustimmen, wobei 1 = Stimme \u00fcberhaupt nicht zu und 7 = Stimme voll und ganz zu (Skala 1-7)","Choices":{"1":{"Display":"Im Allgemeinen misstraue ich unseren internationalen Verb\u00fcndeten"},"2":{"Display":"Ich bin entt\u00e4uscht \u00fcber die Ma\u00dfnahmen der internationalen Gemeinschaft zum Schutz meines Landes"},"3":{"Display":"Ich bin frustriert dar\u00fcber, wie mein Staat auf die Bed\u00fcrfnisse der B\u00fcrger eingeht"},"4":{"Display":"Ich bin w\u00fctend auf meinen Staat, weil er die Interessen seiner B\u00fcrger nicht sch\u00fctzt"},"5":{"Display":"Ich bin w\u00fctend, weil die Informationen, auf die ich zugreifen m\u00f6chte, in meinem Land zensiert werden"},"6":{"Display":"Ich bin frustriert, weil mein Staat die Medien verbietet, auf die ich zugreifen m\u00f6chte"}},"Answers":{"1":{"Display":"Stimme \u00fcberhaupt nicht zu"},"2":{"Display":"Verschiedener Meinung sein"},"3":{"Display":"Stimme eher nicht zu"},"4":{"Display":"Weder zustimmen noch nicht zustimmen"},"5":{"Display":"Stimme eher zu"},"6":{"Display":"Zustimmen"},"7":{"Display":"Stimme voll und ganz zu"}}},"ET":{"QuestionText":"[K10.3] N\u00fc\u00fcd palutakse teil m\u00e4rkida, kui suurel m\u00e4\u00e4ral te n\u00f5ustute j\u00e4rgmiste v\u00e4idetega, kus 1 = T\u00e4iesti ei ole n\u00f5us ja 7 = T\u00e4iesti n\u00f5us (skaala 1\u20137)","Choices":{"1":{"Display":"\u00dcldiselt ma ei usalda meie rahvusvahelisi liitlasi."},"2":{"Display":"Olen pettunud rahvusvahelise \u00fcldsuse tegevuses minu riigi kaitsmisel."},"3":{"Display":"Olen pettunud selles, kuidas minu riik kodanike vajadusi rahuldab"},"4":{"Display":"Olen oma riigi peale vihane, et see ei kaitse oma kodanike huve."},"5":{"Display":"Tunnen viha, sest infot, millele ma tahan ligi p\u00e4\u00e4seda, tsenseeritakse minu riigis."},"6":{"Display":"Olen pettunud, sest minu osariik keelab meedia, millele ma tahan ligi p\u00e4\u00e4seda."}},"Answers":{"1":{"Display":"Kindlalt ei n\u00f5ustu"},"2":{"Display":"Ei n\u00f5ustu"},"3":{"Display":"Pole eriti n\u00f5us"},"4":{"Display":"Ei n\u00f5ustu ega ole eriarvamusel"},"5":{"Display":"Enam-v\u00e4hem n\u00f5us"},"6":{"Display":"N\u00f5ustun"},"7":{"Display":"T\u00e4iesti n\u00f5us"}}},"FA":{"QuestionText":"[\u0633\u0648\u0627\u0644 \u06f1\u06f0.\u06f3] \u0627\u06a9\u0646\u0648\u0646 \u0627\u0632 \u0634\u0645\u0627 \u062e\u0648\u0627\u0633\u062a\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f \u0645\u06cc\u0632\u0627\u0646 \u0645\u0648\u0627\u0641\u0642\u062a \u062e\u0648\u062f \u0631\u0627 \u0628\u0627 \u062c\u0645\u0644\u0627\u062a \u0632\u06cc\u0631 \u0645\u0634\u062e\u0635 \u06a9\u0646\u06cc\u062f\u060c \u06a9\u0647 \u062f\u0631 \u0622\u0646 \u06f1 = \u06a9\u0627\u0645\u0644\u0627\u064b \u0645\u062e\u0627\u0644\u0641 \u0648 \u06f7 = \u06a9\u0627\u0645\u0644\u0627\u064b \u0645\u0648\u0627\u0641\u0642 (\u0645\u0642\u06cc\u0627\u0633 \u06f1 \u062a\u0627 \u06f7)","Choices":{"1":{"Display":"\u062f\u0631 \u06a9\u0644\u060c \u0645\u0646 \u0628\u0647 \u0645\u062a\u062d\u062f\u0627\u0646 \u0628\u06cc\u0646\u200c\u0627\u0644\u0645\u0644\u0644\u06cc\u200c\u0645\u0627\u0646 \u0628\u06cc\u200c\u0627\u0639\u062a\u0645\u0627\u062f\u0645."},"2":{"Display":"\u0645\u0646 \u0627\u0632 \u0627\u0642\u062f\u0627\u0645\u0627\u062a \u062c\u0627\u0645\u0639\u0647 \u0628\u06cc\u0646\u200c\u0627\u0644\u0645\u0644\u0644\u06cc \u062f\u0631 \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u06a9\u0634\u0648\u0631\u0645 \u0646\u0627\u0627\u0645\u06cc\u062f \u0647\u0633\u062a\u0645."},"3":{"Display":"\u0645\u0646 \u0627\u0632 \u0646\u062d\u0648\u0647 \u0631\u0633\u06cc\u062f\u06af\u06cc \u0627\u06cc\u0627\u0644\u062a\u0645 \u0628\u0647 \u0646\u06cc\u0627\u0632\u0647\u0627\u06cc \u0634\u0647\u0631\u0648\u0646\u062f\u0627\u0646 \u0646\u0627\u0627\u0645\u06cc\u062f \u0647\u0633\u062a\u0645."},"4":{"Display":"\u0645\u0646 \u0627\u0632 \u0627\u06cc\u0627\u0644\u062a\u0645 \u0639\u0635\u0628\u0627\u0646\u06cc \u0647\u0633\u062a\u0645 \u06a9\u0647 \u0627\u0632 \u0645\u0646\u0627\u0641\u0639 \u0634\u0647\u0631\u0648\u0646\u062f\u0627\u0646\u0634 \u0645\u062d\u0627\u0641\u0638\u062a \u0646\u0645\u06cc\u200c\u06a9\u0646\u062f."},"5":{"Display":"\u0645\u0646 \u0639\u0635\u0628\u0627\u0646\u06cc \u0647\u0633\u062a\u0645 \u0686\u0648\u0646 \u0627\u0637\u0644\u0627\u0639\u0627\u062a\u06cc \u06a9\u0647 \u0645\u06cc\u200c\u062e\u0648\u0627\u0647\u0645 \u0628\u0647 \u0622\u0646\u0647\u0627 \u062f\u0633\u062a\u0631\u0633\u06cc \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u0645 \u062f\u0631 \u06a9\u0634\u0648\u0631\u0645 \u0633\u0627\u0646\u0633\u0648\u0631 \u0645\u06cc\u200c\u0634\u0648\u062f."},"6":{"Display":"\u0645\u0646 \u06a9\u0644\u0627\u0641\u0647 \u0634\u062f\u0647\u200c\u0627\u0645 \u0686\u0648\u0646 \u0627\u06cc\u0627\u0644\u062a\u0645 \u062f\u0633\u062a\u0631\u0633\u06cc \u0628\u0647 \u0631\u0633\u0627\u0646\u0647\u200c\u0647\u0627\u06cc\u06cc \u06a9\u0647 \u0645\u06cc\u200c\u062e\u0648\u0627\u0647\u0645 \u0631\u0627 \u0645\u0645\u0646\u0648\u0639 \u06a9\u0631\u062f\u0647 \u0627\u0633\u062a."}},"Answers":{"1":{"Display":"\u06a9\u0627\u0645\u0644\u0627\u064b \u0645\u062e\u0627\u0644\u0641\u0645"},"2":{"Display":"\u0645\u062e\u0627\u0644\u0641"},"3":{"Display":"\u062a\u0627 \u062d\u062f\u0648\u062f\u06cc \u0645\u062e\u0627\u0644\u0641\u0645"},"4":{"Display":"\u0646\u0647 \u0645\u0648\u0627\u0641\u0642 \u0648 \u0646\u0647 \u0645\u062e\u0627\u0644\u0641"},"5":{"Display":"\u062a\u0627 \u062d\u062f\u0648\u062f\u06cc \u0645\u0648\u0627\u0641\u0642\u0645"},"6":{"Display":"\u0645\u0648\u0627\u0641\u0642"},"7":{"Display":"\u06a9\u0627\u0645\u0644\u0627\u064b \u0645\u0648\u0627\u0641\u0642\u0645"}}},"FR":{"QuestionText":"[Q10.3] Il vous sera maintenant demand\u00e9 d&#39;indiquer dans quelle mesure vous \u00eates d&#39;accord avec les affirmations suivantes, o\u00f9 1 = Tout \u00e0 fait en d\u00e9saccord et 7 = Tout \u00e0 fait d&#39;accord (\u00e9chelle de 1 \u00e0 7)","Choices":{"1":{"Display":"En g\u00e9n\u00e9ral, je me m\u00e9fie de nos alli\u00e9s internationaux"},"2":{"Display":"Je suis d\u00e9\u00e7u par les actions de la communaut\u00e9 internationale pour prot\u00e9ger mon pays."},"3":{"Display":"Je me sens frustr\u00e9 par la mani\u00e8re dont mon \u00c9tat r\u00e9pond aux besoins des citoyens"},"4":{"Display":"Je suis en col\u00e8re contre mon \u00c9tat parce qu\u2019il ne parvient pas \u00e0 prot\u00e9ger les int\u00e9r\u00eats de ses citoyens."},"5":{"Display":"Je ressens de la col\u00e8re parce que les informations auxquelles je veux acc\u00e9der sont censur\u00e9es dans mon pays."},"6":{"Display":"Je suis frustr\u00e9 parce que mon \u00c9tat interdit les m\u00e9dias auxquels je veux acc\u00e9der"}},"Answers":{"1":{"Display":"Fortement en d\u00e9saccord"},"2":{"Display":"\u00catre en d\u00e9saccord"},"3":{"Display":"Plut\u00f4t en d\u00e9saccord"},"4":{"Display":"Ni d&#39;accord ni en d\u00e9saccord"},"5":{"Display":"Plut\u00f4t d&#39;accord"},"6":{"Display":"Accepter"},"7":{"Display":"Tout \u00e0 fait d&#39;accord"}}},"HU":{"QuestionText":"[10.3. k\u00e9rd\u00e9s] Most arra kell majd jeleznie, hogy mennyire \u00e9rt egyet a k\u00f6vetkez\u0151 \u00e1ll\u00edt\u00e1sokkal, ahol 1 = Hat\u00e1rozottan nem \u00e9rtek egyet \u00e9s 7 = Hat\u00e1rozottan egyet\u00e9rtek (1-7-es sk\u00e1la)","Choices":{"1":{"Display":"\u00c1ltal\u00e1noss\u00e1gban v\u00e9ve nem b\u00edzom a nemzetk\u00f6zi sz\u00f6vets\u00e9geseinkben."},"2":{"Display":"Csal\u00f3dott vagyok a nemzetk\u00f6zi k\u00f6z\u00f6ss\u00e9g orsz\u00e1gom v\u00e9delm\u00e9ben tett int\u00e9zked\u00e9sei miatt."},"3":{"Display":"Frusztr\u00e1ltnak \u00e9rzem magam amiatt, ahogyan az \u00e1llamom kezeli a polg\u00e1rok ig\u00e9nyeit"},"4":{"Display":"D\u00fch\u00f6s vagyok az \u00e1llamra, ami\u00e9rt nem v\u00e9di meg polg\u00e1rai \u00e9rdekeit."},"5":{"Display":"D\u00fch\u00f6t \u00e9rzek, mert az orsz\u00e1gomban cenz\u00far\u00e1zz\u00e1k az inform\u00e1ci\u00f3kat, amelyekhez hozz\u00e1f\u00e9rni szeretn\u00e9k."},"6":{"Display":"Frusztr\u00e1lt vagyok, mert az \u00e1llamom betiltja azokat a m\u00e9di\u00e1kat, amelyekhez hozz\u00e1f\u00e9rni szeretn\u00e9k."}},"Answers":{"1":{"Display":"Hat\u00e1rozottan nem \u00e9rtek egyet"},"2":{"Display":"Nem \u00e9rt egyet"},"3":{"Display":"Kiss\u00e9 nem \u00e9rtek egyet"},"4":{"Display":"Sem egyet\u00e9rt\u00e9s, sem ellentmond\u00e1s"},"5":{"Display":"R\u00e9szben egyet\u00e9rtek"},"6":{"Display":"Egyet\u00e9rt"},"7":{"Display":"Teljesen egyet\u00e9rtek"}}},"IT":{"QuestionText":"[Q10.3] Ora ti verr\u00e0 chiesto di indicare il tuo grado di accordo con le seguenti affermazioni, dove 1 = Fortemente in disaccordo e 7 = Fortemente d&#39;accordo (scala da 1 a 7)","Choices":{"1":{"Display":"In generale, non mi fido dei nostri alleati internazionali"},"2":{"Display":"Sono deluso dalle azioni della comunit\u00e0 internazionale nel proteggere il mio Paese"},"3":{"Display":"Mi sento frustrato dal modo in cui il mio stato affronta i bisogni dei cittadini"},"4":{"Display":"Sono arrabbiato con il mio stato perch\u00e9 non riesce a proteggere gli interessi dei suoi cittadini"},"5":{"Display":"Provo rabbia perch\u00e9 le informazioni a cui voglio accedere vengono censurate nel mio paese"},"6":{"Display":"Sono frustrato perch\u00e9 il mio stato vieta i media a cui voglio accedere"}},"Answers":{"1":{"Display":"Fortemente in disaccordo"},"2":{"Display":"Non sono d&#39;accordo"},"3":{"Display":"Un po&#39; in disaccordo"},"4":{"Display":"N\u00e9 d&#39;accordo n\u00e9 in disaccordo"},"5":{"Display":"Abbastanza d&#39;accordo"},"6":{"Display":"Essere d&#39;accordo"},"7":{"Display":"Sono assolutamente d&#39;accordo"}}},"KAT":{"QuestionText":"[Q10.3] \u10d0\u10ee\u10da\u10d0 \u10d7\u10e5\u10d5\u10d4\u10dc \u10db\u10dd\u10d2\u10d4\u10d7\u10ee\u10dd\u10d5\u10d4\u10d1\u10d0\u10d7 \u10db\u10d8\u10e3\u10d7\u10d8\u10d7\u10dd\u10d7 \u10d7\u10e5\u10d5\u10d4\u10dc\u10d8 \u10d7\u10d0\u10dc\u10ee\u10db\u10dd\u10d1\u10d8\u10e1 \u10ee\u10d0\u10e0\u10d8\u10e1\u10ee\u10d8 \u10e8\u10d4\u10db\u10d3\u10d4\u10d2 \u10d2\u10d0\u10dc\u10ea\u10ee\u10d0\u10d3\u10d4\u10d1\u10d4\u10d1\u10d7\u10d0\u10dc, \u10e1\u10d0\u10d3\u10d0\u10ea 1 = \u10d9\u10d0\u10e2\u10d4\u10d2\u10dd\u10e0\u10d8\u10e3\u10da\u10d0\u10d3 \u10d0\u10e0 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8 \u10d3\u10d0 7 = \u10e1\u10e0\u10e3\u10da\u10d8\u10d0\u10d3 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8 (1-7 \u10e8\u10d9\u10d0\u10da\u10d0)","Choices":{"1":{"Display":"\u10d6\u10dd\u10d2\u10d0\u10d3\u10d0\u10d3, \u10db\u10d4 \u10d0\u10e0 \u10d5\u10d4\u10dc\u10d3\u10dd\u10d1\u10d8 \u10e9\u10d5\u10d4\u10dc\u10e1 \u10e1\u10d0\u10d4\u10e0\u10d7\u10d0\u10e8\u10dd\u10e0\u10d8\u10e1\u10dd \u10db\u10dd\u10d9\u10d0\u10d5\u10e8\u10d8\u10e0\u10d4\u10d4\u10d1\u10e1"},"2":{"Display":"\u10d8\u10db\u10d4\u10d3\u10d2\u10d0\u10ea\u10e0\u10e3\u10d4\u10d1\u10e3\u10da\u10d8 \u10d5\u10d0\u10e0 \u10e1\u10d0\u10d4\u10e0\u10d7\u10d0\u10e8\u10dd\u10e0\u10d8\u10e1\u10dd \u10e1\u10d0\u10d6\u10dd\u10d2\u10d0\u10d3\u10dd\u10d4\u10d1\u10d8\u10e1 \u10e5\u10db\u10d4\u10d3\u10d4\u10d1\u10d4\u10d1\u10d8\u10d7 \u10e9\u10d4\u10db\u10d8 \u10e5\u10d5\u10d4\u10e7\u10dc\u10d8\u10e1 \u10d3\u10d0\u10e1\u10d0\u10ea\u10d0\u10d5\u10d0\u10d3"},"3":{"Display":"\u10d8\u10db\u10d4\u10d3\u10d2\u10d0\u10ea\u10e0\u10e3\u10d4\u10d1\u10e3\u10da\u10d8 \u10d5\u10d0\u10e0 \u10d8\u10db\u10d8\u10d7, \u10d7\u10e3 \u10e0\u10dd\u10d2\u10dd\u10e0 \u10e3\u10db\u10d9\u10da\u10d0\u10d5\u10d3\u10d4\u10d1\u10d0 \u10e9\u10d4\u10db\u10d8 \u10e1\u10d0\u10ee\u10d4\u10da\u10db\u10ec\u10d8\u10e4\u10dd \u10db\u10dd\u10e5\u10d0\u10da\u10d0\u10e5\u10d4\u10d4\u10d1\u10d8\u10e1 \u10e1\u10d0\u10ed\u10d8\u10e0\u10dd\u10d4\u10d1\u10d4\u10d1\u10e1"},"4":{"Display":"\u10db\u10d4 \u10d2\u10d0\u10d1\u10e0\u10d0\u10d6\u10d4\u10d1\u10e3\u10da\u10d8 \u10d5\u10d0\u10e0 \u10e9\u10d4\u10db\u10e1 \u10e1\u10d0\u10ee\u10d4\u10da\u10db\u10ec\u10d8\u10e4\u10dd\u10d6\u10d4, \u10e0\u10dd\u10db \u10d5\u10d4\u10e0 \u10d8\u10ea\u10d0\u10d5\u10d3\u10d0 \u10db\u10dd\u10e5\u10d0\u10da\u10d0\u10e5\u10d4\u10d4\u10d1\u10d8\u10e1 \u10d8\u10dc\u10e2\u10d4\u10e0\u10d4\u10e1\u10d4\u10d1\u10e1"},"5":{"Display":"\u10d2\u10d0\u10d1\u10e0\u10d0\u10d6\u10d4\u10d1\u10e3\u10da\u10d8 \u10d5\u10d0\u10e0, \u10e0\u10d0\u10d3\u10d2\u10d0\u10dc \u10d8\u10dc\u10e4\u10dd\u10e0\u10db\u10d0\u10ea\u10d8\u10d0, \u10e0\u10dd\u10db\u10d4\u10da\u10d6\u10d4\u10ea \u10ec\u10d5\u10d3\u10dd\u10db\u10d0 \u10db\u10e1\u10e3\u10e0\u10e1, \u10e9\u10d4\u10db\u10e1 \u10e5\u10d5\u10d4\u10e7\u10d0\u10dc\u10d0\u10e8\u10d8 \u10ea\u10d4\u10dc\u10d6\u10e3\u10e0\u10d8\u10e1 \u10e5\u10d5\u10d4\u10e8\u10d0\u10d0."},"6":{"Display":"\u10d8\u10db\u10d4\u10d3\u10d2\u10d0\u10ea\u10e0\u10e3\u10d4\u10d1\u10e3\u10da\u10d8 \u10d5\u10d0\u10e0, \u10e0\u10d0\u10d3\u10d2\u10d0\u10dc \u10e9\u10d4\u10db\u10d8 \u10e8\u10e2\u10d0\u10e2\u10d8 \u10d9\u10e0\u10eb\u10d0\u10da\u10d0\u10d5\u10e1 \u10db\u10d4\u10d3\u10d8\u10d0\u10e1, \u10e0\u10dd\u10db\u10d4\u10da\u10d6\u10d4\u10ea \u10ec\u10d5\u10d3\u10dd\u10db\u10d0 \u10db\u10e1\u10e3\u10e0\u10e1"}},"Answers":{"1":{"Display":"\u10d9\u10d0\u10e2\u10d4\u10d2\u10dd\u10e0\u10d8\u10e3\u10da\u10d0\u10d3 \u10d0\u10e0 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"},"2":{"Display":"\u10d0\u10e0 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"},"3":{"Display":"\u10d2\u10d0\u10e0\u10d9\u10d5\u10d4\u10e3\u10da\u10ec\u10d8\u10da\u10d0\u10d3 \u10d0\u10e0 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"},"4":{"Display":"\u10d0\u10e0\u10ea \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8 \u10d3\u10d0 \u10d0\u10e0\u10ea \u10d0\u10e0 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"},"5":{"Display":"\u10dc\u10d0\u10ec\u10d8\u10da\u10dd\u10d1\u10e0\u10d8\u10d5 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"},"6":{"Display":"\u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"},"7":{"Display":"\u10e1\u10e0\u10e3\u10da\u10d8\u10d0\u10d3 \u10d5\u10d4\u10d7\u10d0\u10dc\u10ee\u10db\u10d4\u10d1\u10d8"}}},"LT":{"QuestionText":"[10.3 klausimas] Dabar j\u016bs\u0173 bus papra\u0161yta nurodyti, kiek sutinkate su \u0161iais teiginiais, kur 1 = Visi\u0161kai nesutinku ir 7 = Visi\u0161kai sutinku (1\u20137 bal\u0173 skal\u0117)","Choices":{"1":{"Display":"Apskritai nepasitikiu m\u016bs\u0173 tarptautiniais s\u0105jungininkais"},"2":{"Display":"Esu nusivyl\u0119s tarptautin\u0117s bendruomen\u0117s veiksmais ginant mano \u0161al\u012f"},"3":{"Display":"Mane nuvyl\u0117 tai, kaip mano valstyb\u0117 tenkina pilie\u010di\u0173 poreikius"},"4":{"Display":"Esu piktas ant savo valstyb\u0117s, kad ji negina savo pilie\u010di\u0173 interes\u0173."},"5":{"Display":"Jau\u010diu pykt\u012f, nes informacija, prie kurios noriu prisijungti, mano \u0161alyje yra cenz\u016bruojama."},"6":{"Display":"Esu nusivyl\u0119s, nes mano valstija draud\u017eia \u017einiasklaid\u0105, prie kurios noriu prisijungti"}},"Answers":{"1":{"Display":"Visi\u0161kai nesutinku"},"2":{"Display":"Nesutinku"},"3":{"Display":"\u0160iek tiek nesutinku"},"4":{"Display":"Nei sutinku, nei nesutinku"},"5":{"Display":"I\u0161 dalies sutinku"},"6":{"Display":"Sutinku"},"7":{"Display":"Visi\u0161kai sutinku"}}},"LV":{"QuestionText":"[10.3.\u00a0jaut\u0101jums] Tagad jums tiks l\u016bgts nor\u0101d\u012bt, cik liel\u0101 m\u0113r\u0101 j\u016bs piekr\u012btat \u0161\u0101diem apgalvojumiem, kur 1\u00a0=\u00a0piln\u012bb\u0101 nepiekr\u012btu un 7\u00a0=\u00a0piln\u012bb\u0101 piekr\u012btu (skala no 1\u00a0l\u012bdz 7)","Choices":{"1":{"Display":"Kopum\u0101 es neuzticos m\u016bsu starptautiskajiem sabiedrotajiem."},"2":{"Display":"Esmu v\u012blies par starptautisk\u0101s sabiedr\u012bbas r\u012bc\u012bbu manas valsts aizsardz\u012bb\u0101."},"3":{"Display":"Esmu neapmierin\u0101ts ar to, k\u0101 mana valsts risina pilso\u0146u vajadz\u012bbas"},"4":{"Display":"Esmu dusm\u012bgs uz savu valsti par to, ka t\u0101 neaizsarg\u0101 savu pilso\u0146u intereses."},"5":{"Display":"Esmu dusm\u012bgs, jo inform\u0101cija, kurai v\u0113los piek\u013c\u016bt, man\u0101 valst\u012b tiek cenz\u0113ta."},"6":{"Display":"Esmu neapmierin\u0101ts, jo mans \u0161tats aizliedz piek\u013cuvi pla\u0161sazi\u0146as l\u012bdzek\u013ciem, kuriem v\u0113los piek\u013c\u016bt."}},"Answers":{"1":{"Display":"Piln\u012bb\u0101 nepiekr\u012btu"},"2":{"Display":"Nepiekr\u012btu"},"3":{"Display":"Da\u013c\u0113ji nepiekr\u012btu"},"4":{"Display":"Ne piekr\u012btu, ne nepiekr\u012btu"},"5":{"Display":"Da\u013c\u0113ji piekr\u012btu"},"6":{"Display":"Piekr\u012btu"},"7":{"Display":"Piln\u012bb\u0101 piekr\u012btu"}}},"NL":{"QuestionText":"[Q10.3] Nu wordt u gevraagd aan te geven in hoeverre u het eens bent met de volgende stellingen, waarbij 1 = Sterk oneens en 7 = Sterk eens (schaal van 1-7)","Choices":{"1":{"Display":"Over het algemeen wantrouw ik onze internationale bondgenoten"},"2":{"Display":"Ik ben teleurgesteld over de acties van de internationale gemeenschap bij het beschermen van mijn land"},"3":{"Display":"Ik voel me gefrustreerd over de manier waarop mijn staat inspeelt op de behoeften van burgers"},"4":{"Display":"Ik ben boos op mijn staat omdat deze de belangen van haar burgers niet beschermt."},"5":{"Display":"Ik voel woede omdat de informatie die ik wil raadplegen in mijn land wordt gecensureerd"},"6":{"Display":"Ik ben gefrustreerd omdat mijn staat de media verbiedt waartoe ik toegang wil hebben"}},"Answers":{"1":{"Display":"Ik ben het er absoluut niet mee eens"},"2":{"Display":"Niet mee eens"},"3":{"Display":"Ik ben het er enigszins mee oneens"},"4":{"Display":"Noch eens, noch oneens"},"5":{"Display":"enigszins mee eens"},"6":{"Display":"Mee eens zijn"},"7":{"Display":"Helemaal mee eens"}}},"PL":{"QuestionText":"[Q10.3] Teraz zostaniesz poproszony o wskazanie stopnia, w jakim zgadzasz si\u0119 z nast\u0119puj\u0105cymi stwierdzeniami, gdzie 1 = Zdecydowanie si\u0119 nie zgadzam, a 7 = Zdecydowanie si\u0119 zgadzam (skala 1-7)","Choices":{"1":{"Display":"Generalnie nie ufam naszym mi\u0119dzynarodowym sojusznikom"},"2":{"Display":"Jestem rozczarowany dzia\u0142aniami spo\u0142eczno\u015bci mi\u0119dzynarodowej maj\u0105cymi na celu ochron\u0119 mojego kraju"},"3":{"Display":"Czuj\u0119 frustracj\u0119 z powodu sposobu, w jaki m\u00f3j stan zaspokaja potrzeby obywateli"},"4":{"Display":"Jestem z\u0142y na m\u00f3j stan za to, \u017ce nie chroni interes\u00f3w swoich obywateli"},"5":{"Display":"Czuj\u0119 z\u0142o\u015b\u0107, poniewa\u017c informacje, do kt\u00f3rych chc\u0119 uzyska\u0107 dost\u0119p, s\u0105 w moim kraju cenzurowane"},"6":{"Display":"Jestem sfrustrowany, bo m\u00f3j stan zabrania mi dost\u0119pu do medi\u00f3w, do kt\u00f3rych chc\u0119 mie\u0107 dost\u0119p"}},"Answers":{"1":{"Display":"Zdecydowanie si\u0119 nie zgadzam"},"2":{"Display":"Nie zgadza\u0107 si\u0119"},"3":{"Display":"Raczej si\u0119 nie zgadzam"},"4":{"Display":"Ani si\u0119 zgadzam, ani nie zgadzam"},"5":{"Display":"Raczej si\u0119 zgadzam"},"6":{"Display":"Zgadza\u0107 si\u0119"},"7":{"Display":"Zdecydowanie si\u0119 zgadzam"}}},"RU":{"QuestionText":"[Q10.3] \u0422\u0435\u043f\u0435\u0440\u044c \u0432\u0430\u043c \u0431\u0443\u0434\u0435\u0442 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u043e \u0443\u043a\u0430\u0437\u0430\u0442\u044c \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0432\u0430\u0448\u0435\u0433\u043e \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u044f \u0441\u043e \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u043c\u0438 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f\u043c\u0438, \u0433\u0434\u0435 1 = \u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u0435 \u0441\u043e\u0433\u043b\u0430\u0441\u0435\u043d \u0438 7 = \u041f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0441\u043e\u0433\u043b\u0430\u0441\u0435\u043d (\u0448\u043a\u0430\u043b\u0430 \u043e\u0442 1 \u0434\u043e 7)","Choices":{"1":{"Display":"\u0412 \u0446\u0435\u043b\u043e\u043c \u044f \u043d\u0435 \u0434\u043e\u0432\u0435\u0440\u044f\u044e \u043d\u0430\u0448\u0438\u043c \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u043c \u0441\u043e\u044e\u0437\u043d\u0438\u043a\u0430\u043c."},"2":{"Display":"\u042f \u0440\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043d \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f\u043c\u0438 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0433\u043e \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430 \u043f\u043e \u0437\u0430\u0449\u0438\u0442\u0435 \u043c\u043e\u0435\u0439 \u0441\u0442\u0440\u0430\u043d\u044b."},"3":{"Display":"\u042f \u0440\u0430\u0437\u043e\u0447\u0430\u0440\u043e\u0432\u0430\u043d \u0442\u0435\u043c, \u043a\u0430\u043a \u043c\u043e\u0435 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u043e \u0443\u0434\u043e\u0432\u043b\u0435\u0442\u0432\u043e\u0440\u044f\u0435\u0442 \u043f\u043e\u0442\u0440\u0435\u0431\u043d\u043e\u0441\u0442\u0438 \u0433\u0440\u0430\u0436\u0434\u0430\u043d."},"4":{"Display":"\u042f \u0437\u043e\u043b \u043d\u0430 \u0441\u0432\u043e\u0435 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u043e \u0437\u0430 \u0442\u043e, \u0447\u0442\u043e \u043e\u043d\u043e \u043d\u0435 \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442 \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u044b \u0441\u0432\u043e\u0438\u0445 \u0433\u0440\u0430\u0436\u0434\u0430\u043d."},"5":{"Display":"\u042f \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044e \u0433\u043d\u0435\u0432, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f, \u043a \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u044f \u0445\u043e\u0447\u0443 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0434\u043e\u0441\u0442\u0443\u043f, \u043f\u043e\u0434\u0432\u0435\u0440\u0433\u0430\u0435\u0442\u0441\u044f \u0446\u0435\u043d\u0437\u0443\u0440\u0435 \u0432 \u043c\u043e\u0435\u0439 \u0441\u0442\u0440\u0430\u043d\u0435."},"6":{"Display":"\u042f \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0435\u043d, \u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u043c\u043e\u0435 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u043e \u0437\u0430\u043f\u0440\u0435\u0449\u0430\u0435\u0442 \u043c\u043d\u0435 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u0421\u041c\u0418, \u043a \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u044f \u0445\u043e\u0447\u0443 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0434\u043e\u0441\u0442\u0443\u043f"}},"Answers":{"1":{"Display":"\u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u0435 \u0441\u043e\u0433\u043b\u0430\u0441\u0435\u043d"},"2":{"Display":"\u041d\u0435 \u0441\u043e\u0433\u043b\u0430\u0441\u0435\u043d"},"3":{"Display":"\u041d\u0435\u043c\u043d\u043e\u0433\u043e \u043d\u0435 \u0441\u043e\u0433\u043b\u0430\u0441\u0435\u043d"},"4":{"Display":"\u041d\u0438 \u0441\u043e\u0433\u043b\u0430\u0441\u0435\u043d, \u043d\u0438 \u043d\u0435 \u0441\u043e\u0433\u043b\u0430\u0441\u0435\u043d"},"5":{"Display":"\u0412 \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u0441\u043e\u0433\u043b\u0430\u0441\u0435\u043d"},"6":{"Display":"\u0421\u043e\u0433\u043b\u0430\u0448\u0430\u0442\u044c\u0441\u044f"},"7":{"Display":"\u041f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0441\u043e\u0433\u043b\u0430\u0441\u0435\u043d"}}},"SR":{"QuestionText":"[\u041f10.3] \u0421\u0430\u0434\u0430 \u045b\u0435 \u0432\u0430\u0441 \u0437\u0430\u043c\u043e\u043b\u0438\u0442\u0438 \u0434\u0430 \u043d\u0430\u0437\u043d\u0430\u0447\u0438\u0442\u0435 \u0441\u0442\u0435\u043f\u0435\u043d \u0432\u0430\u0448\u0435\u0433 \u0441\u043b\u0430\u0433\u0430\u045a\u0430 \u0441\u0430 \u044