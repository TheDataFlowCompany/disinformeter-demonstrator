\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u044b \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0435 \u043e\u0442\u2026<br \/> \u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u043e\u0446\u0435\u043d\u0438\u0442\u0435 \u043e\u0442 1 (\u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043d\u0435 \u0434\u043e\u0432\u0435\u0440\u044f\u044e) \u0434\u043e 7 (\u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0434\u043e\u0432\u0435\u0440\u044f\u044e)","Choices":{"1":{"Display":"\u0412\u0430\u0448\u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u043d\u043e\u0432\u043e\u0441\u0442\u043d\u044b\u0435 \u0430\u0433\u0435\u043d\u0442\u0441\u0442\u0432\u0430"},"2":{"Display":"\u041d\u043e\u0432\u043e\u0441\u0442\u043d\u044b\u0435 \u0430\u0433\u0435\u043d\u0442\u0441\u0442\u0432\u0430, \u0441 \u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438 \u0432\u044b \u043d\u0435\u0447\u0430\u0441\u0442\u043e \u0441\u0442\u0430\u043b\u043a\u0438\u0432\u0430\u0435\u0442\u0435\u0441\u044c"},"3":{"Display":"\u0421\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0441\u0435\u0442\u0438 (\u0442\u0430\u043a\u0438\u0435 \u043a\u0430\u043a Instagram, TikTok, Facebook, Twitter \u0438 \u0442. \u0434.)"},"4":{"Display":"\u0413\u0440\u0443\u043f\u043f\u044b \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f\u0445 \u0434\u043b\u044f \u043e\u0431\u043c\u0435\u043d\u0430 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f\u043c\u0438 (\u0442\u0430\u043a\u0438\u0445 \u043a\u0430\u043a WhatsApp, Telegram, Signal \u0438 \u0442. \u0434.)"},"5":{"Display":"\u041f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u044b \u043f\u043e\u0434\u043a\u0430\u0441\u0442\u043e\u0432 (\u0442\u0430\u043a\u0438\u0435 \u043a\u0430\u043a Spotify, Apple Podcasts \u0438 \u0442. \u0434.)"},"6":{"Display":"\u041f\u043e\u043b\u0438\u0442\u0438\u043a\u0438"},"7":{"Display":"\u0413\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u