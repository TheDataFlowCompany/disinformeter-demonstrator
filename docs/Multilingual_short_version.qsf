f\u064a\u062f \u0645\u062f\u0649 \u0645\u0648\u0627\u0641\u0642\u062a\u0643 \u0639\u0644\u0649 \u0627\u0644\u0639\u0628\u0627\u0631\u0627\u062a \u0627\u0644\u062a\u0627\u0644\u064a\u0629\u060c \u062d\u064a\u062b 1 = \u0623\u062e\u062a\u0644\u0641 \u0628\u0634\u062f\u0629 \u06487 = \u0623\u0648\u0627\u0641\u0642 \u0628\u0634\u062f\u0629 (\u0645\u0642\u064a\u0627\u0633 \u0645\u0646 1 \u0625\u0644\u0649 7)","Choices":{"1":{"Display":"\u0625\u0644\u0649 \u062d\u062f \u0645\u0627\u060c \u0623\u0646\u0627 \u0645\u0639\u062c\u0628 \u0628\u0631\u0648\u0633\u064a\u0627"},"2":{"Display":"\u0623\u062d\u064a\u0627\u0646\u064b\u0627 \u0623\u0634\u0639\u0631 \u0628\u0627\u0644\u0625\u0644\u0647\u0627\u0645 \u0645\u0646 \u0631\u0648\u0633\u064a\u0627"},"3":{"Display":"\u0631\u0648\u0633\u064a\u0627 \u062a\u0645\u0646\u062d\u0646\u064a \u0627\u0644\u0623\u0645\u0644"}},"Answers":{"1":{"Display":"\u0623\u062e\u062a\u0644\u0641 \u0628\u0634\u062f\u0629"},"2":{"Display":"\u0644\u0627 \u0623\u0648\u0627\u0641\u0642"},"3":{"Display":"\u0644\u0627 \u0623\u062a\u0641\u0642 \u0625\u0644\u0649 \u062d\u062f \u0645\u0627"},"4":{"Display":"\u0644\u0627 \u0623\u0648\u0627\u0641\u0642 \u0648\u0644\u0627 \u0623\u062e\u062a\u0644\u0641"},"5":{"Display":"\u0623\u0648\u0627\u0641\u0642 \u0625\u0644\u0649 \u062d\u062f \u0645\u0627"},"6":{"Display":"\u064a\u0648\u0627\u0641\u0642"},"7":{"Display":"\u0623\u0648\u0627\u0641\u0642 \u0628\u0634\u062f\u0629"}}},"BG":{"QuestionText":"[\u041210.5] \u0421\u0435\u0433\u0430 \u0449\u0435 \u0431\u044a\u0434\u0435\u0442\u0435 \u043f\u043e\u043c\u043e\u043b\u0435\u043d\u0438 \u0434\u0430 \u043f\u043e\u0441\u043e\u0447\u0438\u0442\u0435 \u0441\u0442\u0435\u043f\u0435\u043d\u0442\u0430 \u043d\u0430 \u0432\u0430\u0448\u0435\u0442\u043e \u0441\u044a\u0433\u043b\u0430\u0441\u0438\u0435 \u0441\u044a\u0441 \u0441\u043b\u0435\u0434\u043d\u0438\u0442\u0435 \u0442\u0432\u044a\u0440\u0434\u0435\u043d\u0438\u044f, \u043a\u044a\u0434\u0435\u0442\u043e 1 = \u041d\u0430\u043f\u0